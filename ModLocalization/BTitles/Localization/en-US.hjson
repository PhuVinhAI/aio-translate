	BTitles: {
		Configs: {
			GeneralConfig: {
				DisplayName: General Config

				Headers: {
					Visuals_Config: Visuals Config
					Advanced_Customization: Advanced Customization
					Animation: Animation
					Auto_Detection: Auto_ Detection Header
					System: System Header
				}

				Position: {
					Label: Position
					Tooltip: Choose the position of the Title
				}

				CustomPositionX.Label: Custom Position X
				CustomPositionY.Label: Custom Position Y

				Scale: {
					Label: Scale
					Tooltip: Set the scale of the title
				}

				UseCustomTextColors: {
					Label: Colorize Titles
					Tooltip: Enable or disable custom title colors for each biome
				}

				ShowIcons: {
					Label: Biome Icons
					Tooltip: Enable or disable custom icon for each biome, if available
				}

				DisplaySubtitle: {
					Label: Display Subtitle
					Tooltip: Enable or disable title subtitle
				}

				EnableBackgrounds: {
					Label: Title Backgrounds
					Tooltip: Enable visibility for title and subtitle backgrounds
				}

				HideWhileInventoryOpen: {
					Label: Hide While Inventory Open
					Tooltip: Should titles be hidden when the player inventory is open
				}

				CustomBiomeNames: {
					Label: Custom Biome Names
					Tooltip: Set custom names for the biomes
				}

				EnableDraggableTitle: {
					Label: Enable Draggable Title
					Tooltip: Enable or disable draggable title if position is set to Custom
				}

				BiomeCheckDelay: {
					Label: Biome Check Interval
					Tooltip: Interval between biome checks in seconds
				}

				TitleAnimation: {
					Label: Animation Type
					Tooltip: Title appear and disappear animation
				}

				VisibilityDuration: {
					Label: Visibility Duration
					Tooltip: Time for titles to be displayed on screen in seconds, 0 means infinite

					TransitionInDuration: {
						Label: Transition In Duration
						Tooltip: Time for titles to appear on screen in seconds
					}

					TransitionOutDuration: {
						Label: Transition Out Duration
						Tooltip: Time for titles to disappear from screen in seconds
					}
				}

				TransitionInDuration: {
					Label: Transition In Duration
					Tooltip: Time for titles to appear on screen in seconds
				}

				TransitionOutDuration: {
					Label: Transition Out Duration
					Tooltip: Time for titles to disappear from screen in seconds
				}

				PositionOption: {
					Top.Label: Top
					Bottom.Label: Bottom
					RPGStyle.Label: RPG Style
					Custom.Label: Custom
				}

				ScaleOption: {
					Small.Label: Small
					Normal.Label: Normal
					Big.Label: Big
				}

				BiomeNameMapping: {
					CurrentName: {
						Label: Current Name
						Tooltip: The current (original) name of the biome.
					}

					NewName: {
						Label: New Name
						Tooltip: The new custom name for the biome.
					}
				}

				TitleAnimationType: {
					None.Label: No Animation
					ShowFade.Label: Show/Fade
					ShowFadeSwipe.Label: Show/Fade With Swipe
				}

				AutoDetectBiomes: {
					Label: Automatically detect modded biomes
					Tooltip: Show titles for biomes from mods without explicit support
				}

				AutoDetectNewBiomes: {
					Label: Auto-Detect New Biomes
					Tooltip: Enable automatic detection of biomes from unsupported mods
				}

				HasShownAdvertisement: {
					Label: Has Shown Advertisement
					Tooltip: ""
				}

				HasShownFirstTimeMessage: {
					Label: First Time Message Shown
					Tooltip: Internal flag to track if the welcome message has been shown
				}
			}

			PositionOption: {
				Top: {
					Label: Top
					Tooltip: Mods.BTitles.Configs.PositionOption.Top.Tooltip
				}

				Bottom: {
					Label: Bottom
					Tooltip: Mods.BTitles.Configs.PositionOption.Bottom.Tooltip
				}

				RPGStyle: {
					Label: RPG style
					Tooltip: Mods.BTitles.Configs.PositionOption.RPGStyle.Tooltip
				}

				Custom: {
					Label: Custom
					Tooltip: Mods.BTitles.Configs.PositionOption.Custom.Tooltip
				}
			}

			ScaleOption: {
				Small: {
					Label: Small
					Tooltip: Mods.BTitles.Configs.ScaleOption.Small.Tooltip
				}

				Normal: {
					Label: Normal
					Tooltip: Mods.BTitles.Configs.ScaleOption.Normal.Tooltip
				}

				Big: {
					Label: Big
					Tooltip: Mods.BTitles.Configs.ScaleOption.Big.Tooltip
				}
			}

			BiomeNameMapping: {
				CurrentName: {
					Label: Current Name
					Tooltip: The current (original) name of the biome.
				}

				NewName: {
					Label: New Name
					Tooltip: The new custom name for the biome.
				}
			}

			TitleAnimationType: {
				None: {
					Label: No animation
					Tooltip: Mods.BTitles.Configs.TitleAnimationType.None.Tooltip
				}

				ShowFade: {
					Label: Show/Fade
					Tooltip: Mods.BTitles.Configs.TitleAnimationType.ShowFade.Tooltip
				}

				ShowFadeSwipe: {
					Label: Show/Fade with swipe
