					UniverseSplitter: {
						DisplayName: Universe Splitter
						Tooltip:
							'''
							Triệu hồi một trường năng lượng tại vị trí con trỏ chuột
							Sau khi triển khai, trường sẽ bắt đầu triệu hồi nhiều tia nhỏ
							Sau vài giây, một tia laser khổng lồ xuất hiện tại vị trí của trường
							Hiệu ứng này có hồi chiêu 30 giây
							Cố gắng dùng vật phẩm trong thời gian hồi sẽ khiến nó chập mạch và gây sát thương cho bạn
							[c/BB57FF:'Một cổ vật từ kỷ nguyên trước, đang chờ lệnh của bạn.']
							[c/BB57FF:'Đây là một ý tưởng tồi tệ, nhưng dù sao nó cũng không phải của bạn... đúng chứ?']
							'''
					}

					VengefulSunStaff: {
						DisplayName: Vengeful Sun Staff
