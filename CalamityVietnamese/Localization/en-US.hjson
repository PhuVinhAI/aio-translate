				StatMeter: {
					DisplayName: Stat Meter
					FoolsName: Pasta Strainer
					Tooltip:
						'''
						Hiển thị gần như toàn bộ chỉ số của người chơi
						Các chỉ số tấn công/tiện ích hiển thị sẽ thay đổi tùy theo vật phẩm đang cầm
						[REV]
						[ITEMS]
						[GENERIC]
						[ABYSS]
						'''
					RevStats:
						'''
						Tăng sát thương Rage: {0}% | Thời gian Rage Mode: {1} giây
						Tăng sát thương Adrenaline: {2}% | Tăng giảm sát thương Adrenaline: {3}%
						'''

					ClassNameOverride: {
						Default: sát thương true
						Generic: sát thương không thuộc class
						NoSpeed: " (không có tốc độ)"
						SummonMeleeSpeed: " (roi)"
					}

					DamageStats:
						'''
						Class: {0}
						Sát thương: {1}
						Xuyên giáp: {2}
						'''
					DamageBase: "[{0} cơ bản] +"
					DamageNormal: "{0}%"
					DamageMult: " x{0}"
					DamageFlat: " {0} cố định"
					Crit: " | Tỉ lệ chí mạng: {0}%"
					AttackSpeed: Tốc độ tấn công: {0}%
					WhipMeleeInheritance: " [{0}% từ melee]"
					// Class stats
					AmmoStats: Tỉ lệ tiêu hao đạn: {0}%
					ManaStats: Tiêu hao mana: {0}% | Hồi mana: {1}
					SummonStats: Slot minion: {0} | Slot sentry: {1}
					WhipStats: Tầm đánh roi: {0}%
					RogueStats:
						'''
						Stealth tối đa: {0} | Hồi khi đứng yên: {1} / giây | Hồi khi di chuyển: {2} / giây
						Tăng vận tốc rogue: {3}%
						'''
					// Utility stats
					ToolRange: Tăng tầm công cụ: ({0}, {1})
					MiningSpeed: " | Tốc độ đào: {0}%"
					PlacementRange: Tăng tầm đặt block: ({0}, {1})
					TileSpeed: " | Tốc độ đặt block: {0}%"
					WallSpeed: " | Tốc độ đặt tường: {0}%"
					// Other stats
					GenericStats:
						'''
						Phòng thủ: {0} | Giảm sát thương: {1}% | Hồi máu: {2} HP/giây
						Tốc độ di chuyển: {3}% | Tăng lực nhảy: {4}%
						'''
					FlightTime: " | Thời gian bay của cánh: {0} giây"
					MiscStats: Aggro: {0} | May mắn: {1}%
					AbyssStats:
						'''
						Bóng tối Abyss: {0} | Ánh sáng người chơi: {1}x | Độ rộng đèn pin: {2}x
						Tốc độ mất hơi thở: {3}
						Máu mất mỗi tick khi hết hơi: {4}
						Phòng thủ mất do áp suất: {5}
						'''
					AbyssStatsHidden: Chỉ số Abyss chỉ hiển thị khi ở trong Abyss
				}

