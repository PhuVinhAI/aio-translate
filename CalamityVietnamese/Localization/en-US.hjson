							'''
					}

					AquasScepter: {
						DisplayName: Aqua's Scepter
						Tooltip:
							'''
							{$CommonItemTooltip.Sentry}
							Triệu hồi một đám mây bão khổng lồ trút mưa xuống kẻ địch và đánh các kẻ địch gần đó bằng năng lượng tesla quá tải
							'Thuyền trưởng! Tôi nghĩ- chúng ta sắp có cơn mưa rồi!'
							'''
