					ViridVanguard: {
						DisplayName: Virid Vanguard
						Tooltip:
							'''
							Luân phiên triệu hồi rìu và kiếm, cả hai đều tẩm độc mạnh
							Rìu bay quanh người chơi, gây sát thương lớn ở cự ly gần
							Kiếm truy đuổi kẻ địch với độ chính xác cực cao và xé nát chúng
							Tất cả vũ khí gây Sage Poison, mạnh hơn khi có nhiều vũ khí được triệu hồi
							Khi các ô lính triệu hồi đã đầy, <left> lần nữa để tung ra một cơn lốc chém về phía con trỏ
							Kỹ năng này có hồi chiêu 5 giây và yêu cầu cầm vật phẩm này
							Shift-<right> vật phẩm trong túi để đổi hướng quay
							'''
					}

					VoidConcentrationStaff: {
						DisplayName: Void Concentration Staff
						Tooltip:
							'''
							Triệu hồi một hào quang hư không đáng sợ tấn công bằng cách bắn các quả cầu hư không
							Sát thương lính triệu hồi tăng 5% khi hào quang đang hoạt động
							Yêu cầu 3 ô lính triệu hồi
							Chỉ có thể tồn tại một hào quang
							<right> để phóng một hố đen lớn dần theo thời gian
							'''
					}

					VoidEaterMarionette: {
						DisplayName: Void Eater Marionette
						Tooltip:
							'''
							Chứa sức mạnh điều khiển một Devourer thu nhỏ
							Triệu hồi lặp lại sẽ tăng chiều dài và sức mạnh của Devourer
							Devourer tấn công bằng [c/ff00ff:Divinity Devourer], [c/ff00ff:Faith Incinerator] và [c/ff00ff:Ultracosmic Maelstrom]
							Có thể chơi trò nhặt đồ với các vật phẩm rơi ra
							Shift-<right> vật phẩm trong túi khi Devourer đã được triệu hồi để ưu tiên nhặt đồ
							'''
					}

					WarloksMoonFist: {
						DisplayName: Warloks' Moon Fist
						Tooltip:
							'''
