						Tooltip:
							'''
							Phóng một quả bom hạt nhân skyfin tự dẫn tới kẻ địch bên dưới
							Đòn đánh Tàng Hình tự dẫn cực nhanh bất kể vị trí kẻ địch
							'Phi đội cá ném bom đang tới!'
							'''
					}

					SlickCane: {
						DisplayName: Slick Cane
						Tooltip:
							'''
							Vung cây gậy để đánh cắp tiền từ kẻ địch
							Đòn đánh Tàng Hình có 1/20 cơ hội khiến kẻ địch rơi 1-2 đồng vàng khi trúng đòn
							Đòn đánh Tàng Hình tăng sát thương dựa theo số tiền trong túi đồ, tối đa tới 1 Platinum
							'Nền kinh tế ở trạng thái hoàn hảo'
							'''
					}

					SludgeSplotch: {
						DisplayName: Sludge Splotch
						Tooltip: Đòn đánh Tàng Hình khiến khối bùn chính tách đôi khi trúng mục tiêu, gây thêm sát thương
					}

					SnapClam: {
						DisplayName: Snap Clam
						Tooltip:
							'''
							Có thể bám vào kẻ địch và gây sát thương theo thời gian
							Đòn đánh Tàng Hình ném ra năm con sò cùng lúc gây sát thương theo thời gian mạnh hơn
							'''
					}

					SpearofDestiny: {
						DisplayName: Spear of Destiny
						Tooltip:
							'''
							Luân phiên giữa ném 3 cây lao nhỏ tự dẫn và ném một cây thương xuyên phá
							Đòn đánh Tàng Hình ném một cây thánh thương vận tốc cao phát nổ khi trúng mục tiêu
							'''
					}

					SpearofPaleolith: {
						DisplayName: Spear of Paleolith
						Tooltip:
							'''
							Ném một cây thương cổ đại phá vỡ giáp của kẻ địch
							Các cây thương sẽ rải các mảnh hóa thạch khi bay
							Đòn đánh Tàng Hình bay chậm hơn nhưng xa hơn, rải nhiều mảnh hóa thạch hơn
							'''
					}

					SpentFuelContainer: {
						DisplayName: Spent Fuel Container
						Tooltip:
							'''
							Ném một thùng nhiên liệu chứa lượng plutonium nhỏ gây ra vụ nổ hạt nhân
							Vụ nổ sẽ không xảy ra nếu bên dưới không có khối
							Đòn đánh Tàng Hình để lại vùng nhiễm xạ tồn tại sau khi vụ nổ kết thúc
							'Chiến tranh không bao giờ thay đổi'
							'''
					}

					SporeKnife: {
						DisplayName: Spore Knife
						Tooltip:
							'''
							Ném một con dao mọc đầy bào tử, vỡ ra thành đám mây bào tử độc
							Đòn đánh Tàng Hình phun ra các chồi cây tự dẫn bám vào kẻ địch và gặm chúng
							'''
					}

					StarofDestruction: {
						DisplayName: Star of Destruction
						Tooltip:
							'''
							Ném ra một loạt tia vũ trụ hợp lại thành Ngôi Sao Hủy Diệt
							Ngôi sao phát nổ sẽ từ từ bay theo con trỏ cho tới khi hết thời gian hoặc trúng kẻ địch
							Khi hết thời gian, ngôi sao phát nổ lớn gây sát thương tăng thêm
							Đòn đánh Tàng Hình ném thêm các tia hội tụ thành ngôi sao nhanh hơn có thể xuyên mục tiêu và nổ mỗi lần trúng
							'''
					}

					StellarKnife: {
						DisplayName: Stellar Knife
						Tooltip:
							'''
							Ném các con dao dừng giữa không trung rồi tự dẫn vào kẻ địch, gây [cbuff:CalamityMod/AstralInfectionDebuff]
							Đòn đánh Tàng Hình ném ra loạt 10 con dao theo hình quạt
							'ZA WARUDO'
							'''
					}

					StormfrontRazor: {
						DisplayName: Stormfront Razor
						Tooltip:
							'''
							Ném một con dao triệu hồi sét khi trúng mục tiêu
							Đòn đánh Tàng Hình khiến dao bay nhanh hơn và triệu hồi nhiều tia sét khi trúng
							[c/24C7F0:'Ra đòn và chặn dòng chảy']
							'''
					}

					SubductionSlicer: {
						DisplayName: Subduction Slicer
						Tooltip:
							'''
							Ném một lưỡi hái phát nổ khi trúng kẻ địch
							Đòn đánh Tàng Hình còn triệu hồi một cột lửa khi trúng
							'''
					}

					Supernova: {
						DisplayName: Supernova
						Tooltip:
							'''
							Ném một quả bom thông minh khóa mục tiêu và truy đuổi
							Nếu không tìm thấy mục tiêu, nó sẽ quay trở lại với bạn
							Mỗi quả bom tạo ra một siêu tân tinh nhỏ kéo kẻ địch yếu lại và truy đuổi kẻ địch mạnh
							Đòn đánh Tàng Hình tạo ra vụ nổ rung chuyển chính nền móng của thực tại
							'''
					}

					TarragonThrowingDart: {
						DisplayName: Tarragon Throwing Dart
						Tooltip:
							'''
							Bắn ra một phi tiêu xuyên mục tiêu
							Đòn đánh Tàng Hình phun ra gai khi trúng kẻ địch
							'''
					}

					TerrorTalons: {
						DisplayName: Terror Talons
						Tooltip:
							'''
							Bắn ra những móng vuốt nhỏ dao động
							Đòn đánh Tàng Hình phóng một móng vuốt lớn tốc độ cao chém nhiều lần
							'''
					}

					TheAtomSplitter: {
						DisplayName: The Atom Splitter
						Tooltip:
							'''
							Ném một cây lao lượng tử tồn tại chồng chập, tấn công từ nhiều dòng thời gian cùng lúc
							Đòn đánh Tàng Hình thực hiện nhiều cú đánh đồng thời hơn
							'''
					}

					TheFinalDawn: {
						DisplayName: The Final Dawn
						Tooltip:
							'''
							Tấn công kẻ địch bằng cú vung lưỡi hái khổng lồ để hồi lại Tàng Hình
							Nhấn lên và tấn công để ném lưỡi hái
							Đòn đánh Tàng Hình thực hiện cú vung ngang để lại hào quang lửa tồn tại
							Đòn đánh Tàng Hình khi nhấn lên sẽ lao vào kẻ địch và chém xuyên qua chúng, tạo ra các quả cầu lửa tự dẫn
							'Chúng ta sẽ lại cưỡi ngựa tiến vào bình minh'
							'''
					}

					TheOldReaper: {
						DisplayName: The Old Reaper
						Tooltip:
							'''
							Ném một lưỡi hái nhiễm xạ chém xuyên kẻ địch
							Gắn các đồng vị không ổn định khi trúng mục tiêu, tạo ra vụ nổ hạt nhân trễ khi chúng phân rã
							Đòn đánh Tàng Hình được ném lên trời và rơi xuống kẻ địch vài giây sau
							Khi trúng, đòn đánh Tàng Hình tạo ra cơn mưa axit tập trung
							'''
					}

					TheSyringe: {
						DisplayName: The Syringe
						Tooltip:
							'''
							Ném một ống tiêm tốc độ cao tăng sát thương khi bay
							Vỡ ra thành mảnh kính và tàn tro dịch bệnh khi va chạm
							Đòn đánh Tàng Hình còn vỡ ra thành ong dịch bệnh
							'Tôi khá chắc cái này không tốt cho sức khỏe'
							'''
					}

					ThrowingBrick: {
						DisplayName: Throwing Brick
						Tooltip:
							'''
							Chứng minh độ bền của nó bằng cách ném lên trời và bắt bằng mặt
							Ném một viên gạch sẽ vỡ nếu Tàng Hình đầy
							'''
					}

					TimeBolt: {
						DisplayName: Time Bolt
						Tooltip:
							'''
							Ném một con dao thời gian làm méo mó thời gian quanh kẻ địch
							Đòn đánh Tàng Hình có thể trúng nhiều kẻ địch hơn và tạo vùng thời gian lớn hơn
							'Không nên có giới hạn cho nỗ lực của con người'
							'''
					}

					TitaniumShuriken: {
						DisplayName: Titanium Shuriken
						Tooltip: Đòn đánh Tàng Hình hoạt động như boomerang và tạo ra các bản sao khi trúng kẻ địch
					}

					ToothBall: {
						DisplayName: Tooth Ball
						Tooltip: Đòn đánh Tàng Hình tạo ra mây mưa khi trúng kẻ địch
					}

					TotalityBreakers: {
						DisplayName: Totality Breakers
						Tooltip:
							'''
							Phát nổ thành hắc ín đen cực dễ cháy
							Hắc ín đen phủ dầu lên kẻ địch và thiêu đốt chúng
							Đòn đánh Tàng Hình rò rỉ hắc ín đen khi bay
							'Tôi cần một breaker lớn hơn'
							'''
					}

					ToxicantTwister: {
						DisplayName: Toxicant Twister
						Tooltip:
							'''
							Ném ra bốn đĩa xoay thành hình quạt xoáy quanh con trỏ
							Đòn đánh Tàng Hình xoáy trong phạm vi rộng hơn và tạo lốc xoáy mưa độc tự dẫn vào kẻ địch
							'''
					}

					Turbulance: {
						DisplayName: Turbulance
						Tooltip:
							'''
							Bắn một cây lao gió vỡ ra thành các nhát chém gió khi trúng mục tiêu
							Các nhát chém gió đôi khi tự dẫn, và luôn tự dẫn nếu cây lao chí mạng
							Đòn đánh Tàng Hình để lại các nhát chém gió tự dẫn phía sau
							'''
					}

					TwistingThunder: {
						DisplayName: Twisting Thunder
						Tooltip:
							'''
							Bắn ra tia sét điện giật kẻ địch
							Tia sét bay nhanh hơn khi trời đang mưa
							Triệu hồi sét từ bầu trời khi trúng mục tiêu
							Đòn đánh Tàng Hình triệu hồi nhiều sét hơn và bay nhanh hơn
							'''
					}

					UrchinStinger: {
						DisplayName: Urchin Stinger
						Tooltip:
							'''
							Găm vào kẻ địch và tiêm một loại độc cực mạnh
							Đòn đánh Tàng Hình găm vào kẻ địch và gây độc lâu hơn
							Găm bảy mũi gai vào một kẻ địch đang bị găm bởi đòn Tàng Hình sẽ tạo ra một vụ nổ phóng xạ
							'''
					}

					UtensilPoker: {
						DisplayName: Utensil Poker
						Tooltip:
							'''
							Bắn các dụng cụ ăn uống theo loạt ba
							Đòn đánh Tàng Hình sẽ thay thế bất kỳ dụng cụ nào bằng một con dao mổ cực mạnh
							'Gà không gian, chỉ vậy thôi'
							'''
					}

					Valediction: {
						DisplayName: Valediction
						Tooltip:
							'''
							Ném một lưỡi hái tử thần tự dẫn
							Đòn đánh Tàng Hình tạo ra các cơn lốc lưỡi dao khi trúng kẻ địch
							'''
					}

					Vega: {
						DisplayName: Vega
						Tooltip:
							'''
							Ném một cây thương vỡ ra thành các mảnh sao khi va chạm và tạo ra Starburst
							Đòn đánh Tàng Hình triệu hồi hình ảnh của Lyra gây sát thương cực lớn trong một khu vực
							<right> để tiêu thụ 20 Starburst và ngay lập tức thực hiện một đòn Tàng Hình, bất kể mức Tàng Hình hiện tại
							Đòn đánh này gọi tất cả các mảnh sao tấn công kẻ địch bị trúng và gây [cbuff:CalamityMod/Voidfrost]
							Tiêu thụ Starburst bằng Vega cho phép sử dụng Tàng Hình trong 10 giây, ngay cả khi không có giáp rogue
							'Bản nhạc cuối cùng của một thiên tài bị hiểu lầm... hay chỉ là một kẻ điên'
							'''
					}

					WaveSkipper: {
						DisplayName: Wave Skipper
						Tooltip:
							'''
							Ném một cây thương nảy bật rất nhiều lần
							Đòn đánh Tàng Hình ném ra ba cây thương tốc độ cao
							'''
					}

					WebBall: {
						DisplayName: Web Ball
						Tooltip:
							'''
							Ném một quả cầu phủ đầy mạng nhện khiến kẻ địch bị bao phủ bởi tơ nhện và chậm lại
							Đòn đánh Tàng Hình làm chậm kẻ địch lâu hơn
							'''
					}

					Whitewater: {
						DisplayName: Whitewater
						Tooltip:
							'''
							Ném một lọ nước trắng ma thuật vào vị trí con trỏ, sẽ phát sáng sau một lúc ngắn
							Những lọ trúng kẻ địch khi đang phát sáng sẽ phóng ra bốn cây lao nước hội tụ trở lại vị trí của lọ
							Nếu lọ trúng kẻ địch hoặc bay quá xa, nó sẽ quay trở lại chủ nhân
							Đòn đánh Tàng Hình tạo ra sáu cây lao nước và triệu hồi một xoáy nước trắng hồi máu cho người chơi và đẩy lùi kẻ địch
							Đồng minh bước vào xoáy nước sẽ được hồi máu lâu gấp đôi
							'''
					}

					Wrathwing: {
						DisplayName: Wrathwing
						Tooltip:
							'''
							Ném một cây thương có cánh linh hoạt tự dẫn và liên tục phun lửa
							Đòn đánh Tàng Hình tạo ra vụ phun trào tàn lửa khi trúng mục tiêu
							'''
					}

					WulfrumKnife: {
						DisplayName: Wulfrum Knife
						Tooltip:
							'''
							Bắn các dao Wulfrum theo loạt 3 và găm vào kẻ địch
							Đòn đánh Tàng Hình khiến dao bay xa hơn và đánh trúng nhiều lần cùng lúc
							<right> để hút tất cả các dao đang găm quay trở lại bạn, hồi lại Tàng Hình
							Các dao quay về cũng tạm thời cho phép dùng đòn Tàng Hình ngay cả khi không có giáp rogue
							'''
					}

					Pumpkaboom: {
						DisplayName: Pumpkaboom
						Tooltip:
							'''
							Ném một quả bí ngô găm vào kẻ địch và phát nổ sau một khoảng trễ
							Đòn đánh Tàng Hình ném ra những quả bí lớn hơn hút kẻ địch vào trước khi gây ra vụ nổ lớn hơn
							'''
					}
				}

				DraedonsArsenal: {
					AerialTracker: {
						DisplayName: P-LSR: Aerial Tracker
						Tooltip:
							'''
							Thả ra một đĩa bay bắn laser vào kẻ địch gần đó
							Laser không gây sát thương trực tiếp mà áp dụng hiệu ứng bỏng laser cộng dồn
							Khi bị trúng đủ laser hoặc sau một khoảng thời gian, hiệu ứng bỏng laser sẽ gây sát thương trực tiếp
							Đĩa bay tăng tốc khi quay trở lại người chơi
							Đòn đánh Tàng Hình ném ra hai đĩa có thể bắn nhiều mục tiêu khác nhau ở khoảng cách xa hơn
							'''
					}

					AqueousHunterDrone: {
						DisplayName: P-PMA: Aqueous Hunter Drone
						Tooltip:
							'''
							Triệu hồi một drone tôm bắn loạt tên lửa plasma tự dẫn
							<right> khi đang cầm bất kỳ vũ khí triệu hồi nào để ra lệnh cho con tôm phóng loạt tên lửa thẳng đứng
							Tên lửa thẳng đứng sẽ nhắm về phía con trỏ và để lại vụ nổ tồn tại nếu trúng mặt đất
							Mỗi con tôm chiếm 4 ô lính triệu hồi
							[c/1FFBFF:'Khi truy đuổi những kẻ theo các vị thần, Yharim tin rằng không nên bỏ sót bất kỳ điều gì.]
							[c/1FFBFF:Vũ khí cho các tình huống dưới nước được chú trọng đặc biệt, nhưng không mẫu nào từng được triển khai.']
							'''
					}

					Auger: {
						DisplayName: P-GSS: Auger
						Tooltip:
							'''
							Một thiết bị đeo cổ tay phát ra lưỡi kiếm năng lượng từ tính
							<right> để tạo lực hút từ tính ngắn tại vị trí con trỏ và tăng sức mạnh cho nhát chém tiếp theo
							[c/1FFBFF:'Ban đầu được sản xuất để cắt và tách các khối nguyên liệu thô để vận chuyển.]
							[c/1FFBFF:Giữ cho cả hai tay rảnh mà vẫn đảm bảo sức mạnh khiến nó cực kỳ tiện dụng.']
							'''
					}

					CountermeasureMitt: {
						DisplayName: B-LSR: Countermeasure Mitt
						Tooltip:
							'''
							Một găng tay hàn chính xác với bộ phát laser ở mỗi đầu ngón tay
							<right> để tập trung toàn bộ bộ phát thành một vụ nổ lòng bàn tay tầm ngắn luôn chí mạng
							Vụ nổ lòng bàn tay có thời gian hồi chiêu, ngắn hơn đáng kể nếu bắn trượt
							[c/1FFBFF:'Hầu hết các tiểu đoàn thích tấn công diện rộng hoặc tập trung vào một mục tiêu duy nhất.]
							[c/1FFBFF:Chiếc găng này phục vụ cả hai, dù nó không thể kết hợp hoàn toàn hai chiến thuật đó.']
							'''
					}

					GalvanizingGlaive: {
						DisplayName: Galvanizing Glaive
						Tooltip:
							'''
							Vung một cây thương bao phủ kẻ địch trúng đòn trong trường năng lượng
							Khi kết thúc, cây thương sẽ phát ra một xung năng lượng bổ sung
							[c/1FFBFF:'Một công cụ nhanh chóng và gọn gàng chia một vật thành hai.]
							[c/1FFBFF:Hiệu quả và độ tin cậy của nó như một vũ khí là điều không thể phủ nhận.']
							'''
					}

					HolofibreImmolator: {
						DisplayName: R-PMA: Holofibre Immolator
						Tooltip:
							'''
							Bắn ba giọt plasma chịu ảnh hưởng trọng lực xuyên qua kẻ địch
							Giữ <left> để nhanh chóng sạc cung và bắn một mũi tên plasma tốc độ cao
							Mũi tên plasma sẽ phát nổ sau khi va chạm, mạnh hơn nếu găm vào địa hình
							Giữ <right> để bắn liên tục các phát chưa sạc
							Giữ <right> và <left> sẽ tự động bắn các mũi tên đã sạc với tốc độ hơi chậm hơn
							[c/1FFBFF:'Vẻ thanh lịch của holofibre là vô song.]
							[c/1FFBFF:Tuy nhiên, lực căng cơ học có thể đã mang lại kết quả ổn định hơn.']
							'''
					}

					HydraulicVoltCrasher: {
						DisplayName: Hydraulic Volt Crasher
						Tooltip:
							'''
							Một búa khoan điện tích điện gây sốc cho mọi kẻ địch gần đó khi trúng
							Nhấn <right> để sử dụng mà không phá tường
							[c/1FFBFF:'Một thiết bị dùng để dập các tấm kim loại bằng điện, hợp nhất chúng ngay lập tức.]
							[c/1FFBFF:Tất nhiên, nó cũng có thể trở thành một vũ khí hủy diệt.']
							'''
					}

					MountedScanner: {
						DisplayName: Mounted Scanner
						Tooltip: Triệu hồi một mô-đun quét mạnh mẽ phía trên đầu bạn bắn laser vào kẻ địch gần đó
					}

					Nidhogg: {
						DisplayName: B-GSS: Nidhogg
						Tooltip:
							'''
							Một khẩu railgun năng lượng từ bắn nhanh tạo ra các vụ nổ từ tính kéo kẻ địch yếu vào khi trúng
							Chỉ có thể tồn tại một vụ nổ cùng lúc
							Nhấn <right> để bắt đầu sạc một tia năng lượng hủy diệt luôn chí mạng và sẽ bắn khi sẵn sàng
							Đòn sạc này không thể bị ngắt và có thời gian hồi rất dài
							[c/1FFBFF:'Nhiều binh sĩ đánh giá thấp sức hủy diệt của từ tính.]
							[c/1FFBFF:Khẩu railgun này đã thuyết phục nhiều kẻ hoài nghi bằng hiệu suất nghiền nát của nó.']
							'''
					}

					PhalanxSurge: {
						DisplayName: W-LSR: Phalanx Surge
						Tooltip:
							'''
							Bắn một loạt laser
							Giữ <right> để sạc vũ khí, cho phép lao tới và đâm kẻ địch bằng thương năng lượng
							Giữ <left> khi dùng đòn sạc sẽ phóng bạn về phía trước với tốc độ cao và gây thêm sát thương
							Dùng đòn sạc có thời gian hồi ngắn
							[c/1FFBFF:'Lực lượng của Yharim rất cần vũ khí cận chiến.]
							[c/1FFBFF:Một cây thương laser để xuyên thủng kẻ thù đã nhận được sự tán thưởng vang dội.']
							'''
					}

					Phaseslayer: {
						DisplayName: Phaseslayer
						Tooltip:
							'''
							Tạo ra một lưỡi kiếm laser khổng lồ được điều khiển bằng con trỏ
							Di chuyển con trỏ để vung kiếm và xé nát kẻ địch
							Vung càng nhanh gây càng nhiều sát thương và phóng thêm các tia kiếm
							'''
					}

					PlasmaCaster: {
						DisplayName: Plasma Caster
						Tooltip:
							'''
							Nhấn <left> để bắn một viên plasma lớn phát nổ
							Nhấn <right> để bắn chế độ turbo, tăng tốc độ bắn nhưng giảm độ chính xác
							'''
					}

					PlasmaGrenade: {
						DisplayName: Plasma Grenade
						Tooltip:
							'''
							Ném một quả lựu đạn phát nổ thành plasma khi va chạm
							Đòn đánh Tàng Hình phát nổ dữ dội tạo ra vụ nổ bốc hơi
							[c/1FFBFF:'Mỗi quả lựu đạn chứa một đơn vị plasma cực kỳ nén và nóng. Hãy sử dụng cực kỳ cẩn thận.']
							'''
					}

					PoleWarper: {
						DisplayName: Pole Warper
						Tooltip:
							'''
							Triệu hồi một cặp nam châm bay lơ lửng đẩy nhau và liên tục lao vào kẻ địch
							Các thiết bị từ tính xé toạc kẻ thù bằng cách tự phóng khỏi đối cực của chúng
							'''
					}

					PulseDragon: {
						DisplayName: Pulse Dragon
						Tooltip:
							'''
							Ném hai đầu rồng cơ khí phát ra trường điện gây sát thương
							[c/1FFBFF:'Yharim đặc biệt yêu cầu vũ khí này được mô phỏng theo những con Rồng cổ xưa.]
							[c/1FFBFF:Thật sáo rỗng.']
							'''
					}

					PulseGrenade: {
						DisplayName: R-PLS: Pulse Grenade
						Tooltip:
							'''
							Một quả lựu đạn tự tái tạo sẽ truy đuổi kẻ địch và vỡ thành 8 quả cầu xung
							Các quả cầu xung sẽ quay lại bạn và tái tạo lại lựu đạn, đánh trúng mọi thứ trên đường đi
							Đòn đánh Tàng Hình ném lựu đạn với tốc độ cao và vỡ thành gấp đôi số quả cầu
							'''
					}

					PulsePistol: {
						DisplayName: P-PLS: Pulse Pistol
						Tooltip:
							'''
							Bắn một quả cầu xung truy đuổi mục tiêu gần đó
							Sau khi trúng kẻ địch, quả cầu xung sẽ tách thành hai
							Khả năng xuyên của quả cầu xung tăng khi giết kẻ địch
							'''
					}

					PulseRifle: {
						DisplayName: A-PLS: Pulse Rifle
						Tooltip:
							'''
							Bắn một tia xung tăng cường vỡ thành 4 quả cầu xung tần số cao khi trúng
							Các quả cầu xung sẽ truy đuổi kẻ địch gần đó và càng đánh trúng sẽ truy đuổi càng nhanh
							Khả năng xuyên của quả cầu xung không giảm khi giết kẻ địch hoặc gây sát thương thấp
							[c/1FFBFF:'Vũ khí cá nhân của ta, dùng để tiêu diệt những tạo vật thất bại.]
							[c/1FFBFF:Ta đã sao lưu bản thiết kế phòng khi bản gốc bị phá hủy.']
							'''
					}

					PulseTurretRemote: {
						DisplayName: Pulse Turret Remote
						Tooltip:
							'''
							{$CommonItemTooltip.Sentry}
							Triệu hồi một tháp pháo bắn các vụ nổ xung vào kẻ địch
							Chỉ có thể tồn tại một tháp pháo xung cùng lúc
							'''
					}

					ShortCircuit: {
						DisplayName: P-TSL: Short Circuit
						Tooltip:
							'''
							Nhấn <left> để bắn nhanh các tia điện gây choáng với lực đẩy lùi cao
							Nhấn <right> để bắn một móc nối vào kẻ địch và liên tục điện giật chúng
							Sau khi điện giật đủ lâu, móc sẽ tạo ra một vụ nổ điện trước khi quay về
							Các đòn móc thành công có thời gian hồi ngắn, trừ khi móc giết kẻ địch
							{$Common.ArmorPenetration}
							'''
					}

					SnakeEyes: {
						DisplayName: Snake Eyes
						Tooltip:
							'''
							Triệu hồi một drone lơ lửng bắn các tia năng lượng xuyên giáp cực kỳ chính xác
							Nếu tia bắn trúng, drone sẽ dịch chuyển vào đường bay và phản xạ tia đó
							Các tia phản xạ sẽ truy đuổi mục tiêu và phát nổ khi va chạm
							[c/1FFBFF:'Được trang bị cảm biến cao cấp, rất ít thứ có thể né tránh chúng. Thậm chí còn ít hơn có thể thoát khỏi ánh nhìn của chúng.]
							[c/1FFBFF:Một bước chuyển tuyệt vời giữa các thí nghiệm máy linh hồn dựa trên thị giác của ta và dự án mới nhất.']
							'''
					}

					SystemBane: {
						DisplayName: System Bane
						Tooltip:
							'''
							Ném một thiết bị không ổn định găm xuống đất và phóng điện vào kẻ địch gần đó
							Đòn đánh Tàng Hình khiến thiết bị phát ra trường điện từ lớn gây sát thương
							'''
					}

					TeslaCannon: {
						DisplayName: Tesla Cannon
						Tooltip:
							'''
							Một khẩu pháo năng lượng nhẹ bắn tia điện mạnh phát nổ
							Tia điện có thể lan sang mục tiêu gần đó
							'''
					}

					TheAnomalysNanogun: {
						DisplayName: The Anomaly's Nanogun
						Tooltip:
							'''
							Nhấn <left> để sạc 5 tia plasma bắn nhanh
							Nhấn <right> để phóng 3 bom phân hạch
							'Chào mừng đến bữa tiệc, bạn à'
							'''
					}

					Vulcan: {
						DisplayName: R-GSS: Vulcan
						Tooltip:
							'''
							Một khẩu Gatling dùng mana bắn theo loạt
							Nhấn <right> để phóng một lao móc từ tính hút các viên đạn của bạn
							Phóng lao móc sẽ khiến chế độ bắn theo loạt kéo dài lâu hơn
							Khi lao móc hết hiệu lực, tất cả các viên đạn bị hút sẽ phóng vào kẻ địch gần đó với sát thương tăng
							[c/1FFBFF:'Ban đầu là tia khai thác gắn trần, việc tháo pin chỉ làm giảm trọng lượng của nó một chút.]
							[c/1FFBFF:Nó ít được sử dụng và nhận nhiều phàn nàn từ quân đoàn pháp sư chiến đấu.']
							'''
					}

					WavePounder: {
						DisplayName: Wave Pounder
						Tooltip:
							'''
							Ném một quả bom phát nổ thành sóng xung kích cực mạnh
							Đòn đánh Tàng Hình tạo ra các sóng xung kích cực kỳ mạnh
							'''
					}
				}

				Typeless: {
					Aestheticus: {
						DisplayName: Aestheticus
						Tooltip:
							'''
							Bắn ra các tinh thể phát nổ và làm chậm kẻ địch
							Vũ khí này nhận tỉ lệ từ toàn bộ chỉ số sát thương của bạn cùng lúc
							'''
					}

					ClaretCannon: {
						DisplayName: Claret Cannon
						Tooltip:
							'''
							Bắn ra một viên đạn claret siêu nén
							Viên đạn phát nổ khi trúng kẻ địch và giải phóng các quả cầu máu
							Vụ nổ xé toạc kẻ địch, gây [cbuff:CalamityMod/Laceration] và làm giảm mạnh phòng thủ của chúng
							Nhặt các quả cầu máu sẽ giảm thời gian [cbuff:PotionSickness] nếu có
							Nếu bạn không có [cbuff:PotionSickness], khả năng hồi phục tự nhiên sẽ được tăng cường
							Chỉ có thể bắn một lần mỗi 10 giây
							'''
					}

					ColdheartIcicle: {
						DisplayName: Coldheart Icicle
						Tooltip: "'Làm tốt lắm (băng đấy)'"
					}

					EyeofMagnus: {
						DisplayName: Eye of Magnus
						Tooltip:
							'''
							Bắn ra các khối năng lượng vũ trụ truy đuổi kẻ địch, hồi máu và mana khi trúng mục tiêu
							Phát nổ thành một đám mây tinh vân làm giảm phòng thủ của kẻ địch
							Vũ khí này nhận tỉ lệ từ trung bình tất cả chỉ số sát thương của bạn
							'''
					}

					LunicEye: {
						DisplayName: Lunic Eye
						Tooltip:
							'''
							Bắn ra các tia năng lượng truy đuổi làm giảm phòng thủ của kẻ địch
							Vũ khí này nhận tỉ lệ từ trung bình tất cả chỉ số sát thương của bạn
							'''
					}

					RelicOfDeliverance: {
						DisplayName: Relic of Deliverance
						Tooltip:
							'''
							Dùng <left> để cưỡi lên cây thương; giữ <left> để tăng tốc thương, làm bạn di chuyển chậm lại
							Thả ra để phóng bản thân đi với tốc độ cực cao, giảm một nửa khi có boss còn sống
							Mất quá nhiều tốc độ khi đang tích lực sẽ làm hỏng cú tích lực và đặt lại tốc độ của bạn
							Cú lao cho phép bạn húc xuyên qua kẻ địch và di chuyển xuyên qua các khối
							Ở trong khối quá lâu sẽ dịch chuyển bạn trở lại vị trí đã đi vào
							Nhấn <right> để xuống khỏi thương
							Giữ cây thương sẽ làm giảm mạnh sát thương của toàn bộ lính triệu hồi
							[c/FF8C00:Sự báo thù đã tiếp thêm sức mạnh cho ta, ta chẳng nghĩ gì ngoài việc thực thi nó.]
							[c/FF8C00:Con rồng đã lấy đi tất cả của ta, để lại những mảnh vỡ của ta rải rác trên mặt đất.]
							[c/FF8C00:Nhưng khi ta chiến đấu bên cạnh Nàng, ta biết vẫn còn điều đáng để chiến đấu vì nó.]
							'''
					}

					Skynamite: {
						DisplayName: Skynamite
						Tooltip:
							'''
							Ném ra một khối thuốc nổ lơ lửng thách thức trọng lực
							'Bạn không cần bằng cấp khí động học để dùng thứ này đâu...'
							'''
					}

					StarStruckWater: {
						DisplayName: Star Struck Water
						Tooltip: Lan truyền Astral Infection lên một số khối
					}

					StratusSphere: {
						DisplayName: Stratus Sphere
						Tooltip:
							'''
							Phóng ra một điểm kỳ dị gây ảnh hưởng lên mọi thực thể trong phạm vi rộng xung quanh
							Người chơi bị ảnh hưởng sẽ nhận Starbursts theo thời gian và sẽ tiêu thụ Starbursts để bay khi hết thời gian bay
							<right> để khiến Starbursts tạo thành một lá chắn, khiến bạn mất Starbursts thay vì mất máu
							Phóng điểm kỳ dị sẽ vô hiệu hóa lá chắn, và tạo lá chắn sẽ vô hiệu hóa điểm kỳ dị
							'Dẫn dắt linh hồn vào những vì sao, một ý tưởng thật vô nghĩa'
							'''
					}
				}
			}

			Accessories: {
				Abaddon: {
					DisplayName: Abaddon
					Tooltip:
						'''
						{$CommonItemTooltip.PercentIncreasedCritChance}
						Đòn chí mạng gây nổ, thiêu đốt kẻ địch gần đó bằng [cbuff:CalamityMod/BrimstoneFlames]
						Giảm {1}% sát thương nhận từ [cbuff:CalamityMod/BrimstoneFlames]
						'''
				}

				AbyssalDivingGear: {
					DisplayName: Abyssal Diving Gear
					Tooltip:
						'''
						Giảm sát thương do áp suất của Abyss gây ra khi hết hơi thở
						Loại bỏ hiệu ứng chảy máu do Abyss gây ra
						Cho phép bơi và kéo dài đáng kể thời gian thở dưới nước
						Phát sáng dưới nước và tăng khả năng di chuyển trên băng
						Cung cấp một lượng ánh sáng vừa phải và giảm tốc độ mất hơi thở trong Abyss
						'''
				}

				AbyssalDivingSuit: {
					DisplayName: Abyssal Diving Suit
					Tooltip:
						'''
						Biến người mang thành một thợ lặn bọc giáp:
						Tăng tốc độ di chuyển tối đa và gia tốc khi ở dưới nước, nhưng giảm khi ở ngoài nước
						Cho phép bơi, kéo dài thời gian thở dưới nước, phát sáng dưới nước và cải thiện khả năng di chuyển trên băng
						Cung cấp một lượng ánh sáng vừa phải, giảm mất hơi thở và giảm sát thương do chết đuối trong Abyss
						Sinh vật Abyss khó phát hiện bạn hơn, giảm tác động giảm phòng thủ của Abyss, và cho phép bạn chìm nhanh hơn trong chất lỏng
						Miễn nhiễm với nước lưu huỳnh và việc tăng mất hơi thở của [cbuff:CalamityMod/CrushDepth]
						Tăng kháng với việc mất hơi thở do [cbuff:CalamityMod/HadopelagicPressure]
						'''
				}

				AbyssalMirror: {
					DisplayName: Abyssal Mirror
					Tooltip:
						'''
						Kẻ địch ít nhắm vào bạn hơn, kể cả trong Abyss
						Tạo stealth nhanh hơn 25% khi đứng yên và 12% khi di chuyển
						{$Common.DodgeProvided}
						Né đòn sẽ hồi stealth và giải phóng một đám mây gây sát thương và làm choáng kẻ địch gần đó
						'''
					HoldShiftTooltip: "{$Common.DodgeInformation}"
					FlavorTooltip: "'Ánh sáng không thể chạm tới đáy đại dương'"
				}

				AeroStone: {
					DisplayName: Aero Stone
					Tooltip:
						'''
						Cung cấp thêm {0} giây thời gian bay
						Bạn từ từ hồi lại thời gian bay khi đang ở trên không nhưng không bay hay lướt
						'Một trong những cổ vật cổ đại'
						'''
				}

				Affliction: {
					DisplayName: Affliction
					Tooltip: Cho tất cả đồng đội +{0} HP/s hồi máu, +{1}% máu tối đa, {2}% giảm sát thương, {3} phòng thủ và {4}% tăng sát thương
				}

				AlchemicalDecanter: {
					DisplayName: Alchemical Decanter
					Tooltip:
						'''
						Mọi đòn tấn công gây [cbuff:CalamityMod/Plague] và giảm {0}% sát thương nhận từ [cbuff:CalamityMod/Plague]
						Đạn bắn sinh ra plague seeker khi trúng kẻ địch
						Giải phóng ong dịch bệnh và tẩm bạn bằng [cbuff:Honey] khi bị trúng đòn
						'''
				}

				AlluringBait: {
					DisplayName: Alluring Bait
					Tooltip:
						'''
						Tăng {0} sức mạnh câu cá
						Tăng lượng cá nguyên liệu dùng làm thuốc thu được
						'''
				}

				AmalgamatedBrain: {
					DisplayName: Amalgamated Brain
					Tooltip:
						'''
