					Tooltip:
						'''
						Đặt giàn giáo kim loại tạm thời. Sử dụng [i:CalamityMod/WulfrumMetalScrap] {$Items.Materials.WulfrumMetalScrap.DisplayName} cho mỗi {0} ô được xây
						Giàn giáo cần đặt cạnh một khối rắn để có thể đặt xuống
						'Dành cho khi bạn cần xây nhanh và không cần nó tồn tại lâu.'
						'''
				}

				WulfrumTreasurePinger: {
					DisplayName: Wulfrum Treasure Pinger
					Tooltip:
						'''
						Xác định vị trí kim loại gần đó hy vọng có giá trị hơn wulfrum
						Thiết bị này trông cực kỳ tạm bợ. [c/FC4903:Nó chắc chắn sẽ hỏng sớm thôi]
						'''
				}
			}
		}

		Attunement: {
			// Broken Biome Blade
			DefaultAttunement: {
				Name: Pure Clarity
				Function: Bắn ra một kiếm khí yếu phá vỡ phòng thủ của kẻ địch
			}

			HotAttunement: {
				Name: Arid Grandeur
				Function:
					'''
					Triệu hồi các lưỡi kiếm thiêu đốt phía trước bạn, chúng sẽ lớn dần khi đánh trúng kẻ địch
					Các lưỡi kiếm sẽ bật bạn khỏi các khối khi đang ở trên không
					'''
			}

			ColdAttunement: {
				Name: Biting Embrace
				Function: Thực hiện combo 3 nhát chém bằng lưỡi kiếm băng giá, đòn cuối cùng đóng băng kẻ địch trong chốc lát
			}

			EvilAttunement: {
				Name: Decay's Retort
				Function: Lao tới bằng ảo ảnh kiếm rapier ma quái, bật ngược khỏi mục tiêu trúng đòn và hút sinh lực của chúng
			}

			// Mended Biome Blade
			TrueDefaultAttunement: {
				Name: Pure Clarity
				Function:
					'''
					Bắn ra một kiếm khí yếu phá vỡ phòng thủ của kẻ địch
					Gây trúng ba đòn cận chiến trực tiếp sẽ tích tụ một cú lao mạnh, được tung ra khi bạn ngừng vung kiếm
					Kẻ địch trúng cú lao sẽ bị đánh dấu bằng một ấn ký khiến kiếm khí tự động truy đuổi chúng
					'''
			}

			TrueHotAttunement: {
				Name: Arid Grandeur
				Function:
					'''
					Triệu hồi các lưỡi kiếm thiêu đốt phía trước bạn, chúng sẽ lớn dần khi đánh trúng kẻ địch
					Các lưỡi kiếm sẽ bật bạn khỏi các khối khi đang ở trên không
					Thả ra khi lưỡi kiếm đã tích đầy năng lượng sẽ phóng chúng lao về phía trước xé nát kẻ thù
					'''
			}

			TrueColdAttunement: {
				Name: Biting Embrace
				Function:
					'''
					Thực hiện combo 3 nhát chém bằng lưỡi kiếm băng giá, đòn cuối cùng đóng băng kẻ địch trong chốc lát
					Mỗi lần vung kiếm sẽ giải phóng làn sương băng giá tồn tại gây sát thương
					'''
			}

			TrueTropicalAttunement: {
				Name: Grovetender's Touch
				Function:
					'''
					Ném lưỡi kiếm ra bằng một roi dây leo
					Đánh trúng kẻ địch bằng đầu roi khi roi quật sẽ luôn gây chí mạng
					Các dây leo lan ra từ đòn chí mạng, có thể đánh trúng tối đa ba mục tiêu
					'''
			}

			TrueEvilAttunement: {
				Name: Decay's Retort
				Function:
					'''
					Lao tới bằng ảo ảnh kiếm rapier ma quái, bật ngược khỏi mục tiêu trúng đòn và hút sinh lực của chúng
					Gây trúng ba đòn liên tiếp mà không chạm đất sẽ biến đòn kế tiếp thành cú đâm lướt cường hóa
					'''
			}

			HolyAttunement: {
				Name: Heaven's Might
				Function:
					'''
					Vung kiếm xoay quanh bạn, tăng tốc và gây nhiều sát thương hơn theo thời gian
					Sau khi vung đủ lâu, thả ra sẽ ném thanh kiếm về phía con trỏ trong thời gian ngắn
					Đánh trúng kẻ địch bằng thanh kiếm được ném ở sức mạnh tối đa sẽ khiến một khối thiên thạch astral bùng lên từ chúng
					'''
			}

			// True Biome Blade
			WhirlwindAttunement: {
				Name: Swordsmith's Pride
				Function:
					'''
					Giữ <left> để vung kiếm xoay quanh bạn, tăng tốc và gây nhiều sát thương hơn theo thời gian
					Năng lượng astral tự dẫn sẽ bắn loạn xung quanh bạn khi đang vung kiếm
					Sau khi vung đủ lâu, thả ra sẽ ném thanh kiếm về phía con trỏ
					Thanh kiếm bị ném sẽ bùng nổ thành các khối astral khi trúng kẻ địch
					'''
				PassiveDesc: Đánh trúng kẻ địch đôi khi sẽ sinh ra các astral bomber tự dẫn lan truyền Astral Infection
			}

			FlailBladeAttunement: {
				Name: Lamentations of the Chained
				Function:
					'''
					Tung ra một loạt lưỡi kiếm xích liên hoàn
					Đánh trúng kẻ địch bằng đầu lưỡi kiếm sẽ luôn gây chí mạng
					Đòn chí mạng sẽ phóng ra thêm các sợi xích ma bám vào nhiều mục tiêu
					'''
				PassiveDesc: Một móc xích ma thuật bay quanh bạn, xoay tròn và đóng băng kẻ địch trong khi gây sát thương
			}

			SuperPogoAttunement: {
				Name: Sanguine Fury
				Function:
					'''
					Triệu hồi các lưỡi kiếm dung nham phía trước bạn, chúng sẽ lớn dần khi đánh trúng kẻ địch
					Các lưỡi kiếm sẽ bật bạn khỏi các khối khi đang ở trên không
					Thả ra sẽ phóng các lưỡi kiếm tích năng lượng về phía trước như một bánh xe
					Tấn công ngay sau khi ném lưỡi kiếm sẽ phóng bạn tới nó, chém xuyên kẻ địch và hồi máu cho bạn
					'''
				PassiveDesc: Đánh trúng kẻ địch hiếm khi hồi máu cho bạn
			}

			ShockwaveAttunement: {
				Name: Earthen Tides
				Function:
					'''
					Tích lực cho một cú lao phá đất, thả ra để tung đòn tàn phá
					Kiếm khí tự dẫn sẽ phát ra khi thanh kiếm đang tích lực
					Đánh trúng kẻ địch bằng cú lao sẽ tạo ra sóng chấn động và đánh dấu chúng bằng ấn ký phá giáp thu hút kiếm khí
					Đâm xuống đất bằng cú lao sẽ khiến nhiều vụ nổ bụi đất bùng lên xung quanh bạn
					'''
				PassiveDesc: Định kỳ phát ra các sóng chấn động lớn khi tấn công
			}

			// Galaxia
			PhoenixAttunement: {
				Name: Phoenix's Pride
				Function:
					'''
					Vung kiếm xoay quanh bạn, tăng tốc theo thời gian
					Tinh vân xoáy liên tục phát ra các tia vũ trụ tự dẫn
					Thả ra để ném thanh kiếm về phía con trỏ cùng với 6 tia vũ trụ khổng lồ
					Thanh kiếm bị ném sẽ bùng nổ thành một cơn lốc lửa khi trúng kẻ địch
					'''
			}

			AriesAttunement: {
				Name: Aries' Wrath
				Function:
					'''
					Liên kết thanh kiếm với con trỏ của bạn bằng một chuỗi chòm sao
					Đánh trúng kẻ địch gây ra các vụ nổ tinh vân sinh ra các tia vũ trụ tự dẫn
					'''
			}

			PolarisAttunement: {
				Name: Polaris' Gaze
				Function:
					'''
					Dẫn truyền sức mạnh của Galaxia vào một vòng xoáy năng lượng thiên thể
					Vòng xoáy mạnh dần theo thời gian và khi đánh trúng kẻ địch
					Thả ra để bắn một ngôi sao mạnh trực tiếp tại con trỏ, bắn phá kẻ địch xung quanh bằng các tia năng lượng
					Tấn công ngay sau khi bắn ngôi sao sẽ phóng bạn tới nó, gây sát thương lên kẻ địch
					'''
			}

			AndromedaAttunement: {
				Name: Andromeda's Stride
				Function:
					'''
					Tích lực cho một cú lao không gian, thả ra để tung ra đòn tấn công thiên hà
					Trong khi tích lực, thanh kiếm định kỳ phát ra các tia tự dẫn
					Lao vào kẻ địch sẽ khiến những ngôi sao tự dẫn khổng lồ mưa xuống từ bầu trời
					'''
			}
		}

		Bestiary: {
			//Abyss Enemies
			BabyCannonballJellyfish: Những sinh vật này đã bị săn bắt suốt hàng thế kỷ. Chúng được sử dụng rộng rãi làm đạn dược cho tàu thuyền hoặc thậm chí như những quả bom thông thường. Trong thời gian gần đây, các nhà sinh thái học đã cố gắng phục hồi quần thể của chúng do vai trò quan trọng của chúng đối với việc bảo tồn Sulphurous Sea.
			Bloatfish: Mang tính địa chất nhiều hơn sinh học, loài bloatfish có lớp da dính như keo dùng để phủ cơ thể bằng voidstone. Dù giúp bảo vệ chúng khỏi kẻ săn mồi, trọng lượng khổng lồ lại khiến chúng chìm xuống những tầng sâu nhất của Abyss.
			BobbitWorm: Ẩn mình trong những góc tối nhất của vực thẳm để tấn công con mồi mất cảnh giác, bobbit worm tận dụng tối đa bóng tối của Abyss. Để sống sót ở nơi có môi trường khắc nghiệt bậc nhất thế giới này, một sinh vật phải hoặc cực kỳ mạnh mẽ, hoặc biết tận dụng môi trường để sinh tồn, hoặc cả hai.
			BoxJellyfish: Lớn hơn sứa thông thường, cú chích của loài gây hại dai dẳng này cực kỳ nguy hiểm. Dù có thể được tìm thấy trong hầu hết các vùng nước lớn, chúng đã tuyệt chủng cục bộ quanh Ilmeris sau khi Brimstone Witch quay những lời nguyền của mình chống lại vương quốc.
			CannonballJellyfish: Những con sứa này giúp giữ Abyss sạch khỏi sự nhiễm độc lưu huỳnh. Không giống phần lớn sinh vật có lớp vỏ cứng ở Sulphurous Sea, chúng dùng các xúc tu chích để hút axit xung quanh rồi sử dụng nó cho mục đích tự vệ.
			ChaoticPuffer: Những sinh vật này hít vào một lượng nhỏ scoria trong nước khi phồng lên, làm chất lỏng bên trong nóng lên dữ dội. Ở trạng thái này chúng đủ nóng để làm chảy sắt, gây bỏng khủng khiếp cho bất kỳ ai chạm phải, và những kẻ săn mồi cố nuốt chúng sẽ bị luộc chín từ bên trong.
			ColossalSquid: Loài mực này đã phát triển kích thước và sức mạnh khổng lồ do ảnh hưởng từ tinh chất của Silva. Vì trước đây là loài ăn thực vật nên chúng có thể trực tiếp tiêu thụ những sinh vật do Silva tạo ra, khiến sinh lực bên trong chúng dồi dào hơn gần như mọi sinh vật khác trong Abyss.
			Cuttlefish: Sử dụng khả năng ngụy trang tự nhiên để ẩn mình khỏi những kẻ săn mồi lớn hơn và bắt con mồi không cảnh giác, cuttlefish kiên nhẫn chờ đợi trên mặt đất cho đến khi ra tay. Khi bị quấy rầy, chúng truy đuổi sinh vật khác không ngừng với sự hung dữ đủ để dọa lui cả những kẻ săn mồi tiềm năng.
			DevilFish: Được gọi như vậy vì cặp sừng quỷ của mình, devilfish hấp thụ những luồng khí còn sót lại từ ô nhiễm của Azafure, dùng ngọn lửa đó để tăng sức mạnh. Những tầng sâu của Abyss phần lớn không bị ô nhiễm bởi rác thải và độc tố nhờ những sinh vật bí ẩn này.
			EidolonWyrm: Họ hàng của các auric dragon, chúng thích nghi bằng cách ẩn náu trong một góc bị lãng quên của thế giới để sống sót sau các cuộc thanh trừng vĩ đại. Tuy nhiên ngay cả khi không sở hữu auric soul, sức mạnh của eidolon wyrm vẫn sánh ngang với nhiều đồng loại từng sở hữu chúng.
			GiantSquid: Mực là loài động vật nổi tiếng với tập tính ăn thịt đồng loại, gần như không ngần ngại ăn chính giống loài của mình khi cần thức ăn. Trớ trêu thay, kẻ săn mồi chính của sinh vật này lại chính là nó.
			GulperEel: Dù chậm chạp và cồng kềnh, những con lươn này di chuyển trong Abyss một cách đáng ngạc nhiên. Chúng hòa vào bóng tối, với cái miệng có thể mở rộng bất thường để từ từ nuốt chửng con mồi. Con mồi của chúng thường không hề nhận ra tình cảnh của mình cho đến khi đã quá muộn.
			Laserfish: Mặc dù Draedon rất ít nghiên cứu Abyss do áp suất khổng lồ khiến việc đó không thực tế, nhưng khoảng thời gian ngắn ngủi mà máy móc của hắn hoạt động ở đây đã để lại dấu vết dưới dạng Laserfish. Những con cá điều khiển học này từng được tạo ra để làm “đôi mắt” của hắn trong rãnh sâu, đồng thời là thí nghiệm về việc cơ thể sinh học thích nghi với tâm trí cơ khí như thế nào.
			LuminousCorvina: Lumenyl phát triển trên vây của những con corvina kỳ lạ này, khiến chúng trở thành một trong số ít nguồn sáng trong Abyss. Chúng sống sót bằng cách dẫn dụ những kẻ săn mồi của mình tới con mồi khác, phát tín hiệu vị trí bằng những xung âm chói tai.
			MirageJelly: Sử dụng ánh sáng khúc xạ từ các tinh thể lumenyl và dòng nước được làm ấm bởi sức nóng thiêu đốt của scoria, những con sứa này có thể tạo ra các ảo ảnh của chính mình để đánh lừa kẻ săn mồi hoặc bẫy con mồi.
			MorayEel: Khi một con cá cắn vào gót chân bạn và trông giống một con lươn, đó là moray. Khi nó bơi trong rạn san hô và có hai hàng răng, đó là moray. Khi bạn bị một cái ôm nhớp nháp tát thẳng vào mặt, đó vẫn là moray.
			Oarfish: Oarfish nổi tiếng với việc đẻ hàng nghìn thậm chí hàng triệu trứng trong chu kỳ sinh sản cực kỳ nhanh. Những quả trứng này là nguồn thức ăn dồi dào nhất trong Abyss, là một phần lý do khiến cả những sinh vật nhỏ bé và ít nguy hiểm nhất vẫn có thể sống được ở độ sâu gần như không thể sinh tồn của đại dương.
			SlabCrab: Dù lớp mai cứng như đá, Slab Crab lại ẩn mình ở vùng yên bình nhất của Abyss; bởi nó không thể chịu được làn nước axit phía trên cũng như những kẻ săn mồi đáng sợ phía dưới. Bình thường nó sẽ là con mồi chỉ những kẻ mạnh nhất mới có thể ăn được, nhưng trong môi trường này, nó chỉ vừa đủ để tránh khỏi sự đào thải của tự nhiên.
			ReaperShark: Là những kẻ săn mồi đỉnh cao của vực thẳm, loài cá mập này tận dụng cả khả năng ẩn mình lẫn sức mạnh để săn bất cứ thứ gì tiến lại gần. Chúng dùng cánh tay của mình cho nhiều mục đích, từ ném những con mực khổng lồ vào vách Abyss cho đến nghiền nát chiếc đầu bọc giáp của eidolon wyrm — rất ít sinh vật có thể sánh với sức mạnh thô bạo của chúng.
			ToxicMinnow: Những con cá nhỏ bất thường này đã tiến hóa để sử dụng dưỡng chất từ thực vật chúng ăn nhằm tạo ra độc tố trong cơ thể, sau đó giải phóng khi chết. Vì lý do này chúng hầu như không có kẻ săn mồi và gần như không đóng góp gì cho môi trường xung quanh.
			Viperfish: Là loài cá ăn tạp sống ở tầng giữa của Abyss, viperfish nằm gần đáy chuỗi thức ăn. Cái miệng rộng vốn dùng để lọc thức ăn cũng có thể được dùng để dọa kẻ săn mồi bằng cách bắt chước hình dáng đáng sợ hơn nhiều của gulper eel.
			//Acid Rain Enemies
			AcidEel: Dù bản thân cũng là loài săn mồi, acid eel vẫn nằm gần đáy chuỗi thức ăn của Sulphurous Sea. Chế độ ăn của chúng chủ yếu gồm các loài thân mềm, nhờ khả năng luồn lách vào những khe hẹp. Tốc độ và khả năng ngụy trang của chúng cũng giúp tránh trở thành bữa ăn cho sinh vật khác.
			BabyFlakCrab: Flak crab non hoàn toàn không cố gắng chống lại kẻ săn mồi mà chỉ đơn giản bỏ chạy trước mọi mối đe dọa. Loài này chỉ học cách bắn đạn từ xa khi trưởng thành, khiến con non gần như không có khả năng tự vệ và phụ thuộc vào bố mẹ.
			Bloodworm: Bloodworm là sinh vật cực kỳ hiếm khi bắt gặp, vì chúng sẽ đào xuống đất ngay khi cảm nhận nguy hiểm. Cần phải có sự kiên nhẫn, trí tuệ và nhanh nhẹn phi thường mới có thể bắt được một con, khiến chúng hầu như chỉ có đúng một kẻ săn mồi tự nhiên.
			CragmawMire: Một sinh vật gần như bất động sống trong vùng sâu của bãi hoang phóng xạ, nó sở hữu lớp ngoại giáp cứng hơn titan để bảo vệ lõi cơ thể. Để bù lại việc không thể di chuyển, nó hình thành mối quan hệ cộng sinh với một con giun chuyên kéo con mồi tới cho nó để đổi lấy sự bảo vệ.
			FlakCrab: Để ẩn mình khỏi những sinh vật lang thang, flak crab cải trang thành các miệng phun khí lưu huỳnh rải rác khắp Sulphurous Sea. Vì chúng sinh sản rất nhanh nên việc vô tình bắt gặp chúng cùng con non là chuyện khá phổ biến.
			GammaSlime: Một con slime bị quá tải phóng xạ từ những thí nghiệm năng lượng hạt nhân mà Draedon đã bỏ dở từ lâu. Dù các phương pháp tạo năng lượng hạt nhân vượt trội hơn nhiều công nghệ trước đó về hiệu suất thô, ngay cả những tiến bộ ấy cũng không đủ làm hài lòng vị kỹ sư bí ẩn.
			IrradiatedSlime: Slime đôi khi rơi từ trên trời xuống, nhưng ở Sulphurous Sea quá trình hình thành slime trên không diễn ra nhanh hơn nhiều do bầu không khí đặc quánh lưu huỳnh và phóng xạ. Không hiếm khi những con slime kích thước đầy đủ rơi từ trên trời xuống trong cơn mưa axit, chứ chưa nói tới cả một cơn "mưa slime".
			Mauler: Bức xạ mạnh đã khiến những gen tiền sử trong loài cá mập này thức tỉnh trở lại, ban cho nó tốc độ và sức mạnh khủng khiếp. Cơn đói vô tận của con thú này kéo nó tới bờ biển trong những cơn mưa axit để mở một bữa tiệc săn mồi.
			NuclearTerror: Hậu quả từ hành động của chúng ta hiếm khi xuất hiện ngay lập tức. Hàng thế kỷ bị đầu độc và phải chiến đấu liên tục để sinh tồn đã tạo nên con quái vật này, giờ bị dòng nước dữ dội kéo dạt vào bờ. Dù trước kia nó từng là gì, giờ đây chỉ còn lại bản năng sinh tồn.
			NuclearToad: Những con cóc này phồng lên như cá nóc khi có sinh vật lại gần và sẽ phát nổ khi gặp nguy hiểm. Ngay cả những sinh vật đáng sợ của biển cũng đã học cách tránh xa chúng vì bản chất cực kỳ "bùng nổ" của loài này.
			Orthocera: Dù phóng xạ thường giết chết sinh vật sống một cách chậm rãi, ảnh hưởng của Silva đã giữ cho sinh vật tại Sulphurous Sea tiếp tục sống sót, khiến những đột biến từ phóng xạ đôi khi đánh thức lại những gen và đặc điểm đã mất. Sinh vật này là một ví dụ như vậy.
			Radiator: Một loài sên biển từng gần như tuyệt chủng đã học cách mang plutonium suy kiệt kết tinh trên lưng để xua đuổi kẻ săn mồi, thay vì dựa vào độc tố mà hầu hết sinh vật ở Sulphurous Sea giờ đã miễn nhiễm. Dù phóng xạ gây hại cho phần lớn sự sống, với một số loài nó lại trở thành cơ hội.
			Skyfin: Quá yếu để săn mồi trong vùng nước bên dưới, skyfin sử dụng vây giống cánh để bay lên không trung và thường ăn côn trùng hoặc những con chim nhỏ dại dột bay gần biển. Tuy nhiên chúng cũng có thể săn con mồi lớn hơn trên đất liền bằng cách đi theo bầy và sử dụng chiến thuật đánh rồi rút.
			SulphurousSkater: Dù bộ ngoại giáp chỉ bảo vệ rất ít, trọng lượng nhẹ đáng kinh ngạc cho phép chúng chạy trên mặt nước. Những côn trùng kỳ lạ này thậm chí còn được thấy cưỡi trên các bong bóng axit để có tầm nhìn tốt hơn và tránh bị sinh vật biển trồi lên nuốt chửng.
			Trilobite: Những loài chân khớp dưới nước này có thể nhảy xa cả trong nước lẫn trên không dù sở hữu lớp vỏ nặng và cứng như đá. Nhờ lớp giáp dày khổng lồ, chúng thậm chí có thể đi qua hệ tiêu hóa của kẻ săn mồi mà vẫn nguyên vẹn.
			//Astral Enemies
			Aries: Những sinh vật này lao qua khắp vùng đất không ngừng nghỉ, truy đuổi bất kỳ kẻ xâm nhập nào dám bước vào lãnh địa của trí tuệ bầy đàn. Sức mạnh của ngôi sao đã ban cho chúng sức bền vô hạn, khiến chúng không còn cảm nhận được sự mệt mỏi.
			Astralachnea: Từng là những con nhện góa phụ đen, giờ chúng đã bị biến đổi chỉ còn lại những chức năng cơ bản nhất. Ảnh hưởng của Astral Infection dưới lòng đất mạnh hơn rất nhiều so với trên mặt đất, khi không khí đặc quánh sương mù dày đặc và tàn tích của ngôi sao đã cắm sâu vào lòng đất.
			AstralProbe: Những con chim bình thường ngày nào đã bị biến đổi bởi lượng mana khổng lồ. Dù yếu khi đứng một mình, chúng thường quấy rối những kẻ chưa bị đồng hóa trong khi nạn nhân còn đang bận chống lại những con thú bị nhiễm khác.
			AstralSlime: Khi slime vốn đã quen với việc hấp thụ cả vật chất lẫn năng lượng từ môi trường, việc mana của ngôi sao chiếm lấy những sinh vật dạng gel này chỉ là chuyện nhỏ. Nhưng lũ slime chẳng hề bận tâm, bởi sự tồn tại của chúng gần như không thay đổi gì.
			Atlas: Những hiệp sĩ của sự lây nhiễm, các sinh vật hợp thể này tung ra những cú đánh cực kỳ mạnh mẽ. Dù chậm chạp vì trọng lượng khổng lồ, chỉ một cú đánh của atlas cũng đủ nghiền nát một khối monolith. Trái tim của chúng vẫn đập chậm rãi ngay cả khi bị xé khỏi cơ thể, như thể sự sống của chúng không thể thực sự chấm dứt.
			FusionFeeder: Bị phình to bởi mana, lượng sức mạnh ma thuật khổng lồ đã làm tê liệt bản năng của những cựu sand shark này, khiến chuyển động của chúng trở nên chậm chạp và nặng nề. Nhu cầu thức ăn của chúng đã hoàn toàn biến mất, và giờ đây chúng chỉ khao khát những vì sao xa xôi.
			Hadarian: Từng chỉ là những con kền kền sa mạc, chúng đã biến đổi thành sinh vật hoàn toàn mới, lông vũ bị lột bỏ và thay thế bằng mô nhầy cùng các mảng giáp giống đá. Chúng đứng yên như tượng, đôi mắt dường như nhìn vào mọi thứ, và cũng chẳng nhìn vào gì cả.
			Astraglomerate: Những khối hợp thể từ nhiều sinh vật khác nhau, với mọi đặc điểm của chúng đã bị biến dạng không thể nhận ra sau khi hợp nhất thành một thực thể duy nhất. Không thể tự hành động do khối lượng khổng lồ, Astraglomerate thay vào đó tách ra những mảnh nhỏ của bản thân để chiến đấu thay cho mình.
			Glomerling: Glomerling có thể không quá nguy hiểm khi đứng một mình, nhưng lại cực kỳ đáng sợ khi xuất hiện với số lượng lớn. Vì chỉ là phần mở rộng của một bầy, chúng không có bản năng tự bảo tồn và chiến đấu tới chết để phục vụ cho tổng thể lớn hơn.
			Mantis: Sinh vật linh hoạt nhất được sinh ra từ Astral Infection, mantis có thể đạt tới tốc độ kinh hoàng và sở hữu cặp vuốt có thể cắt xuyên hầu hết kim loại không quá bền. Khi kẻ thù ở xa, chúng còn có thể nén mana trong không khí thành những lưỡi đĩa sắc bén rồi ném vào mục tiêu.
			Nova: Những sinh vật đơn giản nhưng méo mó được tạo nên từ bụi sao và mana, mang trong mình một lõi năng lượng cực kỳ bất ổn. Chúng cảm thấy mình phải bảo vệ sự lây nhiễm dù gần như không có cách tự vệ, vì vậy cách duy nhất để xua đuổi kẻ xâm nhập là quá tải lõi của mình và tự phát nổ.
			SightseerCollider: Từng là những demon eye, giờ chúng hoạt động như phần mở rộng của ngôi sao đã chết. Khác với biến thể lớn hơn, những sightseer này không thể phun đạn vào kẻ thù. Tất cả những gì chúng làm được là lao thẳng vào những kẻ xâm nhập vùng đất của Astral Infection, với mức độ hiệu quả khá đáng nghi.
			SightseerSpitter: Những wandering eye ngày nào đã bị biến đổi thành thứ hoàn toàn khác. Thay vì lao thẳng vào kẻ thù, chúng chủ yếu phun ra thứ nước bọt lây nhiễm từ cái từng là miệng của mình để tấn công.
			StellarCulex: Cặp càng của chúng không chỉ là vũ khí mà còn là công cụ lan truyền ngôi sao. Bằng cách cắm móng vuốt xuống đất, chúng có thể lây nhiễm các hang động xung quanh nhờ lõi năng lượng siêu tích điện của mình.
			Twinkler: Những con đom đóm bị nhiễm này tồn tại chỉ để làm con mồi, dẫn dụ những sinh vật vô tình tới ngôi sao để bị đồng hóa — những kẻ vốn sẽ không bao giờ tự tìm đến nó.
			//Brimstone Crags Enemies
			CalamityEye: Sinh ra từ tro tàn của trận chiến giữa Phù Thủy và Nguyên Tố, những sinh vật giống con mắt này là những cư dân mới yếu nhất và tầm thường nhất của Brimstone Crags. Tuy vậy, ngay cả chúng cũng là mối đe dọa đối với những kẻ dám xâm phạm vùng đất linh thiêng của chúng.
			DespairStone: Những cấu trúc được tạo từ các khối Brimstone, được ban sự sống bởi những warlock vẫn còn ở Azafure. Nhờ thiết kế giống bánh xe, chúng có thể tăng tốc đến tốc độ khủng khiếp, và mục đích duy nhất của chúng là đảm bảo không ai dám xâm phạm lãnh địa của chủ nhân.
			HeatSpirit: Những công dân của Azafure từng phạm phải tội ác ghê tởm bị trục xuất khỏi thành phố và buộc phải đội những chiếc sọ obsidian không thể tháo ra như dấu ấn của tội lỗi, để mọi người đều biết đến hành vi độc ác của họ. Giờ đây linh hồn lạc lối của những kẻ bị lưu đày cuối cùng cũng có thể trở về sau khi thành phố sụp đổ, và chiếc sọ họ từng mang là thứ duy nhất còn sót lại của họ.
			InfernalCongealment: Một con lava slime đã hấp thụ những mảnh đá cháy sém còn sót lại từ Brimstone Elemental. Dù bản chất khá đơn giản, những sinh vật này vẫn nguy hiểm không kém bất kỳ cư dân nào khác của Brimstone Crags.
			RenegadeWarlock: Những nạn nhân bị cuốn vào làn đạn giữa trận chiến của Calamitas và Brimstone Elemental, bị nguyền rủa phải lang thang vĩnh viễn trong tàn tích của quê hương cũ. Khoảnh khắc cuối cùng của họ là cố bám víu lấy sự sống, và trong cái chết họ tìm cách sinh tồn bằng chính ma thuật đã giết chết mình.
			Scryllar: Những linh hồn đầy oán hận của những người đã mất mạng trong cuộc giao tranh giữa Calamitas và nguyên tố, giờ vĩnh viễn bị trói buộc với quê hương của họ. Những ai ở đủ gần để chứng kiến trận chiến đều đã bỏ mạng trong đó, khiến rất ít người biết được sự thật về kết cục của trận chiến.
			SoulSlurper: Dạng sơ khai của Soul Seeker do Calamitas tạo ra, được triệu hồi trong cuộc chiến giữa Phù Thủy và Brimstone Elemental. Không giống dạng hoàn thiện sau này, cô gần như không kiểm soát được chúng, khiến những tạo vật này trở nên mất kiểm soát ngay sau khi trận chiến khốc liệt kết thúc.
			//Draedon Lab Critters
			Androomba: Một trong những tạo vật bình thường nhất của Draedon, nhiệm vụ của Androomba chỉ đơn giản là dọn dẹp phòng thí nghiệm và nơi ở của ông. Ông và các nhà khoa học không thể lãng phí thời gian vào những việc vặt khi vẫn còn vô số nghiên cứu cần thực hiện.
			Nanodroid: Ánh sáng môi trường, giám sát toàn diện, sửa chữa tức thì… Khi đủ số lượng cỗ máy tí hon này hoạt động cùng nhau, gần như mọi vấn đề đều có thể được giải quyết.
			RepairUnitCritter: Những trợ thủ nhỏ bé tiện lợi này chính là lý do các phòng thí nghiệm của Draedon vẫn tồn tại suốt hàng thập kỷ. Dù cồng kềnh hơn và kém hiệu quả năng lượng hơn nanodroid — phải lấy điện từ máy phát của phòng thí nghiệm — chúng vẫn dễ dàng dọn sạch bụi bẩn, dù khá vất vả khi phải xử lý rỉ sét.
			//Normal Uncategorized Enemies
			AeroSlime: Những con slime vốn bình thường trước đây đã hấp thụ một lượng nhỏ tinh chất rồng từ dòng năng lượng tuôn trào khi Aerialite được tái yểm phép. Giờ đây chúng bay lượn trên bầu trời với đôi cánh mới mọc, vươn tới những độ cao mà rất ít đồng loại dạng thạch của chúng từng đạt tới.
			Burrower: Mặc dù khá nguyên thủy so với công nghệ hiện tại của Draedon, Burrower vẫn được sử dụng cho đến ngày nay. Dù nhiệm vụ chính của chúng là khai thác và vận chuyển khoáng sản, chúng cũng từng được dùng để mở đường cho vô số phòng thí nghiệm dưới lòng đất.
			AuroraSpirit: Từng bị cho là chỉ là câu chuyện dân gian, nhưng sau khi Wall of Flesh bị đánh bại, việc nhìn thấy Aurora Spirit đã trở nên phổ biến. Khi quan sát kỹ hơn, có vẻ những "linh hồn" này thực chất là những thực thể giống như đốm lửa ma được bao bọc trong lớp vỏ cryonic — dấu hiệu rõ ràng cho thấy chúng được tạo ra bởi Archmage Permafrost.
			BloomSlime: Được truyền năng lượng profaned, con slime này mong muốn nhìn thấy thế giới bị thiêu rụi thành tro tàn để chấm dứt nỗi đau mà nó mang lại. Tuy nhiên, hình dạng đơn giản của chúng khiến nữ thần đã bị tiêu diệt khó có thể hoàn toàn áp đặt ý chí của mình lên chúng.
			Bohldohr: Bohldohr được tạo ra để phục vụ người Lihzahrd, được chế tác từ đá cổ đại và ban sự sống bằng ma thuật vào thời kỳ hoàng hôn của Đế chế Lihzahrd vĩ đại. Nhưng mặt trời rồi cũng lặn với mọi nền văn minh, và khi vị thần của họ rời bỏ họ, chúng bị bỏ mặc để tự tồn tại.
			CladCrab: Đủ mạnh để mang cả một ụ đất lớn, những loài giáp xác sống trên cạn này đã phải vật lộn để sinh tồn trong thời kỳ Crusade. Không còn lựa chọn nào khác, chúng đã bổ sung đá và khoáng thạch vào lớp bảo vệ của mình, cho phép chúng tiếp tục tồn tại và phát triển.
			CloudElemental: Một phần của một nguyên tố đơn độc hiếm khi xuất hiện trừ khi lãnh địa của cô đạt sức mạnh tối đa. Nhiều nỗ lực đã được thực hiện bởi tàn dư lực lượng của Yharim để săn lùng các nguyên tố sau khi Azafure sụp đổ. Chỉ đến bây giờ khi chiến tranh đã qua đi, những nguyên tố yếu hơn mới dám quay trở lại.
			GemCrawler: Họ hàng với những prismback của biển Ilmeran. Những con thằn lằn thủy sinh này đã sống hoang dã sau khi từng được nuôi làm thú cưng, nhưng do thiếu dinh dưỡng cần thiết để mọc lăng kính trên lưng, nhiều con đã phát triển thứ gần giống nhất — những viên đá quý.
			BlightSlime: Những con slime đã hấp thụ một phần tinh chất thần thánh bị ô nhiễm. Bị lấp đầy bởi sự tạp nhiễm, giờ đây chúng giống khối thịt thối rữa hơn là thạch, và lượng năng lượng hấp thụ khiến chúng trông như sắp nổ tung. Tuy nhiên, không giống đa số slime có trí tuệ đơn giản, những con này dường như đang tích tụ khối lượng vì một mục đích nào đó.
			Cryon: Archmage Permafrost đã rất cố gắng để tránh trực tiếp tham chiến, thay vào đó ông tạo ra Cryon để làm hộ vệ cá nhân. Nhận thấy sự lan rộng của tinh chất thần thánh giống như nhiều sinh vật khác, chúng đã thức tỉnh khỏi trạng thái ngủ đông để tiêu diệt mọi dấu hiệu của nó nhằm bảo vệ chủ nhân.
			CryoSlime: Những con slime được Archmage yểm phép, đóng vai trò vật chủ để kết tinh sức mạnh băng giá của vùng tundra thành một kim loại ma thuật. Ông đã niệm phép để giấu phần lớn sáng tạo và nghiên cứu của mình ngay sau khi rời khỏi Godseeker, biết rõ rằng Yharim có thể tìm cách khai thác những công trình trước đây của ông.
			Eidolist: Từng là thành viên của giáo phái rồng, giờ đây họ cầu xin sự ưu ái của một chủ nhân mới. Hình dạng giống wyrm cho phép họ sống vô thời hạn trong Abyss, giúp họ tiếp tục phục vụ một mục đích mới.
			FearlessGoldfishWarrior: Dù cá vàng sinh sống tốt trong ao hồ, nhiều con vẫn bò lên đất liền trong cơn bão để ăn giun vừa trồi lên. Thậm chí còn có những câu chuyện về các chiến binh thủy sinh mang theo dao găm bằng vàng lấp lánh, dù hầu hết cho rằng những câu chuyện này quá “cá” để có thể tin được.
			Frogfish: Được ngụy trang hoàn hảo và sẵn sàng tấn công bất cứ lúc nào, Frogfish chứng minh rằng đại dương hiếm khi yên bình như vẻ ngoài của nó. Rất ít nơi có thể mang lại sự bình yên thực sự nơi trung tâm của vùng đất từng là một đế chế vô song.
			EarthElemental: Sau khi Brimstone Elemental rơi vào trạng thái ngủ yên, các thợ rèn của Azafure đã dùng cơ cấu đồng hồ và tinh thể để giam giữ sức mạnh của một nguyên tố vào một cơ thể cơ khí. Dù đáng gờm, giấc mơ tạo ra một nguyên tố thay thế thực sự dường như đã chết cùng với Azafure.
			IceClasper: Dù nguồn gốc chính xác của chúng vẫn là điều bí ẩn, điều được biết là những thực thể hư ảo này tìm cách dập tắt mọi nguồn nhiệt tồn tại trong lãnh địa của chúng. Vì lý do này, cùng với bằng chứng hóa thạch, nhiều người suy đoán rằng Ice Clasper có thể đã đóng vai trò quan trọng trong việc hình thành vùng tundra.
			ImpiousImmolator: Một tượng thần được chạm khắc theo hình ảnh của Bà, được thắp cháy bằng chính sinh lực của người tạo ra nó. Suy cho cùng, mạng sống của một kẻ có ý nghĩa gì khi họ mong muốn nhìn thấy thế giới chìm trong ngọn lửa thiêng của Bà?
			MantisShrimp: Khi hỏi các nhà thám hiểm về những sinh vật nguy hiểm, có rất nhiều câu trả lời khác nhau, nhưng ít ai ngoài các thủy thủ nhắc đến loài tôm bọ ngựa nhỏ bé nhưng đáng sợ này. Cú đánh của chúng nhanh đến mức năng lượng tạo ra có thể làm nóng nước lên tới nhiệt độ sánh ngang với magma của Azafure.
			OverloadedSoldier: Một cơ thể được hồi sinh, tràn ngập linh hồn của những chiến binh đã ngã xuống trong cuộc Crusade mà không thể tìm thấy sự yên nghỉ. Cơn khát chiến đấu của chúng lại bùng cháy khi cảm nhận được tinh chất thần thánh đang lan tỏa trở lại khắp vùng đất.
			PerennialSlime: Những con slime này đã chiếm được một phần nhỏ tinh chất của Nữ Thần Sự Sống. Dù bà đã bị phong ấn trở lại ở đáy sâu nhất của Abyss, những xúc tu ảnh hưởng của bà vẫn vươn xa ra khắp thế giới.
			PhantomSpirit: Những linh hồn trong Dungeon chỉ mơ hồ nhớ về cuộc sống của mình, nhưng có một điều mà tất cả đều nhớ rõ, thứ khiến chúng rơi vào hỗn loạn: người đàn ông đã giam cầm chúng trong những bức tường bị nguyền rủa này, và sức mạnh áp đảo của hắn — sức mạnh mà chúng lại một lần nữa được nhắc nhớ khi có kẻ ngày càng mạnh lên đang lang thang trong hành lang của chúng.
			Piggy: Những chú heo nhỏ này lạch bạch bước đi khắp vùng đất mà không có mục đích rõ ràng, nhưng chỉ vậy thôi cũng khiến chúng hài lòng. Tuy nhiên, rất ít ai biết được làm thế nào chiếc bụng nhỏ bé của chúng lại chứa được lượng mỡ và cơ bắp không hề nhỏ.
			ProfanedEnergyBody: Những kẻ sùng đạo nhất với Bà đi khắp thế giới, được cài cắm vào các xã hội để làm gián điệp và sát thủ. Một trong những nhiệm vụ của họ là xây dựng các đền thờ tôn vinh Bà, truyền vào đó quyền năng thần thánh của Bà, để Bà có thể ban cho những kẻ ngoại đạo mù quáng những khải thị về kỷ nguyên ánh sáng mới của mình.
			Rimehound: Những con chó săn này được lực lượng của Yharim lai tạo và huấn luyện để sống sót trong điều kiện khắc nghiệt của tundra, nhằm phục vụ vai trò trinh sát. Phần lớn đã bị chủ nhân bỏ rơi vì bắt buộc hoặc lựa chọn, và giờ đây phải lang thang vô định mãi mãi.
			Rotdog: Nhanh nhẹn và hung bạo, những con chó săn này rình rập trong đêm, săn mồi bằng hàm răng sắc như dao. Chúng có bản chất tương tự Demon Eye, cả hai đều sinh ra từ cùng một đầm lầy tà ác, nhưng những sinh vật này được tạo ra đặc biệt để tiêu diệt những kẻ đã chứng tỏ mình là mối đe dọa đối với nó.
			ScornEater: Một người yếu về ý chí không nhất thiết yếu về thể xác. Trong những cá nhân mạnh mẽ này cháy lên một ngọn lửa mạnh mẽ, và Bà luôn sẵn sàng thổi bùng ngọn lửa đó. Tất cả những gì họ cần trao đổi để nhận được phước lành hào phóng của Bà là ý chí tự do của mình, và họ sẽ được ban cho sự khai sáng của Bà.
			ShockstormShuttle: Thiết bị khai thác và trinh sát của một nền văn minh đến từ thế giới đã thất lạc từ lâu. Giờ đây chúng tìm kiếm bất kỳ tài nguyên nào còn sót lại trên các hành tinh lân cận, và có lẽ cả thế giới này như một sự thay thế cho quê hương đã bị hủy diệt của chúng.
			Shroomble: Nấm mang lại những tác nhân tái tạo đáng kinh ngạc cho cơ thể con người. Điều này thường được cho là nhờ sự dồi dào của Sự Sống trong chúng, và rõ ràng rằng từ “dồi dào” đôi khi vẫn còn là cách nói giảm.
			Sunskater: Đối với nền văn minh từng sinh sống trên cao phía trên những đám mây, Sunskater được xem là điềm lành. Những sinh vật này truyền cảm hứng hy vọng cho những ai nhìn thấy chúng rằng xã hội của họ có thể tồn tại chừng nào ánh mặt trời còn chiếu sáng thế giới.
			WildBumblefuck: Dù chỉ là một con dragonfolly còn non, nó vẫn là mối đe dọa lớn với mọi thứ xung quanh bất kể tuổi tác. Loài của chúng sống sót qua các cuộc thanh trừng rồng bằng cách sinh sản nhanh chóng, trở nên cực kỳ ẩn dật và phát triển bản tính cực kỳ hung hăng.
			WulfrumAmplifier: Những bộ khuếch đại này tăng cường sức mạnh cho các cỗ máy Wulfrum khác thông qua một trường tesla tiên tiến đáng ngạc nhiên. Mặc dù trường năng lượng này vô hại với sinh vật sống đi qua nó, các cỗ máy Wulfrum được thiết kế để hấp thụ năng lượng từ đó, cho phép chúng hoạt động ở hiệu suất tối đa.
			WulfrumDrone: Mục đích ban đầu của các cỗ máy Wulfrum được thể hiện rõ nhất qua những chiếc drone: quấy rối các binh sĩ cơ bản trong lực lượng của Yharim. Chúng không đủ nguy hiểm để trở thành mục tiêu ưu tiên, nhưng đòn tấn công laser của chúng có thể cực kỳ chết người nếu được nạp năng lượng hoàn toàn.
			WulfrumGyrator: Một trong những cỗ máy Wulfrum tiên tiến hơn, chúng nhảy và lăn theo cách khó đoán để né tránh các đòn tấn công từ xa. Gyrator không quá nguy hiểm khi đứng một mình và chủ yếu được triển khai để bảo vệ những cỗ máy quan trọng hơn.
			WulfrumHovercraft: Dù trông có vẻ hiện đại, ngay cả một kỹ sư mới vào nghề cũng có thể tạo ra những hovercraft như thế này. Chúng không mang được nhiều hỏa lực và lớp giáp khá mỏng, nhưng sức mạnh thực sự của các sáng tạo Wulfrum này nằm ở sự linh hoạt và dễ dàng tái sử dụng cho các dự án khác.
			WulfrumRover: Đơn giản nhất trong các cỗ máy Wulfrum, và cũng là linh vật danh dự của những kẻ nổi dậy chống lại Yharim. Kích thước nhỏ bé và chuyển động nhanh nhẹn của nó có thể khiến một số người liên tưởng đến một con chó, nhưng đừng bị đánh lừa; trong hỗn loạn của chiến trường, một Rover vẫn vô cùng nguy hiểm.
			//Plague Enemies
			Melter: Dù khá yếu ớt so với những sinh vật bị nhiễm Plague khác, Melter lại có khả năng lan truyền dịch bệnh nhanh hơn bất kỳ sinh vật nào. Dù phải trả giá bằng chính mạng sống của mình, chúng được trang bị một cơ chế khiến cơ thể phát nổ khi chết, để lại rất ít thứ xung quanh không bị lây nhiễm.
			PestilentSlime: Virus săn lùng mọi kẽ hở trong cơ thể sinh vật để tái lập trình chúng phục vụ cho vị kỹ sư bí ẩn. Cơ thể thạch của slime đặc biệt dễ bị xâm nhập, nhưng do không có hệ thần kinh, slime không thể nhận mệnh lệnh trực tiếp, chúng chỉ xử lý chúng như những gợi ý mơ hồ.
			PlaguebringerMiniboss: Không gì có thể thoát khỏi Plague; mọi thứ либо bị đồng hóa либо bị tiêu diệt. Ong chúa cũng không ngoại lệ. Dù đủ mạnh để chống lại sinh vật nhiễm bệnh, chúng thường buộc phải bỏ tổ khi đàn ong của mình bị lây nhiễm. Điều này khiến ấu trùng của chúng bị nanite chiếm lấy, và chẳng bao lâu sau một Plaguebringer ra đời.
			PlagueCharger: Hậu duệ của Plaguebringer, những sinh vật này sinh ra đã bị nanomachine của Draedon chiếm hữu. Nanite thúc đẩy quá trình lão hóa của chúng cực nhanh, giúp chúng trưởng thành chỉ trong vài giờ, dù tuổi thọ của chúng chỉ kéo dài vài ngày. Tuy nhiên chính điều này khiến chúng trở thành những binh lính tiêu hao hoàn hảo.
			Plagueshell: Mai và hệ thần kinh của rùa gắn liền với nhau, khiến những con rùa khổng lồ trở thành mục tiêu lý tưởng cho Plague. Mọi cơn đau do việc khoan xuyên mai đều nhanh chóng bị gây tê, khiến chúng hoàn toàn bị kiểm soát mà không có bất kỳ sự phản kháng nào.
			Viruling: Không giống Derpling dùng vòi của mình để hút máu con mồi, Viruling sử dụng nó để tiêm trực tiếp Plague vào nạn nhân. Ngoài chính các Plaguebringer, không có sinh vật nào hiệu quả hơn chúng trong việc lây nhiễm hệ sinh thái xung quanh.
			//Sulphur Sea Enemies
			AnthozoanCrab: Dù ngụy trang như những tảng đá bình thường, chúng có thể dễ dàng ném cả khối đá lớn vào sinh vật khác và sẽ nhanh chóng rút lui nếu bị tiếp cận. Ở nơi khác, một sinh vật như vậy có thể thống trị nhờ sức mạnh của mình; nhưng trong môi trường khắc nghiệt này, chừng đó chỉ vừa đủ để sinh tồn.
			AquaticUrchin: Có họ hàng gần với nhím biển, Aquatic Urchin đã buộc phải thích nghi với làn nước axit và chất thải phóng xạ. Những chiếc gai độc của chúng thường đủ để xua đuổi kẻ săn mồi, nhưng trong môi trường này, một bữa ăn đau đớn vẫn là bữa ăn. Không sinh vật nào ở vùng biển này có thể kén ăn.
			BelchingCoral: Dù san hô vốn dĩ là sinh vật sống, loài này sở hữu trí thông minh cao hơn mức trung bình. Chúng có thể tự vệ trước những sinh vật cố gắng ăn mình bằng cách phóng ra luồng khí lưu huỳnh nén khi bị tiếp cận. Đôi khi quá trình này tạo ra âm thanh giống như âm nhạc.
			Gnasher: Dù khá chậm chạp, những con rùa cá sấu đột biến này sở hữu chiếc mai cứng bất thường. Việc cố giết và ăn chúng thường khiến kẻ săn mồi bị thương nặng bởi lực cắn khủng khiếp và chiếc mai gai có thể dễ dàng đâm xuyên thịt.
			Sulflounder: Họ hàng với một số sinh vật hadopelagic sống ở tầng sâu đại dương, Sulflounder là một nhánh tiến hóa với lớp ngoài rất mong manh. Điều này giúp chúng không bị chìm xuống đáy Abyss, dù phần thịt của chúng gần như không thể chịu được làn nước axit.
			Toxicatfish: Trước đây những con cá này chỉ đe dọa con mồi của mình, nhưng bức xạ từ chất thải hạt nhân của các thí nghiệm cũ của Draedon đã làm mục nát cả cơ thể lẫn tâm trí chúng. Tấn công mọi thứ đến gần, loài từng phát triển mạnh mẽ này giờ đang trên bờ tuyệt chủng.
			Trasher: Dù sở hữu chiếc miệng đủ lớn để nuốt chửng một đứa trẻ, những con cá sấu này chỉ đóng vai trò kẻ ăn xác thối, nuốt những mảnh vụn và xương còn lại sau bữa ăn của kẻ săn mồi khác. Vì phải tiết kiệm năng lượng do ăn khá ít, chúng hiếm khi di chuyển với tốc độ tối đa trừ khi cảm thấy bị đe dọa.
			//Sunken Sea Enemies
			BabyGhostBell: Ghost Bell từng được nuôi với số lượng lớn trong cuộc chiến Ilmeran, vì quân đội Ilmeris cần lượng điện khổng lồ để ngăn chặn Yharim và lực lượng của hắn. Đáng tiếc, nỗ lực đó trở nên vô ích khi vương quốc sụp đổ sau Great Incineration.
			BlindedAngler: Thiếu hầu hết các giác quan thông thường, những kẻ săn mồi này sử dụng dạng sonar sinh học để “nhìn” môi trường xung quanh. Những tinh thể phát sáng trên lưng chúng thu hút con mồi vốn dùng lăng kính của biển làm ánh dẫn đường, giống như thiêu thân lao vào lửa.
			Clam: Clam từng sinh sống ở vùng trên của Ilmeran Sea trước khi xảy ra Incineration, và buộc phải di cư sau trận chiến. Loài của chúng sống sót một phần nhờ khả năng thích nghi và sức bền, nhưng may mắn chắc chắn cũng đứng về phía chúng.
			Cnidrion: Từng được huấn luyện làm chiến mã cho các chiến binh Ilmerian danh dự, Cnidrion sống sót sau Incineration nhờ sức mạnh vượt trội của mình. Chúng tiếp tục bảo vệ nơi từng là trái tim của vương quốc biển khỏi những kẻ xâm nhập, giữ lòng trung thành mãnh liệt với chủ nhân ngay cả khi họ đã qua đời.
			EutrophicRay: Eutrophic Ray hình thành mối quan hệ cộng sinh với Ghost Bell. Chúng có thể tích trữ năng lượng do Ghost Bell cung cấp để kích thích cơ bắp bằng điện, cho phép chúng bùng nổ tốc độ trong thời gian ngắn.
			GhostBell: Những con sứa điện cao áp này có thể làm tê liệt hầu hết sinh vật chỉ với một cú chạm, và là yếu tố lớn trong sức mạnh của quân đội Ilmerian. Vương quốc biển đã dùng điện năng do Ghost Bell tạo ra để đẩy lùi lực lượng của Yharim, điện hóa cả vùng biển để không ai có thể vượt qua biên giới của họ.
			GiantClam: Clam từ từ kết tinh ma lực xung quanh thành ngọc trai, và khi chúng lớn dần thì viên ngọc cũng lớn theo. Khi đạt kích thước tối đa, chúng được gọi là Giant Clam và có thể sử dụng phần nào sức mạnh ma thuật chứa trong viên ngọc của mình.
			PrismBack: Nhờ những lăng kính tuyệt đẹp và tính cách hiền hòa, loài vật này đã được nhiều người nuôi làm thú cưng suốt hàng thế kỷ, thậm chí cả bên ngoài Ilmeris. Dù quá chậm và cồng kềnh để săn mồi bình thường, các lăng kính biển trên lưng chúng lại đóng vai trò làm mồi nhử cho cá nhỏ.
			SeaFloaty: Giun dẹp có thể được tìm thấy ở nhiều vùng biển và đại dương trên khắp thế giới, và rất giỏi chui qua các khe hở nhờ cơ thể mỏng. Loài giun dẹp này chỉ từng sống ở tầng biển sâu hơn, và hoàn toàn không bị ảnh hưởng bởi cuộc tàn sát đã phá hủy nơi sinh sống của nhiều loài khác.
			SeaMinnow: Những đàn Sea Minnow từng là một trong những cảnh tượng đẹp nhất có thể thấy trong thời kỳ Ilmeris còn nguyên vẹn. Những ai được phép vào vương quốc thường tụ tập để ngắm đàn cá bơi lội ngoài biển… nhưng giờ đây tất cả chỉ còn là quá khứ xa xôi, ngay cả với chính những con cá nhỏ này.
			SeaSerpent: Dù là một trong số ít sinh vật ăn thịt từng tồn tại ở Ilmeran Sea, những con rắn biển này vẫn hiền hòa bất thường với những kẻ chúng không coi là con mồi so với tiêu chuẩn ở nơi khác. Vùng biển này chỉ từng có một kẻ săn mồi thật sự hung bạo, và nó đã rời bỏ cuộc sống cô độc yên bình từ nhiều năm trước.
			Stormlion: Một số người sống sót sau sự sụp đổ của Ilmeris kể rằng trong những ngày cuối cùng, lượng sét ma thuật dâng trào trong biển nhiều đến mức không còn một giọt nước nào không mang điện. Cho đến nay, nguồn điện từ trận chiến vẫn còn chôn vùi trong cát, và một số antlion đã học cách dẫn và khai thác sức mạnh của vương quốc đã mất.
			//Town NPCs
			AndroombaFriendly: Những Androomba được tái chế ngược và cải tiến để phát tán các dung dịch của Steampunker thay vì chỉ dọn dẹp bụi bẩn trong phòng thí nghiệm. Chúng có thể được dùng để thanh tẩy thế giới – hoặc khiến nó suy tàn hơn nữa, nếu ai đó mong muốn.
			Archmage: Một trong những chuyên gia hàng đầu thế giới về lý thuyết ma thuật, ông nổi danh với kỹ năng điều khiển huyền thuật. Trong thời gian từng đồng hành cùng đoàn tùy tùng của Yharim, ông đóng vai trò cố vấn cho Godseeker, nhờ vào địa vị và sự chán ghét việc trực tiếp tham chiến.
			Bandit: Bandit có thói quen xấu là lục lọi chiến trường và lấy những thứ không thuộc về mình, nhưng phần lớn hành động của họ xuất phát từ sự căm ghét đối với những kẻ giàu có vô lý mà chưa từng thực sự xứng đáng với khối tài sản của mình. Phương pháp của họ có phần mờ ám, nhưng luôn có thể tin tưởng để hoàn thành công việc.
			BrimstoneWitch: Được chiêu mộ vào lực lượng của Yharim vào giai đoạn cuối của cuộc chiến, ma thuật của cô tràn ngập sức mạnh đến mức gần như không thể thi triển những phép thuật thông thường. Tuy vậy, dù sở hữu sức mạnh to lớn, Calamitas lại không muốn sử dụng nó, bởi cái giá phải trả cho tâm trí của cô là quá nặng nề.
			SeaKing: Vị vua thứ mười bảy của nền quân chủ lập hiến Ilmeris kể từ khi các bộ tộc của Ilmeran Sea thống nhất dưới sự bảo hộ của Nữ Thần Điện Otonilou và vị Thần Biển bí ẩn. Nhưng một vị vua không thể tồn tại nếu không có thần dân, và dù vẫn được những người từng chống lại Godseeker Yharim kính trọng, vương quốc của ông nay đã không còn.
			//Boss Minions
			Brimling: Những phân thân của chính Brimstone Elemental, là một phần trong bản thể của nàng. Cả nàng và các Brimling đều chung một ý chí, vì vậy nàng chăm sóc chúng cũng như chính bản thân mình. Khi bị thương nặng, chúng sẽ rút vào trong một cái kén để tự bảo vệ khỏi tổn thương tiếp theo.
			SoulSeeker: Nỗ lực của bản thể Clone trong việc sử dụng linh hồn của những kẻ bị nguyền rủa làm vũ khí, chúng có mức độ tự chủ nhỉnh hơn đôi chút so với đồng loại Azafurian. Tuy nhiên, với sự giống nhau đáng kinh ngạc với lớp vỏ của Clone, có thể chúng còn khác xa với Soul Seeker hiện tại của Calamitas hơn cả những con trong tàn tích Azafure.
			DarkEnergy: -
			DesertNuisance: Dù thuộc cùng loài với Desert Scourge, những con rắn này còn rất trẻ và chưa phát triển hoàn toàn. Vì điểm yếu này, chúng săn mồi theo bầy cùng con Scourge lớn, và nhiều người đã chứng kiến chúng xé xác con mồi giống như đàn cá piranha từng sống ở vùng biển xưa.
			CosmicGuardian: Dù thuộc cùng loài với con rắn vô danh, tâm trí và chức năng của chúng đơn giản hơn nhiều. Chúng hầu như không có ý chí riêng và mù quáng tuân theo mệnh lệnh của kẻ chủ nhân tham ăn.
			DankCreeper: Những kẻ thao túng thần thánh luôn quan sát thế giới thông qua tín đồ của mình, tạo thành một mạng lưới giám sát sống cho một trí tuệ tổ ong tà ác. Lời của chúng là chân lý, và mọi bằng chứng trái ngược đều bị thiêu rụi. Ngay cả khi đã mục nát, chúng vẫn triệu hồi tay sai để bò trườn, do thám và giết chóc.
			DarkHeart: Ẩn dưới mọi âm mưu và dối trá là những dục vọng đen tối cuộn trào trong trái tim đen kịt của các vị thần này. Khi thân xác của chúng bị xé nát đến mức không thể nhận ra, những trái tim mới mọc lên từ sự mục rữa của chúng để tiếp tục đập trong đau khổ.
			HiveBlob: Những kẻ vô diện gần như bất khả xâm phạm, vì vậy khối hợp thể mục nát này ẩn mình phía sau những tay sai vô hồn, giống như các vị thần đã sinh ra nó từng làm.
			HiveTumor: Khối u này đóng vai trò như bộ não của vùng đất mục rữa, là tàn dư cuối cùng của tâm trí những vị thần đã chết tại đây. Các sinh vật của Corruption tồn tại để bảo vệ nó, và những ai cố gắng phá hủy nó hiếm khi còn sống để kể lại câu chuyện.
			AquaticAberration: Hậu duệ của Leviathan khổng lồ, tuổi thọ của chúng chỉ tính bằng vài giờ. Mọi thứ chúng biết chỉ là săn mồi cho chủ nhân của mình. Ngay cả sinh vật sống trên cạn cũng không thoát khỏi chúng, bởi chúng có khả năng bay trong không khí dễ dàng như bơi trong nước.
			LeviathanStart: Một mồi nhử được tạo ra bởi Water Elemental, Anahita. Nó cất tiếng hát ngọt ngào, tràn đầy hứa hẹn và ấm áp, nhưng hãy cẩn thận: đi theo tiếng gọi ấy đồng nghĩa với việc tự chuốc lấy hiểm nguy.
			PerforatorCyst: Khối thịt run rẩy và co giật này đóng vai trò như trái tim của Perforator Hive, thu thập lượng Ichor loãng còn sót lại trong Crimson và truyền nó vào Hive. Người ta biết rất ít về nó, bởi những ai dám quấy rầy nó đều trở thành một phần của chính vùng đất này.
			CosmicLantern: Những chiếc đèn lồng này mang một ngọn lửa ma thuật méo mó, tỏa sáng nhưng không hề phát ra nhiệt. Nếu nhìn thật kỹ vào ngọn lửa, người ta có thể thấy một thế giới khác ẩn bên trong.
			CosmicMine: Việc xé toạc một khe nứt từ sự biến dạng vào thế giới của chúng ta đòi hỏi nguồn năng lượng khổng lồ – trừ khi bạn là sinh vật thuộc về cả hai thế giới. Chỉ riêng Signus mới có thể tạo ra những cổng như vậy dễ dàng, nhưng ngay cả nó cũng không thể duy trì chúng lâu trước khi nguồn năng lượng dùng để mở cổng phát tán dữ dội.
			CorruptSlimeSpawn: Slime là sinh vật cực kỳ bền bỉ: nếu một slime lớn bị cắt rời những mảnh gel sống khỏi cơ thể, các mảnh đó vẫn tiếp tục tồn tại như những cá thể riêng. Ngay cả khi chỉ còn là gel, slime vẫn được xem là còn sống – chỉ là ở trạng thái không thể hoạt động theo cách có ý nghĩa.
			CrimsonSlimeSpawn: Slime là sinh vật cực kỳ bền bỉ: nếu một slime lớn bị cắt rời những mảnh gel sống khỏi cơ thể, các mảnh đó vẫn tiếp tục tồn tại như những cá thể riêng. Chúng thậm chí còn giữ lại ký ức của slime ban đầu, và tiếp tục hành động vì lợi ích của “cơ thể mẹ”.
			CrimsonSlimeSpawn2: Dù nhiều slime có thể vô tình mắc vật thể trong cơ thể và học cách dùng chúng làm vũ khí, những slime này là trường hợp đặc biệt. Những chiếc gai của chúng là bộ phận tự nhiên, được mài sắc để có thể đâm xuyên bất kỳ kẻ nào dám chống lại vị thần của chúng.
			Sepulcher: Một sự hợp thể của linh hồn và thịt được ban cho hình dạng và mục đích mới thông qua tà thuật triệu hồn. Sinh vật méo mó này lấy cảm hứng từ phương pháp hồi sinh của auric dragon, nhưng rõ ràng không hề có chút uy nghi nào của loài rồng trong nó. Loại ma thuật dùng để tạo ra Sepulcher từng bị cấm trong Deific Era, nhưng nhiều kẻ vẫn âm thầm thực hành.
			SoulSeekerSupreme: Được tạo ra từ sự kết hợp giữa ma thuật brimstone và tà thuật triệu hồn, những sinh vật đáng ghê tởm này phục vụ mệnh lệnh của chủ nhân mà không hề do dự. Điều chúng thiếu về sức mạnh cá thể được bù lại bằng số lượng đông đảo và khả năng phối hợp đáng ngạc nhiên.
			AquaticScourge: Một sinh vật hiền hòa nhưng đầy uy nghi từng lang thang khắp Sulphurous Sea, chỉ riêng sự tồn tại của nó cũng đủ khiến phần lớn sinh vật tránh xa bờ biển. Khi không còn sự hiện diện của nó để đóng vai trò răn đe, những kẻ săn mồi đáng sợ giờ đây cảm thấy an toàn khi săn mồi trong những cơn bão axit.
			AstrumAureus: Ban đầu được tạo ra để thu hồi thiết bị và khảo sát các chiến trường cũ, cỗ máy do Draedon chế tạo này đã bị Astral Infection chiếm lấy. Đáng tiếc thay, khi nó bị đánh bại, nguồn sức mạnh mà nó sở hữu đã được giải phóng, truyền lại cho những chiến binh khác của vì sao đó.
			AstrumDeus: Khi một ngôi sao bắt đầu lụi tàn, trong điều kiện bình thường sức mạnh của nó sẽ dần biến mất khi rơi về phía thiên thể gần nhất. Tuy nhiên, một số ngôi sao hấp hối lại phồng lên và mục ruỗng trước khi rơi xuống. Astrum Deus tồn tại để nuốt chửng những ngôi sao này trước khi Astral Infection xuất hiện trong chúng, và nó đã được tôn kính vì nghĩa vụ thiêng liêng này từ thuở xa xưa.
			BrimstoneElemental: Thức tỉnh khỏi giấc ngủ sâu trong những năm gần đây, sự tỉnh giấc của cô đã khởi đầu cho sự sụp đổ của Azafure. Phần lớn cho rằng việc khai thác Brimstone quá mức của thành phố đã gây ra sự hồi sinh bất ngờ này, một số khác đổ lỗi cho ô nhiễm, và vài người nhắc đến những lời tiên tri đáng ngờ. Nhưng sau cánh cửa đóng kín, người ta thì thầm rằng cô đã được hồi sinh có chủ đích như một phần của âm mưu từ các thế lực đối địch.
			Bumblefuck: Từ rất lâu trước đây, những kẻ cùng huyết thống với auric dragons này đã ẩn mình sâu trong rừng rậm. Chúng săn mồi bằng lượng điện tĩnh khổng lồ tạo ra khi đôi cánh vỗ vào lớp lông vũ trên cơ thể, phóng ra những tia sét đỏ chết chóc.
			Calamitas: Cỗ máy rình rập trong màn đêm này mang theo bản sao thất bại của Supreme Witch. Dù thiếu đi những lời nguyền và hắc thuật của cô, chỉ một mảnh nhỏ sức mạnh brimstone của Calamitas cũng đủ khiến bản sao rơi vào điên loạn. Không còn chút nhân tính nào còn sót lại.
			Cataclysm: Một tạo vật đáng thương của bản sao, được tạo ra nhằm bắt chước một trong những người anh em của Supreme Witch. Tuy nhiên sinh vật này và những tạo vật khác của bản sao đều không có ý chí riêng, chẳng khác nào những con rối do cô điều khiển.
			Catastrophe: Một tạo vật đáng thương của bản sao, được tạo ra nhằm bắt chước một trong những người anh em của Supreme Witch. Dù vậy, không nhiều người có thể nhận ra điều đó bất chấp nỗ lực của cô, dù một vài đặc điểm quan trọng vẫn còn tồn tại trong những sự pha trộn ghê tởm này.
			CeaselessVoid: -
			Crabulon: Một loài giáp xác từng sinh sống ở trung tâm Ilmeran Sea, đã kịp trốn thoát trong Đại Hỏa Thiêu. Crabulon chạy trốn xuống lòng đất, tìm thấy sự quen thuộc trong ánh sáng xanh phát ra từ những cây nấm phát quang. Dù cuối cùng cũng gục ngã trước bào tử, nó đã ra đi trong yên bình, nhớ về quê nhà của mình.
			Cryogen: Khi Yharim nhận ra Archmage đã phản bội, Calamitas được lệnh truy lùng và giết người thầy cũ của mình. Sau cuộc đối đầu đầy nước mắt, cô quyết định phong ấn ông thay vì giết, đồng thời dàn dựng cái chết của ông. Phép thuật tạo nên phong ấn sống này là một sự sáng tạo đáng kinh ngạc, đồng thời cũng là lời tưởng niệm bi thương cho mọi bài học mà Permafrost đã truyền dạy cho học trò.
			DesertScourge: Một con rắn biển từng bơi trong vùng nước của Ilmeran Sea, nó kỳ lạ thay lại chọn ở lại quê nhà thay vì tìm nơi trú ẩn mới dưới đáy đại dương sâu thẳm. Nhanh chóng thích nghi với chế độ ăn gồm antlion và xương rồng, nó đã chiếm lấy vị trí kẻ săn mồi đỉnh cao của sa mạc sau khi đối thủ duy nhất của nó phải ẩn mình.
			DevourerofGods: Một thực thể mang vô số danh xưng và truyền thuyết, đến mức ranh giới giữa sự thật và huyền thoại về những chiến tích của nó trở nên mơ hồ. Dù Yharim từng tin rằng bản chất mà nó nuốt chửng sẽ bị xóa sổ hoàn toàn khỏi tồn tại, nhưng một quy luật căn bản của vũ trụ là năng lượng không thể bị hủy diệt—nó chỉ có thể chuyển từ dạng này sang dạng khác.
			Draedon: Một trong vô số cơ thể trinh sát được tạo ra bởi, và mô phỏng theo hình ảnh của, vị kỹ sư bí ẩn Draedon. Nhà khoa học này ngày càng trở nên ẩn dật kể từ khi rời khỏi bên cạnh Godseeker, dành từng khoảnh khắc tỉnh táo cho công trình nghiên cứu bất tận của mình.
			Apollo: Với những khẩu pháo plasma có sức nóng sánh ngang ngọn lửa của chính Calamitas và được huấn luyện qua các mô phỏng chiến đấu với những kẻ mạnh nhất thế giới, rất ít thứ có thể sánh ngang cỗ máy chiến tranh này. Dù khung máy tiêu thụ lượng năng lượng khổng lồ, nhu cầu đó dễ dàng được đáp ứng bởi lõi năng lượng Exo Prism của nó. Chỉ cần nhìn vào nhà tiên tri này cũng đủ cảm nhận ánh nhìn không bao giờ dao động của nó.
			Ares: Siêu vũ khí đầu tiên do Draedon tạo ra, Ares có khả năng gây ra sự tàn phá trên diện rộng lẫn thực hiện các đòn tấn công tập trung bằng những khẩu pháo chết chóc. Mục tiêu của hắn khi tạo ra các Exo Mechs là rèn nên những cỗ máy chiến tranh có thể sánh ngang sức mạnh lừng danh của Yharim khi họ còn lần cuối gặp nhau. Chỉ cần nhìn vào con quái vật máy móc tà ác này cũng đủ khiến người ta cảm nhận nỗi sợ.
			Artemis: Siêu vũ khí cuối cùng được chế tạo, Artemis chỉ cần một lần chỉnh sửa so với bản thiết kế ban đầu. Bản tính cầu toàn của Draedon đã nâng kỹ năng kỹ thuật của hắn lên tầm cao mới, tạo ra một cỗ máy sở hữu sự linh hoạt và độ chính xác khó tin. Nhìn thấy nữ cung thủ này cũng có nghĩa là bạn đã nhìn chậm mất một khoảnh khắc.
			Thanatos: Một con rắn máy được chế tạo bằng biến thể cải tiến từ lớp giáp của Devourer, nó được thiết kế để gần như bất khả xâm phạm. Ngay cả điểm yếu phải xả nhiệt khi quá nóng cũng được biến thành sức mạnh, bởi không sinh vật bằng thịt hay kim loại nào có thể sống sót trong nhiệt độ như vậy. Nhìn thấy nỗi kinh hoàng dạng rắn này là hiểu thế nào là sức mạnh tuyệt đối.
			HiveMind: Dù chiến dịch của Yharim sau này lan rộng khắp thế giới, mọi thứ đều bắt đầu tại vùng đất này với cuộc tàn sát các vị thần độc tài tàn bạo. Ngay khi những kẻ lãnh đạo của chúng gục ngã dưới tay Godseeker, đội quân của chúng sụp đổ như hiệu ứng domino. Suy cho cùng, một trí tuệ bầy đàn không thể hoạt động nếu thiếu bộ não của nó.
			Anahita: Từng là cư dân của Abyss, cô đã rời nơi đó từ rất lâu do ảnh hưởng của Silva lan rộng khắp quê hương cũ. Cô mong muốn thấy mọi thứ bị đại dương nuốt chửng, để lãnh địa của mình có thể bao trùm cả thế giới. Đó chính là bản chất của mọi elemental.
			Leviathan: Một loài bò sát biển khổng lồ ẩn mình dưới đáy đại dương cùng với Water Elemental, Anahita. Không ai biết liệu cô có phải cá thể cuối cùng của giống loài mình hay chỉ đơn giản được tạo ra giống như chủ nhân của mình.
			GreatSandShark: Những kẻ săn mồi thông minh này từng bơi dọc bờ biển phía trên của Ilmeran Sea, nhiều con còn được huấn luyện để chống lại lực lượng của Yharim. Thế nhưng khi ngày đó đến, sand sharks gần như chẳng là gì trước Supreme Witch, và cá thể này chỉ sống sót nhờ tháo chạy trong vội vã.
			OldDuke: Một trong những nhánh hậu duệ rồng nguyên thủy được sinh ra trong Draconic Era. Những con rồng ra đời sau khi tất cả auric souls đã được ban tặng cho giống loài của chúng buộc phải tồn tại mà không có chúng, vĩnh viễn nằm ngoài vòng luân hồi tái sinh. Thế nhưng trớ trêu thay, kỷ nguyên của auric dragons đã kết thúc, và những kẻ từng bị từ chối lại trở thành kẻ sống sót trong thế giới mới này.
			Perforator: Hiện thân sống của những điều tồi tệ nhất mà thế giới này mang lại, những ký sinh trùng này tận dụng triệt để tổ của chúng. Chúng dùng nó để tìm kiếm ngày càng nhiều con mồi để nuốt chửng, mong muốn trở nên lớn hơn nữa, để một ngày nào đó có thể giành lại những gì chúng đã mất.
			PerforatorHive: Xé toạc và nuốt chửng, chỉ lấy cho riêng mình cho đến khi chẳng còn gì sót lại—đó là bản năng nguyên thủy mà các vị thần để lại, thứ giờ đây hình thành nên Crimson. Những ham muốn ích kỷ của chúng đã kết tụ thành tổ này, bị lũ giun tham ăn xâm chiếm với khao khát duy nhất là nuốt chửng tất cả.
			PlaguebringerGoliath: Việc tạo ra Plague ban đầu bắt đầu sau khi những cỗ máy sử dụng sức mạnh linh hồn không mang lại kết quả như mong muốn, khiến Draedon tìm kiếm sự kiểm soát tuyệt đối. Sau nhiều thập kỷ thử nghiệm vô số biến thể khác nhau, cả Plague và goliath của nó ra đời, và sự lây lan của nó cho phép kiểm soát sự sống ở mức độ từng được cho là không thể.
			Polterghast: Thực thể hỗn hợp hoang dại đã xua đuổi giáo phái từng cư ngụ nơi đây, đồng thời vô tình phá vỡ một liên minh từng được cho là vĩnh cửu. Nhiều người đã tiến sâu vào dungeon để tìm kiếm kho báu và tri thức đã thất lạc từ lâu, nhưng phần lớn chỉ gia nhập vào những linh hồn đã chiếm nơi này làm lãnh địa của chúng.
			PrimordialWyrm: Wyrm đầu tiên, được Goddess of Life ban phước, sở hữu sức mạnh khổng lồ vượt xa gần như mọi auric brethren của nó. Nó mang trong mình sự căm ghét sâu sắc với bất kỳ dấu hiệu nào của ánh sáng bị chiếm đoạt, và thậm chí sẽ tấn công cả kẻ cầm giữ Primordial Light nếu họ quay lại để giành lại cổ vật của mình. Và dù sức mạnh của nó khủng khiếp đến đâu, nó vẫn chưa bao giờ có cơ hội chiến thắng.
			ProfanedGuardianCommander: Trong một thời đại đã bị lãng quên, có bốn chiến binh đã dùng trí tuệ và sự phối hợp của mình để giết một con rồng, để một người trong số họ có thể nuốt lấy auric soul của nó. "Ta là kẻ thông thái nhất," vị chỉ huy tuyên bố, "ta nên là người đó." Mọi thứ rơi vào im lặng, cho đến khi Providence lên tiếng: "Ngươi cần rèn luyện trí tuệ của mình bằng hành động, để chúng ta có thể áp đặt ý chí lên thế giới này."
			ProfanedGuardianDefender: Trong một thời đại đã bị lãng quên, có bốn chiến binh đã dùng lòng trung thành dành cho nhau để giết một con rồng, để một người trong số họ có thể nuốt lấy auric soul của nó. "Ta là kẻ mạnh nhất," nữ chiến binh khiên tuyên bố, "ta nên là người đó." Mọi thứ rơi vào im lặng, cho đến khi Providence lên tiếng: "Ngươi thiếu sự kiên định trong niềm tin, đến mức còn chẳng dám thử hái những vì sao trên bầu trời."
			ProfanedGuardianHealer: Trong một thời đại đã bị lãng quên, có bốn chiến binh đã dùng quyết tâm vô hạn của mình để giết một con rồng, để một người trong số họ có thể nuốt lấy auric soul của nó. "Ta là kẻ dũng cảm nhất," vị giáo sĩ tuyên bố, "ta nên là người đó." Mọi thứ rơi vào im lặng, cho đến khi Providence lên tiếng: "Lòng dũng cảm của ngươi che mờ sự thật, rằng sự tự tin thái quá sẽ khiến ngươi diệt vong."
			Providence: Trong một thời đại đã bị lãng quên, có bốn nhà tiên tri. Với cơn thịnh nộ chính nghĩa, họ giết một con rồng, và người lãnh đạo của họ đã nuốt lấy auric soul Ngọn Lửa của nó. "Thế giới này thiếu sự dẫn dắt, và con người chìm trong bóng tối." Cô nói. Mọi thứ rơi vào im lặng, cho đến khi Providence lên tiếng lần nữa. "Hãy tiến lên, và thắp sáng thế giới một lần nữa." Và mọi chuyện đã diễn ra như vậy.
			Ravager: Sự tái sinh méo mó của God of Sacrifices, được ban cho sự sống một lần nữa. Những necromancer trung thành với đức tin của hắn đã mang cơ thể tan nát của hắn trở lại ngôi đền, hiến dâng chính mạng sống của mình để đảo ngược cái Chết của hắn. Thế nhưng necromancy là một nghệ thuật không hoàn hảo, và vị thần giờ đây gần như không còn lý trí, chỉ đơn giản phá hủy mọi thứ nó gặp phải.
			Signus: "'Mọi khao khát đều có cái giá của nó'. Một khế ước được ràng buộc bằng Onyx và niêm phong bằng máu, và mọi điều ước đều có thể trở thành hiện thực—một cánh cổng, một lời hứa, một sự phản bội. Kỳ lạ thay, không có ghi chép nào về Signus trước kỷ nguyên của các vị thần, và cho đến ngày nay cũng chỉ còn rất ít thông tin. Có lẽ, với cái giá thích hợp, người ta có thể tự mình khám phá ra sự thật về Signus."
			SlimeGodPaladin: Slime God tránh giao chiến trực diện vì điểm yếu của mình, thay vào đó nó tạo ra những hộ vệ để bảo vệ bản thân. Những hộ vệ này được hình thành từ vô số blight slime, sự ô uế của chúng đóng vai trò đối trọng với sự thuần khiết của vị thần của chúng.
			SlimeGodCore: Dù là một Gluttonous slime, Slime God vẫn tự kiềm chế không để bản thân phát triển mất kiểm soát nhằm duy trì sự cân bằng của thế giới. Nó vẫn bị truy đuổi trong suốt cuộc Thập Tự Chinh, nhưng đã sống sót qua vô số lần rút lui chiến lược. Chính nghĩa vụ mà nó gánh vác và phương thức mà nó sử dụng là lý do khiến Onyx Kinsmen tôn thờ một vị thần nhỏ bé như vậy.
			StormWeaver: Một sinh vật xâm lấn đến từ chiều không gian khác, được nhiều kẻ tôn làm vua của bầu trời, bay lượn khắp tầng khí quyển trên cao với tốc độ gần như không thể sánh kịp. Không giống những thực thể khác từ Distortion, Storm Weaver không có mục đích cao cả nào, chỉ đơn giản ăn tàn tích của nền văn minh từng tồn tại trên bầu trời.
			SupremeCalamitas: Sau khi thừa hưởng sức mạnh ma thuật gần như vô hạn khi còn là một thiếu niên, cô được chiêu mộ vào quân đội của Yharim, nơi cô phục vụ suốt gần một thập kỷ. Cô say mê bạo lực, chìm đắm trong vũ điệu điên loạn và cái chết bất tận, cho phép Godseeker sử dụng mình như một vũ khí trong cuộc chiến vô tận chống lại các vị thần. Nhưng giờ đây khi ngọn lửa trong cô đã lụi tàn, tất cả những gì còn lại chỉ là tàn tro âm ỉ của sự hối hận.
			SupremeCataclysm: Người anh cả trong ba anh em, anh từng là một đấu sĩ lừng danh ở Azafure, với rất ít người trong thành phố có thể sánh được sức mạnh thuần túy của mình. Anh luôn bảo vệ em gái, thề rằng sẽ luôn ở bên khi cô cần. Và người anh ấy vẫn tiếp tục giữ lời hứa đó, ngay cả sau khi đã chết.
			SupremeCatastrophe: Người con thứ trong ba anh em từng là một kiếm sĩ tài ba khi còn sống, làm lính đánh thuê để kiếm sống. Dù lựa chọn nghề nghiệp đầy máu me, anh vẫn cố gắng đối xử tử tế với em gái và bảo vệ cô khỏi mọi nguy hiểm mà công việc của mình có thể mang đến cho gia đình còn lại. Anh vẫn tiếp tục bảo vệ cô, ngay cả sau khi đã chết.
			Yharon: Mỗi con rồng từng nắm giữ sức mạnh gần như vô hạn đối với lãnh địa của mình, một quyền năng căn bản được rút ra trực tiếp từ linh hồn bị phân mảnh của thế giới. Những con rồng là bậc thầy của mọi thứ; sự sống, cái chết, thậm chí cả Primordial Light vĩ đại có thể xua tan màn đêm vĩnh cửu phía bên kia. Thế nhưng, một trong những sinh vật hùng vĩ ấy đã đạt đến đỉnh cao sức mạnh có lẽ chỉ đứng sau vị vua của chúng. Kẻ đã khiến giống loài của mình trở nên bất tử nhờ quyền năng Tái Sinh... nhưng rồi, ngay cả sự vĩnh cửu cũng không kéo dài mãi.
		}

