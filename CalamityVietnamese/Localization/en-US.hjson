					}

					WitherBlossomsStaff: {
						DisplayName: Wither Blossoms Staff
						Tooltip:
							'''
							Triệu hồi bốn bông hoa mục rữa trên đầu bạn
							Tổng cộng các bông hoa tiêu tốn hai ô lính triệu hồi
							'''
					}

					WulfrumController: {
						DisplayName: Wulfrum Controller
						Tooltip:
							'''
							Triệu hồi một Wulfrum Droid chiến đấu cho bạn
							Giữ <right> khi đang cầm bộ điều khiển để chuyển toàn bộ drone của bạn giữa chế độ thường và siêu nạp
							Các droid siêu nạp sẽ ngừng tấn công và tập trung năng lượng Wulfrum vào bạn
							Droid siêu nạp cung cấp +0.5 HP/giây hồi máu và 3 phòng thủ cho mỗi droid
							Cũng có thể dùng để hồi máu cho người chơi khác bằng cách giữ con trỏ chuột đủ gần họ
							'''
					}

					YharonsKindleStaff: {
						DisplayName: Yharon's Kindle Staff
						Tooltip:
							'''
							Triệu hồi một draconid rực lửa chiến đấu cho bạn
							Yêu cầu 5 ô lính triệu hồi để sử dụng
							'''
					}
				}

				Rogue: {
					AdamantiteThrowingAxe: {
						DisplayName: Adamantite Throwing Axe
						Tooltip: Đòn tàng hình bỏ qua trọng lực và gọi sét đánh khi trúng kẻ địch
					}

					AntlionSkewer: {
						DisplayName: Antlion Skewer
						Tooltip:
							'''
							Ném những con Antlion bị xiên còn sống, chúng bắn ra luồng cát
							Đòn tàng hình phun ra nhiều bóng cát và luồng gió
							Mây cát tạm thời giảm sát thương va chạm của kẻ địch
							'''
					}

					Apoctolith: {
						DisplayName: Apoctolith
						Tooltip:
							'''
							Đòn chí mạng làm giảm phòng thủ của kẻ địch
							Đòn tàng hình làm vỡ và làm choáng kẻ địch trong chốc lát
							'Có lẽ dùng mặt để đỡ gạch không phải ý tưởng hay...'
							'''
					}

					AshenStalactite: {
						DisplayName: Ashen Stalactite
						Tooltip:
							'''
							Ném một thạch nhũ nhỏ sẽ vỡ thành bụi sau khi bay một đoạn ngắn
							Đòn tàng hình ném một măng đá lớn hơn, gây nhiều sát thương hơn, bay chậm hơn và xa hơn trước khi vỡ thành bụi gây sát thương
							'''
					}

					AuroradicalThrow: {
						DisplayName: Auroradical Throw
						Tooltip:
							'''
							Phóng ra một ngôi sao tách ra sau một thời gian ngắn
							Các ngôi sao sau khi tách sẽ tự tìm mục tiêu gần đó sau vài giây
							Đòn tàng hình triệu hồi thiên thạch khi trúng kẻ địch
							Gây hiệu ứng [cbuff:CalamityMod/AstralInfectionDebuff]
							'''
					}

					BallisticPoisonBomb: {
						DisplayName: Ballistic Poison Bomb
						Tooltip:
							'''
							Ném một quả bom dính nổ ra gai và mây độc
							Đòn tàng hình tạo ra nhiều đám mây hơn với độc kéo dài lâu hơn
							'''
					}

					BlastBarrel: {
						DisplayName: Blast Barrel
						Tooltip:
							'''
							Ném một thùng thuốc nổ lăn và phát nổ khi va vào tường
							Đòn tàng hình làm thùng nảy hai lần trước khi biến mất với hiệu ứng khác nhau sau mỗi lần nảy
							'Một số người từng nhảy qua thứ này'
							'''
					}

					BlazingStar: {
						DisplayName: Blazing Star
						Tooltip:
							'''
							Ném một lưỡi glaive nóng đỏ có thể dội lại
							Sau khi dội khỏi địa hình, glaive có thể đánh trúng cùng một kẻ địch lần nữa
							Đòn tàng hình xé toạc kẻ địch đầu tiên trúng phải và tạo các vòng glaive xoay quanh gây đẩy lùi mạnh
							'''
					}

					BloodsoakedCrasher: {
						DisplayName: Bloodsoaked Crasher
						Tooltip:
							'''
							Ném một chiếc rìu đẫm máu bị ảnh hưởng bởi trọng lực và có thể nảy hai lần
							Rìu tăng tốc theo thời gian nhưng sẽ chậm lại khi trúng kẻ địch
							Phun ra các quả cầu máu khi trúng mục tiêu
							Nhặt các quả cầu máu sẽ giảm thời gian của [cbuff:PotionSickness]
							Đòn tàng hình tạo ra các tia máu tự tìm mục tiêu khi trúng
							'''
					}

					BouncingEyeball: {
						DisplayName: Bouncing Eyeball
						Tooltip:
							'''
							Ném một con mắt nảy bật khỏi bề mặt
							Đòn tàng hình khiến con mắt di chuyển nhanh hơn và nảy mạnh hơn
							Lực đẩy lùi mạnh hơn nhiều trong Blood Moon
							'''
					}

					Brimblade: {
						DisplayName: Brimblade
						Tooltip:
							'''
							Ném một lưỡi kiếm tách ra khi trúng kẻ địch
							Đòn tàng hình tách thêm và khiến người chơi bắn ra một loạt phi tiêu brimstone
							'''
					}

					BurningStrife: {
						DisplayName: Burning Strife
						Tooltip:
							'''
							Ném một quả cầu gai shadowflame phát nổ thành lửa
							Đòn tàng hình khiến quả cầu mọc xúc tu khi trúng mục tiêu
							'Chắc chắn không an toàn để bỏ túi'
							'''
					}

					CelestialReaper: {
						DisplayName: Celestial Reaper
						Tooltip:
							'''
							Ném một lưỡi hái tự tìm mục tiêu rất nhanh
							Lưỡi hái sẽ nảy sau khi trúng kẻ địch tối đa sáu lần
							Đòn tàng hình tạo ra các dư ảnh gây sát thương
							'''
					}

					Celestus: {
						DisplayName: Celestus
						Tooltip:
							'''
							Ném một lưỡi hái tốc độ cao tách thành nhiều lưỡi hái ma khi trúng kẻ địch
							Đòn tàng hình đảo hướng và tự tìm mục tiêu sau khi quay lại người chơi
							'''
					}

					Cinquedea: {
						DisplayName: Cinquedea
						Tooltip: Đòn tàng hình cắm vào kẻ địch trước khi phóng tiếp về phía trước, chém mọi thứ
					}

					CobaltKunai: {
						DisplayName: Cobalt Kunai
						Tooltip: Đòn tàng hình bắn ra bốn tia năng lượng cobalt tự tìm mục tiêu
					}

					ConsecratedWater: {
						DisplayName: Consecrated Water
						Tooltip:
							'''
							Ném một chai nước thánh phát nổ thành cột lửa thiêng
							Cột lửa sẽ biến mất nếu không có khối ở phía dưới
							Đòn tàng hình tạo ba cột lửa thay vì một khi va chạm
							Chai này bụi một cách đáng ngạc nhiên
							'''
					}

					ContaminatedBile: {
						DisplayName: Contaminated Bile
						Tooltip:
							'''
							Ném một lọ mật nhiễm phóng xạ vỡ ra và tạo thành đám mây
							Đòn tàng hình khiến các bong bóng sulphuric nhanh chóng nổi lên từ đám mây
							'''
					}

					CorpusAvertor: {
						DisplayName: Corpus Avertor
						Tooltip:
							'''
							Ném một con dao quay tạo ra bản sao dội lại
							Gây nhiều sát thương hơn khi máu của bạn càng thấp và có hút máu
							Đòn tàng hình ném một con dao cầu vồng xuyên thấu tạo thêm một nhát chém phía sau, với cái giá là máu
							Con dao này cho người chơi cùng đội 10% sát thương và +2 HP/giây hồi máu khi trúng, và hồi máu cho họ dựa trên sát thương gây ra
							'Có vẻ đã bị mòn theo thời gian'
							'''
					}

					CosmicKunai: {
						DisplayName: Cosmic Kunai
						Tooltip:
							'''
							Bắn ra một luồng kunai tầm ngắn liên tục
							Đòn tàng hình khiến kunai xuyên kẻ địch, bay xa hơn và tạo ra 5 lưỡi hái tự tìm mục tiêu
							'''
					}

					CraniumSmasher: {
						DisplayName: Cranium Smasher
						Tooltip:
							'''
							Luân phiên ném đĩa xuyên thấu lăn trên mặt đất và đĩa nổ
							Đòn tàng hình cắm vào kẻ địch trúng phải và phát nổ nhiều lần
							'''
					}

					CrushsawCrasher: {
						DisplayName: Crushsaw Crasher
						Tooltip:
							'''
							Ném ra những chiếc rìu nảy bật
							Đòn Tàng Hình ném ra sáu chiếc cùng lúc
							'''
						GFBFirstWords:
							'''
							Crushsaw
							Crashsaw
							Crushclaw
							Crashclaw
							Crushcaw
							Crushaw
							Crushmaw
							Crashmaw
							Crawshaw
							Coleslaw
							Cashew
							Cawcaw
							Crabshaw
							Castle
							Catshaw
							Catspaw
							'''
						GFBLastWords:
							'''
							Crasher
							Crusher
							Clasher
							Casher
							Clacker
							Catcher
							Trasher
							Rasher
							Cracker
							Cackler
							Checker
							Clicker
							Catsher
							'''
						GFBWordSeparator: " "
					}

					Crystalline: {
						DisplayName: Crystalline
						Tooltip:
							'''
							Tách thành nhiều mảnh đạn khi bay
							Đòn Tàng Hình khiến lưỡi kiếm tách ra nhiều hơn và tạo tinh thể khi bị phá hủy
							'''
					}

					CrystalPiercer: {
						DisplayName: Crystal Piercer
						Tooltip:
							'''
							Ném ra một lao pha lê xuyên qua kẻ địch vô hạn
							Đòn Tàng Hình bay xuyên khối, bỏ qua trọng lực và triệu hồi các mảnh pha lê khi bay
							'''
					}

					CursedDagger: {
						DisplayName: Cursed Dagger
						Tooltip:
							'''
							Ném một dao găm nguyền rủa cực nhanh và hai dao găm yếu hơn bay lệch hướng
							Đòn Tàng Hình ném một dao găm duy nhất phát nổ thành xoáy lửa nguyền
							'''
					}

					DeepSeaDumbbell: {
						DisplayName: Deep Sea Dumbbell
						Tooltip:
							'''
							Ném một quả tạ nảy bật và văng ra các quả tạ nhỏ sau mỗi lần nảy
							Nhấn <right> để gồng cơ, tăng sát thương đòn đánh tiếp theo lên tối đa 5 lần
							Động tác gồng cơ có thể gây sát thương trực tiếp lên kẻ địch
							'''
					}

					DeepWounder: {
						DisplayName: Deep Wounder
						Tooltip:
							'''
							Ném một rìu vực sâu gây hiệu ứng Heavy Bleeding và Crush Depth lên kẻ địch trúng phải
							Đòn Tàng Hình khiến chiếc rìu cắm vào kẻ địch, giải phóng một loạt đạn nước
							Các đạn nước sẽ bay tới kẻ địch gần nhất sau một khoảng trễ ngắn
							'''
					}

					DefectiveSphere: {
						DisplayName: Defective Sphere
						Tooltip:
							'''
							Bắn ra nhiều loại quả cầu chết chóc với hiệu ứng khác nhau
							Tối đa năm quả cầu có thể được ném cùng lúc
							Đòn Tàng Hình phóng ra cả 4 loại quả cầu cùng lúc
							'''
					}

					DesecratedWater: {
						DisplayName: Desecrated Water
						Tooltip:
							'''
							Ném một bình nước tà ác phát nổ thành vô số bong bóng hắc ám
							Đòn Tàng Hình tạo thêm bong bóng gây Ichor và Cursed Inferno
							'''
					}

					DimensionTearingDisk: {
						DisplayName: Dimension-Tearing Disk
						Tooltip:
							'''
							Ném một đĩa cắt rách không gian theo hướng kẻ địch gần nhất
							Đòn Tàng Hình bám vào kẻ địch và giải phóng [c/ff00ff:God's Bane Doombeam Array]
							'''
					}

					DoomsdayDevice: {
						DisplayName: Doomsday Device
						Tooltip:
							'''
							Đòn đánh trực tiếp từ vũ khí sẽ cấp Tàng Hình
							Đòn đánh không Tàng Hình sẽ không tiêu hao Tàng Hình khi đã nạp đầy
							Giữ đòn Tàng Hình quá giới hạn sẽ khiến Tàng Hình bị rút cạn nhanh chóng
							Đòn Tàng Hình dội qua nhiều kẻ địch trước khi kết thúc bằng một cú va chạm cực mạnh
							'Một thiết bị nổ công nghệ cao với sức tàn phá khủng khiếp... Giá như bạn biết cách kích hoạt nó'
							'Ít nhất bạn có thể ném nó thật mạnh!'
							'''
					}

					DukesDecapitator: {
						DisplayName: Duke's Decapitator
						Tooltip:
							'''
							Ném một rìu thủy lực xé toạc kẻ địch khi tiếp xúc
							Rìu quay càng nhanh thì sẽ đánh trúng càng nhiều lần trước khi biến mất
							Đòn Tàng Hình phát ra các bong bóng tầm ngắn
							'''
					}

					DuststormInABottle: {
						DisplayName: Duststorm in a Bottle
						Tooltip:
							'''
							Phát nổ tạo thành một đám mây bụi
							Đòn Tàng Hình tạo ra đám mây bụi mạnh hơn và tồn tại lâu hơn
							'''
					}

					DynamicPursuer: {
						DisplayName: Dynamic Pursuer
						Tooltip:
							'''
							Ném một đĩa xử lý tính toán bắn điện vào kẻ địch
							Đòn Tàng Hình cho phép đĩa dội sang mục tiêu khác, bắn laser và gây nổ
							Nếu đĩa không tìm được mục tiêu mới để dội tới, nó sẽ tiếp tục truy đuổi mục tiêu ban đầu
							'''
					}

					EclipsesFall: {
						DisplayName: Eclipse's Fall
						Tooltip:
							'''
							Triệu hồi giáo từ trên trời khi đánh trúng
							Đòn Tàng Hình đóng đinh kẻ địch và triệu hồi mưa giáo liên tục theo thời gian
							'Khi mặt trời chìm vào bóng tối, ngươi sẽ biết đến phán quyết'
							'''
					}

					EnchantedAxe: {
						DisplayName: Enchanted Axe
						Tooltip:
							'''
							Ném một chiếc rìu tốc độ cao quay trở lại bạn sau khi bay một quãng ngắn hoặc chạm tường
							Tại điểm xa nhất so với người chơi, một chiếc rìu phép thuật bay xuyên tường sẽ được phóng về phía kẻ địch gần nhất
							Đòn Tàng Hình khiến rìu bay xa hơn và tạo thêm nhiều rìu phép tự dẫn
							'''
					}

					EpidemicShredder: {
						DisplayName: Epidemic Shredder
						Tooltip:
							'''
							Ném một boomerang dịch bệnh giải phóng plague seekers khi chạm khối hoặc kẻ địch
							Đòn Tàng Hình khiến boomerang liên tục giải phóng plague seekers khi bay
							Trái với tên gọi của nó, dùng sai cách có lẽ sẽ gây ra cả một đại dịch
							'''
					}

					Equanimity: {
						DisplayName: Equanimity
						Tooltip:
							'''
							Ném một boomerang hỗn loạn dội qua nhiều kẻ địch
							Mỗi lần trúng kẻ địch sẽ luân phiên triệu hồi mảnh sáng tự dẫn hoặc mảnh tối xuyên phá
							Đòn Tàng Hình gây nổ ánh sáng hoặc bóng tối mỗi lần dội, cường hóa mảnh có màu đối lập
							'''
					}

					ExecutionersBlade: {
						DisplayName: Executioner's Blade
						Tooltip:
							'''
							Ném ra một loạt lưỡi kiếm tự dẫn
							Đòn Tàng Hình triệu hồi một máy chém lưỡi kiếm khi trúng mục tiêu
							'''
					}

					Exorcism: {
						DisplayName: Exorcism
						Tooltip:
							'''
							Ném một cây thánh giá Hallow khổng lồ lên trời, sau đó nó sẽ rơi xuống vị trí con trỏ của bạn
							Kẻ địch trúng khi rơi sẽ bị đóng đinh và liên tục thiêu đốt bởi ánh sáng thánh
							Khi kết thúc sẽ tạo ra một vụ nổ hình thánh giá
							Đòn Tàng Hình xoay và ném cây thánh giá, kết thúc bằng vụ nổ mạnh hơn tại vị trí con trỏ
							'''
					}

					FantasyTalisman: {
						DisplayName: Fantasy Talisman
						Tooltip:
							'''
							Bắn ra các bùa chú tốc độ cao bỏ qua trọng lực
							Bùa chú bám vào kẻ địch và giải phóng các linh hồn báo thù truy đuổi chúng
							Đòn Tàng Hình giải phóng nhiều linh hồn hơn và bùng nổ thành các linh hồn lạc lối khi biến mất
							'May mà tôi không cược chống lại bạn!'
							'''
					}

					FeatherKnife: {
						DisplayName: Feather Knife
						Tooltip:
							'''
							Ném một con dao triệu hồi những chiếc lông vũ tự dẫn
							Đòn Tàng Hình ném ra một loạt dao
							'''
					}

					FishboneBoomerang: {
						DisplayName: Fishbone Boomerang
						Tooltip:
							'''
							Dội qua tối đa ba kẻ địch
							Đòn Tàng Hình giải phóng các mảnh xương mục nát sau mỗi lần dội
							[c/5C95A1:Dù Vương Quốc Biển đang dần bốc hơi và thất bại trong cuộc chiến, những cư dân kiêu hãnh của nó vẫn không dễ dàng gục ngã.]
							[c/5C95A1:Trong nỗ lực cuối cùng, họ buộc phải chế tạo vũ khí từ bộ xương của những sinh vật đã chết.]
							'''
					}

					FrostcrushValari: {
						DisplayName: Frostcrush Valari
						Tooltip:
							'''
							Bắn một boomerang băng giá tầm xa tạo ra các mảnh băng tự dẫn khi trúng mục tiêu
							Đòn Tàng Hình ném một boomerang bay theo con trỏ chuột
							'''
					}

					FrostyFlare: {
						DisplayName: Frosty Flare
						Tooltip:
							'''
							Ném một pháo sáng bám vào kẻ địch và gọi mưa băng xuống chúng
							Đòn Tàng Hình triệu hồi các bản sao ảo ảnh thay vì mảnh băng
							'Không được lắp vào súng pháo sáng'
							'''
					}

					GacruxianMollusk: {
						DisplayName: Gacruxian Mollusk
						Tooltip:
							'''
							Giải phóng các tia lửa tự dẫn khi bay
							Đòn Tàng Hình giải phóng những con ốc tự dẫn tạo ra nhiều tia lửa hơn
							'''
					}

					GelDart: {
						DisplayName: Gel Dart
						Tooltip:
							'''
							Ném các phi tiêu gel nảy bật phủ slime lên kẻ địch trúng phải
							Đòn Tàng Hình bỏ qua trọng lực, nảy mạnh hơn và liên tục rò rỉ slime
							'''
					}

					GhoulishGouger: {
						DisplayName: Ghoulish Gouger
						Tooltip:
							'''
							Ném từng bộ bốn lưỡi hái ma quái với vận tốc cực cao
							Đòn Tàng Hình triệu hồi một cơn lốc linh hồn đau khổ khi trúng mục tiêu
							'''
					}

					GildedDagger: {
						DisplayName: Gilded Dagger
						Tooltip:
							'''
							Ném một lưỡi dao sáng bóng dội sang kẻ địch khác khi trúng mục tiêu
							Đòn Tàng Hình khiến lưỡi dao tự dẫn sau khi dội, mỗi lần dội gây thêm 5% sát thương
							Đòn Tàng Hình cũng tăng khả năng xuyên
							'''
					}

					Glaive: {
						DisplayName: Glaive
						Tooltip:
							'''
							Ném một glaive dội bật
							Đòn Tàng Hình xé toạc kẻ địch đầu tiên trúng phải và tạo một vòng glaive bay quanh với lực đẩy lùi lớn
							'''
					}

					GleamingDagger: {
						DisplayName: Gleaming Dagger
						Tooltip:
							'''
							Ném một lưỡi dao sáng bóng dội sang kẻ địch khác khi trúng mục tiêu
							Đòn Tàng Hình khiến lưỡi dao tự dẫn sau khi dội, mỗi lần dội gây thêm 5% sát thương
							Đòn Tàng Hình cũng tăng khả năng xuyên
							'''
					}

					GodsParanoia: {
						DisplayName: Gods' Paranoia
						Tooltip:
							'''
							Ném các quả cầu gai tự dẫn bám vào kẻ địch
							Các quả cầu gai bám trên mục tiêu sẽ triệu hồi cơn bão kunai god slayer cục bộ mỗi khi gây sát thương
							Đòn Tàng Hình tự dẫn nhanh hơn và tấn công với tốc độ cao hơn
							'''
					}

					GraveGrimreaver: {
						DisplayName: Grave Grimreaver
						Tooltip:
							'''
							Ném một lưỡi hái nguyền rủa tự dẫn
							Lưỡi hái triệu hồi đầu lâu khi bay và nổ thành bầy dơi khi trúng mục tiêu
							Đòn Tàng Hình tạo ra một cơn lũ dơi và đầu lâu rơi xuống khi bị phá hủy
							Gây Cursed Flames và Confusion
							'Vũ khí ưa thích của một bộ xương lịch lãm'
							'''
					}

					HardenedHoneycomb: {
						DisplayName: Hardened Honeycomb
						Tooltip:
							'''
							Bắn một tổ ong vỡ thành nhiều mảnh
							Đòn Tàng Hình cho hiệu ứng Honey khi trúng mục tiêu và triệu hồi ong
							'''
					}

					HeavenfallenStardisk: {
						DisplayName: Heavenfallen Stardisk
						Tooltip:
							'''
							Ném một đĩa sao lên trời rồi lao về phía con trỏ chuột
							Phát nổ thành một ngôi sao gồm các tia astral khi trúng mục tiêu
							Đòn Tàng Hình gọi mưa tia năng lượng astral từ trên trời
							Gây [cbuff:CalamityMod/AstralInfectionDebuff]
							'''
					}

					Hypothermia: {
						DisplayName: Hypothermia
						Tooltip:
							'''
