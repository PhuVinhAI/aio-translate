					BansheeHook: {
						DisplayName: Móc Banshee
						Tooltip: Vung móc banshee bắn ra lưỡi dao và phát nổ khi trúng địch
					}

					Basher: {
						DisplayName: Chùy Thối
						Tooltip:
							'''
							Vung một cây chùy mục nát gây nhiễm độc và phóng xạ khi đánh trúng
