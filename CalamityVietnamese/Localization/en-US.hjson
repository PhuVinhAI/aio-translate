							Bắn ra tinh chất hư không xé toạc kẻ địch gần đó bằng xúc tu
							'Vực thẳm đã nhìn lại bạn đủ lâu rồi. Giờ nó lên tiếng, và nó không nói một cách nhẹ nhàng'
							'''
					}

					Nebulash: {
						DisplayName: Nebulash
						Tooltip: Bắn ra kiếm roi phát nổ hạt khi trúng địch và gây [cbuff:CalamityMod/AstralInfectionDebuff]
					}

					NeptunesBounty: {
						DisplayName: Neptune's Bounty
						Tooltip:
							'''
							Ném ra một thanh kiếm vực sâu xoay tròn liên tục phun năng lượng nước
							Khi lưỡi kiếm bắt đầu rơi xuống, nó sẽ tự chuyển hướng tới kẻ địch với tốc độ tăng và sát thương gấp đôi
							'''
					}

					Oblivion: {
						DisplayName: Oblivion
						Tooltip:
							'''
							{$Common.YoyoStatsInfinite}
							Bắn ra phi tiêu brimstone khi kẻ địch ở gần
							'''
					}

					OldLordClaymore: {
						DisplayName: Old Lord Claymore
						Tooltip: Một lưỡi kiếm chậm nhưng mạnh, thiêu đốt kẻ địch và có lực đẩy lùi lớn
						HoldShiftTooltip:
							'''
							[c/df4420:Một món quà dành cho những Ác Quỷ xuất sắc, bản sao của thanh kiếm được sử dụng bởi vị Chúa Quỷ vĩ đại nhất.]
							[c/df4420:Sự thịnh vượng ông mang lại cho chủng tộc của họ vẫn vô song, ngay cả khi giờ đây họ một mình cai trị Địa Ngục.]
							'''
					}

					OmegaBiomeBlade: {
						DisplayName: True Biome Blade
						Tooltip:
							'''
							[FUNC]
							[PASS]
							Giữ <right> trong 2 giây để điều chỉnh vũ khí theo sức mạnh của quần xã sinh vật xung quanh
							Nhấn <right> trong thời gian ngắn hơn để hoán đổi giữa điều chỉnh chủ động và bị động
							Active Attunement : [ATT1]
							Passive Attunement : [ATT2]
							'''
						DefaultFunction:
							'''
							Chưa có tác dụng... hiện tại
							Có vẻ việc nâng cấp lưỡi kiếm đã mở rộng khả năng của các dạng điều chỉnh trước đây
							'''
						DefaultPassive: Điều chỉnh phụ của bạn giờ có thể cung cấp hiệu ứng bị động
					}

					Omniblade: {
						DisplayName: Omniblade
						Tooltip: Một lưỡi kiếm cổ xưa được rèn bởi huyền thoại Omnir
					}

					Orderbringer: {
						DisplayName: Orderbringer
						Tooltip:
							'''
							Bắn ra sóng năng lượng xuyên thấu và triệu hồi bốn ngôi sao tự truy đuổi gần con trỏ
							Đánh trúng bằng lưỡi kiếm sẽ gọi xuống hai tia sáng từ bầu trời
							'Cho dù bạn ở đâu, bạn cũng không bao giờ cô độc'
