							'''
					}

					MirrorBlade: {
						DisplayName: Mirror Blade
						Tooltip:
							'''
							Đánh trúng kẻ địch hoặc đạn của kẻ địch sẽ triệu hồi tối đa 10 mảnh gương bay quanh
							Các mảnh vượt quá 10 sẽ tự tìm kiếm kẻ địch
							Giữ <right> để kết tụ các mảnh gương bay quanh thành một lá chắn
							'''
						HoldShiftTooltip:
							'''
							[c/aab7f1:Mỗi mảnh giảm 10% sát thương của viên đạn đánh trúng lá chắn]
							[c/aab7f1:Lá chắn sẽ vỡ sau một viên đạn, phóng các mảnh gương về phía kẻ địch với sát thương tăng]
							[c/aab7f1:Khi có đủ 10 mảnh, bạn sẽ nhận bất tử trong thời gian ngắn khi lá chắn vỡ]
							'''
						FlavorTooltip: "[c/7b6d8d:'Một lưỡi kiếm được lấy từ chính phản chiếu của bạn trong Ceaseless Void']"
					}

