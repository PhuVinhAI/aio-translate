					CalamarisLament: {
						DisplayName: Calamari's Lament
						Tooltip: "[GFB]"
						TooltipNormal:
							'''
							Triệu hồi một con mực nhỏ hung hãn phun mực vào kẻ địch
							Ở khoảng cách xa, con mực sẽ bắn các loạt mực truy đuổi mục tiêu rất mạnh
							Ở cự ly gần, con mực sẽ bám vào kẻ địch và gây thêm sát thương
							'Trong Abyss, mọi loại tài nguyên đều khan hiếm.
							Mỗi loài đều sống đơn độc. Đơn giản là không đủ để chia sẻ.'
							'''
						TooltipGFB: "'Woomy!'"
					}

