				}

				Serpentuna: {
					DisplayName: Serpentuna
					QuestDescription: Tôi chán việc luôn thua tiền tiêu vặt cho lũ rắn ở vùng nước Ilmeran rồi! Tôi muốn câu hết lũ rắn con đó lên, và tôi cần SỰ GIÚP ĐỠ của cậu! ...Gì? Không, tôi đâu có định lừa tiền người khác...
				}

				SparklingEmpress: {
					DisplayName: Sparkling Empress
					Tooltip:
						'''
						Bắn ra tia laser tập trung để tiêu diệt kẻ địch
						Kẻ địch bị hạ gục sẽ nổ thành các mảnh prism
						'''
				}

				SpecularSturgeon: {
					DisplayName: Specular Sturgeon
					Tooltip:
						'''
						Một loài cá sống ở vùng nước sâu có thể tồn tại qua nhiều thế hệ
						Không cần nói cũng biết, nó rất già!
						'''
				}

				Squidoom: {
					DisplayName: Squidoom
					Tooltip: Những ai nhìn nó quá lâu được cho là sẽ rơi vào trạng thái thôi miên
				}

				SunkenSailfish: {
					DisplayName: Sunken Sailfish
					Tooltip: Lao đi với tốc độ 60 dặm một giờ
				}

				SurfClam: {
					DisplayName: Surf Clam
					QuestDescription: Có tin đồn rằng một đàn ngao khổng lồ đã chiếm lấy vùng biển dưới sa mạc! Ngao là món ăn ngon, nên chỉ nghe thôi tôi đã thấy đói rồi! Cậu giúp tôi giải quyết cơn đói này nhé? Tất nhiên là cậu sẽ giúp rồi! Chỉ cần đảm bảo cả cậu và con ngao đều quay về nguyên vẹn!
				}

				// Other Catches
				EnchantedStarfish: {
					DisplayName: Enchanted Starfish
					Tooltip:
						'''
						{$ItemTooltip.ManaCrystal}
						Hoạt động như một lựa chọn thay thế cho [i:ManaCrystal] {$ItemName.ManaCrystal}
						'''
				}

				FishofEleum: {
					DisplayName: Fish of Eleum
					QuestDescription: Thật không công bằng khi tất cả cá ngầu chỉ xuất hiện khi cậu giết mấy con quỷ to! Mà tôi nói "ngầu" theo đúng hai nghĩa đấy. Tôi đã thấy cá ở tundra được hình thành từ tinh chất của cái lạnh thuần khiết! Đã đến lúc tôi có túi đá cho bể cá rồi, nên đi bắt nó cho tôi, không thì cậu sẽ bị đóng băng đấy!
				}

				FishofFlight: {
					DisplayName: Fish of Flight
					Tooltip: Nhấn <right> để tách [i:SoulofFlight] linh hồn
				}

				GlimmeringGemfish: {
					DisplayName: Glimmering Gemfish
					Tooltip: Nhấn <right> để tách [ITEMS] đá quý
				}

				Gorecodile: {
					DisplayName: Gorecodile
					Tooltip: Nhấn <right> để tách [i:CalamityMod/BloodOrb] Blood Orb
				}

				// Hydrothermal / Sulphurous / Misc Fish
				HydrothermalCrate: {
					DisplayName: Hydrothermal Crate
					Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
				}

				Spadefish: {
					DisplayName: Spadefish
					Tooltip:
						'''
						'Làm sao một con cá có thể được dùng để đào xuyên qua lòng đất?
						Một số câu hỏi tốt nhất nên để đó...'
						'''
				}

				StuffedFish: {
					DisplayName: Stuffed Fish
					Tooltip: Nhấn <right> để tách [HERBS] thảo mộc và [SEEDS] hạt giống
				}

				SulphurousCrate: {
					DisplayName: Sulphurous Crate
					Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
				}

				SunbeamFish: {
					DisplayName: Sunbeam Fish
					QuestDescription: Cậu từng thấy những con sunskater bay lơ lửng trên cao phía trên mây chưa? Tôi sẽ tiết lộ bí mật nhỏ này: Chúng bắt đầu cuộc đời như những con cá nhỏ! Vậy còn chờ gì nữa, hãy vươn tới những vì sao và bắt một con xuống cho tôi!
				}

				// Fishing Rods
				EarlyBloomRod: {
					DisplayName: Early Bloom Rod
					Tooltip:
						'''
						Bắn ra sáu dây câu cùng lúc. Dây câu không bao giờ đứt
						'Chim dậy sớm sẽ bắt được cá'
						'''
				}

				FeralDoubleRod: {
					DisplayName: Feral Double Rod
					Tooltip:
						'''
						Bắn ra hai dây câu cùng lúc
						Cũng như bạn đã thuần hóa con quái vật rừng rậm, giờ bạn có thể thuần hóa cá ngoài biển
						'''
				}

				HeronRod: {
					DisplayName: Heron Rod
					Tooltip:
						'''
						Tăng sức mạnh câu cá lên {0}x khi ở ngoài không gian
						'Chiếc đầu và mỏ im lặng lao xuống và kẹp lấy nó,
						và chiếc mỏ nuốt chửng con cá nhỏ khi cái đuôi của nó quẫy loạn.'
						'''
				}

				NavyFishingRod: {
					DisplayName: Navy Fishing Rod
					Tooltip:
						'''
						Bắn phao gây hiệu ứng Static Discharge lên kẻ địch gần đó
						'Biển là một thành phố. Ngay bên dưới là những xa lộ, đại lộ,
						con đường và vòng xoay tấp nập giao thông tàu ngầm.'
						'''
				}

				RiftReeler: {
					DisplayName: Rift Reeler
					Tooltip:
						'''
						Bắn ra bốn dây câu cùng lúc
						Có thể câu cá trong dung nham
						'Chiến trường là một cảnh tượng hỗn loạn không ngừng.
						Kẻ chiến thắng là kẻ kiểm soát được sự hỗn loạn đó, cả cần câu lẫn con cá.'
						'''
				}

				SlurperPole: {
					DisplayName: Slurper Pole
					Tooltip:
						'''
						Có thể câu cá trong dung nham
						'Chính dung nham cháy bỏng của tâm hồn mới là thứ có lò luyện bên trong—một ngọn núi lửa của đau khổ và buồn bã.'
						'''
				}

				TheDevourerofCods: {
					DisplayName: The Devourer of Cods
					Tooltip:
						'''
						Bắn ra mười dây câu cùng lúc. Dây câu không bao giờ đứt và có thể câu trong dung nham
						Vật phẩm đã móc sẽ luôn được giữ trên lưỡi câu
						Cá thường sẽ tự động bị tiêu thụ khi câu
						Tiêu thụ cá cho phép phao móc thêm vật phẩm mới và nuôi người sử dụng
						'Kẻ nuốt chửng này từng chỉ là một Eater of Shoals'
						'''
				}

				VerstaltiteFishingRod: {
					DisplayName: Verstaltite Fishing Rod
					Tooltip:
						'''
						Tăng sức mạnh câu cá lên {0}x khi ở tundra
						Đặc tính lăng kính của hợp kim cổ đại này rất hoàn hảo để thu hút cá
						'''
				}

				WulfrumRod: {
					DisplayName: Wulfrum Fishing Pole
					Tooltip:
						'''
						Có thể câu được Wulfrum Metal Scrap và Wulfrum Energy Core
						'Thứ này hoạt động khá tệ, nhưng vẫn còn hơn không...'
						'''
				}

				// Bait
				GrandMarquisBait: {
					DisplayName: Grand Marquis Bait
					Tooltip: ""
				}

				// Bobbers
				ScrapBobber: {
					DisplayName: Wulfrum Bobber
					Tooltip:
						'''
						Cung cấp minigame câu cá
						Giữ các phím di chuyển theo hướng được chỉ định khi câu để bắt vật phẩm
						Cần câu sẽ mạnh dần nếu bạn không mắc lỗi trong thời gian dài, tăng tốc độ
						'Đáng lẽ phải có máy dò cá lắp vào đây, nhưng nó chỉ kêu khi bạn chĩa vào chính mình...'
						'''
				}

				NavystoneBobber: {
					DisplayName: Sunken Sinker
					Tooltip:
						'''
						{$ItemTooltip.FishingBobber}
						Cung cấp minigame câu cá
						Phao sẽ nổi ngang độ cao của bạn khi ở dưới nước, cho phép câu cá dưới nước
						Di chuyển theo hướng được chỉ định khi câu để bắt vật phẩm
						'''
				}

				SkylineBobber: {
					DisplayName: Acrobatic Bobber
					Tooltip:
						'''
						{$ItemTooltip.FishingBobber}
						Cung cấp minigame câu cá
						Di chuyển khi đang câu sẽ di chuyển các phao của bạn
						Các vòng sẽ xuất hiện dần phía trên mặt nước
						Chạm vào vòng sẽ móc một vật phẩm vào phao
						Phao sẽ tự động kéo vật phẩm vào khi rơi trở lại nước
						'''
				}

				PerennialBobber: {
					DisplayName: Feral Bobber
					Tooltip:
						'''
						{$ItemTooltip.FishingBobber}
						Tăng sức mạnh câu cá dựa trên lượng máu bạn đã mất
						Cung cấp minigame câu cá
						Giữ <right> khi bắt cá để rút máu và tăng tốc độ bắt
						Phao có thể móc vào kẻ địch, gây sát thương khi máu bị rút
						'''
				}

				ScoriaBobber: {
					DisplayName: Volcanic Sinker
					Tooltip:
						'''
						{$ItemTooltip.FishingBobber}
						Cho phép câu cá trong dung nham
						Cung cấp minigame câu cá
						Di chuyển khi đang câu sẽ di chuyển các phao của bạn
						Các khe nứt sẽ xuất hiện dần trong chất lỏng, chứa vật phẩm
						Khi phao chạm vào khe nứt, nó sẽ tự động kéo vật phẩm bên trong lên
						'''
				}
			}

			Lore: {
				ShortTooltip:
					'''
					[c/E3AF40:Những lời thì thầm từ trên cao khẽ vang bên tai bạn...]
					[c/BEBEBE:Giữ Shift để lắng nghe rõ hơn]
					'''

				LoreAbyss: {
					DisplayName: The Abyss
					Lore:
						'''
						Dưới lòng biển sâu tồn tại vô số khe nứt tối tăm không ánh sáng, nhưng nơi này là một kỳ quan địa chất thực sự.
						Nó nằm gần bờ biển một cách đáng bất an. Bằng cách nào đó, ngay cả hàng eon chuyển động kiến tạo cũng không thể bịt kín hay nghiền nát nó.
						Vực Thẳm cô lập này là nơi trú ngụ yên bình, dù còn gây tranh cãi, của naiade Anahita cùng nhiều sinh vật biển ẩn dật khác.
						Tại đây ta đã vứt bỏ phần tàn dư đang sinh sôi của Silva, nữ thần của sự sống.
						Dĩ nhiên, trong số các vị thần thì nàng là kẻ không chịu chết hoàn toàn.
						Ta mong rằng nàng sẽ bị lãng quên, nhưng sự kiên cường và ý chí của nàng thật đáng kinh ngạc.
						Dù đã tan rã, ảnh hưởng của nàng vẫn tràn ngập cái hố áp suất nghiền nát ấy với vô vàn hệ thực vật và sinh vật.
						Những bộ rễ khổng lồ của nàng vẫn tiếp tục quật phá lớp đá dày đặc không tưởng, sinh trưởng ngoài tầm kiểm soát.
						Chẳng bao lâu nữa nàng sẽ tái tạo nơi này theo hình ảnh của chính mình.
						Ta không thể tưởng tượng nổi số phận nào tệ hơn cho vùng vực sâu bị nguyền rủa này.
						'''
					Tooltip: ""
				}

				LoreAquaticScourge: {
					DisplayName: Aquatic Scourge
					Lore:
						'''
						Một con rắn biển từng vô cùng hùng mạnh khác, thích nghi hoàn hảo với môi trường khắc nghiệt của nó.
						Không giống Scourge kia — kẻ đói khát và phải săn tìm từng mẩu thức ăn; con này từng sống khá thoải mái.
						Vi sinh vật tiến hóa cực nhanh, vì vậy nó vẫn có thể duy trì cách kiếm ăn bằng cách lọc nước khi đại dương bắt đầu mục rữa.
						Một sự tương phản rõ rệt so với phần còn lại của hệ sinh thái.
						Gần như mọi sinh vật khác trong Sulphur Sea đều cực kỳ hung dữ.
						Thật đáng tiếc khi pháo đài bình yên cuối cùng của nó cũng đã sụp đổ.
						'''
					Tooltip: ""
				}

				LoreArchmage: {
					DisplayName: The Archmage
					Lore:
						'''
						Hắn vẫn còn sống sao?! Ta cứ tưởng hắn đã bị Calamitas giết chết.
						Có vẻ như cô ta đã giam cầm Đại Pháp Sư để giữ mạng cho hắn.
						Ta từng nghĩ khối băng giá đó là một cấu trúc cũ của hắn, đang mất kiểm soát vì không còn chủ nhân dẫn dắt.
						Permafrost từng là một đồng minh cũ của ta, mang danh hiệu Đại Pháp Sư với danh tiếng lẫy lừng.
						Sự thông thái của hắn đã dẫn dắt nhiều cuộc chinh phạt ban đầu của ta, khiến chúng có thể xảy ra.
						Nhưng khi cuộc thập tự chinh của ta thay đổi và tham vọng ngày càng lớn, hắn đã phản đối kịch liệt.
						Nơi từng là công lý, giờ đã bị che mờ bởi bạo quyền.
						Hắn rời đi cùng với Phù Thủy không lâu sau đó.
						'''
					Tooltip: ""
				}

				LoreAstralInfection: {
					DisplayName: Astral Infection
					Lore:
						'''
						Vùng mộng cảnh méo mó này là phiên bản từ các vì sao của thứ mục rữa tầm thường mà ngươi thấy trên thế giới mình.
						Ta không thể nói rằng mình hiểu rõ toàn bộ quá trình, nhưng ngay cả các vì sao trên bầu trời cũng có thể chết.
						Khi bị bỏ mặc, xác của chúng sẽ phình to và thối rữa.
						Thông thường vẫn tồn tại một dạng trật tự nào đó, giống như vòng tuần hoàn của sự sống.
						Những thực thể vũ trụ tuần tra trong khoảng không vô tận và rỉa xác chết, chỉ để lại những bộ xương sạch sẽ.
						Bản thân sự lây nhiễm này là một nhiễu loạn từ không gian sâu.
						Nó có ý chí riêng, áp đặt nó lên sự sống và đất đai.
						Những ai có tâm trí đủ để hiểu được hình dạng thật của vũ trụ thì gần như miễn nhiễm.
						Họ sẽ không bị mê hoặc bởi một “chân lý cao hơn”, càng không phải thứ được rao giảng bởi một khối mụn bệnh hoạn.
						'''
					Tooltip: ""
				}

				LoreAstrumAureus: {
					DisplayName: Astrum Aureus
					Lore:
						'''
						Vốn thực dụng, Draedon đã gửi cỗ máy này đi để tìm và phân tích nguồn gốc của Astral Infection.
						Dù trên danh nghĩa là trinh sát, mẫu Aureus lại được trang bị vũ khí hạng nặng và có thể leo qua mọi địa hình.
						Nó đã hoạt động rất hiệu quả… ít nhất là cho đến khi bị đồng hóa bởi sự lây nhiễm.
						Những trí tuệ có ý thức đủ mạnh có thể kháng lại lời gọi của sự lây nhiễm vô thời hạn.
						Tuy nhiên… ngay cả silicon tinh vi nhất cũng không nằm ngoài tầm với của nó.
						Dù sao thì Draedon vẫn thích những tạo vật của mình tiếp tục phục vụ.
						Khi thí nghiệm này kết thúc, chắc chắn hắn sẽ nhắm đến ngươi tiếp theo.
						Hãy cẩn thận.
						'''
					Tooltip: ""
				}

				LoreAstrumDeus: {
					DisplayName: Astrum Deus
					Lore:
						'''
						Trên thế giới của chúng ta, thực thể này được tôn kính như vị thần của bầu trời đêm.
						Người ta nói nó nuốt chửng những ngôi sao sắp chết rồi sinh ra những ngôi sao mới.
						Không giống nhiều vị thần mà ngươi và ta biết, nó vô tội.
						Một sự khác biệt quan trọng, bởi nó cũng bị bệnh giống như họ.
						Sự lây nhiễm đã xâm chiếm cơ thể nó đến từ ngoài Terraria.
						Cả ta lẫn Draedon đều không thể nhận diện hoàn toàn.
						Khi ý chí bị khuất phục, nó ném một mảnh vật chất astral bị nhiễm bệnh xuống thế giới này rồi đến để canh giữ.
						May thay, một thực thể vĩ đại bước đi giữa các vì sao như vậy có lẽ chưa thực sự chết.
						Dù vùng đất này đã phải trả một cái giá khủng khiếp, cái giá của một bản án sai lầm còn lớn hơn thế.
						'''
					Tooltip: ""
				}

				LoreAwakening: {
					DisplayName: Awakening
					Lore:
						'''
						Những lăng mộ của loài rồng đang chuyển động.
						Ánh mắt ta ngẩng lên thấy bụi cổ xưa rơi xuống từ những gờ đá cao.
						Đôi cánh vĩ đại này… đã bao lâu rồi kể từ khi ta còn là một anh hùng xứng đáng với danh xưng đó?
						Cảm giác như hàng thế kỷ đã trôi qua, nhưng với ta chỉ như một cái chớp mắt.
						Hãy nhìn những công trình của ta… giờ đây chỉ còn là đống hoang tàn.
						Không ai dám tìm đến ta, bước trên con đường của ta.
						Thế giới tàn nhẫn này chẳng chờ đợi gì cho họ cả.
						'''
					Tooltip: ""
				}

				LoreAzafure: {
					DisplayName: Azafure
					Lore:
						'''
						Thường được gọi là Thành Phố Đầu Tiên, lịch sử hỗn loạn của nó kéo dài từ Thời Đại Rồng.
						Một viên ngọc văn minh kỳ lạ, sức nóng khổng lồ của địa ngục đã mang lại cho nó tiềm năng vô hạn trong phòng thủ và công nghiệp.
						Các bậc thợ rèn nơi đây tài năng đến mức khi ta lôi kéo họ về phía mình, ta chưa từng thiếu vũ khí.
						Nhìn lại, thật đau lòng khi phải thừa nhận rằng chính tay nghề của họ đã dẫn đến sự sụp đổ của toàn thành phố.
						Đối với Phù Thủy và ta… không khí nơi này mãi mãi nhuốm đầy hối hận.
						Không còn gì có thể thay đổi được nữa.
						'''
					Tooltip: ""
				}

				LoreBloodMoon: {
					DisplayName: Blood Moon
					Lore:
						'''
						Sự tà ác này không phải do bất kỳ vị thần nào tạo ra.
						Trăng Máu đã tồn tại từ buổi bình minh của lịch sử.
						Nó vừa đáng sợ vừa tầm thường.
						Mọi người đã quen với những đoàn xác sống lững thững.
						Các xã hội có tổ chức gần như không hề bị đe dọa.
						Thậm chí, họ còn xem đó là cơ hội để huấn luyện những binh lính trẻ.
						Những kẻ mang dòng máu chiến binh có thể tự mình lao ra chiến trường để tận hưởng cuộc tàn sát.
						Đó là cách ta nhớ về những đêm mất ngủ thời trẻ…
						Đứng giữa đống xác chết cao đến đầu gối.
						'''
					Tooltip: ""
				}

				LoreBrainofCthulhu: {
					DisplayName: The Brain of Cthulhu
					Lore:
						'''
						Đúng là những dị thể kinh hoàng giờ đã trở nên phổ biến, phần lớn là do chính tay ta.
						Dù chúng vốn luôn là sản phẩm từ sự ngu xuẩn của các vị thần,
						chính những vị thần đó trước kia cũng tiêu diệt chúng.
						Việc ta tiêu diệt các thần giả đã khiến nhiều nỗi kinh hoàng cổ xưa không còn bị kiểm soát,
						và những nỗi kinh hoàng mới xuất hiện mỗi năm.
						Giờ đây… chúng chỉ là những bậc thang để ngươi tiến lên.
						'''
					Tooltip: ""
				}

				LoreBrimstoneElemental: {
					DisplayName: Brimstone Elemental
					Lore:
						'''
						Một thực thể kỳ lạ.
						Cho đến gần đây, cô ta đã ngủ yên suốt nhiều thời đại.
						Như một người bảo hộ thầm lặng của thành phố, hiện diện trong văn hóa của họ.
						Khi nền kinh tế phát triển, dấu vết brimstone lan ra khắp thế giới đã biết.
						Không ai biết vì sao giấc ngủ của cô ta kết thúc.
						Ban đầu chỉ là một sự chuyển động nhẹ, người dân vẫn lạc quan thận trọng.
						Nhưng sự thức tỉnh của cô ta thật kinh hoàng.
						Lửa địa ngục tràn khắp đường phố.
						Không ai an toàn trước ngọn lửa.
						Số phận thật trớ trêu khi Calamitas lại có mặt ở đó để đối đầu với cô ta.
						Có lẽ cả hai có sự liên kết nào đó…
						Họ chiến đấu ngang sức, lửa chống lại lửa.
						Không ai chiến thắng, và thành phố vẫn bị thiêu rụi trong biển lửa.
						'''
					Tooltip: ""
				}

				LoreCalamitas: {
					DisplayName: Calamitas
					Lore:
						'''
						Không ai phải gánh chịu bất hạnh nhiều như Brimstone Witch, Calamitas.
						Khi ta lần đầu gặp cô, cô vẫn chỉ là một cô gái.
						Quỳ rạp trước triều đình của ta, mặc những mảnh giẻ cháy sém và run rẩy.
						Ta không thể hiểu nổi sức mạnh ma thuật tà ác khủng khiếp đang chảy trong cơ thể cô.
						Ngay cả bản thân cô cũng gần như không kiểm soát được nó.
						Permafrost nhận ra điều này ngay lập tức.
						Với vẻ mặt đau đớn, hắn khuyên ta hãy chăm sóc cô.
						Cô gái bước vào sự dạy dỗ của hắn, rồi nhanh chóng phục vụ dưới trướng ta.
						Cô cháy bỏng khao khát trút cơn thịnh nộ lên các vị thần.
						Những kẻ sùng đạo đã run sợ trước sự hiện diện của cô.
						Cái tên Calamitas là do chính họ đặt ra, được thì thầm trong nỗi sợ.
						Trong các chiến dịch của ta, sức hủy diệt của cô là át chủ bài.
						Không người, không quân đội, không thành phố hay vị thần nào có thể chống lại cơn cuồng nộ của cô.
						Cuối cùng, tội lỗi khủng khiếp của cô trở nên quá nặng nề.
						Cô rời khỏi ta cùng với người thầy của mình.
						Gánh nặng những việc đã làm vẫn ám ảnh cô cho đến hôm nay.
						Cô căm ghét ta… và ta không thể trách cô.
						Làm ơn… nếu có thể, hãy dành cho cô sự tôn trọng mà ta đã không làm.
						'''
					Tooltip: ""
				}

				LoreCalamitasClone: {
					DisplayName: Calamitas Clone
					Lore:
						'''
						Ta từng thấy con quái vật này lang thang trong đêm và không mấy để tâm.
						Với công nghệ của nó, rõ ràng đó là một trong những tạo vật của Draedon.
						Nhưng việc nó chứa một bản sao của Phù Thủy… thật ghê tởm.
						Chắc chắn Calamitas sẽ không bao giờ chấp nhận một dự án như vậy.
						Ta không rõ bằng cách nào nó có thể sử dụng ma thuật brimstone của bà ta.
						Có lẽ một ngày nào đó chúng ta sẽ tìm ra câu trả lời.
						'''
					Tooltip: ""
				}

				LoreCeaselessVoid: {
					DisplayName: Ceaseless Void
					Lore:
						'''
						Một cánh cổng từng bị phong ấn và bất động, được giam giữ trong Dungeon. Giáo phái canh giữ nơi đó đã giữ bí mật này vô cùng nghiêm ngặt.
						Khi phát hiện Devourer of Gods, thủ lĩnh của họ vội vã dẫn ta đến căn phòng của nó để tiết lộ sự tồn tại của cánh cổng.
						Cánh cổng đó dẫn đến quê hương của Devourer. Nó giống hệt cánh cổng của hắn, chỉ cổ xưa hơn và hoàn toàn ổn định.
						Con rắn đó khẳng định: nó cũng là tạo vật của hắn. Và sự tồn tại vĩnh viễn của nó là một sai lầm mà sau này hắn đã sửa chữa.
						Nhưng khe nứt này chắc chắn còn cổ xưa hơn cả hắn. Nó có niên đại từ Thời Đại Hoàng Kim của loài rồng.
						Lời nói dối của hắn quá mỏng manh và gượng ép. Có thứ gì đó mạnh hơn nhiều so với Devourer đang can dự.
						Sự tồn tại kỳ dị của nó cứ gặm nhấm tâm trí ta.
						Nó không chỉ đe dọa riêng ta.
						Nó đe dọa tất cả. Mọi thứ.
						Thế nhưng ngay cả khi đối diện với lời nói dối trắng trợn và hiểm họa khủng khiếp, ta vẫn quay lưng bước đi… và không bao giờ trở lại.
						'''
					Tooltip: ""
				}

				LoreCorruption: {
					DisplayName: The Corruption
					Lore:
						'''
						Không xử lý đúng cách tinh chất của một vị thần đã bị giết là một sai lầm chết người.
						Vùng đất hoang tàn này chính là bằng chứng.
						Sau khi giết những vị thần đầu tiên, ta đã làm ngơ khi tinh chất tha hóa tuôn trào từ thi thể của họ và chui sâu vào lòng Terraria.
						Sự tồn tại của nơi mục rữa này chính là bằng chứng rằng những vị thần cổ xưa đã không còn hy vọng cứu rỗi.
						'''
					Tooltip: ""
				}

				LoreCrabulon: {
					DisplayName: Crabulon
					Lore:
						'''
						Nấm và một con cua biển.
						Một bên tìm vật chủ; bên kia tìm một nơi trú ngụ mới.
						Những cây nấm này sở hữu sức sống đáng lo ngại.
						Bất cứ thứ gì ngã xuống trong lãnh địa của chúng đều không bao giờ được yên nghỉ.
						Chính kiểu áp đặt quyền kiểm soát ghê rợn lên những kẻ không tự nguyện như thế đã dẫn ta bước lên con đường này.
						'''
					Tooltip: ""
				}

				LoreCrimson: {
					DisplayName: The Crimson
					Lore:
						'''
						Không khí hôi thối, hệ sinh vật bệnh hoạn, địa hình ghê tởm…
						Nơi đây chính là sai lầm đầu tiên trong cuộc thập tự chinh của ta.
						Tinh chất của một vị thần không đơn giản biến mất khi cơ thể chết đi.
						Nó phải được tiêu hủy hoàn toàn hoặc xử lý đúng cách.
						Tinh chất của một vị thần chính trực sẽ không bao giờ mục rữa thành một đầm lầy kinh hoàng như thế này.
						'''
					Tooltip: ""
				}

				LoreCynosure: {
					DisplayName: Cynosure
					Lore:
						'''
						Giờ đây ngươi đang đứng trước ranh giới của vô tận.
						Sức mạnh mà ngươi tích lũy được thật phi thường.
						Dũng khí và lừa dối, sự thật và giả dối, trung thành và phản bội…
						Ngươi đã vượt qua tất cả những khái niệm đó.
						Ngươi đã xé toạc mọi thứ cản đường mình.
						Bản thân thế giới giờ cũng phải uốn cong theo ý chí của ngươi.
						Ngươi không thấy sao, cỏ tách ra nơi ngươi bước, và các vì sao tỏa sáng nơi ánh mắt ngươi hướng đến?
						Terraria quỳ gối trước ngươi, dù là vì sợ hãi hay kính trọng.
						Đây chính là sức mạnh mà loài rồng từng nắm giữ.
						Sức mạnh nguyên sơ của thời khai sinh.
						Giờ đây giữa ta và ngươi chẳng còn nhiều khoảng cách.
						Nếu ngươi không tìm đến để chiến đấu với ta, hẳn ngươi đã không đi xa đến vậy.
						Khi đã sẵn sàng: hãy tìm đến ngôi mộ của Ánh Sáng, tại đỉnh Dragon Aerie.
						Ta sẽ chờ đợi thử thách của ngươi.
						'''
					Tooltip: ""
				}

				LoreDesertScourge: {
					DisplayName: Desert Scourge
					Lore:
						'''
						Từng là một con rắn biển hùng vĩ, không đe dọa gì ngoài những sinh vật cực nhỏ mà nó ăn.
						Sau khi Ilmeris bị thiêu rụi, nó bắt đầu quen với việc săn mồi.
						Để sống sót, nó nhanh chóng học cách tìm kiếm con mồi lớn hơn.
						Tuy nhiên với Scourge, có vẻ như cuối cùng nó cũng trở thành con mồi.
						Suy cho cùng, ngoài đại dương luôn có một con cá lớn hơn.
						'''
					Tooltip: ""
				}

				LoreDestroyer: {
					DisplayName: The Destroyer
					Lore:
						'''
						Các Hiệp Sĩ Godseeker trong đội quân của ta là những binh sĩ tinh nhuệ nhất.
						Họ chiến đấu vì lý tưởng của ta, và ta cũng bảo vệ họ.
						Ta ban cho họ những bộ giáp khổng lồ và vũ khí đồ sộ để sức mạnh của họ không bao giờ suy giảm.
						Đôi khi ta còn luyện tập cùng họ, truyền cảm hứng để họ đạt tới cơn cuồng nộ chính nghĩa mạnh mẽ hơn.
						Draedon hiểu rõ điều đó và ban cho họ những hình dạng khổng lồ này.
						Những cỗ máy được phủ kín vũ khí và lớp giáp khóa liên kết làm từ kim loại thiêng.
						Dù thực chất chỉ là thiết bị khai mỏ được cải tạo, sự hiện diện của chúng trên chiến trường vẫn vô cùng áp đảo.
						'''
					Tooltip: ""
				}

				LoreDevourerofGods: {
					DisplayName: The Devourer of Gods
					Lore:
						'''
						Kẻ tham ăn khét tiếng từ thế giới khác — nay bằng xương bằng thịt.
						Danh hiệu đáng sợ của hắn là do chính hắn tự phong, nhưng sự thật khiến nó trở nên không thể phủ nhận.
						Hắn là một kẻ thù khủng khiếp: có thể nuốt chửng các vị thần và hấp thụ toàn bộ tinh chất của họ.
						Ta đã ra lệnh cho Draedon bọc giáp cho thân hình khổng lồ của hắn để hắn có thể đánh bại cả những vị thần vĩ đại trong chiến đấu tay đôi.
						Đúng như một con rắn, hắn có chiếc lưỡi xảo quyệt.
						Hắn liên tục thao túng ta, thúc đẩy ta thực hiện những hành động khủng khiếp.
						Ta đã chiêu mộ hắn trong tuyệt vọng.
						Cuộc chiến của ta đã kéo dài hàng thập kỷ, và ta sẵn sàng làm mọi thứ để kết thúc nó.
						Chính lúc đó sai lầm của ta ra đời.
						Sự sa ngã của ta bắt đầu ngay khi ý nghĩ chiêu mộ tên khốn đó xuất hiện.
						Sự thiếu trung thành của hắn đã quá rõ ràng ngay từ đầu.
						Nhưng ta nghi ngờ rằng chuyện còn hơn thế.
						Những năng lực dị giới và chiến thuật áp đảo của Devourer cho thấy lòng trung thành của hắn thuộc về nơi khác.
						Liệu hắn chỉ là một binh lính… một con tốt của một thế lực tà ác vượt xa mọi thứ?
						'''
					Tooltip: ""
				}

				LoreDragonfolly: {
					DisplayName: Dragonfolly
					Lore:
						'''
						Gần cuối Thời Đại Rồng, đã có ghi chép về những loài rồng “không thuần chủng”.
						Wyvern, Basilisk, Pigron và nhiều loài khác được ghi nhận, dù không ai biết chính xác chúng ra đời như thế nào.
						Cho đến nay, các học giả vẫn tranh luận về tên gọi và dòng dõi thật sự của chúng.
						Bỏ qua vấn đề tên gọi: rõ ràng những nhánh đầu tiên vẫn đủ thuần khiết để giữ lại sức mạnh to lớn của tổ tiên.
						Đương nhiên điều đó khiến chúng trở thành mục tiêu của những mệnh lệnh tàn nhẫn từ các vị thần,
						và phần lớn đã bị săn lùng đến tuyệt chủng.
						Người ta biết rằng Fishron, Folly và Abyssal Wyrm đã sống sót sau những cuộc thanh trừng của Thời Đại Thần Thánh.
						Đáng chú ý là giờ đây chúng đều trở nên ẩn dật hoặc cực kỳ hung bạo.
						Thật bi kịch khi chúng đã tiến hóa thành như vậy.
						'''
					Tooltip: ""
				}

				LoreDukeFishron: {
					DisplayName: Duke Fishron
					Lore:
						'''
						Dù nghe có vẻ kỳ quái, loài này chính là sinh vật mạnh nhất của đại dương.
						Chúng là những thợ săn không khoan nhượng và có thể tồn tại ngoài nước trong thời gian dài.
						Truyền thuyết kể rằng fishron có nguồn gốc từ loài rồng thật sự từ hàng ngàn năm trước.
						Nhiều câu chuyện khác cũng nói về những sinh vật mang dòng máu rồng,
						nhưng trong trường hợp này, điều đó là sự thật.
						Dù có chung huyết thống hay không, fishron không có linh hồn auric.
						Ta biết rất rõ điều đó.
						'''
					Tooltip: ""
				}

				LoreEaterofWorlds: {
					DisplayName: The Eater of Worlds
					Lore:
						'''
						Bất kỳ sinh vật mạnh mẽ nào cũng sẽ sinh ra vô số truyền thuyết về sự vĩ đại và nỗi kinh hoàng của nó.
						Con sâu quái vật đó cũng không ngoại lệ.
						Một thứ nhỏ bé như vậy mà nuốt chửng cả hành tinh?
						Thật nực cười.
						Nhưng ngay cả lời chế giễu cũng lan truyền nhanh khi có một chút sự thật phía sau.
						Không cần tìm đâu xa để thấy ví dụ.
						Tất cả chúng ta đều bị bao quanh bởi mê tín và những giả định vô căn cứ.
						Bản thân ta cũng từng bị gán cho vô số lời buộc tội và khoe khoang vô nghĩa.
						'''
					Tooltip: ""
				}

				LoreEmpressofLight: {
					DisplayName: Empress of Light
					Lore:
						'''
						Dù mang danh hiệu cao quý, nàng thực chất chỉ là sứ giả của những thế lực vượt ngoài thế giới và các quy luật tự nhiên.
						Vào ban ngày, nàng có thể điều khiển Ánh Sáng Nguyên Sơ, khiến nàng gần như không thể chạm tới.
						May thay, khi chỉ còn ánh sao để sử dụng, nàng cũng gục ngã như bất kỳ bạo chúa vô duyên nào.
						Thói quen hút lấy sức mạnh của những thực thể vĩ đại khác của nàng thật đáng khinh.
						Điều đó khiến nàng trở nên phục tùng một cách bệnh hoạn.
						Phụ thuộc, nhưng tự nguyện, vì chúng cho phép nàng thỏa mãn cơn khát thấp hèn của mình.
						Ta từng định tự tay giết nàng vì sự phản bội đó, nhưng nàng nổi tiếng là mục tiêu rất khó truy lùng.
						'''
					Tooltip: ""
				}

				LoreExoMechs: {
					DisplayName: The Exo Mechanical Trio
					Lore:
						'''
						Một kỳ quan kỹ thuật đáng sợ.
						Chuyên môn của Draedon luôn là máy móc chiến tranh, nhưng những thứ này thật hoàn hảo.
						Lời tuyên bố táo bạo của hắn rằng không vị thần nào sánh được với công trình của hắn… tuy nhiên là sai.
						Hắn không biết đến Kẻ Phản Bội toàn năng.
						Dù vậy, chỉ bằng thép và trí tuệ, hắn đã tạo ra những cỗ máy hủy diệt có thể sánh ngang với Calamitas.
						Điều đó chẳng mang lại cho ta chút an ủi nào.
						Ít nhất Calamitas vẫn còn một trái tim.
						Draedon là một con quái vật vô đạo đức không gì sánh nổi.
						Hắn hoàn toàn không có nhân tính hay lòng trắc ẩn.
						Với công nghệ vượt xa mọi hiểu biết này, hắn đang đứng bên bờ của sự thần hóa.
						Hắn có thể tạo ra những cơn ác mộng nhân tạo kinh hoàng bất cứ lúc nào.
						Nguồn lực của hắn hẳn gần như vô hạn.
						Nếu hắn nổi giận — nếu hắn thậm chí có cảm xúc đó — mọi hy vọng của sự sống sẽ bị dập tắt trong chớp mắt,
						chìm trong cơn bão silicon.
						Tuy nhiên… có lẽ ngươi có thể tận dụng kỹ nghệ không tưởng của hắn,
						và tìm kiếm tri thức từ hắn.
						'''
					Tooltip: ""
				}

				LoreEyeofCthulhu: {
					DisplayName: The Eye of Cthulhu
					Lore:
						'''
						Trong thời đại xa xưa, các anh hùng đã làm nên tên tuổi khi đối đầu với những con quái vật như thế này.
						Giờ đây chúng xuất hiện khắp nơi, sinh ra từ những ảnh hưởng tà ác bị bỏ mặc.
						Chúng hòa lẫn hoàn hảo với sự bất công khủng khiếp mà tổ tiên của chúng từng gây ra.
						Giết một con chỉ mở đường cho hàng chục con khác xuất hiện.
						Chắc hẳn điều đó cũng không làm ngươi bận tâm.
						'''
					Tooltip: ""
				}

				LoreGolem: {
					DisplayName: Golem
					Lore:
						'''
						Thật là một thứ đáng thương.
						Thực sự là một sự chế giễu theo mọi nghĩa của từ đó.
						Người Lihzahrd đã bị vị thần của họ bỏ rơi từ rất lâu.
						Họ cố gắng tạo ra thần tượng này như một sự thay thế đáng thương.
						Kết quả là một sự pha trộn giữa nhiều khái niệm và chủ đề của các vị thần,
						nổi bật nhất là sức nóng của mặt trời.
						Nó còn lâu mới đạt đến tầm của một vị thần máy móc… và điều đó tốt hơn.
						Bởi vì nếu không, khả năng còn lại sẽ quá đáng sợ để nghĩ đến.
						Dù ta tin rằng công trình tầm thường này không đáng được nhắc đến,
						người Lihzahrd vẫn tôn thờ nó không chút do dự.
						Ta không thấy cần phải can thiệp vào những chuyện thấp kém như vậy.
						'''
					Tooltip: ""
				}

				LoreHiveMind: {
					DisplayName: The Hive Mind
					Lore:
						'''
						Một phần nào đó của tâm trí vị thần có thể tồn tại sau khi chết,
						giống như những cử động cuối cùng của một con côn trùng bị nghiền nát.
						Phần tàn dư ít ỏi đó cố gắng tụ họp và kết hợp lại trong sự tôn thờ.
						Một nỗ lực tuyệt vọng nhằm khôi phục sức mạnh của nó.
						Thật đáng thương.
						May mắn thay, sự vô ích của nỗ lực này là không thể so sánh.
						Khối sinh khối vẫn phục tùng… dù chẳng có gì đạt được.
						Sức mạnh thần thánh bắt nguồn từ niềm tin.
						Các vị thần được tạo nên từ sức mạnh của chính họ,
						và sự lan rộng vô thức của Corruption chính là dạng tôn thờ ghê tởm của nó.
						'''
					Tooltip: ""
				}

				LoreKingSlime: {
					DisplayName: King Slime
					Lore:
						'''
						Theo thời gian, những sinh vật dạng thạch này hấp thụ lẫn nhau và dần lớn lên cả về kích thước lẫn sức mạnh.
						Điều này không đáng lo ngại.
						Tự nhiên mà nói, slime gần như vô tri và chỉ tụ tập với nhau một cách ngẫu nhiên.
						Tuy nhiên có vẻ chúng có thể hấp thụ cả kiến thức,
						dù chỉ ở dạng rất sơ khai.
						'''
					Tooltip: ""
				}

				LoreLeviathanAnahita: {
					DisplayName: Leviathan and Anahita
					Lore:
						'''
						Mặc dù nàng tự nhận mình là kẻ thống trị toàn bộ đại dương của thế giới, sự thật là nàng chỉ là một kẻ ẩn dật nơi vực sâu.
						Những Elemental như nàng là mối đe dọa nghiêm trọng đối với tất cả những ai ở xung quanh. Các Elemental khác cũng không phải ngoại lệ.
						Anahita đã bị đẩy khỏi quê hương của mình trong Abyss bởi thảm thực vật đang lan rộng của Silva.
						Các ghi chép khác nhau về con quái thú hùng vĩ luôn ở bên cạnh nàng. Một số cho rằng chính Anahita đã triệu hồi Leviathan.
						Dù ngươi tin vào điều gì, chúng vẫn không thể tách rời, ngay cả trong cái chết.
						Một lòng trung thành kiên định đến vậy! Điều đó khiến ta nhớ đến Yharon.
						'''
					Tooltip: ""
				}

				LoreMechs: {
					DisplayName: The Mechanical Trio
					Lore:
						'''
						Những cỗ máy thép cồng kềnh này là các thí nghiệm của Draedon, đồng nghiệp cũ của ta và cũng là một kỹ sư thiên tài.
						Ý định của hắn là vận hành một cỗ máy chiến tranh bằng năng lượng linh hồn, cho phép nó chiến đấu với mục đích và sự cuồng nhiệt.
						Các tạo vật này đã thành công, có lẽ là quá thành công khi những linh hồn bên trong tiếp tục thể hiện ý chí tự do của riêng chúng.
						Draedon không hài lòng với kết quả đó. Tuy nhiên, đó vẫn là những binh sĩ của ta, lòng trung thành của chúng được rèn lại trong sắt thép.
						Ta đã giải tán chúng khỏi nhiệm vụ, nhưng chúng vẫn còn lang thang ở đây.
						Lùng sục khắp vùng đất để tìm bằng chứng về thần thánh.
						Thật không may cho ngươi, điều đó khiến ngươi lọt vào tầm ngắm của chúng. Hãy cho chúng một trận chiến xứng đáng để chết vì nó.
						'''
					Tooltip: ""
				}

				LoreOldDuke: {
					DisplayName: The Old Duke
					Lore:
						'''
						Đó có lẽ là một trong những sinh vật phàm trần lâu đời nhất còn sống trên hành tinh này.
						Những Fishron đầu tiên được ghi nhận vào giữa Kỷ Nguyên Rồng.
						Thật là một di sản kỳ lạ…!
						Fishron là một trong những nhánh hậu duệ đầu tiên của những con rồng auric thuần huyết.
						Chúng cổ xưa và được tôn kính đến mức nhiều sử gia tin rằng chúng chính là những quái vật biển nguyên bản trong truyền thuyết.
						Tên Duke này đặc biệt xảo quyệt: hắn đã né tránh hàng thế kỷ săn đuổi và cho đến giờ vẫn sống sót sau một vụ đầu độc vô cùng triệt để.
						Hơn gần như tất cả những sinh vật khác, sinh vật này là một huyền thoại sống.
						Người ta không khỏi tự hỏi điều gì đang diễn ra trong tâm trí của một huyền thoại đang lụi tàn….
						'''
					Tooltip: ""
				}

				LorePerforators: {
					DisplayName: The Perforators and Their Hive
					Lore:
						'''
						Những sinh vật này thật độc nhất. Chúng sử dụng sức mạnh của những vị thần đã ngã xuống theo cách thuần khiết nhất, mạch máu chảy tràn ichor đổ ra.
						Mọi thứ tồn tại trong Crimson thực chất là thần thánh bị lộn trái; máu thịt của chúng giờ đây lấp lánh sự phản bội bệnh hoạn cho tất cả chứng kiến.
						Vũng bùn này bốc mùi của hàng thế kỷ thao túng độc ác và sự thống trị tàn nhẫn lên những kẻ bất lực.
						Phán xét đã qua từ lâu, và giờ chỉ còn sự diệt vong đang chờ đợi.
						'''
					Tooltip: ""
				}

				LorePlaguebringerGoliath: {
					DisplayName: Plaguebringer Goliath
					Lore:
						'''
						Một nữ hoàng vô tội, bị ép phải chịu đựng một sự tồn tại đầy đau đớn. Đây chẳng khác nào một tội ác chống lại tự nhiên.
						Không hề hỏi ý kiến ta, Draedon đã tìm cách vũ khí hóa những bầy ong Jungle vốn đã có tổ chức rất tốt.
						Khi hắn cho ta xem dự án hoàn chỉnh của mình, ta đã vô cùng phẫn nộ.
						Hắn đã biến chúng thành nô lệ. Thật đáng khinh. Thậm chí còn ghê tởm.
						Draedon chẳng hề bận tâm đến sự phẫn nộ của ta và quay lại với những công việc khác của hắn như thể chẳng có chuyện gì.
						Kể từ đó, ta ngừng đưa ra bất kỳ yêu cầu nào với Draedon.
						Hắn đã cho ta thấy bộ mặt thật của mình….
						Những năm cuối đời của ta không phải lúc nào cũng chính trực.
						Nhưng ta sẽ không bao giờ xiềng xích một sinh vật để chiến đấu nhân danh mình.
						Làm vậy chẳng khác nào ta cũng giống những vị thần khốn nạn mà ta truy đuổi.
						'''
					Tooltip: ""
				}

				LorePlantera: {
					DisplayName: Plantera
					Lore:
						'''
						Con quái thú hoa cỏ đó đến từ một khu rừng mang tên Vernal Pass, quê hương của Braelor — chiến binh của Silva.
						Khi ta biết được nguồn gốc của hắn, ta đã tự mình tìm đến nơi đó.
						Than ôi, dường như chính thảm cỏ dưới chân ta đã ngăn ta tìm thấy nó.
						Ta từ bỏ cuộc truy tìm, nhưng sự kiêu ngạo của cư dân nơi đó cuối cùng lại trở thành tai họa của chính họ.
						Họ sợ hãi đến mức đã tạo ra một kẻ canh giữ ghê tởm để chống lại ta.
						Xiềng xích linh hồn của những sinh vật từng tự do chỉ có thể dẫn đến một kết cục.
						Cuộc nổi loạn của con quái thú thực vật này hoàn toàn là điều tất yếu.
						Giờ khi ngươi đã giết nó, những linh hồn hỗn loạn còn đáng sợ hơn đã bắt đầu bén rễ trên vùng đất này.
						Sự thiển cận của ngôi làng vốn đã đáng xấu hổ, nhưng hậu quả của nó có lẽ còn tệ hơn nữa.
						'''
					Tooltip: ""
				}

				LorePolterghast: {
					DisplayName: Polterghast
					Lore:
						'''
						Cuộc chiến của ta càng kéo dài, ta càng chìm sâu vào sự thờ ơ và lơ là.
						Linh hồn ma quái này chính là minh chứng cho thất bại của ta.
						Ta trốn sau những lời biện minh, gọi chúng là nghĩa vụ.
						Chiến đấu với các vị thần. Huấn luyện. Cai trị.
						Ta có thời gian và nguồn lực để xử lý mọi thứ.
						Ta chỉ đơn giản bị tê liệt bởi sự thờ ơ.
						Hàng loạt tù nhân mà ta giam giữ trong ngục tối — ta đã tuyên bố rằng họ chết cùng với những kẻ canh giữ.
						Bên trong những bức tường bị nguyền rủa đó, không linh hồn nào có thể yên nghỉ.
						Linh hồn của họ hợp nhất lại thành một con quái vật vô dạng.
						Sôi sục trong cơn thịnh nộ, chìm trong đau khổ, gào thét trong điên loạn.
						Sự hợp thể đó hoàn toàn mất kiểm soát.
						Giáo phái rồng vô cùng phẫn nộ, thủ lĩnh của họ yêu cầu ta tự tay tiêu diệt nó.
						Ta đã không đáp lại.
						Từ lâu ta đã trở nên điếc với thế giới bên ngoài cuộc thập tự chinh của mình.
						Đừng sa ngã như ta.
						'''
					Tooltip: ""
				}

				LorePrelude: {
					DisplayName: Prelude
					Lore:
						'''
						Trong thời đại xa xưa, nay được gọi là Kỷ Nguyên Rồng, những con rồng hùng vĩ đã bảo vệ Terraria khỏi mọi mối đe dọa.
						Sức mạnh lẫy lừng của chúng đã bị thử thách bởi một quái vật dị dạng đến từ bên ngoài các vì sao.
						Dù chiến đấu với toàn bộ sức mạnh, những con rồng chỉ có thể làm nó bị thương và suy yếu… nhưng không thể tiêu diệt.
						Không còn lựa chọn nào khác, chúng xé nát con quái vật đó, biến nó thành cái bóng của chính mình rồi phong ấn nó.
						Những gì còn sót lại của nó giờ nằm bị giam cầm trong Mặt Trăng, nơi xa nhất mà các con rồng có thể đày nó tới.
						Rất nhiều rồng đã ngã xuống trong trận chiến đó, và giống loài của chúng không bao giờ phục hồi được.
						Chính Zeratros cũng bị thương nặng.
						Có vẻ như sức mạnh của ông, cùng với sinh mạng của ông, sẽ mất đi vĩnh viễn.
						Một người phàm, đã thề phục vụ loài rồng, đã đứng lên với quyết tâm cứu lấy vị Vua cao quý của họ.
						'''
					Tooltip: ""
				}

				LoreProfanedGuardians: {
					DisplayName: The Profaned Guardians
					Lore:
						'''
						Những Guardian là sự mở rộng ô uế từ quyền năng của Profaned Goddess, kẻ sử dụng cùng một ngọn lửa tà ác đó.
						Chúng được trao quyền tự chủ một phần để truy lùng các mối đe dọa, hiếm khi bị nhìn thấy bên ngoài những ngôi đền được thánh hóa nhân danh nàng.
						Nàng đã mở rộng lãnh địa tội lỗi của mình, và tin rằng ngươi chính là mối đe dọa lớn nhất.
						Suy cho cùng, chính ngươi đã tiêu diệt con kinh hoàng sinh ra từ Hư Không, kẻ đã châm ngòi cho sự diệt vong của loài rồng.
						Hãy lôi nàng ra khỏi nơi ẩn náu. Đừng tỏ lòng thương xót; Profaned Goddess cũng chẳng hề có.
						'''
					Tooltip: ""
				}

				LoreProvidence: {
					DisplayName: Providence, the Profaned Goddess
					Lore:
						'''
						Một ngày vinh quang.
						Những chiến công dũng cảm ở tầm cỡ này được khắc ghi vào huyền thoại. Trong thời đại này, chỉ có Phù Thủy, Braelor và ta mới có thể sánh ngang.
						Providence có lẽ là một trong những vị thần độc ác nhất, ám ảnh với việc thanh tẩy thông qua sự xóa sổ.
						Những kẻ tôn thờ nàng xem mạng sống chẳng có bao nhiêu giá trị. Đau đớn không phải cái giá mà chúng cho rằng đáng để trả.
						Profaned Goddess hứa với tín đồ của mình rằng nàng sẽ chấm dứt bất bình đẳng bằng cách biến tất cả thành tro bụi vô dạng.
						Những kẻ sùng bái nàng ý chí yếu ớt, vậy mà nàng vẫn ngự trị như một trong những vị thần quyền năng nhất.
						Có lẽ chính bản chất dễ bị thao túng của chúng đã cho phép nàng rút ra nhiều sức mạnh đến vậy… 
						'''
					Tooltip: ""
				}

				LoreQueenBee: {
					DisplayName: Queen Bee
					Lore:
						'''
						Mặc dù có kích thước khổng lồ, những sinh vật này khá hiền hòa trừ khi bị khiêu khích. Tính khí yên bình của chúng ngày nay hiếm thấy… thậm chí còn là một vẻ đẹp hiếm hoi.
						Ngày trước, cả những ngôi làng từng mọc lên quanh các tổ ong khổng lồ này để cùng nhau thu hoạch mật ong trong hòa bình, đồng thời bảo vệ chúng khỏi nguy hiểm.
						Dù cái chết của nó là điều dễ hiểu trong hoàn cảnh này, ta vẫn cảm thấy thương xót cho những sinh vật hùng vĩ ấy.
						Số phận đã quá tàn nhẫn với giống loài của chúng.
						'''
					Tooltip: ""
				}

				LoreQueenSlime: {
					DisplayName: Queen Slime
					Lore:
						'''
						Sau khi bỏ chạy khỏi trận chiến với ngươi, có vẻ Slime God đã tạo ra một kẻ canh giữ mới từ những tinh chất vừa được giải phóng.
						Bị mắc kẹt trong quá trình hấp thụ sức mạnh mới… nó không thể chạy trốn thêm lần nữa.
						Hoặc có lẽ nó đã bị dồn đến tuyệt vọng để sinh tồn.
						Một cuộc săn vinh quang, một đối thủ xứng tầm. Giờ thì ngươi đã hiểu rằng mình phải truy đuổi chúng đến tận cùng Terraria.
						'''
					Tooltip: ""
				}

				LoreRavager: {
					DisplayName: The Ravager
					Lore:
						'''
						Một titan xác thịt ghê tởm được tạo ra chỉ với mục đích duy nhất: hủy diệt tàn bạo và không ngừng nghỉ.
						Con quái vật này là nước cờ tuyệt vọng nhằm xoay chuyển cục diện trước những paladin hùng mạnh của ta.
						Ta đã tấn công thánh đường của chúng không lâu sau khi xử tử vị thần của chúng, nhưng dù vậy ta vẫn không thể hoàn toàn ngăn chặn sự ra đời của nó.
						Nghi thức của chúng đã chôn vùi cơ thể và linh hồn của những đồng minh đã ngã xuống vào trong thứ kinh tởm này.
						Khi các pháp sư hiến dâng chính mạng sống của mình làm vật tế, nó thức tỉnh. Ta đã chém hạ nó ngay tại đó, biến nó thành một đống thịt nát.
						Ta không biết bằng cách nào nó sống sót khỏi lưỡi kiếm của ta, nhưng có vẻ phần xác thịt của nó giờ không còn nghe theo bất kỳ ý chí nào nữa.
						Sự tàn bạo không kiểm soát của nó nên là lời nhắc nhở rằng hãy cẩn thận với những gì ngươi tin tưởng.
						'''
					Tooltip: ""
				}

				LoreRequiem: {
					DisplayName: Requiem
					Lore:
						'''
						Khi Light Dragon đang hấp hối, một nhà sư đã đến thăm ông. Gần như không ai hiểu chuyện gì đã xảy ra ngày hôm đó.
						Phần lớn nói rằng cái chết của ông đã được xoa dịu. Sự thật thì sao? Linh hồn auric của Zeratros đã bị nuốt chửng — hoàn toàn.
						Nhà sư đứng dậy, bao phủ trong Primordial Light, tuyên bố bản thân là Xeroc. Vị Thần Đầu Tiên.
						Khi một con rồng được yên nghỉ tại Aerie, sức mạnh của nó sẽ được trả lại để một ngày nào đó có thể quay trở lại.
						Xeroc đã từ bỏ lời thề của mình và phá vỡ chu kỳ đó, trở thành kẻ phản bội không ai sánh bằng.
						Tin tức về sự thăng thần lan truyền rất nhanh. Nhiều kẻ cố gắng noi theo, hy vọng chiếm lấy một linh hồn auric cho riêng mình.
						Giờ thì ngươi đã biết… dù ý định có tốt đến đâu, mọi vị thần đều là tội nhân. Từng kẻ một đều đồng lõa trong tội diệt chủng.
						Dù hành trình của ngươi dẫn tới đâu, đứng về phía ta hay chống lại ta… mong rằng vận may sẽ đứng về phía ngươi.
						Bởi vì ngoài điều đó ra, sẽ chẳng còn gì giúp được ngươi.
						'''
					Tooltip: ""
				}

				LoreSignus: {
					DisplayName: Signus
					Lore:
						'''
						Một dị thể vượt ngoài mọi lời giải thích, sinh ra từ Distortion và được tôn thờ bởi tộc Onyx.
						Gần như toàn bộ thông tin về thực thể này đều đến từ chính bộ tộc bí ẩn đó. Mọi thứ khác chỉ là lời đồn.
						Nó được cho là có thể xuất hiện ở nhiều nơi cùng lúc. Khả năng lừa dối và sự xảo quyệt tàn nhẫn của nó là vô song.
						Đồng minh của Statis, Braelor, đã đấu với ta đến thế giằng co. Khi hai lưỡi kiếm khóa chặt, ronin lao tới tung đòn kết liễu.
						Devourer không phải kẻ coi trọng danh dự hay lòng trung thành. Nhưng hắn đã cảm nhận được sự yếu đuối. Sự do dự. Một con mồi dễ dàng.
						Con xà đã cuốn cả hai kẻ tấn công ta vào một cơn lốc xoáy không gian, khẳng định với ta rằng chúng đã chết chắc.
						Thế nhưng, hẳn Statis đã đạt được một thỏa thuận nào đó với Signus. Hắn thoát khỏi sự lưu đày mà không hề hấn gì.
						'''
					Tooltip: ""
				}

				LoreSkeletron: {
					DisplayName: Skeletron
					Lore:
						'''
						Một ông lão đáng thương đã bị một giáo phái cổ xưa bắt giữ, nguyền rủa ông vì đã xâm nhập thư viện cổ của chúng.
						Chúng từng là bạn của ta. Thủ lĩnh của chúng say mê loài rồng, nuôi mộng thậm chí hồi sinh một con.
						Bản thân những bức tường của nơi đó cũng bị nguyền rủa sâu sắc. Ma thuật đã phai mờ từ lâu khi những binh lính mục rữa bên trong.
						Đừng mong học được nhiều từ những cuốn sách cũ kỹ đó. Chúng được viết nên bởi lòng nhiệt thành sai lầm.
						'''
					Tooltip: ""
				}

				LoreSkeletronPrime: {
					DisplayName: Skeletron Prime
					Lore:
						'''
						Một số linh hồn bị thù hận nuốt chửng đến mức chúng thề rằng sẽ làm bất cứ điều gì nhân danh ta.
						Lòng trung thành của chúng không hề lay chuyển. Tuyệt đối. Không có tội ác nào là vượt quá giới hạn; sự trả thù của chúng không có điểm dừng.
						Ta đã tổ chức chúng thành các đội xung kích, gieo rắc kinh hoàng với súng phun lửa và vũ khí thiêu đốt.
						San bằng những nơi thờ phụng và thiêu rụi những kẻ mộ đạo giả dối, chuyên môn của chúng là xóa bỏ đức tin bằng ngọn lửa.
						Draedon hiểu điều đó rất rõ. Và hắn đã tạo cho chúng một diện mạo đáng sợ đến mức gợi lên chính sự hủy diệt.
						'''
					Tooltip: ""
				}

				LoreSlimeGod: {
					DisplayName: The Slime God
					Lore:
						'''
						Một tộc cổ xưa từng tôn thờ thứ này như biểu tượng duy trì sự cân bằng của tự nhiên. Giờ đây sự thuần khiết của nó đã bị vấy bẩn bởi lớp bùn nhơ mới hấp thụ.
						Sinh vật dạng thạch này không biết, cũng chẳng quan tâm đến người sống sót cuối cùng của tộc đó.
						Bi kịch như vậy quá đỗi quen thuộc trong việc thờ phụng.
						Tuy vậy, Slime God đủ khôn ngoan để trở nên hèn nhát. Nó bỏ chạy khỏi những trận chiến không thể thắng khi tay sai của nó bị tiêu diệt.
						Có lẽ vận may sẽ đứng về phía ngươi nếu bắt gặp nó lúc không đề phòng.
						'''
					Tooltip: ""
				}

				LoreStormWeaver: {
					DisplayName: Storm Weaver
					Lore:
						'''
						Sinh vật này, dù không hùng vĩ bằng Devourer, vẫn là một mối nguy hiểm khủng khiếp theo cách riêng của nó.
						Chrysadia từng xem nó như một tai họa khét tiếng; người ta nói rằng nó có thể nuốt trọn cả Wyvern.
						Nó đến thế giới của chúng ta thông qua một khe nứt do Devourer mở ra. Hắn lập tức bắt đầu cuộc săn đuổi, nhưng ta đã can thiệp.
						Hắn khẳng định rằng con xà nhỏ hơn kia quá nguy hiểm để được phép sống. Nhưng điều đó hóa ra chẳng qua chỉ là một lời dối trá khác.
						Dù vậy, thật kỳ lạ. Cho đến tận hôm nay, ta vẫn không biết vì sao hắn lại giả vờ lo lắng đến thế.
						Rồi lại nghĩ, người ta biết rất ít về Serpent hay quê hương của hắn. Ngay cả những nghiên cứu ám ảnh của Draedon cũng không mang lại nhiều kết quả.
						Dẫu vậy, ta không cho rằng Devourer có quyền tước đoạt mạng sống của Weaver chỉ dựa trên sự nghi ngờ.
						Kể từ đó, hắn đã theo dõi Weaver. Nhưng hắn không hề biết rằng mình đã đứng yên tại cùng một vị trí suốt bấy lâu.
						Rốt cuộc, hắn luôn nghĩ bản thân là kẻ không thể bị chạm tới.
						'''
					Tooltip: ""
				}

				LoreSulphurSea: {
					DisplayName: Sulphur Sea
					Lore:
						'''
						Bờ biển này chưa bao giờ dễ chịu, dù trước kia nó từng có những ngày tháng tốt đẹp hơn nhiều.
						Những làn khói không ngừng bốc lên từ nền công nghiệp của Azafure khiến làn nước tràn ngập các ion ăn mòn.
						Dù vậy, sự sống cứng cỏi vẫn thích nghi với môi trường mới này. Chắc hẳn có sự trợ giúp từ Silva khi nàng đào xuyên xuống tận Underworld.
						Từng bị xem là vùng đất không thể sinh sống, sự suy thoái ngày càng nặng đã khiến Draedon quyết định biến nơi này thành bãi đổ rác.
						Nhiều năm xả thải cẩu thả đã khiến sự biến đổi của vùng bờ biển này trở nên không thể đảo ngược.
						'''
					Tooltip: ""
				}

				LoreTwins: {
					DisplayName: The Twins
					Lore:
						'''
						Không phải mọi cuộc chiến đều là giao tranh trực diện. Hậu cần, tình báo và trí tuệ đều quan trọng ngang nhau để đảm bảo chiến thắng.
						Những cỗ máy này là trinh sát và đặc vụ tinh nhuệ nhất của ta, được tái sinh trong hình dạng ban cho chúng tầm nhìn vô song.
						Kẻ thù chỉ an toàn khi ngươi cho phép hắn được như vậy: cung thủ, gián điệp, sát thủ và nhiều kẻ khác giúp ngươi luôn giữ lợi thế quyết định.
						Draedon hiểu rất rõ rằng trận chiến công bằng duy nhất là trận chiến mà ngươi chiến thắng.
						Sự trợ giúp của hắn không bao giờ sai lệch, những tính toán của hắn lạnh lùng và tàn nhẫn.
						Ngay cả mục tiêu lẩn tránh giỏi nhất cũng không có cơ hội.
						'''
					Tooltip: ""
				}

				LoreUnderworld: {
					DisplayName: The Underworld
					Lore:
						'''
						Danh tiếng địa ngục mà Underworld mang hiện nay thực ra chỉ là chuyện khá gần đây.
						Những lớp tro bụi đang bóp nghẹt các thành phố từng vĩ đại vẫn còn ấm nóng.
						Những vị thần độc đoán hơn muốn ta trở thành kẻ đại diện cho mục đích của chúng, yêu cầu ta cai trị xã hội của chúng từ nơi đây.
						Thế nhưng dù được bao quanh bởi magma, Azafure vẫn bị thiêu rụi khi những mong muốn của chúng không được đáp ứng.
						Đó là cái giá đáng buồn của chiến tranh, nhưng ta không hề hối hận khi chiến đấu vì người dân của mình.
						'''
					Tooltip: ""
				}

				LoreWallofFlesh: {
					DisplayName: The Wall of Flesh
					Lore:
						'''
						Việc giam giữ tinh chất của một vị thần đã bị giết không phải chuyện nhỏ. Nó là một cấu trúc khổng lồ và ghê rợn.
						Bức Tường được ghép lại bằng những sợi gân mục nát và ma thuật còn ghê tởm hơn, tạo thành một nhà tù xác thịt thô sơ.
						Nó đã hoàn thành nhiệm vụ: ngăn chặn sự khuếch tán của ảnh hưởng thần thánh ngoài kiểm soát.
						Nếu không có bước đột phá giả kim này, chính thế giới mà ta chiến đấu để bảo vệ có lẽ đã bị hủy diệt trong cuộc tàn sát do ta gây ra.
						Phương pháp của ta từ đó đã thay đổi. Ta không còn cần phải giam giữ những tinh chất như vậy nữa, khi chúng có thể bị nuốt chửng.
						Mong rằng ngươi sẽ kế thừa lòng dũng cảm của ta để chống lại dòng năng lượng bùng phát sau đó.
						'''
					Tooltip: ""
				}

				LoreYharon: {
					DisplayName: Yharon, Resplendent Phoenix
					Lore:
						'''
						Sự trở lại của Thời Đại Rồng… tan vỡ. Chỉ trong chớp mắt, tất cả đã trở thành tro bụi bay trong gió….
						Yharon là con rồng auric cuối cùng. Là một phượng hoàng, quyền năng của hắn bao gồm cả sự tái sinh.
						Các vị thần tưởng rằng hắn đã bị tiêu diệt cùng đồng loại, nhưng hắn quay trở lại dưới dạng một quả trứng được giấu trên Aerie.
						Ta vốn được định sẵn sẽ nuốt lấy linh hồn auric của hắn khi hắn nở ra, và cai trị vĩnh viễn với tư cách God-King.

						[c/FCA92B:Định mệnh là thứ dành cho kẻ yếu.]

						Ta đã từ chối ý muốn của chúng, và phá tan âm mưu của chúng. Ta bị kết án tử hình vì tội phản nghịch.
						Lũ hèn nhát xu nịnh đó đã ném cả trứng của Yharon và ta xuống dòng magma của Địa Ngục.
						Sức nóng khủng khiếp đã thiêu cháy cơ thể ta một cách kinh hoàng, nhưng lại khiến Yharon được tái sinh. Hắn trỗi dậy trong biển lửa và cứu mạng ta.
						Kể từ ngày đó, linh hồn của chúng ta trở thành một. Hắn kể cho ta nghe câu chuyện về Zeratros, và cuộc diệt chủng của giống loài hắn.
						Ta đã hứa với hắn rằng ta sẽ đòi lại công lý. Và thế là chiến tranh bắt đầu, Yharon trở thành ngọn hải đăng hy vọng cho tất cả.
						Giờ đây, hy vọng ấy đã tàn lụi từ lâu. Ta chỉ còn là cái vỏ rỗng của người anh hùng ngày trước, và đây chính là bằng chứng cuối cùng.
						Yharon có thể sẽ trở lại, như hắn vẫn luôn làm, nhưng hắn… hắn đã nói lời từ biệt với ta.
						'''
					Tooltip: ""
				}
			}

