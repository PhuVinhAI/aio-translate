					FracturedArk: {
						DisplayName: Ark Nứt Vỡ
						Tooltip:
							'''
							[PARRY]
							Một lưỡi kiếm cũ kỹ từng được dùng chống lại cái ác của thế giới, nay sẵn sàng chiến đấu lần nữa
							'''
						ParryInfo:
							'''
							<right> để đưa Ark ra phía trước
							Đánh trúng kẻ địch sẽ phản đòn và cho bạn một khoảng bất tử ngắn
							Phản đòn cường hóa 10 nhát chém tiếp theo, tăng sát thương và cho phép phóng đạn
							'''
					}

					GaelsGreatsword: {
						DisplayName: Đại Kiếm Gael
						Tooltip:
							'''
							Nhát chém đầu bắn ra đầu lâu tự truy đuổi
							Nhát chém thứ hai bắn ra đầu lâu khổng lồ
							Nhát chém thứ ba không có đạn
							Liên tục tạo Rage khi sử dụng
							Nhát chém để lại vệt máu phát nổ khi dưới 50% máu
							Đôi khi triệu hồi loạt sét khi dưới 50% máu
							Thay thế Rage Mode bằng cơn mưa đầu lâu khổng lồ
							Kỹ năng này có hồi chiêu 30 giây
							'Đưa nó đây... linh hồn bóng tối của ngươi'
							'''
					}

					GalactusBlade: {
						DisplayName: Galactus Blade
						Tooltip:
							'''
							Gọi xuống một cơn mưa sao chổi từ bầu trời
							Được rèn từ cơn thịnh nộ của hỗn loạn hạt nhân
							'''
					}

					GalaxySmasher: {
						DisplayName: Galaxy Smasher
						Tooltip:
							'''
							Ném một chiếc búa nặng chịu ảnh hưởng của trọng lực, sẽ quay trở lại sau khi đánh trúng kẻ địch
							Những cú đánh liên tiếp sẽ triệu hồi ngày càng nhiều mảnh vỡ vũ trụ
							Sau tám lần đánh trúng, chiếc búa sẽ tự cường hóa bằng năng lượng thiên hà,
							tung ra một đòn hủy diệt làm rung chuyển cả không gian và thời gian
							'''
					}

					GalileoGladius: {
						DisplayName: Galileo Gladius
						Tooltip:
							'''
							Đâm liên tục phía trước người chơi, tạo ra Starburst khi trúng địch
							<right> để ném thanh gladius bằng một chuỗi chòm sao, xuyên thủng kẻ địch và gây [cbuff:CalamityMod/Voidfrost]
							Khi lưỡi kiếm đang cắm vào mục tiêu, dùng <left> hoặc <right> để rút nó ra
							<left> rút kiếm ra và gây sát thương lớn, tiêu hao 10 Starburst
							<right> kéo bản thân tới lưỡi kiếm, cho phép bật nhảy khỏi kẻ địch
							Nhảy khỏi kẻ địch tiêu hao 20 Starburst và cho bạn trạng thái bất tử tạm thời
							'Figaro, magnifico'
							'''
					}

					GeliticBlade: {
						DisplayName: Gelitic Blade
						Tooltip: Bắn ra làn sóng gel chậm dần khi đánh trúng kẻ địch
					}

					GildedProboscis: {
						DisplayName: Gilded Proboscis
						Tooltip:
							'''
							Hút máu tỉ lệ với sát thương gây ra cho kẻ địch
							<left> để tích lực cho một cú đâm chính xác
							Cú đâm ban đầu yếu nhưng sẽ mạnh dần khi giữ lâu hơn
							<right> để lao tới với một cú chém hất mạnh
							Khoảng cách lao tới phụ thuộc vào việc bạn đang di chuyển cùng hay ngược hướng lao
							Luôn gây chí mạng, và tỉ lệ chí mạng càng cao thì sát thương chí mạng càng lớn
							'''
