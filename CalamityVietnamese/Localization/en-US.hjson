					}

					SpectralstormCannon: {
						DisplayName: Spectralstorm Cannon
						Tooltip:
							'''
							Bắn ra một loạt pháo sáng linh hồn khiến vũ khí tích tụ nhiệt thiêu đốt
							Trong khi đang hạ nhiệt, các bóng ma truy đuổi liên tục được giải phóng
							Bắn quá lâu sẽ khiến vũ khí quá nhiệt và không thể sử dụng trong một thời gian ngắn
							Tuy nhiên, kích hoạt quá nhiệt sẽ giải phóng một vụ nổ linh hồn mạnh mẽ và đặt lại nhiệt
							Nhấn <right> để cất vũ khí, giữ nguyên mức nhiệt hiện tại
							{$CommonItemTooltip.PercentChanceToSaveAmmo}
							'Bắt buộc trang bị kính bảo hộ chống nổ ectoplasm'
							'''
					}

					SpeedBlaster: {
						DisplayName: Speed Blaster
						Tooltip:
							'''
