						DisplayName: Pandemic
						Tooltip:
							'''
							{$Common.YoyoStatsInfinite}
							Bắn ra plague seekers khi kẻ địch ở gần
							'''
					}

					PerfectDark: {
						DisplayName: Perfect Dark
						Tooltip: Bắn ra quả cầu tà ác bám vào khối và phát nổ
					}

					PhosphorescentGauntlet: {
						DisplayName: Phosphorescent Gauntlet
						Tooltip:
							'''
							Tung ra những cú đấm lưu huỳnh cực nhanh
							Khi sử dụng, bạn lao theo hướng của con trỏ chuột
							Khi va chạm, bạn sẽ bị bật ngược lại
							'''
					}

					PhotonRipper: {
						DisplayName: Photon Ripper
						Tooltip:
							'''
							Phóng ra dòng răng ánh sáng cứng với tốc độ cực cao
							Vũ khí này và các đạn của nó hoạt động như một cưa máy
							Nhấn <right> để sử dụng mà không chặt cây
							'''
					}

					PrismaticBreaker: {
						DisplayName: Prismatic Breaker
						Tooltip:
							'''
							Bắn ra nhiều loạt sao ma thuật khi vũ khí đang tích lực
							Sau khi tích lực xong, một tia laser cầu vồng khổng lồ sẽ được bắn ra để hủy diệt kẻ địch
							Vũ khí này được tăng sức mạnh bởi cả sát thương cận chiến và tầm xa
							Có vẻ thuộc về một cô gái phép thuật nào đó. Tỏa ra năng lượng vũ trụ mãnh liệt
							'''
					}

					Pwnagehammer: {
						DisplayName: Pwnagehammer
						Tooltip:
							'''
							Ném một chiếc búa nặng chịu ảnh hưởng trọng lực, tạo ra vụ nổ năng lượng thánh khi va chạm
							Sau khi đánh trúng bốn lần, một chiếc búa linh hồn sẽ được triệu hồi để giáng xuống kẻ địch
							'''
					}

					Quagmire: {
						DisplayName: Quagmire
						Tooltip:
							'''
							{$Common.YoyoStatsInfinite}
							Bắn ra các đám mây bào tử
							'''
					}

					RedSun: {
						DisplayName: Red Sun
						Tooltip:
							'''
							Gọi xuống loạt pháo sáng mặt trời từ bầu trời
							'Trên thiên đường'
							'''
					}

					RemsRevenge: {
						DisplayName: Rem's Revenge
						Tooltip:
							'''
							Triệu hồi các vụ nổ máu và giảm {0} phòng thủ của kẻ địch khi đánh trúng
							'Một chùy gai chết chóc xứng với chủ nhân quỷ dữ của nó'
							'''
					}

					Respiteblock: {
						DisplayName: Respiteblock
						Tooltip:
							'''
							Một chiếc cưa máy trắng lấp lánh phun máu xanh và tím khắp nơi
							Đánh trúng kẻ địch bằng lưỡi cưa sẽ hồi máu cho bạn và gây sát thương cực lớn
							[c/0e8401:'Không sao khi trở nên nguy hiểm']
							'''
					}

					Riptide: {
						DisplayName: Riptide
						Tooltip:
							'''
							{$Common.YoyoStats}
							Phun ra xoắn ốc các dòng nước
							'''
					}

					Roxcalibur: {
						DisplayName: Roxcalibur
						Tooltip:
							'''
							[WOF]Giữ <left> để tích lực cho một cú đánh
							Thả ra khi con trỏ ở phía trên bạn để vung kiếm bình thường, phóng ra các mảnh đá
							Thả ra khi con trỏ ở phía dưới bạn để lao xuống và bật khỏi kẻ địch
							Lao vào khối sẽ tạo ra sóng chấn động
							Bạn không thể rút nó khỏi tảng đá, nên đành mang cả tảng đá theo
							'''
						LockedInfo: Bức Tường Thịt địa ngục giữ chìa khóa cho sức mạnh của vũ khí này
					}

					SaharaSlicers: {
						DisplayName: Sahara Slicers
						Tooltip:
							'''
							Một cặp dao găm đôi có tầm đánh ngắn
							Đánh trúng kẻ địch bằng dao sẽ cho bạn hai tia năng lượng mỗi lần, tối đa 10
							Nhấn <right> để ném các tia năng lượng đã tích lũy vào kẻ địch
