					}

					Mourningstar: {
						DisplayName: Mourningstar
						Tooltip: Phóng ra hai thanh kiếm roi mặt trời phát nổ khi trúng địch
					}

					Murasama: {
						DisplayName: Murasama
						Tooltip:
							'''
							Một lưỡi kiếm tần số cao có thể cắt xuyên cả những kẻ địch mạnh nhất
							Mỗi đòn thứ ba gây sát thương cực lớn
							Chứng minh giá trị của bạn bằng cách hạ gục The Devourer of Gods để rút thanh kiếm này khỏi vỏ
							[c/F41A31:'Sẽ có máu đổ!']
