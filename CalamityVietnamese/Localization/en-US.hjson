				AngelicAlliance: {
					DisplayName: Angelic Alliance
					Tooltip:
						'''
						Triệu hồi sức mạnh thiên đường để cường hóa đòn tấn công và lính triệu hồi
						Dũng khí, Khai sáng, Hân hoan. Hợp nhất trong Phán xét
