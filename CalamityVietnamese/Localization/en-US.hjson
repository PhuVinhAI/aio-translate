						DisplayName: Sulphurous Grabber
						Tooltip:
							'''
							{$Common.YoyoStatsInfinite}
							Thỉnh thoảng giải phóng một vòng bong bóng nhiều màu
							Yoyo được tăng sức mạnh sau khi chạm bong bóng xanh
							'''
					}

					Swordsplosion: {
						DisplayName: Swordsplosion
						Tooltip:
							'''
							Bắn ra nhiều kiếm tia cầu vồng rơi từ trên trời
							Bầy kiếm
							'''
					}

					TaintedBlade: {
						DisplayName: Tainted Blade
						Tooltip: Gây nhiễm độc khi đánh trúng kẻ địch
					}

					TeardropCleaver: {
						DisplayName: Teardrop Cleaver
						Tooltip: Khiến kẻ địch phải rơi lệ
					}

					TenebreusTides: {
						DisplayName: Tenebreus Tides
						Tooltip:
							'''
							Bắn ra cây thương nước xuyên qua kẻ địch và địa hình
							Đánh trúng kẻ địch sẽ triệu hồi các lưỡi kiếm và thương nước tấn công mục tiêu
							'Inundatio ex Laminis'
							'''
					}

					Terratomere: {
						DisplayName: Terratomere
						Tooltip:
							'''
							Hồi máu cho người chơi khi đánh cận chiến trực tiếp
							Bắn ra nhiều tia năng lượng xuyên mục tiêu truy đuổi rất nhanh
							Khi đánh trúng sẽ phát nổ và liên tục chém mục tiêu
							'Liên kết với bản chất của Terraria'
							'''
					}

					TerrorBlade: {
						DisplayName: Terror Blade
						Tooltip:
							'''
							Bắn ra tia khủng bố nảy trên các khối
							Mỗi lần nảy sẽ phát ra một vụ nổ
							'''
					}

					TheBurningSky: {
						DisplayName: The Burning Sky
						Tooltip:
							'''
							Gọi xuống dòng lửa rồng tại vị trí con trỏ
							'Giơ lưỡi kiếm lên bầu trời và chứng kiến tận thế'
							'''
					}

					TheDarkMaster: {
						DisplayName: The Dark Master
						Tooltip:
							'''
							Bắn ra các nhát chém vọng đỏ khi trên 75% máu
							Sát thương đạn tăng theo mỗi HP trên 400
							Nhấn <right> để tạo ba phân thân bóng tối theo đội hình Delta
							Các phân thân sẽ bắt chước các cú vung kiếm của bạn và bắn ra đạn
							Đạn vẫn được bắn bất kể máu của bạn nhưng gây ít sát thương hơn
							Các phân thân chỉ tồn tại khi bạn đang cầm vũ khí này
							'Lưỡi kiếm mà qua đó bóng tối giáng xuống kẻ thù số phận kinh hoàng'
							'''
					}

					TheGodsGambit: {
						DisplayName: The God's Gambit
						Tooltip:
							'''
							{$Common.YoyoStatsInfinite}
							Bắn ra dòng slime khi có kẻ địch ở gần
							'''
					}

					TheLastMourning: {
						DisplayName: The Last Mourning
						Tooltip: Triệu hồi những quả bí ngô rực lửa và đầu lâu tang tóc tách thành các quả cầu lửa khi trúng kẻ địch
					}

					TheMicrowave: {
						DisplayName: The Microwave
						Tooltip:
							'''
							{$Common.YoyoStatsInfinite}
							Nướng chín kẻ địch gần đó bằng bức xạ và gây [cbuff:CalamityMod/AstralInfectionDebuff]
							'Nấu nướng theo phong cách Astral Infection'
							'''
					}

					TheMutilator: {
						DisplayName: The Mutilator
						Tooltip:
							'''
							Đánh trúng kẻ địch sẽ cường hóa The Mutilator, tăng sát thương của nó
							Khi tích đầy năng lượng, đánh trúng kẻ địch sẽ gây ra vụ nổ quả cầu máu
							Nhặt các quả cầu máu này sẽ giảm thời gian của [cbuff:PotionSickness]
							'''
					}

					TheObliterator: {
						DisplayName: The Obliterator
						Tooltip:
							'''
							{$Common.YoyoStatsInfinite}
							[GFB]
