							Nếu kẻ địch nằm trong tầm nhìn của các roi tại thời điểm va chạm, tia sáng sẽ bắn về phía nó
							'''
					}

					StarnightLance: {
						DisplayName: Starnight Lance
						Tooltip: Bắn ra tia starnight băng giá
					}

					StellarContempt: {
						DisplayName: Stellar Contempt
						Tooltip:
							'''
							Ném một chiếc búa nặng chịu ảnh hưởng trọng lực, sẽ quay trở lại sau khi đánh trúng kẻ địch
							Các lần đánh liên tiếp gọi xuống ngày càng nhiều pháo sáng mặt trăng từ bầu trời
							Sau năm lần đánh trúng, chiếc búa được siêu nạp năng lượng mặt trăng để nghiền nát mục tiêu
							'''
					}

					StellarStriker: {
						DisplayName: Stellar Striker
						Tooltip: Triệu hồi bầy pháo sáng mặt trăng từ bầu trời khi đánh trúng kẻ địch
					}

					StormRuler: {
						DisplayName: Storm Ruler
						Tooltip:
							'''
							Bắn ra các tia năng lượng tạo lốc xoáy tại điểm va chạm
							Lốc xoáy hút kẻ địch vào
							'Chỉ cơn bão mới có thể quật ngã đại thụ'
							'''
					}

					StormSaber: {
						DisplayName: Storm Saber
						Tooltip:
							'''
							Bắn ra hai tia bão tự truy đuổi
							Một từ lưỡi kiếm và một từ bầu trời
							'''
					}

					StreamGouge: {
						DisplayName: Stream Gouge
						Tooltip:
							'''
							Triệu hồi một cổng không gian mà cây thương đi xuyên qua
							Sau khi đi qua, các cổng sẽ xuất hiện gần con trỏ và phóng ra bản sao lưỡi cắt của cây thương
							Kẻ địch bị các bản sao đánh trúng sẽ tạo ra vết rách trong không gian, lộ ra nền vũ trụ
							'''
					}

					StygianShield: {
						DisplayName: Stygian Shield
						Tooltip:
							'''
							Giữ <left> để tích lực cho cú lướt mọi hướng xuyên qua kẻ địch
							<right> để ném khiên nhỏ nảy sang kẻ địch gần đó khi va chạm
							Cấp miễn nhiễm đẩy lùi và {0} phòng thủ khi cầm
							Tuy nhiên không thể lướt cho đến khi bạn ngừng cầm vũ khí này trong {1} giây
							'''
					}

					SubmarineShocker: {
						DisplayName: Submarine Shocker
						Tooltip: Kẻ địch phát ra tia điện khi bị đánh trúng
					}

