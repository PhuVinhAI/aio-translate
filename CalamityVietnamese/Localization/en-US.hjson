					BurningRevelation: {
						DisplayName: Hỏa diệm khải huyền
						Tooltip:
							'''
							{$Common.YoyoStatsInfinite}
							Một yo-yo cháy rực không ngừng tích tụ năng lượng
							Đánh trực tiếp sẽ tăng mạnh mức tích tụ và giải phóng năng lượng profaned theo cấp tích tụ
							Khi đạt mức tối đa, yo-yo tung ra loạt sao tự truy đuổi, gây sát thương càng lớn khi bay càng xa
