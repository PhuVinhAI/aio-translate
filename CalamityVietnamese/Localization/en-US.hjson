				// Schematics
				SchematicUnlocked:
					'''
					Đã được giải mã.
					Nhấp để xem nội dung.
					Công thức đã mở khóa:
					'''

				EncryptedSchematicHell: {
					DisplayName: Bản Thiết Kế Mã Hóa (Underworld)
					Tooltip: Cần một Codebreaker với màn hình hiển thị tinh vi để giải mã
					Content:
						'''
						Chỉ những kẻ có cấp bậc cao nhất trong các tiểu đoàn của quân đội Yharim mới được sở hữu những vũ khí này. Tuy nhiên, chúng vẫn chưa phải là những công cụ mạnh nhất của ta. Những... kẻ đó không thể được tin tưởng để sử dụng chúng.
						Bổ sung: Mảnh ghép cuối cùng vẫn còn. Hãy đi từ ngọn lửa nóng nhất mà vùng đất này có thể tạo ra, đến cái lạnh khắc nghiệt nhất. Ta phải thừa nhận điều này có một sự đối xứng đầy thi vị.
						'''
				}

				EncryptedSchematicIce: {
					DisplayName: Bản Thiết Kế Mã Hóa (Ice)
					Tooltip: Cần một Codebreaker với hệ thống điều chỉnh điện áp phức tạp để giải mã
					Content:
						'''
						Kể từ đó ta đã tạo ra những vũ khí còn vượt xa cả những thứ này, nhưng chúng vẫn là những sáng tạo đáng tự hào. Không có tiến bộ nào xuất hiện nếu không có khát vọng được sinh ra từ sự không hài lòng.
						Bổ sung: Thời khắc đã đến. Ngươi đã sẵn sàng.
						'''
				}

				EncryptedSchematicJungle: {
					DisplayName: Bản Thiết Kế Mã Hóa (Jungle)
					Tooltip: Cần một Codebreaker với cảm biến tầm xa được tinh chỉnh chính xác để giải mã
					Content:
						'''
						Khi cấp bậc tăng lên, mức độ chết chóc của trang bị thường cũng tăng theo. Trong tay những binh sĩ có năng lực, các vũ khí này có thể thay đổi cục diện. Tuy nhiên, những binh sĩ có năng lực chỉ hành động theo mệnh lệnh từ cấp trên.
						Bổ sung: Nếu ngươi đọc được điều này, nghĩa là ngươi đã đi rất xa. Đừng làm ta thất vọng. Hãy đến Địa Ngục, nơi thành phần tiếp theo được cất giữ trong những lò rèn từng thuộc về ta.
						'''
				}

				EncryptedSchematicPlanetoid: {
					DisplayName: Bản Thiết Kế Mã Hóa (Planetoid)
					Tooltip: Cần một Codebreaker với máy tính giải mã cơ bản để giải mã
					Content:
						'''
						Trong một đội quân, cũng như vũ khí, binh lính phục vụ những mục đích khác nhau. Sự phân biệt đó là vô cùng quan trọng, bởi một công cụ mạnh mẽ nhưng nằm trong tay kẻ không phù hợp thì cũng chẳng khác gì một cây gậy gỗ.
						Bổ sung: Hãy tìm đến căn cứ hoạt động của ta gần quê hương của loài Lihzahrd nhất. Ta chân thành chúc ngươi may mắn, bởi đã rất lâu rồi ta mới có một đối tượng thí nghiệm xứng đáng.
						'''
				}

				EncryptedSchematicSunkenSea: {
					DisplayName: Bản Thiết Kế (Sunken Sea)
					Tooltip:
						'''
						Những sơ đồ chi tiết tinh vi của nhiều thiết bị và vũ khí hiện lên trên màn hình hologram
						Nhặt vật phẩm này hoặc giữ nó trong túi đồ sẽ vĩnh viễn mở khóa các công thức mới
						Nhấp để xem nội dung
						'''
					Content:
						'''
						Những vũ khí ta cung cấp cho nhân viên trong các phòng thí nghiệm khá yếu. Hầu như không thích hợp cho chiến đấu.
						Tuy nhiên, chúng vẫn đủ để tự vệ trước các cơ chế phòng thí nghiệm hoặc những sáng tạo có thể đã mất kiểm soát.
						Bổ sung: Với những kẻ tự cho mình mạnh mẽ, hãy tìm kiếm ở rìa trên của tầng khí quyển hành tinh này một cấu trúc tương tự như Sunken Sea.
						Đến cuối cùng ta sẽ biết liệu ngươi có xứng đáng đối đầu với những tạo vật của ta hay không.
						'''
				}
			}

