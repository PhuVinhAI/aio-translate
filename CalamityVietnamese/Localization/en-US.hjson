						DisplayName: Kiếm Lãng Quên
						Tooltip: Bắn ra hai lưỡi cát thay đổi tốc độ khi bay
					}

					FourSeasonsGalaxia: {
						DisplayName: Galaxia
						Tooltip:
							'''
							[FUNC]
							Thoát khỏi xiềng xích trần thế và tràn đầy sức mạnh vũ trụ
							Có thể truy cập tất cả các trạng thái đồng bộ
							Nhấn <right> để thay đổi trạng thái theo vị trí con trỏ
