					LiliesOfFinality: {
						DisplayName: Lilies of Finality
						Tooltip:
							'''
							Yêu cầu 2 ô lính triệu hồi để sử dụng
							Chỉ có thể triệu hồi một lần
							'Tỉnh dậy'
							'''
					}

					Metastasis: {
						DisplayName: Metastasis
						Tooltip:
							'''
							Triệu hồi một Sepulcher chiến đấu cho bạn
							Khi Sepulcher đang hoạt động, các trái tim brimstone sẽ xuất hiện và bay quanh bạn
							Khi có quá nhiều trái tim, nó sẽ tạm ngừng tấn công để phá hủy chúng
							Điều này xảy ra thường xuyên hơn tùy vào số lượng trái tim hiện có
							Yêu cầu 4 ô lính triệu hồi và chỉ có thể triệu hồi một lần
							'''
						Calamitas:
							'''
							'Khi ta gia nhập hàng ngũ của Yharim, Devourer là một trong những kẻ đầu tiên chào đón ta. Ban đầu hắn có vẻ tử tế, nhưng chiếc mặt nạ đó không tồn tại lâu.
							Hắn kiêu ngạo, thiếu tôn trọng và đầy toan tính. Nếu ngươi chưa giết hắn, ta cũng sẽ làm điều đó.
							Ta tạo ra Sepulcher của mình như một sự chế nhạo đối với sự kiêu ngạo của hắn, nhưng có vẻ lời sỉ nhục đó chẳng có tác dụng. Ngươi có thể thêm "não sên" vào danh sách những danh hiệu bịa đặt của hắn.'
							'''
					}

