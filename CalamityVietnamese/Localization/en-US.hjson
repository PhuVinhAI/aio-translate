					Ozzathoth: {
						DisplayName: Ozzathoth
						Tooltip:
							'''
							{$Common.YoyoStatsInfinite}
							Bắn ra các quả cầu vũ trụ bắn laser vào kẻ địch gần đó
							'Hủy diệt vũ trụ chỉ trong chớp mắt'
