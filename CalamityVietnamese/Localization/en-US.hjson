					EmpyreanKnives: {
						DisplayName: Dao Empyrean
						Tooltip: Ném ra loạt dao tự truy đuổi dội khỏi địa hình và hồi máu cho người dùng
					}

					EntropicClaymore: {
						DisplayName: Đại Kiếm Entropy
						Tooltip:
							'''
							Bắn ra chùm plasma sống bơi trong không khí
							Plasma sẽ theo con trỏ hoặc kẻ địch gần nhất
							Plasma xuyên mục tiêu nhưng sẽ ngừng truy đuổi sau khi trúng kẻ địch đầu tiên
							'''
					}

					EssenceFlayer: {
						DisplayName: Essence Flayer
						Tooltip: Bắn ra lưỡi hái linh hồn tạo ra các linh hồn hồi máu khi giết kẻ địch
					}

					EvilSmasher: {
						DisplayName: Evil Smasher
						Tooltip:
							'''
							Mỗi kẻ địch bạn giết sẽ tăng chỉ số của búa
							Các cộng dồn này tăng cho đến khi đạt giới hạn
							Cộng dồn sẽ reset nếu bạn đổi sang vật phẩm khác
							Mỗi lần bạn bị đánh trúng sẽ mất 1 cộng dồn
							'EViL! sMaSH eVIl! SmAsh... ER!'
							'''
					}

					ExaltedOathblade: {
						DisplayName: Exalted Oathblade
						Tooltip:
							'''
							Ném ra lưỡi kiếm xoắn ghim, thiêu đốt và làm chậm kẻ địch
							Tối đa bốn lưỡi kiếm có thể ghim vào một kẻ địch
							Nhấn <right> để vào thế đứng và dùng <left> tung ra nhát chém hủy diệt
							Khi ở trong thế đứng bạn hồi máu, hồi thời gian bay và dash hồi nhanh hơn
							Nhát chém cần thời gian hồi sau khi dùng
							Đánh trúng kẻ địch đang bị ghim sẽ bắn ra toàn bộ lưỡi kiếm và sẵn sàng nhát chém tiếp theo
							'''
						HoldShiftTooltip:
							'''
							[c/b63cd1:Một thanh kiếm được rèn từ truyền thuyết về Ma Vương Cuối Cùng.]
							[c/b63cd1:Được tôn vương bằng sức mạnh áp đảo, thanh kiếm nhuộm máu quỷ và lửa địa ngục.]
							[c/b63cd1:Dù hắn đã chết từ lâu, chưa ai dám ngồi lên ngai vàng đó.]
							[c/b63cd1:Tộc quỷ từ đó chưa từng đoàn kết trở lại.]
							'''
					}

					Exoblade: {
						DisplayName: Exoblade
						Tooltip:
							'''
							Nhấn <left> để phóng nhiều tia năng lượng tự truy đuổi và chém kẻ địch
							Nhấn <right> để dash theo hướng con trỏ cùng lưỡi kiếm
							Đánh trúng trong lúc dash gây sát thương cực lớn và bật ngược
							Nhấn <left> ngay sau khi bật ngược để tung ra nhát chém mạnh
