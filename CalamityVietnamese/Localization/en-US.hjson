					AbyssBlade: {
						DisplayName: kiếm vực thẳm
						Tooltip:
							'''
							Ném ra một thanh kiếm vực sâu xoay tròn, cắt xuyên kẻ địch và giải phóng năng lượng nước khi chạm vào địa hình
							Sau khi dội lại, thanh kiếm sẽ lao về phía kẻ địch và gây gấp đôi sát thương
							'''
					}

					AcidwoodSword: {
						DisplayName: Kiếm Gỗ Axit
						Tooltip: ""
					}

					AegisBlade: {
						DisplayName: Kiếm Khiên Aegis
						Tooltip:
							'''
							Đánh trúng kẻ địch bằng lưỡi kiếm sẽ gây ra một vụ phun trào đất đá
							Nhấn <right> để bắn ra tia Aegis
							'''
					}

					AirSpinner: {
						DisplayName: Air Spinner
						Tooltip:
							'''
							{$Common.YoyoStats}
							Bắn ra lông vũ khi kẻ địch ở gần
							'''
					}

					AmidiasTrident: {
						DisplayName: Đinh Ba của Amidias
						Tooltip: Bắn ra những xoáy nước tự truy đuổi
					}

					AnarchyBlade: {
						DisplayName: Kiếm Hỗn Mang
						Tooltip:
							'''
							Máu của bạn càng thấp thì thanh kiếm gây càng nhiều sát thương
							Đòn đánh sẽ tạo ra một vụ nổ lớn
							Khi dưới 50% máu, đòn đánh có tỷ lệ tiêu diệt ngay lập tức kẻ địch thường
							'''
					}

					Aorta: {
						DisplayName: Aorta
						Tooltip:
							'''
							{$Common.YoyoStats}
							Bắn ra máu tự truy đuổi khi kẻ địch ở gần
							'''
					}

					ArkoftheCosmos: {
						DisplayName: Ark of the Cosmos
						Tooltip:
							'''
							[COMBO]
							[PARRY]
							[BLAST]
							Kết tinh vật chất của toàn bộ hành trình của bạn, đủ sức xé toạc cả các vị thần
							'''
						ComboInfo:
							'''
							Nhấn <left> để thực hiện chuỗi 5 nhát chém, kết thúc bằng việc ném lưỡi kiếm
							Lưỡi kiếm được ném ra sẽ bay theo con trỏ
							Thả nút khi lưỡi kiếm đang bay sẽ gây ra vụ nổ
							'''
						ParryInfo:
							'''
							Nhấn <right> để bật hai lưỡi kéo trước mặt
							Đánh trúng kẻ địch sẽ phản đòn, cho bạn bất tử trong thoáng chốc
							Có thể phản đòn đạn để giảm 160 sát thương của chúng trong thời gian ngắn
							Phản đòn sẽ cường hóa 16 nhát chém tiếp theo
							'''
						BlastInfo: Nhấn <right> hai lần khi còn tích trữ để xé toạc không-thời gian và tiêu thụ toàn bộ tích trữ
					}

					ArkoftheElements: {
						DisplayName: Ark of the Elements
						Tooltip:
							'''
							[COMBO]
							[PARRY]
							Cặp lưỡi kiếm thần thánh thấm đẫm tinh túy của Terraria, đủ sức cắt xuyên cấu trúc thực tại
							'''
						ComboInfo:
							'''
							Nhấn <left> để thực hiện chuỗi 5 nhát chém, kết thúc bằng việc ném lưỡi kiếm
							Thả nút khi lưỡi kiếm đang bay sẽ gây thêm sát thương
							'''
						ParryInfo:
							'''
							Nhấn <right> để bật hai lưỡi kéo trước mặt
							Đánh trúng kẻ địch sẽ phản đòn, cho bạn bất tử trong thoáng chốc
							You can parry projectiles to make them deal 100 less damage for a short period
							Có thể phản đòn đạn để giảm 100 sát thương của chúng trong thời gian ngắn
							'''
					}

					AstralPike: {
						DisplayName: Thương Tinh Tú
						Tooltip: Triệu hồi bầy sao tinh tú khi đánh trúng và gây [cbuff:CalamityMod/AstralInfectionDebuff]
					}

					AstralScythe: {
						DisplayName: Lưỡi Hái Tinh Tú
						Tooltip: Bắn ra vòng lưỡi hái tăng tốc theo thời gian và gây [cbuff:CalamityMod/AstralInfectionDebuff]
					}

					Ataraxia: {
						DisplayName: Ataraxia
						Tooltip: Sự tĩnh lặng tuyệt đối
					}

					Avalanche: {
						DisplayName: Tuyết Lở
						Tooltip:
