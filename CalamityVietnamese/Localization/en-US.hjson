						DisplayName: Lacerator
						Tooltip:
							'''
							{$Common.YoyoStatsInfinite}
							Đánh trúng kẻ địch sẽ triệu hồi một lưỡi cưa máu để xé nát chúng
							Lưỡi cưa gây nhiều sát thương hơn khi yo-yo đánh trúng càng nhiều lần, và sẽ biến mất khi không đánh trúng kẻ địch
							Kẻ địch chạm vào rìa lưỡi cưa sẽ bị xé ra các quả cầu máu
							Nhặt các quả cầu máu này sẽ giảm thời gian của [cbuff:PotionSickness]
							Hướng quay của lưỡi cưa phụ thuộc vào hướng bạn ném yo-yo ban đầu
							[GFB]
							'''
						TooltipNormal: Đã từng có người nghĩ thứ này dùng đánh DoG được đấy lol
						TooltipGFB: Có lẽ dùng đánh DoG cũng ổn...
					}

					LifehuntScythe: {
						DisplayName: Lifehunt Scythe
						Tooltip: Hồi máu khi đánh trúng và bắn ra lưỡi hái năng lượng
					}

					Lightspeed: {
						DisplayName: Lightspeed
						Tooltip:
							'''
							[c/c7f5ff:Tung ra loạt đòn đâm nhanh, tích lũy Elemental Mastery khi đánh trúng]
							[c/c2fff2:Elemental Mastery sẽ mất dần theo thời gian nhưng tạm ngừng giảm khi đạt tối đa]
							[c/ffdfba:Nhấn <right> khi Elemental Mastery tối đa để lao tới con trỏ]
							[c/ffc7c7:Đánh trúng kẻ địch khi đang lao sẽ hoàn lại một phần Elemental Mastery]
							'''
