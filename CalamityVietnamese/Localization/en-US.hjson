					CindersOfLament: {
						DisplayName: Cinders of Lament
						Tooltip:
							'''
							Triệu hồi Cataclysm hoặc Catastrophe tại vị trí con trỏ
							Chúng sẽ nhìn bạn một lúc trước khi lao vào bạn
							Chúng có thể gây sát thương cho cả bạn và kẻ địch
							'''
						Calamitas:
							'''
							'Anh em của ta đã chết ở Azafure. Ta tìm thấy thi thể của họ gần trung tâm thành phố sau khi họ rời đi thám hiểm.
							Trước khi sức mạnh của ta đạt đến như bây giờ, họ luôn ở bên cạnh và không cho bất kỳ ai làm hại ta.
							Đôi khi điều đó cũng gây rắc rối, nhưng họ lại rất ngoan ngoãn.
							Và ngay cả sau tất cả những gì đã xảy ra, ngay cả khi đã chết, họ vẫn trông chừng ta. Thật ngọt ngào phải không?'
							'''
					}

