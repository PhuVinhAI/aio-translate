					CometQuasher: {
						DisplayName: Comet Quasher
						Tooltip: Triệu hồi bầy thiên thạch từ trên trời khi đánh trúng kẻ địch
					}

					CosmicDischarge: {
						DisplayName: Cosmic Discharge
						Tooltip:
							'''
							Đánh trúng kẻ địch bằng roi sẽ gây ra các vụ nổ băng giá và cho người chơi buff Đóng Băng Vũ Trụ
							Buff này cho +2 hồi máu/giây khi đứng yên và đóng băng kẻ địch gần bạn
							'''
					}

					CosmicShiv: {
						DisplayName: Dao Găm Vũ Trụ
						Tooltip:
							'''
							Bắn ra một ngôi sao vũ trụ tự truy đuổi kẻ địch
							Khi trúng địch, một loạt lưỡi dao sẽ liên tục tấn công
							Càng trúng nhiều sao thì càng nhiều lưỡi dao xuất hiện
							'''
					}

					CrescentMoon: {
						DisplayName: Trăng Lưỡi Liềm
						Tooltip:
							'''
							Ném ra một chùy mặt trăng phóng ra các mặt trăng tự truy đuổi tại điểm cao nhất của quỹ đạo
							Giữ <left> để xoay chùy quanh người, tạo ra Starburst
							Khi có 20 Starburst, giữ <left> lần nữa sau khi ném để kích nổ chùy
							Thay vì phóng mặt trăng, vụ nổ này sẽ triệu hồi Scorpius gây sát thương cực lớn và gây [cbuff:CalamityMod/Voidfrost]
							'Sự điên loạn sinh ra từ thiên tài'
							'''
					}

					DarklightGreatsword: {
						DisplayName: Đại Kiếm Hắc Quang
						Tooltip: Bắn ra các lưỡi kiếm hắc quang cắt xuyên kẻ địch và tạo thêm các vết chém
					}

					DeathsAscension: {
						DisplayName: Death's Ascension
						Tooltip:
							'''
							Thực hiện các nhát chém cường lực thấm đẫm linh hồn tạo ra một khe nứt với các lưỡi hái xoay quanh khi đánh trúng
							Nhấn <right> để phóng ra loạt lưỡi hái tự truy đuổi
							Khe nứt sẽ bắn lưỡi hái cùng bạn
							'một thứ vũ khí thật vừa tay...
							[c/660066:Nhưng đôi tay đang cầm nó không phải của bạn']
							'''
					}

					DefiledGreatsword: {
						DisplayName: Đại Kiếm Ô Uế
						Tooltip: Bắn ra các lưỡi kiếm hỏa diệm, hyper và ánh dương
					}

					DepthCrusher: {
						DisplayName: vực thẳm nghiền nát
						Tooltip:
							'''
							Ném ra một chùy vực sâu nặng nề giải phóng năng lượng nước khi chạm địa hình
							Chùy sẽ dội lại khỏi địa hình và kẻ địch
							'''
					}

					DevilsDevastation: {
						DisplayName: Devil's Devastation
						Tooltip:
							'''
							Ném ra lưỡi kiếm quỷ xuyên, thiêu đốt và làm chậm kẻ địch
							Tối đa năm lưỡi kiếm có thể ghim vào một kẻ địch, các đòn tiếp theo sẽ bắn ra những lưỡi kiếm đã ghim trước đó
							Nhấn <right> để vào thế đứng, cho phép dùng <left> tung ra một nhát chém hủy diệt khổng lồ
							Khi ở trong thế đứng, bạn hồi máu và thời gian bay, đồng thời dash hồi nhanh hơn
							Nhát chém hủy diệt cần thời gian hồi sau khi dùng
							Đánh trúng kẻ địch đang bị ghim bằng nhát chém hủy diệt sẽ bắn ra toàn bộ lưỡi kiếm và sẵn sàng cho nhát chém tiếp theo
							Kẻ địch cuối cùng trúng nhát chém hủy diệt sẽ bị đánh dấu tử vong
							Khi rời thế đứng, dấu tử vong sẽ phát nổ gây sát thương khổng lồ
							'''
						HoldShiftTooltip:
							'''
							[c/d13ca2:Lưỡi kiếm hoàn hảo của Địa Ngục, trực tiếp điều khiển sức mạnh Lưu Huỳnh.]
							[c/d13ca2:Loài người gọi sức mạnh này là Hỗn Diệt, sự phá vỡ mọi trật tự trong biển lửa.]
							[c/d13ca2:Có lẽ vì thế mà Brimstone Elemental sở hữu sức mạnh vượt trội so với các chị em của mình.]
							'''
					}

					DevilsSunrise: {
						DisplayName: Bình Minh của Ác Quỷ
						Tooltip:
							'''
							Tung ra chuỗi chém dồn dập mang sức mạnh quỷ dữ
							Năng lượng địa ngục tích tụ trong lưỡi kiếm theo thời gian, tăng nhanh khi đánh trúng kẻ địch
							Nhấn <right> khi năng lượng đầy để ném các lưỡi kiếm xoay về phía con trỏ
							Lưỡi kiếm xoay sẽ cắm vào kẻ địch đầu tiên và liên tục chém chúng, hút sinh lực của chúng
							'Balls? Smalls.'
							'''
					}

					DraconicDestruction: {
						DisplayName: Hủy Diệt Long Tộc
						Tooltip:
							'''
							Bắn ra sóng kiếm rồng phát nổ thành nhiều tia khác
							Các tia phụ bay lên xuống xé nát kẻ địch
							'''
					}

					DragonPow: {
						DisplayName: Dragon Pow
						Tooltip:
							'''
							Bắn ra đầu rồng phóng tia lửa rồng
							Triệu hồi mưa cánh hoa và thác nước khi đánh trúng kẻ địch
							'''
					}

					DragonRage: {
						DisplayName: Cuồng Nộ Rồng
						Tooltip:
							'''
							Xoay gậy gây nổ khi đánh trúng kẻ địch
							Mỗi mười lần đánh sẽ triệu hồi vòng cầu lửa
							'''
					}

					DriftwoodSword: {
						DisplayName: Kiếm Gỗ Trôi
						Tooltip: Thanh kiếm này mạnh hơn khi bạn đang ướt
					}

					Earth: {
						DisplayName: Earth
						Tooltip:
							'''
							Một lưỡi kiếm lăng kính tuyệt đẹp với sức mạnh cận chiến vô song
							Hồi rất nhiều máu khi đánh trúng
							Mỗi nhát chém thứ hai sẽ triệu hồi ba thiên thạch Gaia rơi xuống kẻ địch gần đó
							'Tất cả tạo vật của Người sẽ biết đến vẻ đẹp và cơn thịnh nộ của đấng sáng tạo'
