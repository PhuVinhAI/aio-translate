					TemporalUmbrella: {
						DisplayName: Temporal Umbrella
						Tooltip:
							'''
							Triệu hồi nhiều công cụ hỗ trợ bạn trong chiến đấu:
								- Một mũi tên đỏ thẫm xuyên qua kẻ địch
								- Một chiếc búa marmalade đập kẻ thù thật phong cách
								- Một chiếc rìu ngọc bích chém quái vật và đôi khi chặt cây
								- Một chiếc ô lam đánh bại kẻ thù đầy tao nhã
								- Một khẩu súng trường lavender bắn tỉa những kẻ cản đường bạn
							Tuyệt nhất là bạn còn được đội một chiếc mũ chóp
							Yêu cầu 5 ô lính triệu hồi và chỉ có thể tồn tại một bộ công cụ
							'Khá chắc chắn đấy, tôi cá nó có thể hạ gục cả Mafia chỉ với một đòn'
							'''
					}

					TundraFlameBlossomsStaff: {
						DisplayName: Tundra Flame Blossoms Staff
						Tooltip:
