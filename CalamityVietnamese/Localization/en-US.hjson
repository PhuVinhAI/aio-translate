							Dùng máu của bạn làm đạn
							20% cơ hội không tốn máu
							'''
					}

					BlossomFlux: {
						DisplayName: Blossom Flux
						Tooltip:
							'''
							Bắn dòng lá
							Nhấn <right> để bắn quả cầu bào tử nổ thành đám mây khí bào tử
							'''
						LegendaryText:
							'''
							'...Ta hiểu rồi... Con cái của ta quá sợ hãi Godseeker đến mức chúng xúc phạm cái chết để tạo ra một kẻ canh gác mang hình dáng của ta.
							Ta xin lỗi. Ta đã không nhìn thấu trái tim các ngươi. Sự tuyệt vọng mà ta gây ra...
							Ta đáng lẽ phải lường trước hậu quả của việc lấy đi người bảo hộ của các ngươi.
							Nhưng các ngươi sẽ không còn bị bỏ rơi nữa.
							Hãy nghe ta, hỡi thú hoa. Nhân danh ta, đừng tàn phá nơi này nữa, hãy canh giữ ngôi nhà và ký ức của những người từng sống ở đây.
							Hãy dẫn truyền toàn bộ sức mạnh của tán rừng và những linh hồn đã chết trong ngươi,
							để không Godseeker nào, thấp hay cao, có thể xâm phạm vùng đất này.
							Bảo vệ nó cho đến tia nắng cuối cùng, để vị anh hùng của ta vẫn còn một nơi gọi là nhà.'
							'''
					}

					BrimstoneFury: {
						DisplayName: Brimstone Fury
						Tooltip: Chuyển mũi tên gỗ thành loạt 3 tia brimstone
					}

