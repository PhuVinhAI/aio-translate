					GoldplumeSpear: {
						DisplayName: Goldplume Spear
						Tooltip: Bắn ra những chiếc lông vũ rơi từ trên cao
					}

					GrandDad: {
						DisplayName: Grand Dad
						Tooltip: "[GFB]"
						TooltipNormal:
							'''
							Một lưỡi kiếm nặng đến khó tin, xé toạc kẻ địch bằng chính khối lượng khổng lồ của nó
							Hồi máu khi đánh trúng
							Đánh trúng kẻ địch yếu hơn sẽ phóng chúng đi với lực cực lớn
							Kẻ địch bị phóng sẽ chịu sát thương khổng lồ khi va vào tường hoặc mặt đất
							Giữ <right> khi vung kiếm sẽ giảm mạnh sát thương của lưỡi kiếm nhưng tăng lực và tốc độ phóng
							[c/00B8DF:'Làm sao bạn có thể vung thứ nặng bằng nửa khối lượng của một ngôi sao vậy?']
							'''
						TooltipGFB:
							'''
							Một lưỡi kiếm chất lượng cao có thể xé toạc kẻ địch
							Đánh trúng kẻ địch yếu sẽ hất văng chúng với lực khủng khiếp, thường khiến chúng bị kẹt trong khối
							Kẻ địch bị hất sẽ biến thành JAM khi ĐẬP mạnh vào tường hoặc mặt đất
							Giữ <right> khi vung kiếm sẽ giảm mạnh sát thương nhưng tăng sát thương và tốc độ hất văng, quá đã >:
							[c/00B8DF:'Hãy đọc mô tả vũ khí đi.']
							'''
					}

