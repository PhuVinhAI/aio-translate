					AresExoskeleton: {
						DisplayName: Ares' Exoskeleton
						Tooltip:
							'''
							Tạo một bảng với bốn ô và bốn lựa chọn phía trên: Plasma, Tesla, Laser và Gauss
							Nhấp vào một lựa chọn rồi nhấp vào một ô để triệu hồi pháo tương ứng
							Nhấp vào ô đã có pháo sẽ phá hủy pháo đó và làm trống ô
							Mỗi khẩu pháo chiếm 3 slot minion
							'''
					}

					AtlasMunitionsBeacon: {
						DisplayName: Atlas Munitions Beacon
						Tooltip:
							'''
							[c/F2B629:{$CommonItemTooltip.Sentry}]
							[c/F2B629:Triệu hồi một khẩu pháo cố định chạy bằng năng lượng exo]
							[c/F2B629:Khẩu pháo sẽ bắn kẻ địch trong phạm vi]
							[c/F27049:Nếu kẻ địch ở quá gần, nó sẽ kích hoạt Overdrive]
							[c/F27049:Trong Overdrive khẩu pháo dùng toàn bộ sức mạnh để tiêu diệt mọi kẻ địch]
							[c/F27049:Trong Overdrive khẩu pháo sẽ tích nhiệt và cuối cùng bị quá nhiệt]
							[c/69F0DC:Nhấn <right> khi cầm vật phẩm này để nhấc khẩu pháo lên và tự sử dụng]
							[c/69F0DC:Khi được cầm, khẩu pháo luôn ở trạng thái Overdrive]
							[c/69F0DC:Nếu pháo quá nhiệt khi bạn đang cầm, bạn sẽ buộc phải thả nó]
							[c/9AA4AE:Nhấn <right> để chủ động thả nó xuống]
							[c/9AA4AE:Nếu thả gần bệ, nó sẽ tự động gắn lại]
							'Nhấc nó lên dễ hơn bạn tưởng'
							'''
					}

					BelladonnaSpiritStaff: {
						DisplayName: Belladonna Spirit Staff
