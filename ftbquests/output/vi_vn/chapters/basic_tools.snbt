{
	quest.03E05018D64DDEE1.quest_desc: ["&eCấp 5&r về cơ bản chỉ dành cho quặng Allthemodium, không còn nhiều thứ khác."]
	quest.03E05018D64DDEE1.title: "&eCấp khai thác 5"
