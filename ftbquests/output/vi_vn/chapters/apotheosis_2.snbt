{
	quest.0D6D45DBA64E612D.quest_desc: [
		"Thời gian sinh quái tối đa là khoảng thời gian có thể mất để sinh quái. Giống như Tối thiểu, nó có thể từ 20 đến 32,767. Mỗi Đồng hồ làm thay đổi tốc độ của máy sinh quái thêm 10. Tốc độ được tính bằng tick, trong đó 20 tick bằng 1 giây. Vì vậy, thời gian sinh quái nhanh nhất có thể là 1 giây giữa mỗi lần."
	]
	quest.0D6D45DBA64E612D.title: "Thời gian sinh quái tối đa"
	quest.0E02CE4469FCA4C9.quest_desc: [
		"Kích hoạt bằng Đá đỏ cung cấp cho máy sinh quái của bạn một công tắc bật/tắt. Nếu không có nguồn Đá đỏ, nó sẽ không sinh quái."
	]
	quest.0E02CE4469FCA4C9.title: "Kích hoạt bằng Đá đỏ"
	quest.0F89BFD4A3F63A48.quest_desc: [
		"Một số quái vật (hầu hết là quái vật) cần một số Mức độ ánh sáng nhất định để sinh. Quái vật hung tính cần mức thấp hơn, còn quái vật hiền tính cần mức cao hơn. Sử dụng Đèn linh hồn giúp bạn không phải lo lắng về Mức độ ánh sáng vì nó bỏ qua chúng! Điều này không bỏ qua các yêu cầu khác để sinh, như động vật nhà mái cần cỏ."
	]
	quest.0F89BFD4A3F63A48.title: "Bỏ qua ánh sáng"
	quest.167E1474644C9908.quest_desc: [
		"Thạch anh làm điều ngược lại so với vật phẩm kia đối với Máy sinh quái. Khi có Thạch anh trong tay trái và vật phẩm chỉnh sửa Máy sinh quái khác ở tay phải, nó sẽ làm ngược lại vai trò của nó. Với Thạch anh và Cây Đom đóm thay vì tăng Phạm vi sinh, nó sẽ giảm nó. Với Thạch anh và Nước mắt Ma, nó sẽ giảm Số lượng tối đa."
	]
	quest.167E1474644C9908.title: "Ngày ngược lại"
	quest.186593EBCE3FE8D8.quest_desc: [
		"Phạm vi sinh là khu vực nơi quái vật có thể sinh. Khu vực càng lớn, càng nhiều chỗ để chúng sinh. Khu vực càng nhỏ, nhà máy càng rẻ."
	]
	quest.186593EBCE3FE8D8.title: "Phạm vi sinh"
	quest.18E0F5A78F696FA3.quest_desc: [
		"Mảnh Echo mang lại hiệu ứng đặc biệt cho máy sinh quái. Các sinh vật được sinh ra sẽ có lượng rơi rớng nhân đôi."
	]
	quest.18E0F5A78F696FA3.title: "Vọng âm"
	quest.1AD87CB3226ED224.quest_desc: [
		"Len chỉ làm một việc duy nhất với máy sinh quái là làm nó im lặng. Không thích nghe tiếng ồn ngớ ngẩn của máy sinh quái? Hãy dùng Len! Bất kỳ màu nào, số sợi hay kiểu dáng!"
	]
	quest.1AD87CB3226ED224.title: "Im nào, bạn sẽ đánh thức các sinh vật mất!"
	quest.2FE4B7B70D90A455.quest_desc: [
		"Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2cộng tác viên cộng đồng&r để sử dụng trong các modpack AllTheMods."
		""
		"Vì tất cả các modpack &6AllTheMods&r đều được cấp phép theo &eAll Rights Reserved&r, nhiệm vụ này không được phép sử dụng trong bất kỳ modpack công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng."
		""
		"Nhiệm vụ này được cố ý ẩn, nếu bạn thấy điều này, bạn đang ở chế độ chỉnh sửa."
	]
	quest.30EB438C66324213.quest_desc: [
		"Ngôi sao Nether sẽ làm những gì mảnh Prismarine làm nhưng tốt hơn nhiều. Người chơi không còn cần phải ở gần máy sinh quái. Chỉ cần khối của nó được tải, nó sẽ sinh ra."
	]
	quest.30EB438C66324213.title: "Bỏ qua người chơi"
	quest.310969B8FE0A94DE.quest_desc: [
		"Một thay đổi game khác mà Apotheosis mang lại là cho máy sinh quái. Nhớ là bạn có thể khai thác máy sinh quái bằng Lụa chạm? Vâng, nó đã trở lại nhờ Apotheosis! Cũng có nhiều chỉnh sửa mới bạn có thể thêm vào máy sinh quái bằng cách nhấp chuột phải vào bất kỳ vật phẩm nào trong số này."
	]
	quest.310969B8FE0A94DE.title: "Máy sinh quái Apothic"
	quest.3E2A411FF5B4B0E7.quest_desc: [
		"Phạm vi kích hoạt là khoảng cách người chơi (bạn) phải ở gần máy sinh quái để nó hoạt động. Khoảng cách thấp nhất là cách 1 khối và cao nhất là bán kính 48 khối."
	]
	quest.3E2A411FF5B4B0E7.title: "Phạm vi kích hoạt"
	quest.40096ED0B04C3EC5.quest_desc: [
		"Điều cần thiết cho mọi Spawner. Khi nó nói bỏ qua tất cả điều kiện, nó có nghĩa là hầu hết. Bỏ qua mức độ ánh sáng, các khối cần để sinh ra, và các sinh vật. Tuy nhiên, điều kiện về không gian vẫn cần, ví dụ như Slime cần khu vực 3x3 để sinh, và người chơi cũng cần ở gần."
	]
	quest.40096ED0B04C3EC5.title: "Bỏ qua tất cả điều kiện"
	quest.42D7C8CD8E6F5CD7.quest_desc: [
		"Khi dùng một Quả Chorus lên Spawner, bạn hút linh hồn của các sinh vật sẽ được sinh ra, chỉ còn lại một xác rỗng của chúng. Các sinh vật sẽ mất toàn bộ AI nên chúng sẽ làm đại khái giống như một Armor Stand. Chúng không thể đánh bạn, không thể dịch chuyển, không thể tự di chuyển. Chúng ngồi đó sẵn sàng để bị giết, thật thú vị!"
	]
	quest.42D7C8CD8E6F5CD7.title: "Không AI"
	quest.4D07B0A4A2E77CDA.quest_desc: [
		"Số lượng tối đa là lượng sinh vật có thể được spawner sinh ra và giữ lại. Nếu nó chỉ là 6 sinh vật tối đa, khi 6 sinh vật đã được sinh ra thì sẽ không sinh thêm cho đến khi chúng chết hoặc di chuyển. Mỗi Ghast Tear làm tăng hoặc giảm nó lên 2 Sinh vật. Tối đa 16 Sinh vật và Tối thiểu 1."
	]
	quest.4D07B0A4A2E77CDA.title: "Số lượng tối đa"
	quest.4F7F8F4ED1CA0550.quest_desc: [
		"Một Lửa trại dùng trên spawner sẽ khiến các sinh vật sinh ra đang bốc cháy. Hoàn hảo cho một miếng Steak ngon."
	]
	quest.4F7F8F4ED1CA0550.title: "Cháy"
	quest.6A497B063CF32A5C.quest_desc: [
		"Một Mắt nhện lên men có thể được dùng để tăng lượng sinh vật CÓ THỂ sinh ra từ một spawner. Các sinh vật được sinh ra là ngẫu nhiên với một Lượng tối đa được xác định bởi số. Nó tăng hoặc giảm 1 cho mỗi mắt, tối đa là 16."
	]
	quest.6A497B063CF32A5C.title: "Số lần sinh"
	quest.6F71FD826C29C31A.quest_desc: [
		"Tính năng này có thể mới với những người quay trở lại từ các phiên bản trước. Khi sử dụng trứng rùa trên máy sinh quái, nó sẽ chỉ sinh ra các phiên bản trẻ con của quái vật bên trong. Tính năng này chỉ hoạt động với các phiên bản trẻ con gốc (Vanilla), không áp dụng với mod."
	]
	quest.6F71FD826C29C31A.title: "Trẻ con"
	quest.7A9AE63998BB41FF.quest_desc: [
		"Để xác định khi nào Máy sinh quái sẽ sinh, nó chọn một số ngẫu nhiên giữa thời gian chờ sinh tối đa và tối thiểu. Thời gian chờ tối thiểu có thể từ 20 đến 32,767. Mỗi viên đường làm thay đổi thời gian chờ tối thiểu lên hoặc xuống 10."
	]
	quest.7A9AE63998BB41FF.title: "Thời gian chờ sinh tối thiểu"
	quest.7F6B66566C211735.quest_desc: [
		"Đá nhũ đá (Dripstone) dùng trên máy sinh quái sẽ giảm máu tối đa của quái vật được sinh ra. Điều này có thể giảm máu của chúng xuống còn 20%"
	]
	quest.7F6B66566C211735.title: "Máu"
	task.39702880D9133E3E.title: "Len"
	task.3B219688DA1CF9C8.title: "Mọi quyền được bảo lưu"
	task.73B56F2139A98F77.title: "Mọi quyền được bảo lưu"
}
