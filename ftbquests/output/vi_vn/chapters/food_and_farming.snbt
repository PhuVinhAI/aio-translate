	quest.28C9EDBF6607E180.quest_desc: [
		"Khối này là một phần của nhà bếp multi-block."
		"Điều này sẽ hiển thị mọi công thức có sẵn cho bạn với thức ăn bạn có trong kho đồ, hoặc được lưu trữ trong nhà bếp multi-block."
		"Cuối cùng bạn cũng có thể tạo một căn nhà bếp đẹp trong Minecraft."
	]
	quest.28C9EDBF6607E180.quest_subtitle: "Betty White sinh ra trước cả Bánh Mì Cắt Lát"
