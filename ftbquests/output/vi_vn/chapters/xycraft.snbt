{
	quest.030AC1AF8F735550.quest_desc: [
		"Để đưa chất lỏng vào Bể, bạn sẽ cần một số loại Ống Dẫn."
		"Máy Bơm Nước (Hydro Pump) có thể tự động đưa Nước vào chúng với tốc độ chậm, và hoàn toàn miễn phí!"
	]
	quest.030AC1AF8F735550.title: "Ống Dẫn"
	quest.06B85804163DD18B.quest_desc: [
		"Soaryn Box (Soaryn là tác giả của XyCraft) là chiếc rương của XyCraft."
		"Nó sẽ không giữ vật phẩm khi khối bị phá hủy! Tôi tự hỏi những ô vuông trên nó làm gì?"
	]
	quest.08E484DD3E751697.quest_subtitle: "Chữ B trong Roy G. Biv"
	quest.08E484DD3E751697.title: "&bNgọc Xychorium xanh"
	quest.0D01524F249E25D7.quest_subtitle: "Ai đã tắt đèn?"
	quest.0D01524F249E25D7.title: "&8Ngọc Xychorium tối"
	quest.15540271BF17C2E4.quest_desc: [
		"&lChào mừng đến với XyCraft!&r\"
		"\"
		"Loạt mod này chủ yếu dành cho XyCraft: World và Machines!\"
		"World cung cấp cho chúng ta các viên ngọc có thể tìm thấy khi đào mỏ."
	]
	quest.15540271BF17C2E4.title: "&lXyCraft"
	quest.16B4A00948D1F60D.quest_desc: [
		"Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2cộng tác viên cộng đồng&r để sử dụng trong các modpack AllTheMods.\"
		"\"
		"Vì tất cả các modpack &6AllTheMods&r được cấp phép theo &eAll Rights Reserved&r, nhiệm vụ này không được phép sử dụng trong bất kỳ modpack công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng.\"
		"\"
		"Nhiệm vụ này được cố ý ẩn, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."
	]
	quest.1E00DBAACDF4404F.quest_desc: [
		"Collector hoạt động như một Absorption Hopper rất rẻ.\"
		"\"
		"Nó sẽ nhặt tất cả các vật phẩm trong bán kính 3 khối và đặt vào kho hàng bên dưới hoặc kho của chính nó. Nó có thể được tắt bằng Redstone!"
	]
	quest.2278A98DCDF713D7.quest_desc: [
		"Bây giờ là lúc làm Tank! Trước tiên bạn cần Building Blocks và ít nhất 1 Valve. Glass và Item IOs là tùy chọn.\"
		"\"
		"Tank phải được làm từ khung bằng building blocks. Building blocks là bất cứ thứ gì không trong suốt, bị ảnh hưởng bởi trọng lực, hoặc là Dirt hoặc Grass tự nhiên.\"
		"\"
		"Các vật phẩm như đá, gỗ, hoặc kim loại phải tạo thành khung và các cạnh. Glass, Valves, và Item IOs phải được đặt trong tường và bên trong phải rỗng.\"
		"\"
		"Nó chỉ có thể lớn tối đa 13x13x13. Khi bạn đã làm xong tất cả, nhấp chuột phải vào Valve và nó sẽ hiển thị 'Đã hình thành' hoặc thông báo vấn đề."
	]
	quest.2278A98DCDF713D7.title: "&lBể chứa"
	quest.2AC7BC448C007BDB.quest_desc: [
		"Củng cố Kivi với Nhôm và bạn sẽ nhận được Khung máy, cần thiết để chế tạo máy móc."
	]
	quest.2B5E14A47062F83C.quest_subtitle: "Chữ R trong Roy G. Biv"
	quest.2B5E14A47062F83C.title: "&cRed Xychorium Gems"
	quest.2C4ECA4F5B1639F4.quest_desc: [
		"Vùng ánh sáng không chiếu sáng nhiều, nhưng nó hoạt động như một Đuốc Khổng lồ.\"
		"\"
		"Quái vật sẽ không xuất hiện trong một khu vực xung quanh nó. Khu vực đó có bán kính khoảng 32 khối."
	]
	quest.2C4ECA4F5B1639F4.title: "&fVùng ánh sáng"
	quest.2C7D62231AD6406A.quest_desc: [
		"XyCraft có một bể chất lỏng khối cực tốt!"
	]
	quest.2C7D62231AD6406A.title: "&bLưu trữ và thao tác chất lỏng"
	quest.355244420EA47546.quest_desc: [
		"Fabricator chính là Máy chế tạo tự động. Nó sẽ lấy vật phẩm từ kho dưới và tạo theo công thức đã định.\"
		"\"
		"Bạn có thể khóa công thức bằng CTRL Click. Tuy nhiên, nó sẽ cần ống để đưa vật phẩm đã tạo ra."
	]
	quest.355244420EA47546.quest_subtitle: "Máy chế tạo tự động"
	quest.39E4FC9BA89E44BC.quest_desc: [
		"Balloon on a Stick là nguồn bay sáng tạo sớm và bị hạn chế.\"
		"\"
		"Đặt cần xuống và bạn sẽ được gắn với một quả bóng bay! Nhấn space hai lần để bắt đầu bay, nhưng đừng đi quá xa. Đi quá xa bạn sẽ bị tách rời và rơi."
	]
	quest.39E4FC9BA89E44BC.quest_subtitle: "Lên!"
	quest.3E970E76372AB094.quest_desc: [
		"Máy gieo hạt tăng tốc (§2Accelerated Planter§r) hoạt động tương tự Đất canh tác thông thường nhưng có một số thay đổi."
		"Nó được tưới nước tự động và nhanh hơn Đất canh tác thông thường."
	]
	quest.3E970E76372AB094.title: "§2Máy gieo hạt tăng tốc"
	quest.3F68BA498E877C8C.quest_subtitle: "Tên đệm của Roy Biv"
	quest.3F68BA498E877C8C.title: "§aNgọc Xychorium Xanh"
	quest.43F08B510FC1C06F.quest_desc: [
		"Cổng Vật phẩm cho phép vận chuyển vật phẩm vào và ra khỏi Bể chứa. Chúng có thể được chuyển đổi giữa chế độ Đầu ra và Đầu vào."
	]
	quest.43F08B510FC1C06F.quest_subtitle: "Nơi vật phẩm đến và đi"
	quest.43F08B510FC1C06F.title: "Cổng Vật phẩm"
	quest.4A92237E17ED5F1C.quest_desc: [
		"Kho chứa Void biến mọi kho đồ thành Thùng rác. Đặt nó lên trên kho đồ và không còn vật phẩm nào nữa!"
	]
	quest.5E1D4169C083ACEF.quest_desc: [
		"Tấm đánh lửa (§cIgnition Plate§r) tạo lửa phía trước nó khi được cấp Tín hiệu Redstone."
		"Nó sẽ dập tắt lửa khi Tín hiệu dừng lại."
	]
	quest.5E1D4169C083ACEF.title: "&cTấm đánh lửa"
	quest.623E6A855B363C8D.quest_desc: [
		"Khối &9Nước&r hoạt động như Nước nhưng không có phần di chuyển.\"
		"\"
		"Máy tạo đá sỏi có thể được làm với chúng, Đất canh tác có thể được tưới bằng nó, bạn chỉ không thể dùng nó để MLG clutch. (Cá cũng sẽ cố gắng vào trong đó nhưng vẫn sẽ chết)."
	]
	quest.623E6A855B363C8D.quest_subtitle: "Nước nhưng rắn, băng?"
	quest.623E6A855B363C8D.title: "&9Khối Nước"
	quest.643FB1A3ED0EA9EC.quest_desc: [
		"Van là trái tim của bể chứa của bạn. Đây là nơi bạn sẽ bơm hoặc dẫn chất lỏng vào nó."
	]
	quest.643FB1A3ED0EA9EC.quest_subtitle: "Nơi chất lỏng đến và đi"
	quest.643FB1A3ED0EA9EC.title: "Van"
	quest.64D0D69ADB8820DA.quest_desc: [
		"&8Khoảng trống chất lỏng&r là một khối ngăn tất cả nước được kết nối với nó.\"
		"\"
		"Các khối nguồn hoặc nước chảy, bất cứ gì trong bán kính 1 khối đều biến mất."
	]
	quest.64D0D69ADB8820DA.title: "&8Khoảng trống chất lỏng"
	quest.69F11A94D44AB5CF.quest_subtitle: "Quá nhiều ánh sáng!"
	quest.69F11A94D44AB5CF.title: "&fNgọc Xychorium nhẹ"
	quest.6D0876A402C22067.quest_desc: [
		"XyCraft có một số kho chứa và thao tác với vật phẩm. Tuy nhiên không nhiều như kho chứa và thao tác với chất lỏng!"
	]
	quest.6D0876A402C22067.title: "&6Kho chứa và thao tác vật phẩm"
	quest.71D133BA3EC6F4FD.quest_desc: [
		"Extrator sẽ \"phát triển\" khối hoặc vật phẩm bên dưới nó và di chuyển chúng vào một kho ở phía trên."
		"Điều này có thể được dùng cho máy phát đá sỏi hoạt động với nhiều loại đá, máy phát Amethyst, hoặc thậm chí máy phát Trứng Rồng, cùng nhiều loại khác!"
	]
	quest.71D133BA3EC6F4FD.quest_subtitle: "Nông trại cho Đá! (Và nhiều hơn)"
	quest.7574A782DCFB87CE.quest_desc: [
		"Kivi có thể được dùng cho một vài việc, chủ yếu cho trang trí và máy móc."
		"Bạn sẽ cần Kivi cho Khung Máy và các máy khác trong XyCraft. Nó có thể được dùng với Ngọc Xychorium trong Stonecutter để tạo các khối trang trí."
	]
	quest.7574A782DCFB87CE.title: "&l&7Kivi"
	task.4EEF358CAC170CC4.title: "Ngọc Xychorium"
	task.55DD09212E3DB168.title: "Ống dẫn chất lỏng"
	task.706FA543A6C675D3.title: "Mọi quyền được bảo lưu"
}
