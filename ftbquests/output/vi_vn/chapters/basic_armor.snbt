	quest.76CDF08465700AA2.quest_subtitle: "Thành phố cổ đại"
	quest.76CDF08465700AA2.title: "Trang trí giáp Silence"
	quest.7B500E0577BDFF8F.quest_desc: ["&6Đồng thau&r là sự kết hợp của &6Đồng&r và Thiếc. \n\n\n\nCó hàng chục cách khác nhau để làm hợp kim, tôi sẽ không nói cho bạn cách đúng để làm."]
	quest.7B500E0577BDFF8F.quest_subtitle: "18"
	quest.7B500E0577BDFF8F.title: "&6Giáp Đồng thau"
	quest.7F11ABFB2E21B7E4.quest_desc: ["Giáp là một phần rất quan trọng của &l&2Minecraft&r, nó bảo vệ bạn khỏi nguy hiểm. \n\n\n\nCác món giáp khác nhau cung cấp Điểm Giáp khác nhau. Chúng là thứ quyết định hiệu quả của Giáp, càng nhiều càng tốt!\n\n\n\nHầu hết giáp có thể được thay đổi để trang trí hơn với Trang trí giáp, hãy dùng một món giáp với một Trang trí giáp, và một vật phẩm để tô màu để thay đổi diện mạo!"]
	quest.7F11ABFB2E21B7E4.title: "&l&bGiáp cơ bản&r"
	quest.7FABB77A60E7962C.quest_desc: ["Bằng cách pha trộn Obsidian với &bKim cương&r chúng ta có thể nhận được Bụi Obsidian tinh chế! \n\n\n\nSau đó, chúng ta có thể nén &7Osmium&r vào đó để có dạng Thỏi. \n\n\n\nSau tất cả, chúng ta có thể biến những Thỏi đó thành Giáp với chỉ số tốt hơn cả &6Allthemodium Armor&r!"]
	quest.7FABB77A60E7962C.quest_subtitle: "31"
	quest.7FABB77A60E7962C.title: "&5Giáp Obsidian tinh chế"
	task.4BDF268861CA744F.title: "Mọi quyền được bảo lưu"
	task.57895147416291FE.title: "Mọi quyền được bảo lưu"
