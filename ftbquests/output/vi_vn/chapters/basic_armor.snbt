	quest.729DCB919A92B735.quest_subtitle: "Phòng Thử Nghiệm"
	quest.729DCB919A92B735.title: "Trang Trí Giáp Bolt"
	quest.72DDA413D73E3235.quest_desc: ["Thống số cao hơn nhiều trong mọi thứ với bộ tiếp theo là &6&lGiáp Allthemodium&r, &3Giáp Vibranium&r! \n\n\n\nBạn sẽ cần &6Giáp Allthemodium&r để tạo ra nó."]
	quest.72DDA413D73E3235.quest_subtitle: "32"
	quest.72DDA413D73E3235.title: "&3Giáp Vibranium"
