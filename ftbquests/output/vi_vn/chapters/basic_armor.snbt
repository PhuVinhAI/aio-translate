	quest.6B671CB07D046BEC.title: "&bKim cương&r"
	quest.6C5F9D0D447EFB9C.quest_desc: ["Bạn nghĩ rằng &l&2Vanilla&r là tất cả những gì chúng ta có sao? \n\n\n\n&6Allthemodium Armor&r có nhiều Điểm Giáp và Độ Bền Giáp hơn, cộng thêm Tăng Cường Bảo Vệ chống lại Phép thuật và các hiệu ứng tăng cường khác mà bạn có thể đọc trong Trang Nhiệm Vụ &6&lAllthemodium&r! \n\n\n\nBTW bạn sẽ cần &cNetherite&r để chế tạo nó."]
	quest.6C5F9D0D447EFB9C.quest_subtitle: "24"
	quest.6C5F9D0D447EFB9C.title: "&6Allthemodium Armor"
	quest.6F76DA3BBAE8337B.quest_desc: ["Bộ giáp tuyệt vời nhất chúng ta có thể lấy từ &6&lAllthemodium&r, &5Unobtainium&r! \n\n\n\nBây giờ với 100% Kháng Đẩy Lùi và chỉ số cao hơn ở mọi nơi! \n\n\n\nCũng cần &3Vibranium Armor&r để chế tạo."]
	quest.6F76DA3BBAE8337B.quest_subtitle: "40"
	quest.6F76DA3BBAE8337B.title: "&5Giáp Unobtainium"
	quest.71C552678A0F649F.quest_desc: ["&7Osmium&r xuất hiện xung quanh Deepslate và chỉ cần Sắt để khai thác nhưng nó có chỉ số tốt hơn &cNetherite&r!"]
	quest.71C552678A0F649F.quest_subtitle: "21"
	quest.71C552678A0F649F.title: "&7Giáp Osmium"
