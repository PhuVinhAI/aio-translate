	quest.28408BFAA54E4FC6.quest_desc: ["&7Bộ áo giáp da&r là bộ áo giáp tệ nhất bạn có thể lấy được. \n\n\n\nĐiều đó chủ yếu là vì &c&lMojang&r dự định bạn lấy nó trước bất kỳ cái nào khác. \n\n\n\nTuy nhiên tôi gần như không bao giờ lấy được vì tôi gặp khó khăn trong việc tìm thấy nhiều &8B&fo&8ò&r, xin lỗi &c&lMojang&r!"]
	quest.28408BFAA54E4FC6.quest_subtitle: "7"
