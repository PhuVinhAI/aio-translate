	quest.17A68C4E9E9EA2B7.quest_desc: ["&eGiáp Vàng&r nằm đúng giữa Giáp Sắt và &7Giáp Da&r. Nhưng độ bền của nó gần với &7Giáp Da&r hơn. \n\n\n\nNó không có nhiều công dụng ngoài việc làm cho Piglins trung lập với bạn khi đeo một chút &eGiáp Vàng&r."]
	quest.17A68C4E9E9EA2B7.quest_subtitle: "11"
	quest.17A68C4E9E9EA2B7.title: "&eÁo giáp vàng"
	quest.1C27C74722A19FC1.quest_desc: ["Với một lượng lớn các vật phẩm siêu đắt của &l&5Mekanism&r, bạn có thể nâng cấp &5Unobtainium Armor&r lên &aMekaSuit&r! \n\n\n\nBây giờ nó có thể chứa Năng lượng và thay vì mất máu (trái tim) khi bị tổn thương, nó sẽ tiêu hao Năng lượng. \n\n\n\nBạn có thể sử dụng Upgrade Units để làm cho nó tốt hơn nữa!"]
	quest.1C27C74722A19FC1.quest_subtitle: "Cung cấp năng lượng tối đa"
	quest.1C27C74722A19FC1.title: "&aMekaSuit"
