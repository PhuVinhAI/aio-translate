{
	quest.004D61425172324F.quest_desc: ["&8Giáp xích&r có phần kém hơn một chút so với Sắt. Công dụng chính của nó trong &l&2Minecraft&r là tính kỳ bí, chỉ có thể có được qua Giao dịch và Rơi từ Quái vật. \n\n\n\nTất nhiên đây là mod, nên chúng ta có thể chế tạo nó ngay bây giờ! Điều này lấy đi mục đích của nó..."]
	quest.004D61425172324F.quest_subtitle: "12"
	quest.004D61425172324F.title: "&8Giáp xích"
	quest.04B31A600004F7CB.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2Người đóng góp cộng đồng&r để sử dụng trong các Modpack AllTheMods. \n\n\n\nVì tất cả các pack &6AllTheMods&r được cấp phép dưới &eMọi quyền được bảo lưu&r, Nhiệm vụ này không được phép sử dụng trong bất kỳ pack công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng. \n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.074EC1E636CD6605.quest_desc: ["&cGiáp Netherite&r là tốt nhất mà &l&2Vanilla&r có thể có. Nó có cùng Điểm Giáp với &bKim cương&r nhưng nhiều Độ bền Giáp hơn. \n\n\n\nCó lẽ vì bạn cần &bKim cương&r để chế tạo nó!"]
	quest.074EC1E636CD6605.quest_subtitle: "20"
	quest.074EC1E636CD6605.title: "&cGiáp Netherite"
	quest.0ED11FCF6298CE85.quest_desc: ["&e&lPhép thuật Sắt&r &4Giáp Máu&r!"]
	quest.0ED11FCF6298CE85.quest_subtitle: "20"
	quest.0ED11FCF6298CE85.title: "&4Trang phục Cultist"
