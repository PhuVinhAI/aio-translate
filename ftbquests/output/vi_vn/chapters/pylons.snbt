{
	quest.011F787E620DE9E8.quest_desc: [
		"Để thiết lập Bộ Lọc Quái Vật, bạn chỉ cần nhấp vào quái vật bạn không bao giờ muốn thấy lại, bằng Bộ Lọc Quái Vật."
		""
		"Mỗi Bộ Lọc chỉ có thể chứa 1 quái vật, vì vậy nếu bạn muốn Zombie, Skeleton, Spider, Creeper và Enderman không xuất hiện nữa, bạn sẽ cần 5 Bộ Lọc Quái Vật."
		""
		"Bạn có thể thay đổi quái vật trong đó bằng cách đơn giản nhấp vào một quái vật khác bằng nó."
	]
	quest.011F787E620DE9E8.quest_subtitle: "Hắn không được mời!"
	quest.034A9FBCA6D79BB6.quest_desc: [
		"Cột thu hoạch cần một chiếc cuốc để hoạt động. \"
		"\"
		"(Các loại cuốc không thể vỡ sẽ hoạt động vĩnh viễn, các loại cuốc có thể vỡ sẽ cần được thay thế)."
	]
	quest.09D18512037386C1.quest_desc: [
		"Để đặt Hiệu ứng Thuốc vào, bạn cần lấp đầy một Bộ lọc Thuốc. \"
		"\"
		"Để làm vậy: hãy có một Hiệu ứng Thuốc trên người, sau đó nhấp chuột phải với Bộ lọc Thuốc để loại bỏ nó khỏi bạn và thêm vào Bộ lọc, và lặp lại cho đến khi nó được lấp đầy và kích hoạt. \"
		"\"
		"Điều này cũng hoạt động với các Hiệu ứng Thuốc từ mod hoặc những hiệu ứng bạn thường không thể lấy được qua Thuốc như Haste (Tăng tốc) hay Resistance (Kháng)."
	]
	quest.12ED1EE85E146A4B.quest_desc: [
		"Cột thu hoạch hoạt động như một Nông trại tự động rất đơn giản. Đặt Cột lên hoặc trong Nguồn nước và nó sẽ tự động thu hoạch và trồng lại các Cây trồng đã trưởng thành trong khu vực được đặt xung quanh nó. \"
		"\"
		"Khu vực có thể được đặt thành 3x3, 5x5, 7x7, hoặc 9x9 Khối xung quanh Cột. \"
		"\"
		"Nó sẽ cần một Chiếc cuốc để dùng trên các Loài thực vật và sẽ cần một Kho chứa như một cái rương phía trên nó để đặt các Cây trồng. Làm tất cả những điều đó và nếu nó được bật lên, nó sẽ bắt đầu canh tác!\"
		"\"
		"(Hãy cẩn thận khi sử dụng nhiều bộ điều chỉnh với nó như Lilypads (lá sen) hoặc phân bón vì khi nó canh tác rất nhanh, nó có thể trở thành một 'người ăn TPS')."
	]
	quest.18246A48C20B29D8.quest_desc: [
		"Cột truyền thuốc hoạt động tương tự như một Cột đèn hiệu nhưng tốt hơn và rẻ hơn nhiều! \"
		"Khi một Hiệu ứng Thuốc được đặt vào bởi Bộ lọc Thuốc, nó sẽ liên tục cho bạn Hiệu ứng Thuốc trong khi bạn ở trong vùng Chunk được đặt."
	]
	quest.30B0240543253EFB.quest_desc: [
		"Pylons là một mod tuyệt vời được làm bởi chính &aMutant Gumdrop&r của chúng tôi!\"
		"\"
		"Đừng để kích thước của mod khiến bạn đánh giá thấp nó! Nó cung cấp nhiều Cột có thể được dùng cho nhiều việc để giúp chơi Minecraft dễ dàng hơn.\"
		"\"
		"Để bắt đầu, bạn sẽ cần một ít Đá đen mài nhẵn để chế tạo chúng."
	]
	quest.30B0240543253EFB.title: "&lCột"
	quest.32E52AD6EF194A60.quest_desc: [
		"Cột trục xuất hoạt động như một cách để giữ người khác ra khỏi bãi cỏ của bạn. \"
		"\"
		"Khi được đặt xuống, nó sẽ giữ mọi Người chơi không nằm trong danh sách trắng khỏi một số lượng Chunk được đặt xung quanh nó. \"
		"\"
		"Các Chunk được đặt trong GUI của nó ở góc trái trên từ 1x1, 3x3, hoặc 5x5 Chunk. \"
		"\"
		"Ngoài ra, không, nó không thể được đặt quá gần Điểm sinh. Chúng tôi biết các quỷ dữ các bạn muốn gì và chúng tôi sẽ không cho! \"
		"\"
		"Để đưa người chơi vào Danh sách trắng, hãy kiểm tra Nhiệm vụ Bộ lọc Người chơi!"
	]
	quest.32E52AD6EF194A60.quest_subtitle: "Ra khỏi bãi cỏ của tao!"
	quest.403F76908A8A5661.quest_desc: [
		"Cột trục xuất đẩy người chơi ra khỏi khu vực, nhưng nếu bạn muốn &l một số &r người chơi ở gần! Khi đó bạn sẽ cần một Bộ lọc Người chơi. \"
		"\"
		"Nhấp chuột phải vào một Người chơi với nó để đặt họ vào, sau đó đặt nó vào Cột để đưa họ vào Danh sách trắng! \"
		"\"
		"Vì vậy khi mọi người khác bị đẩy ra, bạn bè của bạn sẽ không bị! \"
		"\"
		"Ngoài ra, theo mặc định, Chủ sở hữu của Cột sẽ không bị trục xuất."
	]
	quest.5B5FC539BD1F4A73.quest_desc: [
		"Cột trụ này dùng để chặn Sinh quái. \"
		"\"
		"Bạn có thể dùng Bộ lọc Quái vật để chặn chỉ một số loại Quái vật nhất định, hoặc dùng Bộ lọc Vô sinh để chặn mọi Sinh quái! \"
		"\"
		"Bạn có thể xếp chồng nhiều Bộ lọc Quái vật để chặn thêm nhiều loại. Hơn nữa, bạn có thể thay đổi Khu vực Làm việc để quy định phạm vi chặn Sinh quái. \"
		"\"
		"Nếu dùng Bộ lọc Vô sinh, nó sẽ bỏ qua tất cả các thiết lập đó."
	]
	quest.5C2C29ECA67F9B49.quest_desc: [
		"Với Bộ lọc Vô sinh, bạn sẽ không bao giờ phải lo lắng về bất kỳ Sinh quái nào trong khu vực 25x25 khối. \"
		"\"
		"Điều đó đủ để bao phủ mọi khoảng cách mà Quái vật sinh ra gần người chơi. Dù là Hung ác hay Hòa bình. \"
		"\"
		"Điều này bao gồm mọi Cấp độ Y, phía trên hoặc phía dưới Cột trụ, vì vậy bạn không còn phải lo việc thắp sáng hang động nữa! \"
		"\"
		"Bộ lọc này không có Danh sách trắng, nó sẽ ngăn chặn mọi Sinh quái."
	]
	quest.5C2C29ECA67F9B49.quest_subtitle: "Cuối cùng cũng được yên tĩnh."
	quest.5E02AE661945306C.quest_desc: [
		"Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2Người đóng góp cộng đồng&r để sử dụng trong các Modpack AllTheMods. \"
		"\"
		"Vì tất cả các pack &6AllTheMods&r được cấp phép theo &eAll Rights Reserved&r, Nhiệm vụ này không được phép sử dụng trong bất kỳ pack công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng. \"
		"\"
		"Nhiệm vụ này cố ý bị ẩn, nếu bạn thấy điều này, bạn đang ở chế độ chỉnh sửa."
	]
	task.35320BB07FB39D05.title: "AllRightsReserved"
	task.59DD89698DBAA215.title: "AllRightsReserved"
	task.616C07AFBAFA7AE4.title: "Cuốc"
}
