{
	quest.001A348054127235.quest_desc: ["&5Budding Amethyst&r có thể hữu ích cho Công thức chế tạo và thậm chí chỉ để Trồng &5Amethyst&r! \n\n\n\nVới một &5Amethyst Block&r, &a60 Eterna&r, giữa &c30% &fvà &c50% Quanta&r, và &550% Arcana&r chúng ta có thể &d&lHòa trộn&r một cái. \n\n\n\nĐể có được tất cả các chỉ số đó, chúng ta có thể sử dụng 15 &4Glowing Hellshelves&r và 4 &2Melonshelves&r."]
	quest.001A348054127235.title: "Chế tạo &5Budding Amethyst"
	quest.0518551637F76C50.quest_desc: ["Để nâng cấp &9Echoing&r, chúng ta sẽ cần một vài Item khác nhau. \n\n\n\nNến, vốn tương đối dễ lấy! Và &9Echo Shards&r... thì chắc chắn không phải... \n\n\n\nCơ hội tốt nhất để lấy chúng là bằng cách Loot một &6Ancient City&r, nhưng bạn có thể Chế tạo chúng với một vài Ritual khác nhau. \n\n\n\n(Hoặc thậm chí sau này với &5Enchanting&r!) \n\n\n\nCác &9Echoing Deepshelves&r sẽ cho rất nhiều &5Arcana&r hơn ở &515%&r! Cùng với việc tăng max &aEterna&r lên &a75&r."]
	quest.0518551637F76C50.title: "&9Echoing Deepshelf"
	quest.0A3C464EF7CDD5F6.quest_desc: ["&4Hellshelves&r là lời giới thiệu về &cQuanta&r, chúng cho &c3% Quanta&r và &a3 Eterna&r. \n\n\n\nTốt hơn kệ thường đúng không? \n\n\n\nBạn sẽ muốn 16 cái cho bước tiếp theo, 15 &4Hellshelves&r xung quanh &5Enchantment Table&r, với 1 cái trong Túi đồ của bạn. \n\n\n\nLàm 11 cái đầu tiên và tôi sẽ cho bạn 5 &4Hellshelves&r cuối!\n\n{image:atm:textures/questpics/apothic/enchant_hellshelf.png width:100 height:100 align:center}"]
	quest.0A3C464EF7CDD5F6.title: "&4Hellshelves"
	quest.0F3A0A4DC18E5E55.quest_desc: ["&aEterna&r thiết lập &5Enchantment Level&r, quyết định &5Enchantments&r nào bạn có thể hoặc sẽ nhận được! \n\n\n\nMặc định là &a0&r và tối đa là &a50&r. \n\n\n\nGần như tất cả &7Bookshelves&r sẽ cho &aEterna&r nhưng mỗi cái có giới hạn tối đa chúng có thể thiết lập."]
	quest.0F3A0A4DC18E5E55.title: "&aEterna"
	quest.105442DA79829777.quest_desc: ["Với 8 &7Books&r và một Đe, chúng ta có thể làm &8Tome of Scrapping&r. Thực tế là 8 cái, nhưng bạn hiểu ý rồi! \n\n\n\nBằng cách kết hợp một Item với &8Tome&r trong Đe, chúng ta có thể lấy một nửa &5Enchantments&r khỏi Item. \n\n\n\nĐiều này sẽ khiến Item bị vỡ và mất hiệu lực sau khi hoàn thành. Tôi không khuyên dùng nó, thay vào đó bạn nên nâng cấp nó!"]
	quest.105442DA79829777.quest_subtitle: "Lấy một nửa phép, làm vỡ Item"
	quest.105442DA79829777.title: "&8Sách Phế Liệu"
	quest.148A33CC36B2563A.quest_desc: ["Kệ Rồng (&dDraconic Shelf&r) là Kệ cuối cùng chúng ta cần để có bộ hoàn hảo. \n\n\n\nNó có thể chỉ cho &aEterna&r nhưng lại có lượng &aEterna&r tối đa là &a100&r. \n\n\n\nĐể chế tạo nó, chúng ta cần 5 &3Hạt Ender&r và 1 &dĐầu Rồng&r. Đó là điều khiến nó &dDraconic&r! \n\n\n\nĐể lấy chúng, bạn có thể dùng &a&lMA&r hoặc tìm thấy chúng trên &dTàu End&r. &dTàu End&r là Cấu trúc trong &d&lThe End&r, ở mũi (phía trước) là &dĐầu Rồng&r."]
	quest.148A33CC36B2563A.title: "&dKệ End Rồng"
	quest.158F872A3A2C3650.quest_desc: ["Bây giờ chúng ta đã có lượng &aEterna&r tối đa là &a80&r, chúng ta có thể bắt đầu &d&lHòa Trộn&r &dHơi Thở Rồng&r! \n\n\n\n&dHơi Thở Rồng&r có thể được thu thập khi chiến đấu với &d&lEnder Dragon&r. Khi nó đậu trên tổ của mình, nó có thể phun một làn &dHồng&r sương mù về phía bạn. Khi ở trong làn sương đó, bạn có thể Nhấp Chuột Phải với một Chai Trống, để thu thập &dHơi Thở Rồng&r! \n\n\n\nCách tốt nhất để có được Cấp độ của chúng ta là với 4 &9Kệ Sculk Vang Dội&r, 4 &9Kệ Sculk Chạm Hồn&r, và 6 &6Kệ Sách Bọc Đá Geode Của Sự Ổn Định&r. \n\n\n\nChúng sẽ cho chúng ta &a80 Eterna&r, &c25% Quanta&r và &5100% Arcana&r. Hoàn hảo cho &d&lHòa Trộn&r!"]
	quest.158F872A3A2C3650.title: "&dHơi Thở Rồng Đã Hòa Trộn"
	quest.1873205CF5247E3E.quest_desc: ["Kệ Sách cuối cùng và vĩ đại nhất trong số &7Kệ Sách&r, &dKệ End&r! \n\n\n\nChúng được tạo ra từ 6 &eGạch Đá End&r, 1 &3Hạt Ender&r, 1 &7Kệ Sách&r, và tất nhiên là &dHơi Thở Rồng Đã Hòa Trộn&r. \n\n\n\nChỉ số của chúng hiện tại không phải là tốt nhất, chỉ cho 5 cho mỗi chỉ số. Nhưng lượng &aEterna&r tối đa &a90&r của chúng là khủng khiếp! \n\n\n\nỒ đúng rồi, hơn nữa chúng có thể được Chế Tạo với các Item khác để nâng cấp chúng!\n\n{image:atm:textures/questpics/apothic/enchant_endshelf.png width:100 height:100 align:center}"]
	quest.1873205CF5247E3E.title: "&dKệ End"
	quest.191A7F3C9FBA4C13.quest_desc: ["Chúng ta có thể Chế Tạo &bKệ Biển Đã Hòa Trộn&r với &bTinh Thể Prismarine&r để có được &bKệ Biển Pha Lê&r. \n\n\n\n&bKệ Biển Pha Lê&r sẽ giữ nguyên &a5 Eterna&r, &55% Arcana&r, và giờ có thêm &c3% Quanta&r. \n\n\n\nVới 12 cái, chúng ta có thể đủ Cấp độ để &d&lHòa Trộn&r &9Kệ Đá Sâu Đang Ngủ&r thành &9Kệ Đá Sâu&r thông thường!"]
	quest.191A7F3C9FBA4C13.title: "&bKệ Biển Pha Lê"
	quest.1FAFDB20F504688E.quest_desc: ["&5Phép Thuật&r có một vài thay đổi với &5&lApotheosis&r. \n\n\n\nTóm lại, 15 &7Kệ Sách&r sẽ không đủ nữa. \n\n\n\nCó những Kệ Sách mới và hành động bạn có thể thực hiện với &5Bàn Phép Thuật&r bây giờ và hy vọng những nhiệm vụ này sẽ giúp bạn hiểu."]
	quest.1FAFDB20F504688E.title: "&5&lApothic Phép Thuật"
	quest.224716A537F2FFA0.quest_desc: ["&8Sách Giáp&r được dùng để nhận &5Phép Thuật&r chỉ dùng trên Giáp. Tất cả &8Sách&r có thể nhận &5Bảo vệ&f, &5Bảo vệ nổ&f, và &5Bảo vệ lửa&r. \n\n\n\nMỗi loại còn cho phép dành riêng cho một phần Giáp. Giày sẽ cho &5Bước Đáy&r và Mũ sẽ cho &5Ưa Thích Nước&r. \n\n\n\nNếu bạn muốn cơ hội tốt nhất chỉ cho &5Bảo vệ&r, hãy thử &8Sách Giáp Ngực&r!"]
	quest.224716A537F2FFA0.title: "&8Sách Giáp"
	quest.235E3C386E8D36A3.quest_desc: ["Đây là nơi sự phân tách giữa &4Kệ Địa Ngục&r và &bKệ Biển&r kết thúc! \n\n\n\nTrước tiên, chúng ta cần Chế tạo một &9Kệ Đá Sâu Ngủ Đông&r. Chúng chỉ là 6 &8Gạch Deepslate Nứt&r và 3 &7Sách&r. \n\n\n\nSau đó, chúng ta cần &a60 Eterna&r, &c40% Quanta&r, và &540% Arcana&r. Chúng ta có thể lấy được với 12 &bKệ Biển Pha Lê&r hoặc 12 &4Kệ Địa Ngục Phát Sáng&r! \n\n\n\nCuối cùng, chúng ta có thể &d&lHòa Trộn&r &9Kệ Đá Sâu Ngủ Đông&r của mình thành &9Kệ Đá Sâu thông thường&r!\n\n{image:atm:textures/questpics/apothic/enchant_deepshelf.png width:100 height:100 align:center}"]
	quest.235E3C386E8D36A3.title: "&9Kệ Đá Sâu"
	quest.24391162F4FF0587.quest_desc: ["Với 15 &bKệ Biển&r xung quanh &5Bàn Phép Thuật&r, chúng ta có thể &d&lHòa Trộn&r &bKệ Biển&r cuối cùng của mình! \n\n\n\n&bKệ Biển Đã Hòa Trộn&r cho nhiều &aEterna&r hơn ở mức 5 với tối đa là &a60&r. Ngoài ra còn nhiều &5Arcana&r hơn ở &55%&r. \n\n\n\nChúng có thể được Chế tạo thành các &7Kệ Sách&r khác nhau, loại chúng ta đang tìm, cho &6Phép Thuật Tối Đa&r là &bKệ Biển Pha Lê&r. \n\n\n\nChúng ta cần 12 loại đó, vì vậy chúng ta cần 12 &bKệ Biển Đã Hòa Trộn&r. Chế tạo 8 và tôi sẽ thưởng cho bạn phần còn lại!"]
	quest.24391162F4FF0587.title: "&bKệ Biển Đã Hòa Trộn"
	quest.24C757B8AA6841F6.quest_desc: ["&5&lApotheosis&r biết &3Trident&r có thể khó lấy đến mức nào nên họ đã làm cho dễ hơn... well kinda easier! \n\n\n\nBạn giờ có thể tạo một &3Trident Trơ&r và &d&lHòa Trộn&r nó để có một &3Trident&r bình thường. \n\n\n\n&3Trident&r yêu cầu từ &a40 Eterna&r, &c20%-50% Quanta&r, và ít nhất &535% Arcana&r. \n\n\n\nBạn có thể lấy được điều này với 1 &7Kệ Sách&r, 4 &9Kệ Sculk Vang Dội&r, và 1 &2Kệ Dưa Hấu&r."]
	quest.24C757B8AA6841F6.title: "Làm một &3Trident&r thực sự"
	quest.24FCFF18296ED907.quest_desc: ["Để nâng cấp &9Kệ Đá Sâu&r xa hơn nữa, thật bất ngờ chúng ta không cần &d&lHòa Trộn&r! Thay vào đó chúng ta cần nhiều Chế tạo hơn! \n\n\n\nĐầu tiên, là 5 &3Khối Sculk&r và một &3Catalyst Sculk&r. Cả hai đều có thể tìm thấy trong &9Deep Dark&r và sẽ cần &5Silk Touch&r để thu thập. \n\n\n\nCuối cùng là &9Nhánh Warden&r... đây là vật rơi từ &9&lWarden&r... Đúng vậy, bạn sẽ cần giết &9&lWarden&r. \n\n\n\nMột khi bạn có tất cả, bạn có thể Chế tạo một trong những &7Kệ Sách&r tốt nhất! Một cái cho &a10 Eterna&r, &c15% Quanta&r, và &510% Arcana&r. \n\n\n\nVà quan trọng nhất, cho chúng ta &aEterna&r tối đa là &a80&r! Gần đến 100 rồi!"]
	quest.24FCFF18296ED907.title: "&9Kệ Sculk Linh hồn"
	quest.2EC2FA680076C07D.quest_desc: ["Để nâng cấp &9Kệ Deep&r xa hơn, thật bất ngờ là chúng ta không cần &d&lInfusion&r! Thay vào đó, chúng ta cần nhiều Chế tạo hơn! \n\n\n\nĐầu tiên, là 5 &3Khối Sculk&r và một &3Máy kích hoạt Sculk&r. Cả hai đều có thể tìm thấy trong &9Deep Dark&r và sẽ cần &5Thuật Lụa Chạm&r để thu thập. \n\n\n\nCuối cùng là &9Warden Tendril&r... đây là vật rơi từ &9&lWarden&r... Đúng vậy, bạn sẽ cần giết &9&lWarden&r. \n\n\n\nKhi bạn có tất cả những thứ đó, bạn có thể Chế tạo một trong những &7Kệ sách&r tốt nhất! Một cái cho &a10 Eterna&r, &c10% Quanta&r, và &515% Arcana&r. \n\n\n\nVà quan trọng nhất, cho chúng ta &aEterna&r tối đa là &a80&r! Gần đến 100 rồi!"]
	quest.2EC2FA680076C07D.title: "&9Kệ Sculk Vọng âm"
	quest.31E7F7464D79F881.quest_desc: ["Không chỉ &7Kệ sách&r mới có thể được &d&lInfuse&r!"]
	quest.31E7F7464D79F881.title: "Các vật phẩm &d&lInfusion&r khác"
	quest.377D6CF86BC1C64F.quest_desc: ["&8Sách Tháo dỡ&r sẽ chỉ lấy đi một nửa &5Phép thuật&r, trong khi &8Sách Tháo dỡ Tối thượng&r sẽ lấy mọi &5Phép thuật&r khỏi Vật phẩm! \n\n\n\nTuy nhiên, cả hai &8Sách&r này sẽ phá vỡ Vật phẩm khi sử dụng. \n\n\n\nĐể &d&lInfuse&r &8Sách Tháo dỡ&r của chúng ta thành một &8Sách Tháo dỡ Tối thượng&r, chúng ta có thể sử dụng 3 &9Kệ Sculk Linh hồn&r và 1 &dKệ Cuối Rồng&r."]
	quest.377D6CF86BC1C64F.quest_subtitle: "Tất cả Phép thuật, phá vỡ Vật phẩm"
	quest.377D6CF86BC1C64F.title: "&8Sách Tháo dỡ Tối thượng"
	quest.3D31B94CC42BCE43.quest_desc: ["&8Sách Trích xuất&r chính là &8Sách&r chúng ta đang tìm! Nó sẽ lấy đi tất cả &5Phép thuật&r và để nguyên Vật phẩm! \n\n\n\nĐể làm nó, chúng ta sẽ cần &d&lInfuse&r &8Sách Tháo dỡ Tối thượng&r của chúng ta. \n\n\n\nChúng ta chỉ cần thêm một &9Kệ Sculk Linh hồn&r khác vào Bàn trước đó của chúng ta để đủ!"]
	quest.3D31B94CC42BCE43.quest_subtitle: "Tất cả Phép thuật, không phá vỡ"
	quest.42746659C66CF17F.quest_desc: ["Thư viện Alexandria &6&o là một phiên bản tốt hơn của &5Thư viện phép thuật&r. \n\n\n\nNó có thể chứa nhiều Cấp độ &5Sách phép&r cao hơn, nhưng vẫn cần Cấp độ của &5Sách&r để lấy ra ở Cấp độ đó. \n\n\n\nNó cũng có thể chứa nhiều Điểm hơn. &5Thư viện phép thuật&r có thể chứa 32768, trong khi &6&oThư viện Alexandria&r có thể chứa 1.1 Tỷ Điểm của mỗi &5Sách&r! \n\n\n\nĐể có được nó, chúng ta cần &d&lHòa trộn&r &5Thư viện phép thuật&r. \n\n\n\nSử dụng 4 &9Soul-Touched Sculkshelves&f, 4 &9Echoing Sculkshelves&f, 1 &dDraconic Endshelf&f, 5 &6Geode-Encased Bookshelves of Stability&r, và một Đầu lâu."]
	quest.42746659C66CF17F.quest_subtitle: "Hãy tưởng tượng nếu La Mã chưa bao giờ bị cháy..."
	quest.42746659C66CF17F.title: "&6&oThư viện Alexandria"
	quest.43167C59036E79A7.quest_desc: ["&8Sách phép của Thợ mỏ&r sẽ giúp bạn với mọi việc Khai thác. Nó sẽ cấp &5Hiệu quả&f, &5May mắn&f, và &5Chạm lụa&r. \n\n\n\nChúng áp dụng cho Cuốc, Rìu, Xẻng, và thậm chí cả Cuốc cấy! \n\n\n\n&8Sách phép của Người đánh cá&r sẽ chỉ cấp &5Phép thuật&r cho Cần câu, và ừ, có rất nhiều."]
	quest.43167C59036E79A7.title: "&8Sách phép Công cụ"
	quest.45161821C221EF0B.quest_desc: ["Khi chúng ta có 15 &4Kệ sách Địa ngục&r xung quanh &5Bàn phép thuật&r của mình, chúng ta sẽ có &a45 Eterna&r và &c30% Quanta&r trong &5Bàn&r. \n\n\n\nĐây là lượng hoàn hảo để &d&lHòa trộn&r &4Kệ sách Địa ngục&r của chúng ta! \n\n\n\n&4Kệ sách Địa ngục đã Hòa trộn&r cấp &a5 Eterna&r với tối đa &a60 Eterna&r, cùng với &c5% Quanta&r. \n\n\n\nChúng có thể được Chế tạo với các Item khác để tạo ra &7Kệ sách&r khác nhau, cho loại chúng ta muốn chúng ta sẽ cần 12 &4Kệ sách Địa ngục đã Hòa trộn&r! \n\n\n\nTất nhiên, với tôi rất hào phóng, bạn sẽ chỉ cần thu thập 8!"]
	quest.45161821C221EF0B.title: "&4Kệ sách Địa ngục đã Hòa trộn"
	quest.4E895C54651A3CB3.quest_desc: ["&8Sách phép&r là &7Sách&r... chỉ là &7Sách&r hữu ích hơn! \n\n\n\nMỗi &8Sách phép&r được Chế tạo với &7Sách&r, Gậy, &cThanh Blaze&f và &cBột&r. \n\n\n\n&8Sách phép&r có thể được &5Phép thuật&r, như Items, để có được &5Phép thuật&r nhất định. \n\n\n\nCòn có &8Sách phép của Scrapping&r có thể được dùng trong Đe để lấy &5Phép thuật&r khỏi Items."]
	quest.4E895C54651A3CB3.title: "&8&lSách phép"
	quest.516E66BE01EE5B31.quest_desc: ["&8Sách phép Vũ khí&r sẽ cấp &5Phép thuật&r cho Kiếm và Rìu. \n\n\n\nHầu hết là những phép giúp giết chóc! Như &5Sắc bén &f và &5Aspect Lửa&r. \n\n&8Sách phép Cung tên&r sẽ cấp &5Phép thuật&r cho Vũ khí tầm xa, Cung và Nỏ. \n\n\n\n&5Xuyên&f, &5Sức mạnh&f, và &5Đẩy lùi&r!"]
	quest.516E66BE01EE5B31.title: "&8Sách Vũ Khí"
	quest.51E554305FFEBA1D.quest_desc: ["Bằng cách kết hợp một &4Infused Hellshelf&r với một ít &eGlowstone&r, chúng ta có thể tạo ra &4Glowing Hellshelves&r! \n\n\n\nChúng có cùng &aEterna&r và &cQuanta&r, nhưng cung cấp &53% Arcana&r. \n\n\n\nĐiều này sẽ hữu ích cho các &d&lInfusions&r sau này, ví dụ như nếu chúng ta muốn dùng 12 cái để &d&lInfuse&r một &9Dormant Deepshelf&f thành &9Deepshelf&r!"]
	quest.51E554305FFEBA1D.title: "&4Kệ Địa Ngục Bùng Cháy"
	quest.523DC411241B470A.quest_desc: ["Tất cả &5Phép Thuật&r từ &5Bàn Phép Thuật&r được xác định bởi Cấp độ của &aEterna&r, &cQuanta&r, và &5Arcana&r. \n\n\n\nChúng ta có thể thấy Nhóm &5Phép Thuật&r có sẵn bằng cách nhấn vào dấu ? ở Góc Phải Trên của GUI &5Bàn Phép Thuật&r khi một Vật Phẩm đang được &5Phép Thuật&r. \n\n\n\nCàng cao &cQuanta&r, càng có cơ hội nhận được &5Phép Thuật&r tệ hơn. Như &5Lời Nguyền Biến Mất &for &5Ràng Buộc&r! \n\n\n\nVới &6Geode-Encased Bookshelf of Stability&r, nó sẽ loại bỏ cơ hội tăng lên của các &5Phép Thuật&r tệ hơn. \n\n\n\nBạn vẫn có thể nhận được &cLời Nguyền&r với nó, chỉ là tỷ lệ thấp hơn nhiều!\n\n{@pagebreak}\n\nĐể Chế tạo nó, chúng ta cần một &7Kệ Sách&r, 7 Calcite, và 1 &5Budding Amethyst&r. \n\n\n\n&5Budding Amethyst&r không thể thu thập được từ Khai Thác, ngay cả với &5Lụa Chạm&r. Bạn sẽ cần một Nghi Lễ hoặc Infusion để lấy nó!"]
	quest.523DC411241B470A.title: "&6Loại Bỏ Phép Thuật Tiêu Cực"
	quest.586D5DE28EEC8014.quest_desc: ["&cQuanta&r giúp trộn lẫn Nhóm &5Phép Thuật&r, làm cho dễ có được nhiều &5Phép Thuật&r khác nhau. \n\n\n\nTuy nhiên, &cQuanta&r có thể phản lại bạn: càng nhiều thì &5Phép Thuật&r xấu càng phổ biến. Các &5Phép Thuật&r xấu như &5Lời Nguyền Ràng Buộc&r! \n\n\n\nTrước đây chúng ta dùng &eRectification&r, thay vào đó bây giờ chúng ta dùng &6Geode-Encased Bookshelves of Stability&r! \n\n\n\nMặc định &cQuanta&r là &c15%&r và tối đa là &c100%&r."]
	quest.586D5DE28EEC8014.title: "&cQuanta"
	quest.5C73247A48E72FB3.quest_desc: ["Nếu bạn muốn loại bỏ một &5Phép Thuật&r cụ thể khỏi &5Nhóm Phép Thuật&r, bạn có thể dùng &bKệ Sách&r này trong cài đặt &5Phép Thuật&r của mình! \n\n\n\nĐặt một &5Sách Phép Thuật&r, bạn muốn đưa vào Danh Sách Đen, vào một vị trí trống trong &bSeashelf&r này. \n\n\n\nSau đó, khi bạn &5Phép Thuật&r, &5Phép Thuật&r này sẽ không xuất hiện trên Vật Phẩm hoặc Sách."]
	quest.5C73247A48E72FB3.title: "Loại Bỏ &5Phép Thuật&r khỏi Nhóm"
	quest.5DE45BC0258D1B0B.quest_desc: ["&dPearlescent Endshelf&r là một &7Kệ&r khá ổn, đặc biệt là về giá. \n\n\n\nNó được tạo ra bằng cách kết hợp một &dEndshelf&r với 4 &7End Rods&r và 2 &3Ender Pearls&r. \n\n\n\nNó sẽ cho chúng ta tối đa &aEterna 90&r, nhưng đây không phải là thứ chúng ta muốn cho &5Phép Thuật&r tối đa."]
	quest.5DE45BC0258D1B0B.title: "&dKệ End Ngọc Trai"
	quest.60850E717C747A78.quest_desc: ["Bạn có bao giờ dành 3 tháng nghiên cứu &oMã Galatic&r để cuối cùng hiểu ngôn ngữ của &5Bàn Phép Thuật&r chỉ để nó trở thành ngôn ngữ vô nghĩa? \n\n\n\nKhông? \n\n\n\nTôi cũng thế, nhưng &9Dấu Hiệu Phép Thuật&r chính là người phiên dịch thực tế cho bạn! \n\n\n\nMỗi &9Dấu Hiệu Phép Thuật&r sẽ cho bạn biết 1 &5Phép Thuật&r trước khi bạn thực sự sử dụng nó."]
	quest.60850E717C747A78.title: "&3Dấu Hiệu Phép Thuật"
	quest.6220EDE42C813C1B.quest_desc: ["Điều tệ nhất về &eCharms&r là chúng vỡ! Tại sao các Hiệu Ứng Potion OP này lại phải có Độ Bền! \n\n\n\nĐừng lo lắng, &5&lApotheosis&r có cách chữa cho điều đó... với &d&lInfusions&r! \n\n\n\nBạn sẽ cần &a100 Eterna&r, từ &c8.5% &fđến &c13.5% Quanta&r, và từ &532.5% &fđến &537.5% Arcana&r. \n\n\n\nBạn có thể sử dụng 10 &4Glowing Hellshelves&r, 4 &6Geode-Encased Bookshelves of Stability&r, 2 &dDraconic Endshelves&r, và một Skeleton Skull! \n\n\n\nĐúng vậy, một số Skull và các Item khác ngoài &7Bookshelves&r cũng cung cấp chỉ số!"]
	quest.6220EDE42C813C1B.title: "&eCharms Bất Khả Phá Hoại"
	quest.62D39F68DE6E44A4.quest_desc: ["&5Arcana&r là một lượng rất quan trọng, nó tăng số lượng &5Enchantments&r bạn nhận được; và làm cho các &5Enchantments&r hiếm trở nên phổ biến hơn. \n\n\n\nVí dụ với Kiếm, &5Smite&r là một &5Enchantment&r rất phổ biến nhưng &5Looting&r thì hiếm hơn nhiều. \n\n\n\nMặc định của &5Arcanas&r là &50%&r và tối đa là &5100%&r."]
	quest.62D39F68DE6E44A4.title: "&5Arcana"
	quest.6852BEFDD4DE4E4B.quest_desc: ["&9Soul-Touched Deepshelves&r là nâng cấp của &9Deepshelves&r. \n\n\n\nChúng được Chế tạo với một &bSoul Lantern&r và 3 &3Sculk Blocks&r. Bạn sẽ cần &5Silk Touch&r để nhặt &3Sculk Blocks&r. \n\n\n\nSau đó, chúng ta có thể Chế tạo phiên bản &9Soul-Touched&r của mình. Chúng sẽ cho rất nhiều &cQuanta&r hơn ở mức &c15%&r! \n\n\n\nNó cũng tăng tối đa &aEterna&r lên &a75&r."]
	quest.6852BEFDD4DE4E4B.title: "&9Soul-Touched Deepshelf"
	quest.6884E25641A1020C.quest_desc: ["&5Thư Viện Phép Thuật&r là nơi lưu trữ &5Sách Phép Thuật&r tuyệt vời nhất, từ trước đến nay! \n\n\n\nĐể Chế tạo nó, bạn sẽ cần 4 &3Ender Chests&r, 1 &5Bàn Phép Thuật&r, và 4 của bất kỳ &d&lInfused&r &7Bookshelves&r nào: &4Infused Hellshelf&r, &bInfused Seashelves&r, và &9Deepshelves&r. \n\n\n\nĐể sử dụng nó, bạn có thể nhấn Shift + Click Trái vào &5Sách Phép Thuật&r hoặc đặt chúng vào &9Khe Xanh&r. Điều này sẽ thêm &5Sách&r vào &5Thư Viện&r. \n\n\n\nCác &5Sách&r được sắp xếp theo tên và được lưu trữ bằng Điểm. Mỗi Cấp của &5Sách Phép Thuật&r xác định Cấp, và nó được phản ánh qua số &5Sách&r cần thiết để đạt được Cấp đó. Cấp 1 là 1 Điểm. Cấp 2 là 2 Điểm. Cấp 3 là 4 Điểm. Cấp 4 là 8 Điểm. \n\n\n\nMỗi &5Sách&r được lưu trữ tối đa 32768 Điểm, và chúng có thể được lấy ra bằng cách Click Trái vào &5Sách&r đã lưu trữ. Mỗi Click sẽ thêm một Cấp khác vào &5Sách&r trong &6Khe Cam&r. \n\n\n\nBạn có thể Click các &5Sách&r khác nhau để thêm vào &5Sách&r trong &6Khe Cam&r, tương tự như kết hợp &5Sách&r trong Anvil. \n\n\n\nCấp tối đa của &5Sách Phép Thuật&r được xác định bởi Cấp cao nhất của &5Sách&r bạn đã đặt vào. Không quan trọng bạn có 32000 Điểm, nếu bạn chỉ đặt &5Sharpness III&r, bạn chỉ có thể lấy ra &5Sharpness III&r."]
	quest.6884E25641A1020C.title: "&5Thư viện Phép thuật"
	quest.695889817162EFC7.quest_desc: ["&aEXP&r rất quan trọng cho &5&lApotheosis Enchanting&r! Mỗi &5phép thuật&r đều cần nó! (Bạn nghĩ tại sao tôi lại cho nó trong mỗi Phần thưởng?) \n\n\n\nVới &d&lInfusion&r chúng ta có thể biến &6Chai mật ong&r thành &aBottles O' Enchanting&r. Thực ra chúng ta có 3 loại &d&lInfusion&r khác nhau cho nó! Nó từ 1 &aBottle O' Enchanting&r, đến 8, đến 32! \n\n\n\nĐầu tiên, là cho 1 &aBottle&r và chỉ cần 2 &9Echoing Sculkshelves&r. \n\n\n\nThứ hai, là cho 8 &aBottles&r và cần 5 &9Echoing Sculkshelves&r và 1 &9Soul-Touched Sculkshelf&r. \n\n\n\nCuối cùng, là cho 32 &aBottles O' Enchanting&r và sẽ cần 5 &9Echoing Sculkshelves&f, 3 &9Soul-Touched&f, và 1 &dDraconic Endshelf&r!"]
	quest.695889817162EFC7.title: "Chế tạo &aEXP&r?"
	quest.6A07D09831428CB9.quest_desc: ["&4&lDị giới&r có thể khá đáng sợ, nếu bạn thích hành trình trên &bbiển&r, hãy dùng &bSeashelves&r! \n\n\n\n&bSeashelves&r là lối vào cho &5Arcana&r, chúng cho &53% Arcana&r và &a3 Eterna&r. \n\n\n\nTốt hơn &7Shelves&r thông thường đúng không? \n\n\n\nBạn sẽ cần 16 cho &d&lInfusing&r... thực ra 15 cho &d&lInfusing&r, 1 để &d&lInfused&r! \n\n\n\nGiống như &4Hellshelves&r, tôi sẽ cho bạn thêm, chỉ cần thu thập 11 bây giờ!\n\n{image:atm:textures/questpics/apothic/enchant_seashelf.png width:100 height:100 align:center}"]
	quest.6A07D09831428CB9.title: "&bSeashelves"
	quest.6C2C135B9B7B9402.quest_desc: ["&d&lInfusion&r là một phiên bản đặc biệt của &5phép thuật&r mà paradoxically được dùng cho &5phép thuật&r tốt hơn. \n\n\n\nKhi lượng &aEterna&r, &cQuanta&r, và &5Arcana&r phù hợp được đạt đến, các &5phép thuật&r sẽ cung cấp &d&lInfusion&r. \n\n\n\n(Để biết cấp độ cần thiết, bạn có thể kiểm tra EMI hoặc theo các Nhiệm vụ này)"]
	quest.6C2C135B9B7B9402.title: "&l&dInfusing"
	quest.6C57D64518FF22C0.quest_desc: ["Phần còn lại của các &5phép thuật&r đến từ &8cuốn sách&r này. \n\n\n\n&5Bất khả diệt&r... Tôi thực sự không biết còn gì nữa..."]
	quest.6C57D64518FF22C0.title: "&8V.v. Sách"
	quest.70D2C5FAC661E01A.quest_desc: ["&bHeart-Forged Seashelf&r là một nâng cấp khác của &bInfused Seashelf&r. \n\n\n\nNó hơi đắt nhưng cho rất nhiều &5Arcana&r! \n\n\n\nĐiều này sẽ rất hữu ích cho các &d&lInfusion&r sau này cần nhiều &5Arcana&r."]
	quest.70D2C5FAC661E01A.title: "&bHeart-Forged Seashelf"
	quest.78E66F1DE42C747A.quest_desc: ["&9Echo Shards&r khá khó farm, hơn nữa chúng ta sẽ cần rất nhiều! Vậy tại sao không có một cách dễ dàng hơn để farm chúng. \n\n\n\nVới &d&lInfusion&r chúng ta có thể biến 1 &9Echo Shard&r thành 4! \n\n\n\nChúng ta cần &a70 Eterna&r, &c50% Quanta&r, và &550% Arcana&r. \n\n\n\nĐể đạt được điều đó, chúng ta có thể dùng 12 &4Glowing Hellshelves&r và 2 &9Deepshelves&r, mà không phải là &9Dormant&r!"]
	quest.78E66F1DE42C747A.title: "Vô hạn &9Echo Shards&r?"
	quest.78FEDE6FA4845585.quest_desc: ["Một số &d&lInfusions&r cần lượng &aEterna&r, &cQuanta&r, hoặc &5Arcana&r rất, rất chính xác. \n\n\n\nĐể có được chúng, bạn có thể cần một trong những &7Shelves&r này. \n\n\n\nMỗi cái làm giảm lượng tài nguyên tương ứng."]
	quest.78FEDE6FA4845585.title: "&4Lượng âm"
	quest.79AF63E77AD70A93.quest_desc: ["&7Bookshelves&r là điểm bắt đầu, nhưng chắc chắn không phải điểm kết thúc. Ít nhất là không phải &7Bookshelves&r thông thường. \n\n\n\nChỉ với &7Bookshelves&r thông thường, bạn chỉ có thể nâng &aEterna&r lên tối đa 30. \n\n(Tôi sẽ giải thích về &5Enchantment Levels&r sớm, nhưng hãy biết rằng bạn cần chúng cao)"]
	quest.79AF63E77AD70A93.title: "&2&lVanilla&r Max chỉ là sự bắt đầu"
	quest.7C758209D06ED0E3.quest_desc: ["Bằng cách kết hợp một &4Infused Hellshelf&r với một ít &eGlowstone&r, chúng ta có thể tạo ra &4Glowing Hellshelves&r! \n\n\n\nChúng có cùng &aEterna&r và &cQuanta&r, nhưng cho &53% Arcana&r. \n\n\n\nĐiều này sẽ hữu ích trong các &d&lInfusions&r sau, như nếu chúng ta muốn dùng 12 cái để &d&lInfuse&r một &9Dormant Deepshelf&f thành một &9Deepshelf&r!"]
	quest.7C758209D06ED0E3.title: "&4Glowing Hellshelf"
	quest.7C9D9D1C054874A7.quest_desc: ["Bạn bao giờ muốn có những &5Enchantments&r hoàn hảo nhất? Như, mọi chỉ số tối đa, mọi &5Enchantment&r tốt đều có? Vậy, bạn sẽ cần những cái này! \n\n\n\nĐầu tiên, là 4 &9Soul-Touched Sculkshelves&r và 4 &9Echoing Sculkshelves&r. Chúng sẽ cho chúng ta tất cả &cQuanta&r và &5Arcana&r mà chúng ta cần! \n\n\n\nTiếp theo, là &dDraconic Endshelf&r sẽ cho chúng ta &a100 Eterna&r, tức là lượng &aEterna&r và mức tối đa. \n\n\n\nThứ ba, là &6Geode-Encased Bookshelf of Stability&r, điều này sẽ làm cho &cQuanta&r không phản chúng ta bằng những &5Enchantments&r tồi! \n\n\n\nCuối cùng là tùy chọn nhưng bạn nên thêm nó, &6Deepshelf of Arcane Treasures&r. &7Bookshelf&r đó sẽ cho phép chúng ta có được những &5Enchantments&r mà bình thường chúng ta không có, như &5Mending&r!"]
	quest.7C9D9D1C054874A7.title: "&6&lBộ setup phép thuật tốt nhất"
	task.3D62C020980A2DEC.title: "Kệ sách"
}
