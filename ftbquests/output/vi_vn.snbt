	file.0000000000000001.title: "All The Mods 10 - LITE"
	quest.000C1ECD781F3F81.quest_desc: ["&2&lThiên nhiên&r được tạo ra để sử dụng Trái Đất vì lợi ích của chúng ta bằng cách &2Độc hại&r và &2Yếu đi&r kẻ thù! Giống như những Tập đoàn Lớn làm với chính Trái Đất! \n\nVật liệu Trọng tâm của &2&lThiên nhiên&r là &2Khoai tây Độc&r. \n\n\n\nCác &2Cuộn&r có màu &aXanh nhạt&r với chữ &2Xanh đậm&r."]
	quest.000C1ECD781F3F81.title: "&2&lThiên nhiên"
	quest.001A348054127235.quest_desc: ["&5Amethyst đang nảy mầm&r có thể hữu ích cho các công thức chế tạo và thậm chí chỉ để trồng &5Thạch anh tím&r! \n\n\n\nVới một &5Khối Thạch anh tím&r, &a60 Eterna&r, giữa &c30% &f và &c50% Quanta&r, và &550% Arcana&r chúng ta có thể &d&lHòa trộn&r một cái. \n\n\n\nĐể có được tất cả các chỉ số đó, chúng ta có thể sử dụng 15 &4Kệ Địa ngục phát sáng&r và 4 &2Kệ Dưa hấu&r."]
	quest.001A348054127235.title: "Chế tạo &5Amethyst đang nảy mầm"
	quest.001DE8028CAF0A08.quest_subtitle: "suỵt... quá ồn...."
	quest.004D61425172324F.quest_desc: ["&8Áo giáp xích&r có phần kém hơn một chút so với Sắt. Công dụng chính của nó trong &l&2Minecraft&r là tính khó tìm, chỉ có thể có được thông qua Giao dịch và Rơi từ Quái vật. \n\n\n\nTất nhiên đây là modpack nên, chúng ta có thể chế tạo nó ngay bây giờ! Điều này lấy đi mục đích của nó..."]
	quest.004D61425172324F.quest_subtitle: "12"
	quest.004D61425172324F.title: "&8Áo giáp xích"
	quest.00611844AFD5C31E.quest_desc: ["Trong khi Máy Khắc và Máy Sạc sẽ tự nhiên chấp nhận RF/FE, phần lớn mạng lưới ME sử dụng hệ thống năng lượng riêng được gọi là AE.\n\n\n\nRF/FE có thể được chuyển đổi thành AE tự nhiên với tỷ lệ 2:1 RF:AE, hoặc trực tiếp thông qua một ME Controller, hoặc thông qua &bBộ tiếp nhận năng lượng&f, có thể thay vào đó được kết nối đến bất kỳ phần nào của mạng lưới."]
	quest.00611844AFD5C31E.quest_subtitle: "Kết nối"
	quest.00A6020BC979947F.quest_desc: ["Với &9Marid Crusher&r vừa được triệu hồi, bạn có thể phá vỡ một Mảnh Echo và một Thỏi Iesnium, khi kết hợp với một Túi mực phát sáng sẽ tạo ra Phấn xanh lục."]
	quest.00A6020BC979947F.title: "&3Phấn xanh lơ"
	quest.00DB5495C3A44999.quest_desc: ["Shift + Chuột phải vào kho để lấy hết vật phẩm."]
	quest.00E1F1279F97557B.quest_desc: ["Tương tự như Máy ép MK1 nhưng cái này tiên tiến hơn! Có thể dùng với Mẫu hình để khi đặt Khối chúng sẽ theo mẫu hình đó!"]
	quest.00EFC7B327E79076.quest_desc: ["Sau khi dùng đi hàng tỷ năng lượng trong SPS, cuối cùng chúng ta cũng tạo ra được &dAntimatter Pellets&r.\n\n\n\nĐưa Khí Antimatter bạn nhận được từ SPS vào Máy kết tinh hóa học và bạn sẽ nhận được 1 Antimatter Pellet cho mỗi 1000mb bạn tạo ra."]
	quest.010607466D565B53.quest_desc: ["Hãy kết nối với Mẹ Thiên nhiên đi.\n\n\n\nVới &aGiày Rễ&r thiên nhiên là bạn tốt nhất của bạn! Khi đứng trên cỏ bạn sẽ hồi máu. Đồng thời, khi ăn thức ăn khi đứng trên cỏ, nó sẽ có tác dụng như bạn đã dùng xương lên cỏ."]
	quest.010607466D565B53.quest_subtitle: "Chân"
	quest.010607466D565B53.title: "&aGiày Rễ"
	quest.0108F3EFDFD6DFD0.quest_desc: ["Storage Link cho phép bạn kết nối nhiều kho không được gắn vào Storage Controller hoặc bất kỳ khối nào được kết nối với nó.\n\n\n\nVì vậy, đây là cách để kết nối không dây một 'multiblock' của các kho mà không cần phải chuột phải từng cái.\n\n\n\nPhạm vi 14 khối vẫn áp dụng."]
	quest.01119871B1D5C576.quest_desc: ["Hầu hết mọi &6Làng&r đều có thể có &6&lTu sĩ&r trong đó. Điều này bao gồm cả &6Làng&r từ mod.\n\n\n\nThông thường họ ở giữa &6Làng&r như gần chợ. Không phải mọi &6Làng&r đều có một người.\n\n{image:atm:textures/questpics/iron_spells/spells_village.png width:200 height:100 align:center}"]
	quest.01119871B1D5C576.title: "&6Làng"
	quest.011F787E620DE9E8.quest_desc: ["Để thiết lập Bộ lọc Quái vật, bạn chỉ cần nhấp vào quái vật mà bạn không bao giờ muốn thấy lại, bằng Bộ lọc Quái vật. \n\n\n\nMỗi Bộ lọc chỉ có thể chứa 1 quái vật, vì vậy nếu bạn muốn Zombie, Skeleton, Nhện, Creeper, và Enderman không xuất hiện nữa, bạn sẽ cần 5 Bộ lọc Quái vật. \n\n\n\nBạn có thể thay đổi quái vật trong đó bằng cách chỉ cần nhấp vào một quái vật khác bằng nó."]
	quest.011F787E620DE9E8.quest_subtitle: "Hắn không được mời!"
	quest.0152938EE5651409.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2cộng tác viên cộng đồng&r để sử dụng trong các modpack AllTheMods.\n\n\n\nVì tất cả các modpack &6AllTheMods&r đều được cấp phép theo &eAll Rights Reserved&r, Nhiệm vụ này không được phép sử dụng trong bất kỳ modpack công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng.\n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.0152C49AB74B9D32.quest_desc: ["Bạn có thể đã nghe mọi người nói về cách &cFusion Reactor&r là nguồn năng lượng tốt nhất trong pack. Ồ, họ có thể đúng\n\n\n\nMột khi đã kích hoạt, Reactor có thể đưa ra tới 80MRF/t với thiết lập đúng. Nó cũng có thể được làm mát bằng nước để tạo ra hơi nước, có thể đưa vào &9Industrial Turbine&r để tạo ra còn nhiều năng lượng hơn.\n\n\n\nĐể xây dựng Fusion Reactor, chúng ta cần theo một mẫu đơn giản. Mỗi mặt sẽ trông như thế này:\n\n\n\n{image:atm:textures/questpics/mek/fusion_pattern.png width:175 height:175 align:1}\n\n{@pagebreak}\n\nĐối với mặt trên, chúng ta muốn thay thế khối giữa bằng Fusion Reactor Controller.\n\n\n\nĐối với các cổng, bạn có thể thay thế bất kỳ Reactor Glass nào ở các cạnh. Đối với thiết lập này, chúng ta sẽ cần hai cổng để nhập &cDeuterium&r và &eTritium&r, sau đó một cổng để xuất năng lượng.\n\n\n\n{image:atm:textures/questpics/mek/completed_fusion_reactor.png width:175 height:150 align:1}"]
	quest.0152C49AB74B9D32.quest_subtitle: "Nguồn Năng Lượng Tốt Nhất Trong Pack"
	quest.0152C49AB74B9D32.title: "&cFusion Reactor"
	quest.019CA0E35F888222.quest_subtitle: "Thêm Tùy Chọn Lọc"
	quest.019CA0E35F888222.title: "&eNâng Cấp Tái Thông Tin Nâng Cao"
	quest.019D5A05A2134C7E.title: "&dHợp Kim Nguyên Tử"
	quest.01C5D8357D8B0D62.quest_desc: ["Nếu bạn biết Đoạn Tàu Dò hoạt động như thế nào thì Mô-đun này sẽ giải thích cho bạn. \n\n\n\nVề cơ bản, nếu một Item cụ thể nằm trong Router, nó sẽ phát ra một Tín Hiệu Redstone từ Router. \n\n\n\nTrong Mô-đun, bạn có thể thiết lập Item, tín hiệu đến từ đâu, và tín hiệu mạnh như thế nào."]
	quest.01F3F0C25BA72BDA.quest_desc: ["Ngoài việc lưu trữ vật phẩm và chất lỏng, AE2 còn cung cấp cách thức tự nhiên để lưu trữ toàn bộ &estructures&f bên trong các ô lưu trữ, không khác biệt lắm so với mod Compact Machines. \n\n\n\nCổng &bSpatial IO Port&f cho phép các cấu trúc được chứa trong &bSpatial Containment Structure&f được thu vào một ô lưu trữ được thiết kế đặc biệt, kích hoạt qua tín hiệu redstone. \n\n\n\nNếu một sinh vật hoặc người chơi vô tình đứng bên trong SCS khi không gian đang được thu, họ cũng sẽ được dịch chuyển đến nơi mà phần còn lại của không gian đi, tức là trong một dimension chuyên dụng. Chỉ cần đảm bảo bạn có cách để ra vào nếu bạn là người bị thu."]
	quest.01F3F0C25BA72BDA.title: "Spatial IO"
	quest.027084AE2DF5EBA6.quest_desc: ["Nhà máy cô đặc nhiệt (Thermal Evaporation Plant) tạo ra Nước muối (Brine) dựa trên nhiệt độ bên trong.\n\n\n\nCó một số cách để tăng nhiệt độ của nhà máy, bao gồm xây dựng chúng trong sa mạc!\n\n\n\nMáy sưởi &aFuelwood Heater&r đốt xô dung nham (Lava), sau đó có thể được dẫn qua ống dẫn nhiệt.\n\n\n\nMáy sưởi &aResistive Heater&r sử dụng RF/FE để tạo nhiệt, và có thể được cài đặt để sử dụng bất kỳ lượng RF/FE nào bạn muốn."]
	quest.027084AE2DF5EBA6.quest_subtitle: "Nước muối nóng ở đây. Nhận Nước muối nóng của bạn ở đây."
	quest.027084AE2DF5EBA6.title: "Làm nóng sản xuất Nước muối của chúng ta"
	quest.0298A17C2AAC5765.quest_desc: ["Tăng số lượng vật phẩm trong một stack của Ba lô lên 8."]
	quest.0298A17C2AAC5765.title: "&bNâng cấp Stack Cấp 3"
	quest.030AC1AF8F735550.quest_desc: ["Để đưa chất lỏng vào Thùng (Tank) bạn sẽ cần một số loại Ống dẫn (Pipes).\n\n\n\nMáy bơm nước (Hydro Pump) có thể tự động đưa Nước vào chúng với tốc độ chậm, và hoàn toàn miễn phí!"]
	quest.030AC1AF8F735550.title: "Ống dẫn"
	quest.03250A0202C25E80.quest_desc: ["Sau khi bạn đã giết thành công &9Unbound Marid&r Demon mà bạn triệu hồi bằng &4Abras' Fortified Conjure&r, bạn có thể sử dụng &9Marid Essence&r mà nó rơi ra để chế tạo Chalk màu \"cao nhất\", Chalk xanh."]
	quest.03250A0202C25E80.title: "&9Phấn xanh"
	quest.034A9FBCA6D79BB6.quest_desc: ["Pylon Thu Hoạch cần một chiếc cuốc để hoạt động. \n\n\n\n(Các loại cuốc không thể phá hủy sẽ hoạt động vĩnh viễn, còn các loại có thể phá hủy sẽ cần được thay thế)."]
	quest.037415D5B965E214.quest_desc: ["Nâng cấp này khiến ba lô không thể bị hủy."]
	quest.037488EF1F3581CE.quest_desc: ["Mặc định, một mạng ME khi không có Bộ điều khiển ME chỉ có bộ đệm nội bộ 800AE. Mỗi Bộ điều khiển ME thêm 8kAE mỗi khối. Đối với mạng lớn, con số này có thể không đủ và có thể khiến mạng tắt ngắt khi cố gắng phục hồi năng lượng cho các thiết bị kết nối.\n\n\n\nTụ điện năng lượng &bEnergy Cell&f cho phép mạng ME lưu trữ nhiều năng lượng hơn, thêm 200kAE mỗi Tụ điện năng lượng thường và 1.6MAE mỗi &bDense&f Energy Cell. Chúng có thể được đặt ở bất kỳ đâu trong mạng để cung cấp bộ đệm năng lượng tăng lên."]
	quest.03E05018D64DDEE1.quest_desc: ["&eCấp 5&r về cơ bản chỉ dành cho Quặng Allthemodium, không có nhiều thứ khác."]
	quest.03E05018D64DDEE1.title: "&eCấp thu hoạch 5"
	quest.03E6FA4DCB71162E.quest_desc: ["&bMáy phun màu&f là một công cụ có thể sạc cho phép nhuộm cáp trong thế giới. Nó hoạt động như một &etụ điện chuyên dụng&f có thể được nạp thuốc nhuộm vanilla hoặc &ebóng sơn&f cho màu cụ thể, cùng với &etuyết&f để rửa màu và biến cáp trở lại dạng Fluix.\n\n\n\nViệc áp dụng màu cho cáp sử dụng 100AE năng lượng từ pin nội bộ, cho tổng cộng 3400 đoạn cáp trong một lần sạc."]
	quest.03E6FA4DCB71162E.title: "Máy phun màu"
	quest.0436DF3308681913.quest_desc: ["Ngồi trên Ngai Vàng là phần còn lại của một vị &4&lVua&r trong quá khứ. Nhưng khi bạn đến gần và chạm vào chúng, bạn sẽ thấy chúng hồi sinh; &4&lVua&r không còn chết nữa! Nhưng chỉ có giết người mới giữ cho ông ta sống... và bạn là sinh vật sống gần nhất. \n\n\n\n&4&lVua Xác&r là Boss khó nhất, ông ta có 400 &cTrái Tim&r và là người duy nhất có một Thanh Boss thực sự (và nhạc). Ông ta có thể sử dụng nhiều loại &3Phép Thuật&r từ bất kỳ lớp nào, từ &2Mũi Độc&r của &2Thiên Nhiên&r đến &6Bệnh&r của &6Thánh&r, thậm chí &aRăng Nanh&r của &aTriệu Hồi&r! Ông ta cũng có thể dịch chuyển, triệu hồi người chết, và đánh bạn bằng &4Gậy Máu&r. \n\n\n\nNếu bạn giết được ông ta, ông ta sẽ rơi &3Cuộn Giấy&r đủ loại, &7Ký Hiệu Trống&r, và có thể rơi &4Gậy Máu&r và Necronomicon.\n\n{image:atm:textures/questpics/iron_spells/spells_king.png width:100 height:200 align:center}"]
	quest.0436DF3308681913.title: "&4&lVua Xác"
	quest.0484051446480B54.quest_desc: ["Gây ra một lượng sát thương khổng lồ và chặt cây! Bạn còn cần gì nữa?"]
	quest.0484051446480B54.title: "&6Allthemodium &5Alloy &3Rìu"
	quest.0498A578D0EC3254.quest_desc: ["Kết hợp Osmium với Redstone trong một Metallurgic Infuser sẽ tạo ra một cái như thế này cho bạn."]
	quest.0498A578D0EC3254.quest_subtitle: "Mạch điều khiển cơ bản"
	quest.04B31A600004F7CB.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2Community contributor&r để sử dụng trong các Modpack AllTheMods. \n\n\n\nVì tất cả các pack &6AllTheMods&r đều được cấp phép theo &eAll Rights Reserved&r, Nhiệm vụ này không được phép sử dụng trong bất kỳ pack công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng. \n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.04E2D539E33B7B0F.quest_desc: ["Máy này kết hợp hai loại khí để tạo ra một loại khí mới.\n\n\n\nBạn sẽ cần máy này để kết hợp Chlorine với Hydrogen tạo ra Hydrogen Chloride, sau đó được sử dụng trong Chemical Injection Chamber của chúng tôi."]
	quest.04E2D539E33B7B0F.quest_subtitle: "Máy kết hợp hóa chất"
	quest.0518551637F76C50.quest_desc: ["Để nâng cấp &9Echoing&r, chúng ta sẽ cần một vài vật phẩm khác nhau. \n\n\n\nNến, vốn tương đối dễ lấy! Và &9Echo Shards&r... thì chắc chắn không dễ... \n\n\n\nCơ hội tốt nhất để lấy chúng là bằng cách Looting một &6Ancient City&r, nhưng bạn có thể Craft chúng với một vài Ritual khác nhau. \n\n\n\n(Hoặc thậm chí sau này với &5Enchanting&r!) \n\n\n\nCác &9Echoing Deepshelves&r sẽ cho rất nhiều &5Arcana&r hơn ở mức &515%&r! Cùng với đó là tăng max &aEterna&r lên &a75&r."]
	quest.0518551637F76C50.title: "&9Echoing Deepshelf"
	quest.051E0C85E7B71CE0.quest_desc: ["Tôi sẽ giả định bạn đã đi khai thác, đúng không? Cuối cùng thì đây là MINEcraft mà.\n\n\n\nBạn sẽ tìm thấy rất nhiều quặng mới có thể khiến bạn bối rối, nhưng bạn có thể bám vào các vật liệu vanilla để bắt đầu!\n\n\n\nĐồng dồi dào và có nhiều công dụng cho những thứ như &aOre Hammers&r hoặc &eDrawer Upgrades&r, vì vậy hãy đảm bảo thu thập nhiều!\n\n\n\nSắt có lẽ là một trong những quặng quan trọng nhất bạn sẽ muốn lấy mỗi khi gặp phải. Thế giới của modded MC về cơ bản chạy bằng Sắt."]
	quest.051E0C85E7B71CE0.title: "Thời đại &9Kim loại&r"
	quest.0583862ED0114442.quest_subtitle: "&f4Tấn công &cSát thương"
	quest.05850541675B2493.quest_desc: ["Đúng vậy.\n\n\n\nBạn đã tạo ra &6&lATM Star&r, điều đó có nghĩa là bạn đã vượt qua modpack!\n\n\n\nVậy tiếp theo là gì?"]
	quest.05850541675B2493.quest_subtitle: "Vậy là bạn đã thắng?"
	quest.05850541675B2493.title: "&6&lATM Star"
	quest.05B0A7D0B991050F.title: "Lò phản ứng (Cứng cáp)"
	quest.05D20B506213A449.quest_desc: ["&9Rotor Tuabin&r được đặt ở giữa Tuabin. Với mỗi Rotor Tuabin, bạn sẽ cần 2 &aLưỡi Tuabin&r. Đối với Tuabin này, chúng ta sẽ sử dụng 3 Rotor.\n\n\n\nKhi nhìn vào Rotor, nhấp chuột phải với &aLưỡi Tuabin&r sẽ đặt chúng trực tiếp lên Rotor. Rotor càng cao, Lưỡi càng dài. Đối với công trình này, chúng ta sử dụng tổng cộng 6 Lưỡi. Nếu bạn dự định xây dựng Tuabin lớn hơn, bạn sẽ cần tăng chiều rộng của Tuabin tùy theo số Lưỡi bạn dự định sử dụng.\n\n\n\n&9Rotational Complex&r phải được đặt ở đỉnh của Rotor Tuabin. Sau đó nó được bao quanh bởi &ePressure Dispersers&r.\n\n\n\nCác Dispersers phải lấp đầy toàn bộ lớp nơi Rotational Complex đặt."]
	quest.05D20B506213A449.title: "&aRotor"
	quest.05DBDD86FCFF3BA8.title: "&5Bóng nâng cấp Sét&r"
	quest.06094615950AC062.title: "Các nâng cấp băng chuyền khác"
	quest.062AA943A1629A86.quest_desc: ["Bạn đã làm nổ tung &cR&6a&ei&2n&3b&9o&5w&r &cF&6u&er&2n&3a&9c&5e&r?!?! Chỉ đặt TNT ngay cạnh nó? Bạn có điên không? Điều đó đã tốn bao nhiêu lò nung và tài nguyên và bạn lại làm nổ nó!!! Bạn có ít nhất nhận được thứ gì tốt từ nó không? &cR&6a&ei&2n&3b&9o&5w&r &cC&eo&3a&5l&r? Than kéo dài mãi mãi? Thực ra khá đáng giá."]
	quest.062AA943A1629A86.title: "&cR&6a&ei&2n&3b&9o&5w &cC&eo&3a&5l"
	quest.0650996C7818ADB5.quest_desc: ["Máy phát nhiệt có 2 chế độ để tạo điện:\n\n\n\n&9Thụ động:&r Bao quanh máy phát với khối nguồn dung nham hoặc khối chảy tạo ra điện thụ động bằng cách tạo nhiệt. Đặt một khối nguồn dung nham ở trên, và để nó chảy xuống các cạnh. Đảm bảo kết nối ống dẫn trước!\n\n\n\n&9Chủ động:&r Đặt vật liệu cháy như than hoặc gỗ vào máy phát sẽ đốt nhiên liệu để tạo điện."]
	quest.0650996C7818ADB5.quest_subtitle: "Máy phát điện cơ bản"
	quest.066F78936C8F943B.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2Người đóng góp cộng đồng&r để sử dụng trong các Modpack AllTheMods. \n\n\n\nVì tất cả các pack &6AllTheMods&r được cấp phép theo &eAll Rights Reserved&r, Nhiệm vụ này không được phép sử dụng trong bất kỳ pack công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng. \n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.067AB3E4C4492F0D.quest_desc: ["Không muốn khai thác một loạt các Quặng bạn có? Tại sao không để Router làm giúp bạn? \n\n\n\nBạn có thể dùng Placer để đặt các Quặng xuống, sau đó để Enchanted Breaker khai thác Quặng. Breaker cần Pickaxe dùng để chế tạo nó phải được Enchant trước, chính Module thì không thể Enchant được. \n\n\n\nBạn có thể cần một Router khác để nhặt các Quặng rơi.\n\n{image:atm:textures/questpics/router/router_break.png width:150 height:80 align:center}"]
	quest.067AB3E4C4492F0D.title: "Router cho Khai thác"
	quest.068728DE3B9B13C3.quest_desc: ["&dSupercritical Phase Shifter&r (SPS) là một cấu trúc multiblock khác được dùng để đưa Polonium vào với lượng lớn năng lượng để tạo ra khí &dAntimatter&r, có thể được kết tinh thành pellet.\n\n\n\nĐể xây SPS, bạn cần làm tổng cộng 72 &9SPS Casings&r (60 cho phần xây, 12 để làm cổng), 3 &9SPS Ports&r, 122 Reactor Glass, và một item khác chúng ta sẽ nói ở nhiệm vụ tiếp theo. Hãy lấy vật liệu trước!"]
	quest.068728DE3B9B13C3.title: "&dSupercritical Phase Shifter"
	quest.0696B725E840B996.quest_desc: ["Để đưa bất cứ thứ gì vào hoặc ra khỏi Lò phản ứng phân hạch, chúng ta cần &aFission Reactor Ports&r. Chúng có thể được cấu hình để đầu vào hoặc đầu ra bằng cách dùng &9Configurator&r. \n\n\n\nMỗi Lò phản ứng phân hạch &acần tối thiểu 4 Cổng&r:\n\n\n\n - 1 Đầu vào Dung môi\n\n - 1 Đầu ra Dung môi\n\n - 1 Đầu vào Nhiên liệu phân hạch\n\n - 1 Đầu ra Chất thải\n\n\n\nĐối với bản dựng khởi đầu này, hãy đặt một cổng ở mỗi phía như hình dưới đây. Đảm bảo cấu hình chúng khớp với danh sách đầu vào và đầu ra!\n\n\n\n{image:atm:textures/questpics/mek/port_example.png width:200 height:200 align:1}"]
	quest.0696B725E840B996.title: "Tương tác với Lò phản ứng phân hạch"
	quest.06B85804163DD18B.quest_desc: ["The Soaryn Box (Soaryn là tác giả của XyCraft) là rương của XyCraft.\n\n\n\nNó sẽ không giữ vật phẩm khi block bị phá! Tôi tự hỏi những ô vuông trên nó có chức năng gì?"]
	quest.06F2C42E6408149E.quest_desc: ["Tôi hy vọng bạn không lấy cắp cái này từ &c&lPyromancer&r, anh ấy là người tốt bụng!\n\n{image:atm:textures/questpics/iron_spells/spells_outfit_pyromancer.png width:50 height:100 align:center}"]
	quest.06F2C42E6408149E.title: "&cTrang phục Pyromancer"
	quest.06F8EDF7513F8611.title: "&dMực Huyền thoại&r"
	quest.074EC1E636CD6605.quest_desc: ["&cGiáp Netherite&r là tốt nhất mà &l&2Vanilla&r có thể có. Nó có cùng Điểm giáp với &bKim cương&r nhưng có nhiều Độ bền giáp hơn.\n\n\n\nCó lẽ vì bạn cần &bKim cương&r để chế tạo nó!"]
	quest.074EC1E636CD6605.quest_subtitle: "20"
	quest.074EC1E636CD6605.title: "&cGiáp Netherite"
	quest.07753C5D94312A50.quest_desc: ["&3Nâng cấp&r: Máy phát điện trái ngược với &3Nâng cấp&r: Nhà máy, thay vì dùng Năng lượng để nấu chảy, nó nấu chảy để tạo Năng lượng. Bạn sẽ không còn nấu chảy vật phẩm trong nó nữa, mỗi Nhiên liệu dùng sẽ được chuyển thành Năng lượng!\n\n\n\n(Tôi tự hỏi liệu kết nối Máy phát điện và Lò nấu Nhà máy có tốt hơn không thay vì chỉ dùng Nhiên liệu trong một cái)"]
	quest.07753C5D94312A50.title: "&3Nâng cấp&r: Máy phát điện"
	quest.077A214422FEFF02.quest_subtitle: "&f6.5 &cSát thương"
	quest.0790D3BB481162A6.quest_desc: ["Cần một Bàn chế tạo di động? Hoặc một Bàn rèn di động? \n\n\n\n&l&8Crafting On A Stick&r bổ sung các phiên bản di động của một số trạm chế tạo yêu thích của bạn! Đây là một thứ phải có trong giai đoạn đầu."]
	quest.0790D3BB481162A6.quest_subtitle: "Ít đặt chỗ, nhiều chế tạo"
	quest.0790D3BB481162A6.title: "Chế tạo... trên Que!"
	quest.07AD45DCF9EE3C2E.quest_desc: ["Món đồ này nâng cấp máy cơ bản thành máy Nhà máy Cơ bản."]
	quest.07AD45DCF9EE3C2E.quest_subtitle: "Nâng cấp lên Nhà máy"
	quest.07ECC87DFF2D3991.quest_desc: ["Khi bạn đã hoàn thành xây dựng &9Energized Induction Matrix&r đầu tiên, bạn sẽ thấy các hạt đỏ xung quanh cấu trúc để cho thấy nó đã hoàn thành.\n\n\n\nĐừng ngại nâng cấp với Cells và Providers cấp cao hơn! Cần không gian nhiều hơn cho chúng? Kích thước tối đa của Induction Matrix có thể là 18x18x18."]
	quest.07ECC87DFF2D3991.title: "&aHoàn thành &9Matrix"
	quest.07FDA46D83F8360D.quest_desc: ["Với 4 &6Allthemodium Nuggets&r và một Ender Pearl, bạn nhận được một Đệm Dịch Chuyển. \n\n\n\nĐặt nó xuống trong một trong các chiều Minecraft để dịch chuyển đến một chiều khác. \n\n\n\nĐể dịch chuyển, bạn cần shift + right click với tay chính và tay phụ trống! Điều này quan trọng, hãy đọc nó! \n\n\n\nCẢ HAI tay cần phải TRỐNG!"]
	quest.07FDA46D83F8360D.title: "Đệm Dịch Chuyển"
	quest.08245411AFDB63DB.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2cộng tác viên cộng đồng&r để sử dụng trong các modpack AllTheMods.\n\n\n\nVì tất cả các modpack &6AllTheMods&r được cấp phép theo &eTất cả các quyền được bảo lưu&r, nhiệm vụ này không được phép sử dụng trong bất kỳ modpack công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng.\n\n\n\nNhiệm vụ này được ẩn cố ý, nếu bạn thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.083D458032F0325C.quest_desc: ["&bME Export Bus&f định kỳ đẩy các vật phẩm trong bộ lọc danh sách trắng của nó ra bất kỳ kho lưu trữ bên ngoài nào mà bus đang hướng tới. Khác với Import Bus, Export Bus không thể hoạt động nếu không được lọc."]
	quest.083D458032F0325C.quest_subtitle: "O"
	quest.08697EB269B011FD.quest_desc: ["Với &dRonaza's Contact&r, bạn có thể nâng cấp &bIesnium Sacrificial Bowl&r của mình lên Eldritch Chalice. Khi được sử dụng trong nghi lễ, nó giảm thời gian hoàn thành... hoàn toàn. \n\n\n\nĐúng vậy, Eldritch Chalice khiến tất cả các nghi lễ hoàn thành ngay lập tức!"]
	quest.0893EFCAC7031FEA.quest_desc: ["Đã đến lúc nướng một chiếc Bánh, nếu bạn có sẵn Sữa và Trứng."]
	quest.0893EFCAC7031FEA.quest_subtitle: "Có bánh và ăn luôn"
	quest.089B1B9837AF4938.title: "&5Công cụ Unobtainium"
	quest.08AC2D81A1004984.title: "&6Allthemodium &5Hợp kim &3Trident"
	quest.08B60D8A25008CCC.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2cộng tác viên cộng đồng&r để sử dụng trong các modpack AllTheMods. \n\n\n\nVì tất cả các modpack &6AllTheMods&r được cấp phép theo &eTất cả các quyền được bảo lưu&r, nhiệm vụ này không được phép sử dụng trong bất kỳ modpack công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng. \n\n\n\nNhiệm vụ này được ẩn cố ý, nếu bạn thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.08CE14FFED813992.quest_subtitle: "13 Khối Hồng Tối Ượt"
	quest.08DDE018A804BFE7.quest_desc: ["Máy này hoạt động giống như Máy nghiền (Macerator) hoặc Máy nghiền bụi (Pulverizer), và sẽ nghiền quặng thành bụi.\n\n\n\nMáy này nghiền 3 quặng thô thành 4 bụi.\n\n\n\nĐây là bước đầu tiên của Nhà máy quặng của bạn. Nó cũng có thể được nâng cấp thành máy nhà máy, tăng số khe sử dụng."]
	quest.08DDE018A804BFE7.quest_subtitle: "Nghiền Quặng Thô thành Bụi"
	quest.08E47A27EFFB7C6B.quest_subtitle: "5 Khối Hồng Khô"
	quest.08E484DD3E751697.quest_subtitle: "B trong Roy G. Biv"
	quest.08E484DD3E751697.title: "&bNgọc Xychorium Xanh Dương"
	quest.09408C6DCAC90318.quest_desc: ["Khối này lưu trữ năng lượng, và cũng có thể được dùng để sạc đồ vật."]
	quest.09408C6DCAC90318.quest_subtitle: "Lưu Trữ Năng Lượng"
	quest.09733948CBCB3FB9.quest_desc: ["&dTầng 6&r là tầng cao nhất, bất cứ thứ gì có thể phá hủy đều có thể được khai thác bằng nó, bao gồm Vibranium và Unobtainium."]
	quest.09733948CBCB3FB9.title: "&dTầng Thu Hoạch 6"
	quest.09C82CDDA800D8C9.quest_desc: ["Wither là trùm thứ hai trong Minecraft, trùm này có tính chất lựa chọn hơn. \n\n\n\nBạn sẽ phải xây Wither để triệu hồn hắn. Sử dụng 4 Cát Linh Hồn (Soul Sand) theo hình chữ T và đặt 3 Đầu Xương Wither (Wither Skeleton Skulls) lên trên sẽ triệu hồn hắn! \n\n\n\nHắn có 300 Trái Tim và sẽ bay xung quanh bắn Đầu Xương Wither vào Người chơi hoặc Quái vật. \n\n\n\nKhi sức khỏe giảm còn một nửa, hắn sẽ nhận được khiên chống lại Đạn và sẽ cần phải giết hắn bằng Kiếm hoặc Rìu. \n\n\n\nMột khi bạn giết hắn, hắn sẽ rơi: Nether Star, cơ hội nhận Withering Soul, và một lượng lớn Vật phẩm Corail."]
	quest.09C82CDDA800D8C9.title: "Giết Wither"
	quest.09D18512037386C1.quest_desc: ["Để đặt Hiệu ứng Phép vào, bạn cần lấp đầy Potion Filter. \n\n\n\nĐể làm vậy: hãy có một Hiệu ứng Phép trên người, sau đó nhấp chuột phải với Potion Filter để loại bỏ nó khỏi bạn và thêm vào Filter, và lặp lại cho đến khi nó được lấp đầy và kích hoạt. \n\n\n\nĐiều này cũng hoạt động với các Hiệu ứng Phép từ mod hoặc những hiệu ứng bạn thường không thể lấy qua Phần xích như Haste hay Resistance."]
	quest.09E25B1CD6CABD5A.quest_desc: ["Nâng cấp này làm cho Router giống với Framed Block. \n\n\n\nNhấn Shift + Chuột phải lên một Block để thay đổi giao diện của Router thành nó. \n\n\n\nChỉ đừng làm mất nó!"]
	quest.0A1C2A7A8617D3E4.quest_subtitle: "Người chơi tốc độ thích thứ này."
	quest.0A1C2A7A8617D3E4.title: "Lúa mì"
	quest.0A1D4228271DECA3.quest_desc: ["Bạn đi đâu rồi?\n\n\n\nỒ, bạn chỉ còn một nửa kích thước trước đó. Đủ nhỏ để chui qua khe 1 Block."]
	quest.0A1D4228271DECA3.quest_subtitle: "Dây chuyền"
	quest.0A1D4228271DECA3.title: "&5Bùa Thu nhỏ&r"
	quest.0A25276925EB0CBA.quest_desc: ["Khi bạn đã thu thập tất cả Chalk có màu và Foundation Chalk, bạn có thể thực hiện nghi lễ loại thứ hai &dkhông có Demon&r, &dRonaza's Contact&r. Đây là nghi lễ tối thượng, sử dụng mọi thứ bạn đã học được cho đến nay!\n\n\n\nNó có số lần sử dụng hạn chế, nhưng mọi thứ được tạo ra từ nghi lễ này đều cực kỳ mạnh mẽ!"]
	quest.0A25276925EB0CBA.quest_subtitle: "Với kho báu thiêng liêng này, ta triệu hồi..."
	quest.0A25276925EB0CBA.title: "&dLiên lạc của Ronaza"
	quest.0A3C464EF7CDD5F6.quest_desc: ["&4Kệ Địa Ngục&r là cách giới thiệu đầu tiên của bạn về &cQuanta&r, chúng cho &c3% Quanta&r và &a3 Eterna&r. \n\n\n\nTốt hơn các Kệ thông thường phải không? \n\n\n\nBạn sẽ cần 16 cái cho bước tiếp theo, 15 &4Kệ Địa Ngục&r xung quanh &5Bàn khảo&r, với 1 cái trong Túi đồ của bạn. \n\n\n\nLàm 11 cái đầu tiên và tôi sẽ cho bạn 5 &4Kệ Địa Ngục&r còn lại!\n\n{image:atm:textures/questpics/apothic/enchant_hellshelf.png width:100 height:100 align:center}"]
	quest.0A3C464EF7CDD5F6.title: "&4Kệ Địa Ngục"
	quest.0A64D0937A5F7513.title: "Cần câu vàng"
	quest.0A9D5C5D2F4CDCC3.title: "&5Búa Unobtainium"
	quest.0AD2B11565B484E7.quest_desc: ["Bạn sẽ cần mọi Lò nung trước &5Netherite&r cho những cái này. Đúng tất cả, ngay cả &6Đồng&r! Ngay cả &7Bạc&r! Ngay cả &3Pha lê&r!"]
	quest.0AD2B11565B484E7.title: "&cR&6a&ei&2n&3b&9o&5w &cP&6l&ea&2t&3i&9n&5g"
	quest.0ADBE90B33ACC9FB.quest_desc: ["&cR&6a&ei&2n&3b&9o&5w&r &cG&6e&en&2e&3r&9a&5t&ce&6r&r là một sự tăng cường cho &cR&6a&ei&2n&3b&9o&5w&r &cF&6u&er&2n&3a&9c&5e&r khi sử dụng &3Mở rộng&r: Máy phát. Nếu tất cả 9 Lò nung khác (không tính AllTheModium Furnaces và cao hơn) đều xung quanh &cR&6a&ei&2n&3b&9o&5w&r &cF&6u&er&2n&3a&9c&5e&cr, có &3Mở rộng&r: Máy phát, và đang tích cực tạo Năng lượng (đã đổ nhiên liệu và chưa đầy) thì chúng sẽ tăng cường cho một &cR&6a&ei&2n&3b&9o&5w&r &cF&6u&er&2n&3a&9c&5e&cr có &3Mở rộng&r: Máy phát và đang hoạt động. Nó sẽ tạo thêm 2kFE mỗi tick!"]
	quest.0ADBE90B33ACC9FB.title: "&cR&6a&ei&2n&3b&9o&5w &cG&6e&en&2e&3r&9a&5t&co&6r&r"
	quest.0AE28C998A3BF136.quest_subtitle: "531,441 Netherrack"
	quest.0AEC181F5E21A299.quest_desc: ["Nếu bạn từng nghe ai đó nói về \"Sức mạnh Dưa hấu\", thì đây chính là nó. Máy phát điện &dGas-Burning Generator&r của Mekanism có thể tạo ra một lượng điện đáng kể bằng cách bơm &9Ethylene&r được làm từ Dưa hấu.\n\n\n\nĐể sản xuất &dEthylene&r, hãy bắt đầu bằng cách nghiền các vật liệu hữu cơ trong một &eCrusher&r để tạo ra &6Nhiên liệu sinh học&r. Dưa hấu thường được dùng cho việc này! Sau đó, nó được bơm vào một &dBuồng phản ứng áp suất&r (PRC).\n\n\n\nPRC cần Nước, Nhiên liệu sinh học và một ít Hydrogen để tạo Ethylene. Bạn có thể lấy Hydrogen từ việc tách nước trong một &9Máy tách điện phân&r.\n\n\n\nKhi bạn đã bắt đầu sản xuất Ethylene, hãy bơm nó vào Gas-Burning Generator để bắt đầu tạo điện!"]
	quest.0AEC181F5E21A299.quest_subtitle: "SỨC MẠNH DƯA HẤU!"
	quest.0AEC181F5E21A299.title: "&9Mekanism: &dMáy phát điện đốt khí"
	quest.0B218DD73FE8D985.quest_desc: ["Nếu bạn đã hoàn thành nhiệm vụ trước đó chính xác, bạn nên đã biến singularity đó thành một cặp &bQuantum Entangled Singularities&f. Các singularity mới này được dùng để liên kết cùng một thiết bị hình xuyến ương được gọi là &eQuantum Network Bridge&f.\n\n\n\nKhi hai chiếc xuyến ương riêng biệt này đã được liên kết bằng Quantum Entangled Singularities và được khởi động bằng một ít năng lượng AE (ví dụ: một energy cell), mạng ME có thể được mở rộng không dây ở phía bên kia của cây cầu, xuyên qua khoảng cách xa hoặc thậm chí các dimension."]
	quest.0B218DD73FE8D985.title: "Cầu Mạng Lượng tử"
	quest.0B3EA604C5172D98.quest_desc: ["Để chúng ta có thể chỉ định &c&mQuỷ&r &9Bạn bè&r nào chúng ta muốn triệu hồi, chúng ta cần tạo một &bSách Ràng buộc&r cụ thể.\n\n\n\nĐể làm điều này, bạn cần tinh chế một ít Thuốc nhuộm Đen trong &dSpiritfire&r để lấy Mực tinh khiết. Với thứ này, chúng ta sẽ tạo &bSách Ràng buộc&r đầu tiên, nó sẽ triệu hồi một &aQuỷ Foliot&r.\n\n\n\nMột cách khác, bạn có thể tạo một Sách Ràng buộc trống, có thể được nhuộm sau đó để phù hợp với cấp độ nghi lễ bạn cần."]
	quest.0B3EA604C5172D98.title: "&bSách &dRàng buộc"
	quest.0BB42C5861B22D32.quest_desc: ["&bLò phản ứng Mycelial&r bao gồm tất cả các Máy phát điện Mycelial hoạt động cùng lúc, gần khối lò phản ứng, và nó sản xuất tổng cộng &a25MFE/t&r.\n\n\n\nNghe có vẻ tốt, nhưng bạn cần tự động hóa một số thứ để nó hoạt động, xem mỗi Máy phát điện Mycelial tiêu thụ gì để hoạt động, và tự động hóa chúng, hầu hết mọi thứ đều đơn giản, nhưng một số khác, thì không đơn giản lắm... &oxem xét Disenchanting Mycelial Generator&r.\n\n\n\nNhưng sau khi bạn tự động hóa tất cả, bạn không cần dừng lại ở một, bạn có thể tạo thêm nhiều lò phản ứng."]
	quest.0BB42C5861B22D32.quest_subtitle: "Đó không phải là Yourcelial Reactor"
	quest.0BB42C5861B22D32.title: "&9Industrial Foregoing: &bLò phản ứng Mycelial"
	quest.0BCCDE24D378F260.quest_subtitle: "Tầng: &d3"
	quest.0BCCDE24D378F260.title: "&dKhung Máy Nâng Cao"
	quest.0BD6365534BF04D5.quest_desc: ["Với Lime Chalk, đã đến lúc khám phá các &5Nghi Lễ Chiếm Hữu&r. Các nghi lễ này hơi khác với những cái khác vì chúng đều yêu cầu một con sinh vật sống để hiến tế, thường là những sinh vật nhỏ như Gà, Ong, Dơi, v.v. Tuy nhiên, khi nghi lễ trở nên phức tạp hơn, chúng sẽ yêu cầu những hiến tế ngày càng lớn.\n\n\n\nNgay cả khi bạn đã đặt tất cả các vật phẩm cần thiết và Sách Ràng Buộc vào Bát Hiến Tế Vàng, Nghi Lễ sẽ không bắt đầu cho đến khi bạn giết con sinh vật hiến tế trên các ký hiệu.\n\n\n\nĐược khuyến nghị là bạn nên tạo một loại vật phẩm bắt sinh vật như Empty Soul Gem, Jar, Mob Imprisonment Tool, hoặc Quantum Catcher!\n\n\n\nTầng đầu tiên của &5Nghi Lễ Chiếm Hữu&r là &eHeidryn's Lure&r, chỉ được dùng để lấy các vật phẩm thông thường như Đầu Xương và Đá End. Vì vậy, bạn có thể bỏ qua thẳng sang tầng thứ hai của nghi lễ, &aIhagan's Enthrallment&r."]
	quest.0BD6365534BF04D5.quest_subtitle: "Bạn sẽ gọi ai?"
	quest.0BD6365534BF04D5.title: "&aIhagan's Enthrallment"
	quest.0C856BBB1679A7DD.quest_desc: ["Trên trang này, bạn sẽ tìm thấy một số vật phẩm và thông tin hữu ích để hỗ trợ bạn trong hành trình!"]
	quest.0C856BBB1679A7DD.quest_subtitle: "Và Các Vật Phẩm Hữu Ích Khác!"
	quest.0C93D7A607AB8B83.quest_desc: ["Để xác nhận các khối, mở bản đồ của bạn bằng phím &6M&r, sau đó nhấp vào biểu tượng &aKhối Đã Xác Nhận&r ở góc trên bên trái.\n\n\n\nĐể xác nhận một khối, nhấp chuột trái và kéo để xác nhận.\n\n\n\nĐể buộc tải một khối, shift + nhấp chuột trái vào khối. Nếu thực hiện đúng, bạn sẽ thấy các đường kẻ xuyên qua khối."]
	quest.0CC0632E8276C787.quest_desc: ["Đặt Bàn Thông Tin trong &l&cThe Nether&r để đến &b&lThe Other&r."]
	quest.0CC0632E8276C787.title: "&c&lThe Nether"
	quest.0CD04A00529FE1C9.quest_desc: ["Rương Đồng có thể được chế tạo nhưng không cần thiết để làm Rương Sắt, tuy nhiên nó có thể được sử dụng nếu bạn muốn tiết kiệm một ít Sắt."]
	quest.0CD04A00529FE1C9.title: "&6Rương Đồng"
	quest.0CE1F6DE5FD6A6D9.title: "&aVòng Nâng Cấp Evocation&r"
	quest.0CE236731DF15DFF.quest_desc: ["Tại sao phải chờ? Thông thường, các vật thể rơi ra trong Minecraft cần một khoảng thời gian để chạm đất trước khi có thể nhặt lại. \n\n\n\nNhưng tại sao phải chờ?\n\n\n\nNâng cấp này cho phép Mô-đun Chân không phải chờ và ngay lập tức nhặt các vật thể. \n\n\n\nRất tốt để giảm lag!"]
	quest.0D01524F249E25D7.quest_subtitle: "Ai tắt đèn vậy?"
	quest.0D01524F249E25D7.title: "&8Đá Quý Xychorium Bóng Tối"
	quest.0D18BBB04693885A.quest_desc: ["Ràng Buộc Cao Cấp của Strigeor là cấp độ thứ hai của &6Nghi Lễ Thấm Nhuần&r. Nó được dùng cho nhiều mục đích khác nhau, nhưng những thứ chính chúng ta cần là Cuốc Đã Thấm Nhuần và Dán Xám."]
	quest.0D18BBB04693885A.quest_subtitle: "Nghi Lễ \"Mọi Thứ\""
	quest.0D18BBB04693885A.title: "&aRàng Buộc Cao Cấp của Strigeor"
	quest.0D4C64DD58567758.quest_desc: ["Thêm một bể chứa vào Ba-lô."]
	quest.0D5691403AEC25A8.quest_desc: ["Router cũng có thể được dùng cho nông nghiệp!\n\n\n\nĐầu tiên, bắt đầu với một trang trại đơn giản. Sau đó bạn sẽ cần một Module Kích hoạt và hướng nó về các Loại cây. Tiếp theo, đặt một Module Chân không vào Router của bạn để thu thập các Loại cây. Cuối cùng, đặt tất cả vào Router, cấp nguồn bằng Đá đỏ, và để nó tự canh tác!\n\n{image:atm:textures/questpics/router/router_farm.png width:60 height:150 align:center}"]
	quest.0D5691403AEC25A8.title: "Router cho Nông nghiệp"
	quest.0D6D45DBA64E612D.quest_desc: ["Khoảng thời gian sinh mồi tối đa là thời gian có thể mất để sinh mồi. Giống như Tối thiểu, nó có thể thấp nhất là 20 và cao nhất là 32,767. Mỗi Đồng hồ điều chỉnh tốc độ của bộ sinh mồi lên 10. Tốc độ được biểu thị bằng tick, trong đó 20 tick bằng 1 giây. Vì vậy, khoảng thời gian sinh mồi nhanh nhất có thể là 1 giây giữa mỗi lần."]
	quest.0D6D45DBA64E612D.title: "Khoảng thời gian sinh mồi tối đa"
	quest.0DC8B68CDF945348.quest_desc: ["Router cho và Router lấy. \n\n\n\nModule này hữu ích cho cả người xây dựng và thậm chí cả người khai thác! Nó có thể được cài đặt để gửi vật phẩm từ Bộ đệm của nó vào Kho đồ của bạn hoặc lấy vật phẩm từ Kho đồ của bạn vào Bộ đệm của nó. \n\n\n\nHoàn hảo cho Khai thác dải, hãy để nó lấy tất cả Đá cuội và Deepslate từ Kho đồ của bạn và đặt vào Thùng Rác."]
	quest.0E02CE4469FCA4C9.quest_desc: ["Kích hoạt Đá đỏ cung cấp cho bộ sinh mồi của bạn một công tắc bật/tắt. Không có Nguồn Đá đỏ, nó sẽ không sinh mồi."]
	quest.0E02CE4469FCA4C9.title: "Kích hoạt Đá đỏ"
	quest.0E03F5EAE4963ECB.quest_subtitle: "8 Khối Xanh Khô"
	quest.0E057B7F76401421.quest_subtitle: "Nâng cấp Đầu tiên"
	quest.0E057B7F76401421.title: "&6Ba lô Đồng"
	quest.0E0CAA31480EC0A1.quest_desc: ["Cho phép Ba-lô nhặt vật phẩm."]
	quest.0E0CAA31480EC0A1.quest_subtitle: "Cho phép Ba-lô nhặt vật phẩm."
	quest.0E20A9B79D1C6637.quest_desc: ["Warden là một trùm được thêm vào trong phiên bản 1.20. \n\n\n\nHắn xuất hiện khi có 3 Sculk Shriekers tự nhiên kích hoạt liên tiếp, hoặc bất kỳ Shrieker nào kích hoạt sau khi một Warden đầu tiên đã xuất hiện. \n\n\n\nHắn là sinh vật mạnh nhất được Minecraft thêm vào, với 500 Trái tim và gây hơn 20 Trái tim sát thương với các đòn tấn công. \n\n\n\nCác đòn tấn công của hắn bao gồm đánh trực tiếp và Sóng Âm (Sonar Blasts) cho những mục tiêu ở xa. \n\n\n\nĐiểm yếu duy nhất của hắn là bị mù, nhưng như Daredevil, điều này chỉ làm các giác quan khác của hắn mạnh hơn! Nếu bạn ở gần, hắn có thể ngửi thấy bạn và hãy cẩn thận với tiếng ồn! \n\n\n\nNếu bạn bằng cách nào đó giết được hắn, hắn sẽ rơi: Sculk Catalysts, Warden Carapace, và Heart of the Deep."]
	quest.0E20A9B79D1C6637.title: "Giết Warden"
	quest.0E594BC58CC7476F.quest_desc: ["Có thể hắn là ác nhân, nhưng hắn vẫn rất thời trang. \n\n{image:atm:textures/questpics/iron_spells/spells_outfit_archevoker.png width:60 height:100 align:center}"]
	quest.0E594BC58CC7476F.title: "&aTrang phục Archevoker"
	quest.0E716B90E60C486B.quest_desc: ["Đôi khi cách tốt nhất để chiến đấu, là không chiến đấu... mà là chạy trốn! \n\n\n\nVới &4Vòng cổ Hoảng loạn&r, khi bị đánh bạn sẽ nhận hiệu ứng Tăng Tốc trong một thời gian ngắn. Vừa đủ để chạy thoát!"]
	quest.0E716B90E60C486B.quest_subtitle: "Vòng cổ"
	quest.0E716B90E60C486B.title: "&4Vòng cổ Hoảng loạn&r"
	quest.0E809747193ED3A9.quest_desc: ["Thành phần lưu trữ cấp MEGA thứ ba, cung cấp &e16777216&f (16384k) byte dung lượng."]
	quest.0E809747193ED3A9.quest_subtitle: "x4^2"
	quest.0E809747193ED3A9.title: "Linh kiện lưu trữ 16M"
	quest.0E8647B8EB4AAC41.quest_desc: ["Sinh vật hòa bình -> Nhiều Pink Slime hơn.\n\nSinh vật hung dữ -> Nhiều thịt hơn."]
	quest.0E8647B8EB4AAC41.title: "Pink Slime \& Thịt lỏng"
	quest.0E9CE6241CDBC420.quest_desc: ["Cái &9Ranged Pump&r đặc biệt đến mức nó có mod riêng!\n\n\n\nCái &9Pump&r sẽ thu thập &9Water Sources&r bên dưới và thay thế chúng bằng Stone.\n\nTuy nhiên nó cần Energy để hoạt động, nhưng rất đáng, nó có phạm vi cực lớn!\n\n\n\nCái &9Water&r thu thập được sẽ cần được Piped ra ngoài."]
	quest.0E9CE6241CDBC420.title: "&l&9Máy bơm tầm xa"
	quest.0EA9E52B67B533DF.quest_desc: ["Khi cao su được nung chảy, nó biến thành nhựa, đây là tài nguyên chính trong Industrial Foregoing."]
	quest.0EC2053B191C55C6.quest_desc: ["Chiết xuất nhựa từ khúc gỗ, chạy nhanh hơn khi được cấp năng lượng.\n\n\n\nKiểm tra JEI để xem khúc gỗ chấp nhận và lượng nhựa. Khúc gỗ tốt nhất để dùng là Acacia."]
	quest.0ED11FCF6298CE85.quest_desc: ["&e&lIron's Spells&r &4Giáp máu&r!"]
	quest.0ED11FCF6298CE85.quest_subtitle: "20"
	quest.0ED11FCF6298CE85.title: "§4Trang phục Tông đồ"
	quest.0EED5D755D2C866A.quest_desc: ["§d§lEnder§r được dùng để lấy toàn bộ sức mạnh của §dEndermen§r và §dEnder Dragon§r, và tất nhiên là sử dụng cho bản thân. §dDịch chuyển§r, §dQuả cầu lửa§r, và §dHơi thở Rồng§r chỉ là một vài trong số đó!\n\n\n\n§d§lEnder's§r Vật liệu trọng tâm là §dEnder Pearls§r.\n\n\n\nVà các §dCuộn§r của nó có màu §5Tím§r với chữ §dHồng§r."]
	quest.0EED5D755D2C866A.title: "§d§lEnder"
	quest.0EFF1AA37772156B.quest_desc: ["Khối này cung cấp nước cho nhà bếp đa khối.\n\n\n\nNó cũng có thể cung cấp nước vô hạn bằng cách bơm nước qua cáp hoặc ống dẫn."]
	quest.0EFF1AA37772156B.quest_subtitle: "1 Khối là đủ!"
	quest.0EFF1AA37772156B.title: "Bồn rửa = Nước vô hạn"
	quest.0F026D5A17CCCF51.quest_desc: ["§dNetherite§r items thậm chí tốt hơn tổng thể, và sẽ không cháy trong lava! Tuy nhiên bạn vẫn sẽ cháy, ngay cả khi đang mặc giáp. Đừng thử.\n\n\n\nNhững item này có thể được dùng để làm một số công cụ và giáp tốt nhất trong game."]
	quest.0F026D5A17CCCF51.title: "§dHạng Netherite"
	quest.0F03E75CF79BADD7.quest_desc: ["MEGA Cells§f cung cấp §bTế bào Lưu trữ Hàng loạt§f đặc chế, bị giới hạn không quá §omột§r loại item có thể lưu trữ trên mỗi tế bào nhưng có thể lưu trữ một số lượng §o§lVÔ HẠN§r* của loại item đó. Trước khi nó chấp nhận một loại item, nó phải được lọc trước bằng Bàn làm việc Tế bào.\n\n\n\n*§oVề kỹ thuật là 'max long'. Nếu bạn biết, bạn biết.§r"]
	quest.0F03E75CF79BADD7.quest_subtitle: "Hàng loạt và cắt"
	quest.0F03E75CF79BADD7.title: "Kho lưu trữ vật phẩm"
	quest.0F1CA44520BDEFEA.quest_subtitle: "6,561 Khối kim cương"
	quest.0F1D6F4729CC38F3.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_rib.png width:100 height:150 align:center}"]
	quest.0F1D6F4729CC38F3.quest_subtitle: "Pháo đài Nether"
	quest.0F1D6F4729CC38F3.title: "Trang trí giáp Rib"
	quest.0F326EEEC2EBE4E5.quest_desc: ["Sử dụng Buồng Làm Phong Phú, bạn có thể làm phong phú vật phẩm để chuyển chúng thành phiên bản đã làm phong phú.\n\n\n\nNhững vật phẩm \"đã làm phong phú\" này cung cấp 8 lần lượng mb trong Máy Pha Kim Loại.\n\n\n\nNếu bạn dự định làm nhiều thép, hãy làm phong phú Than gỗ trước tiên!"]
	quest.0F326EEEC2EBE4E5.quest_subtitle: "Hãy làm phong phú vật phẩm trước tiên!"
	quest.0F3A0A4DC18E5E55.quest_desc: ["&aEterna&r thiết lập &5Cấp độ Phép thuật&r, quyết định bạn có thể hoặc sẽ nhận được &5Phép thuật&r nào! \n\n\n\nMặc định của nó là &a0&r và tối đa là &a50&r. \n\n\n\nGần như tất cả &7Kệ sách&r sẽ cung cấp &aEterna&r nhưng mỗi cái có giới hạn tối đa chúng có thể đặt."]
	quest.0F3A0A4DC18E5E55.title: "&aEterna"
	quest.0F3D51FFD2FE8DCB.quest_desc: ["Với cuốc cấp Diamond, bạn sẽ có thể khai thác &dObsidian&r. Obsidian có thể được dùng để tạo cổng đến &cNether&r.\n\n\n\nKhung cổng có thể có nhiều kích cỡ khác nhau, nhưng hầu hết đều dùng hình dạng cơ bản 'Cửa'. Đây là hình dạng rỗng 4x5, sử dụng ít nhất 10 Obsidian. Bạn không cần dùng Obsidian cho các góc, chỉ cần khung cổng thôi!\n\n\n\n{image:atm:textures/questpics/gettingstarted/example_netherportal.png width:175 height:201 align:1}"]
	quest.0F3D51FFD2FE8DCB.title: "&cĐến Nether&r!"
	quest.0F55D0B4D5094EDB.quest_desc: ["Trong khi tạo nhiều chuỗi nhiệm vụ cho ATM7, Trader Villager nghĩ rằng việc liên tục đẩy tôi xung quanh trong màn hình nhiệm vụ sẽ rất buồn cười.\n\n\n\n\"Loại bỏ chúng. Tất cả.\"\n\n\n\n- AlfredGG \n\n\n\n\"Tôi ủng hộ điều này!\" \n\n\n\n- Toshiba"]
	quest.0F55D0B4D5094EDB.quest_subtitle: "\"Đây là chuyện cá nhân\" - AlfredGG"
	quest.0F55D0B4D5094EDB.title: "Giết Trader Villager và những con Llamas khó chịu của hắn"
	quest.0F89BFD4A3F63A48.quest_desc: ["Một số mob (chủ yếu là quái vật) cần mức độ ánh sáng nhất định để sinh ra. Loài hung ác cần mức ánh sáng thấp, còn loài hòa bình cần mức cao. Sử dụng Đèn linh hồn sẽ giúp bạn không phải lo lắng về mức độ ánh sáng vì nó bỏ qua yếu tố này! Điều này không bỏ qua các yêu cầu khác để sinh ra, ví dụ như động vật nuôi cần có cỏ."]
	quest.0F89BFD4A3F63A48.title: "Bỏ qua Ánh sáng"
	quest.0F8F37D7E12078F5.quest_subtitle: "Hoàn thành tất cả các mẹo!"
	quest.0FAAE744E156D8EF.quest_desc: ["Mycelial Reactor bao gồm tất cả các Mycelial Generators hoạt động cùng lúc, gần khối lò phản ứng, và sản xuất tổng cộng &a25MFE/t&r.\n\n\n\nNghe có vẻ tốt, nhưng bạn cần tự động hóa một số thứ để nó hoạt động, xem mỗi Mycelial Generator tiêu thụ gì để hoạt động, và tự động hóa chúng. Hầu hết mọi thứ đơn giản, nhưng một số thì không... &oví dụ như Disenchanting Mycelial Generator&r.\n\n\n\nNhưng sau khi bạn tự động hóa tất cả, bạn không cần dừng lại ở một, bạn có thể tạo thêm nhiều lò phản ứng."]
	quest.0FAAE744E156D8EF.quest_subtitle: "Lò phản ứng Mycelial, hử?"
	quest.0FD62827710F0AC6.quest_desc: ["Magmator sẽ tạo ra FE khi được cung cấp Lava."]
	quest.0FF852DE33E41C90.quest_desc: ["Nếu chúng ta muốn tạo ra lượng lớn năng lượng, chúng ta cần một cách để lưu trữ tất cả nó, và những Khối Năng lượng đó không đủ dùng.\n\n\n\nChúng ta sẽ tạo một khối đa khối có thể tùy chỉnh dùng để lưu trữ lượng lớn năng lượng, nhưng trước tiên, chúng ta cần làm một ít Bụi Lithium!\n\n\n\nBạn nên có một ít Nước mặn được tạo ra từ nhiệm vụ trước đó bằng cách sử dụng &aNhà bay hơi nhiệt&r. Chạy &eNước mặn&r qua một &aNhà bay hơi nhiệt&r khác để có Lithium lỏng, sau đó sử dụng &9Máy ngưng tụ quay&r để có Lithium mà bạn có thể chạy qua &9Máy kết tinh hóa học&r để có &aBụi Lithium&r."]
	quest.0FF852DE33E41C90.title: "Lưu trữ Năng lượng Nâng cao"
	quest.0FFF2BEE5D8EBE12.title: "Lò phản ứng (Niotic)"
	quest.103834774B57D611.quest_desc: ["Cổng End Mini sẽ cần khá nhiều &dKệ End&r. Đây là các cấp cuối cùng của Kệ mà bạn sẽ nhận được từ &5&lApotheosis&r. Bạn sẽ cần &dHơi thở Rồng được tăng cường&r để chế tạo chúng.\n\n\n\nSau đó bạn chỉ cần Mắt Ender mà bạn cần phải chế tạo chúng để thực sự có được &dKệ End&r.\n\n\n\nNếu bạn somehow đến được &d&lThe End&r và có được Kệ mà không có Mắt Ender thì tôi ấn tượng!"]
	quest.104EBBC08B4733F5.quest_desc: ["&dMáy mô phỏng&r là máy chính trong HNN.\n\n\n\nKhi được cấp năng lượng, nó sẽ chạy mô phỏng dựa trên &bMô hình Dữ liệu&r được đặt bên trong. Năng lượng yêu cầu cũng phụ thuộc vào Mô hình Dữ liệu được đặt bên trong, và có thể thấy trong tooltip của Mô hình.\n\n\n\nMáy cũng yêu cầu ít nhất một &9Ma trận Dự đoán&r để chạy mô phỏng.\n\n\n\nKết quả mô phỏng sẽ được xuất ra Ma trận. Các mô phỏng luôn tạo ra một loại &eDự đoán Chung&r, có thể được sử dụng trong các công thức chế tạo khác nhau. Chúng cũng thay đổi tùy theo nguồn gốc của quái vật trong Mô hình Dữ liệu.\n\n\n\nNếu mô phỏng thành công, bạn sẽ nhận được một &dDự đoán Quái vật&r dựa trên mô hình. Cấp độ cao hơn của Mô hình Dữ liệu được sử dụng, tỷ lệ thành công cho mô phỏng càng cao."]
	quest.104EBBC08B4733F5.title: "&aMô phỏng Cái chết"
	quest.105442DA79829777.quest_desc: ["Với 8 &7Sách&r và một Đe, chúng ta có thể làm &8Cuốn sách Phá bỏ&r. Thực ra là 8 cuốn, nhưng bạn hiểu ý rồi!\n\n\n\nBằng cách kết hợp một Món đồ với &8Cuốn sách&r trong Đe, chúng ta có thể lấy đi một nửa &5Phép thuật&r khỏi Món đồ.\n\n\n\nĐiều này sẽ dẫn đến việc Món đồ bị vỡ và mất hiệu lực sau khi hoàn thành. Tôi không khuyên dùng nó, thay vào đó bạn nên nâng cấp nó!"]
	quest.105442DA79829777.quest_subtitle: "Một nửa Phép thuật, làm vỡ Món đồ"
	quest.105442DA79829777.title: "&8Cuốn sách Phá bỏ"
	quest.10672B5991E5FC34.quest_desc: ["Đồ của tôi, đừng đụng vào.\n\n\n\nChỉ bạn mới có thể sử dụng và nghịch với Router sau khi lắp Nâng cấp."]
	quest.1069244EB72F64CA.quest_desc: ["Tiêu thụ nhiều Năng lượng hơn với các Module Năng lượng!"]
	quest.10E8BC20D406D9FB.quest_subtitle: "Tạo ra nhiều loại Vật liệu Nether"
	quest.110BF3A2BE85F911.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2Người đóng góp cộng đồng&r để sử dụng trong các Modpack AllTheMods.\n\n\n\nVì tất cả các pack &6AllTheMods&r được cấp phép theo &eAll Rights Reserved&r, Nhiệm vụ này không được phép sử dụng trong bất kỳ pack công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng.\n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.110D27EA86CDA62B.quest_desc: ["Hút vật phẩm vào Ba lô."]
	quest.1112E4E2CCEB2467.quest_desc: ["Vậy bây giờ, bạn nên có 5 máy đã sẵn sàng để xử lý quặng của mình. Bạn đã sẵn sàng để làm nó phức tạp hơn chưa?\n\n\n\nNhà máy của bạn nên là: Buồng Tiêm Hóa chất > Buồng Làm Sạch > Máy Dập > Buồng Làm Giàu > Lò/Nhà Luyện kim.\n\n\n\nDễ dàng đến giờ, phải không?\n\n\n\nVậy hãy thắt dây an toàn. Sắp trở nên hoang dã đây."]
	quest.1112E4E2CCEB2467.quest_subtitle: "Nhà máy Quặng Cấp 3"
	quest.111E4ACF7D570EE8.quest_desc: ["Chỉ là Cấu trúc khó nhất trong &2&lVanilla Minecraft&r. Vì vậy tất nhiên đó là nơi bạn sẽ phải tìm kiếm &6Allthemodium&r!\n\n\n\nBạn có thể tìm thấy Quặng trên tường của các Hang động xung quanh các Thành phố Cổ, nó Tỏa sáng nên sẽ dễ nhận biết nhưng rất hiếm!\n\n\n\n{image:atm:textures/questpics/allthemodium/all_city.png width:200 height:100 align:center}"]
	quest.111E4ACF7D570EE8.title: "Thành phố Cổ"
	quest.11A0593C0E2E6A35.quest_desc: ["Sử dụng &eEziveus' Spectral Compulsion&r, chúng ta có thể thổi hồn vào vô số khối thiên nhiên khác nhau để tạo thành một ít &2Paste Thiên nhiên&r. Kết hợp Paste này với một ít Phấn Trắng Không Tinh khiết để tạo ra Phấn Xanh."]
	quest.11A0593C0E2E6A35.title: "&2Phấn Xanh"
	quest.11C5F17C6BB1237B.quest_desc: ["Khi đeo &5Vòng tay Khô héo&r, các Đòn tấn công cận chiến có cơ hội gây hiệu ứng Wither.\n\n\n\nXin lỗi người dùng Cung!"]
	quest.11C5F17C6BB1237B.quest_subtitle: "Cổ tay (Tay)"
	quest.11C5F17C6BB1237B.title: "&5Vòng tay Khô héo&r"
	quest.11D09E918015355C.quest_desc: ["&cMáy phát nhiệt&r của Mekanism là một cách tiếp cận khác với sản xuất năng lượng cơ bản. Nó có hai chế độ tạo năng lượng:\n\n\n\n&9Thụ động:&r Bao quanh máy phát nhiệt với khối Lava nguồn hoặc dòng chảy sẽ tạo ra năng lượng thụ động theo thời gian thông qua nhiệt. Đặt một khối Lava nguồn lên trên và để nó chảy xuống hai bên. Hãy đảm bảo đã nối Ống dẫn để thu năng lượng trước!\n\n\n\n&9Chủ động:&r Đặt vật liệu cháy như Than hoặc Gỗ vào máy sẽ đốt nhiên liệu để tạo năng lượng. Cách này không hiệu quả cho lắm."]
	quest.11D09E918015355C.title: "&cMáy phát nhiệt"
	quest.11D57C768032E3F7.quest_subtitle: "Tùy chọn lọc thêm"
	quest.11D57C768032E3F7.title: "&eNâng cấp Magnet Nâng cao"
	quest.11E957CDEFA0CAAB.quest_desc: ["Chào mừng đến với &5&lThe Beyond&r! \n\n\n\nỞ đây không có gì cả! \n\n\n\nBạn có thể cần một Angel Block."]
	quest.11E957CDEFA0CAAB.title: "&5&lThe Beyond"
	quest.122E6E7CABCB17E7.quest_desc: ["Vì một lý do nào đó, Creepers sợ Mèo. Creepers cũng rất ngốc và tin rằng những con Mèo mà đôi &7Dép&r của bạn trông giống là thật. \n\n\n\nTất cả Creepers sẽ chạy trốn bạn và sẽ không hung tợn khi đôi &7Dép&r này được đeo. \n\n\n\nNgoài ra còn phát ra tiếng mèo kêu khi bạn bị thương! (Tuy nhiên không thể đảm bảo bạn luôn hạ cánh an toàn trên đôi Chân của mình)."]
	quest.122E6E7CABCB17E7.quest_subtitle: "Giày"
	quest.122E6E7CABCB17E7.title: "&7Dép Mèo&r"
	quest.12449D23295CF9ED.quest_desc: ["Mặc dù có thể không có con &9Sứa&r nào trong &2Minecraft&r, chúng ta vẫn có thể lấy được sức mạnh của chúng! Với &9Vòng cổ Sứa&r! Khi đeo nó, khả năng thứ nhất và thụ động cho phép bạn không chìm trong nước, có thể đi trên mặt nước.\n\n\n\nKhả năng thứ hai, cũng là một khả năng thụ động, khiến bạn có thể chích những sinh vật đến gần. Nó có thể được nâng cấp để gây nhiều sát thương hơn.\n\n\n\nKhả năng cuối cùng trao một hiệu ứng cho Khả năng thứ hai. Bất kỳ sinh vật nào bị Khả năng thứ hai đánh trúng sẽ bị tê liệt! May mắn là giờ không còn con &9Sứa&r nào trong &2Minecraft&r nữa..."]
	quest.12449D23295CF9ED.quest_subtitle: "Tìm thấy trong Tàu đắm và Di tích Đại dương"
	quest.12449D23295CF9ED.title: "&9Vòng cổ Sứa"
	quest.1245126B4338C019.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_vex.png width:100 height:150 align:center}"]
	quest.1245126B4338C019.quest_subtitle: "Biệt thự Rừng"
	quest.1245126B4338C019.title: "Viền Giáp Vex"
	quest.12A63C5F8E918266.quest_desc: ["Những &ađôi giày cá&r này giúp bạn bơi nhanh hơn với Khả năng thứ nhất. Nâng cấp chúng để bơi nhanh hơn một chút!\n\n\n\nKhả năng thứ hai cũng hoạt động với &9Nước&r, nhưng là nước từ trên trời. Bạn sẽ chạy nhanh hơn khi trời mưa.\n\n\n\nKhả năng cuối cùng ảnh hưởng đến phổi của bạn, bạn có cơ hội không sử dụng Bong bóng Oxy khi dưới nước."]
	quest.12A63C5F8E918266.quest_subtitle: "Tìm thấy trong Tàu đắm và Di tích Đại dương"
	quest.12A63C5F8E918266.title: "&aGiày lưỡng cư"
	quest.12AE2856444996F6.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2đóng góp viên cộng đồng&r để sử dụng trong các modpack AllTheMods.\n\n\n\nVì tất cả các modpack &6AllTheMods&r được cấp phép theo &eAll Rights Reserved&r, nhiệm vụ này không được phép sử dụng trong bất kỳ modpack công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng.\n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.12D271359D48210E.quest_desc: ["Lò phản ứng nhiệt hạch cần nhiên liệu rất đặc biệt: &dD-T Fuel&r chính xác.\n\n\n\nCó hai cách để cấp nhiên liệu cho Lò phản ứng: Hoặc là bơm D-T Fuel trực tiếp vào Lò phản ứng với tốc độ 1,000mb/t, hoặc là bơm từng nhiên liệu một cách riêng biệt với tốc độ kiểm soát.\n\n\n\nĐể bắt đầu, hãy bơm chúng riêng biệt. Chúng ta có thể cần biết cách chế tạo chúng nữa."]
	quest.12D271359D48210E.title: "Cấp nhiên liệu cho &dLò phản ứng nhiệt hạch"
	quest.12ED1EE85E146A4B.quest_desc: ["Harvester Pylons hoạt động như một Auto-Farm rất đơn giản. Đặt Pylon trên hoặc trong Nguồn Nước và nó sẽ tự động thu hoạch và trồng lại các Cây trồng đã trưởng thành trong khu vực được thiết lập xung quanh nó. \n\n\n\nKhu vực có thể được thiết lập thành 3x3, 5x5, 7x7, hoặc 9x9 Khối xung quanh Pylon. \n\n\n\nNó sẽ cần một Cuốc để sử dụng trên các Cây trồng và sẽ cần một Kho chứa như một cái Rương phía trên nó để đặt các Cây trồng. Làm tất cả những điều đó và nếu nó được Bật, nó sẽ bắt đầu canh tác!\n\n\n\n(Cẩn thận khi sử dụng nhiều bộ điều chỉnh với nó như Lilypads hoặc phân bón vì khi nó canh tác rất nhanh, nó có thể trở thành kẻ ăn TPS)."]
	quest.134608BB2B04D96E.quest_desc: ["Rương có 27 ô và có thể được kết hợp thành rương đôi để lưu trữ gấp đôi số lượng đó."]
	quest.134608BB2B04D96E.quest_subtitle: "Cái Rương"
	quest.134608BB2B04D96E.title: "Kho chứa gốc"
	quest.1348995F64A94396.quest_desc: ["&bMàn hình chế tạo&f hiển thị item đang được chế tạo tổng thể, cùng với số lượng còn lại của item đó vẫn đang được chế tạo.\n\n\n\nCả màn hình AE2 cơ bản và màn hình MEGA đều hoạt động giống hệt nhau, nhưng được cung cấp cho mục đích thẩm mỹ."]
	quest.1348995F64A94396.quest_subtitle: "Tải thêm VRAM"
	quest.13AFCD3B6F62B986.quest_desc: ["Cung cấp công thức Ice và Snow!"]
	quest.13AFCD3B6F62B986.quest_subtitle: "Băng, Băng, Em yêu!"
	quest.13AFCD3B6F62B986.title: "Nâng cấp Băng"
	quest.13F77C38AC015E9F.quest_desc: ["Cao chót vót trên những ngọn núi, cao hơn cả đám mây là một &bTháp&r khác. Nó khiến bạn rùng mình. \n\n\n\nTháp &b&r được làm từ Đá, Gỗ Sồi Đen và Deepslate. Nó có một Tháp thứ hai nhánh ra. Có một cầu thang bên ngoài dẫn đến tầng một. Từ đó bạn có thể leo cầu thang bên trong lên phòng ngủ hoặc tháp thứ hai. \n\n\n\nHoặc bạn có thể mạo hiểm phía sau cầu thang đó xuống Thang để xuống Tầng hầm, nơi &b&lCryomancer&r rất có thể đang ở. \n\n\n\nTrong &bTháp&r bạn có thể tìm thấy Bàn Khắc Chữ, Thạch anh tím và Rương Chiến Lợi!\n\n{image:atm:textures/questpics/iron_spells/spells_mountaintower.png width:200 height:100 align:center}"]
	quest.13F77C38AC015E9F.title: "&bTháp Núi"
	quest.140DE53DC0FCD9F4.quest_desc: ["&bME Annihilation Plane&f có thể được sử dụng để tự động phá bất kỳ khối nào trước nó và trả lại bất cứ thứ gì rơi ra từ khối đó trực tiếp vào mạng ME. \n\n\n\nNhư một lợi ích bổ sung, Annihilation Plane có thể được phù phép giống như một công cụ đào thông thường, ảnh hưởng đến vật rơi từ khối giống như công cụ phù phép đó. Điều này làm cho nó lý tưởng để xử lý khối quặng khi được phù phép với Fortune, ví dụ. \n\nBất kỳ phép màu nào thêm vào đều làm tăng đáng kể lượng năng lượng tiêu thụ của máy bay mỗi lần một khối bị phá. Phù phép máy bay với &eEfficiency&f sẽ giảm tổng mức năng lượng tiêu thụ do tất cả các phép màu khác gây ra, trong khi phép &eUnbreaking&f cho máy bay cơ hội chỉ sử dụng năng lượng đôi khi, tương tự như Unbreaking trên công cụ thông thường."]
	quest.140DE53DC0FCD9F4.quest_subtitle: "VÀO TRONG"
	quest.143AE6889BDA9EF5.quest_desc: ["Các mô-đun chỉ có một số khe cho Item đã lọc, nếu bạn cần nhiều hơn thì hãy dùng cái này! Bộ lọc Item số lượng lớn. \n\n\n\nBạn có thể đặt nhiều Item hơn vào Danh sách trắng hoặc Danh sách đen trong nó. Sau đó ném nó vào nơi mà bộ lọc thông thường đi! \n\n\n\nSẽ cần để chế tạo các bộ lọc độc nhất khác!"]
	quest.144BB025516E0994.quest_desc: ["&3Vibranium&r là quặng tiếp theo sau &6Allthemodium&r, vì vậy tất nhiên nó yêu cầu &6Allthemodium Pickaxe&r (hoặc cùng cấp) để khai thác.\n\n\n\nBạn có thể tìm thấy nó hiếm trong &c&lThe Nether&r hoặc dồi dào trong &b&lThe Other&r.\n\n\n\nCũng nên xử lý quặng để có được nhiều hơn.\n\n\n\nThật đáng buồn, trong khi đó là một quặng ATM màu sắc tuyệt vời, nó có ít công dụng nhất cho các Item khác.\n\n{image:atm:textures/questpics/allthemodium/all_2.png width:100 height:100 align:center}"]
	quest.144BB025516E0994.title: "&3Thỏi Vibranium&r"
	quest.145C8235BCCB9BA8.quest_desc: ["Nếu chúng ta muốn thu thập tất cả các Chalk, chúng ta sẽ cần triệu hồi và giết một &cAfrit&r không thân thiện.\n\n\n\nMặc dù đây không phải là &5Possession Ritual&r, bạn sẽ cần một sinh vật sống để hiến tế cho nghi lễ này. Trong trường hợp này, chúng ta sẽ hiến tế một con Bò. Xin lỗi Betsy!"]
	quest.145C8235BCCB9BA8.quest_subtitle: "R.I.P. Betsy"
	quest.145C8235BCCB9BA8.title: "&cPhấn Đỏ"
	quest.145E7D1A88B83DDD.quest_desc: ["Bạn đi đâu rồi?"]
	quest.145E7D1A88B83DDD.quest_subtitle: "Khăn choàng (Dây chuyền)"
	quest.145E7D1A88B83DDD.title: "&9Khăn choàng tàng hình&r"
	quest.1482F2D45E8F761D.quest_desc: ["Đã đến lúc thu thập vật liệu cần thiết để xây dựng lò phản ứng.\n\n\n\nGiống như hầu hết các khối đa của Mekanism, lò phản ứng có thể có kích thước tùy chỉnh tùy theo nhu cầu của bạn. Chúng phải có hình hộp chữ nhật, với kích thước tối thiểu bên ngoài là 3 rộng, 4 cao và 3 sâu. Kích thước tối đa là 18x18x18. &aChúng ta sẽ xây một lò 5x5 để bắt đầu&r.\n\n\n\nCác cạnh của vỏ ngoài &bphải&r được làm từ &aVỏ Lò Phản ứng Phân hạch&r, trong khi các mặt có thể là vỏ hoặc &bKính Lò Phản ứng&r, Cổng Lò Phản ứng, hoặc Bộ điều hợp logic lò phản ứng. Chúng ta sẽ đề cập đến chúng sau.\n\n\n\nBây giờ, hãy xây một Lò Phản ứng phân hạch 5x5x5 cơ bản!\n\n\n\nCần thêm trợ giúp để xây dựng? Giữ &dw&r khi di chuột qua Vỏ Lò Phản ứng Phân hạch sẽ hiển thị Ponder có thể giúp bạn xây dựng nó."]
	quest.1482F2D45E8F761D.quest_subtitle: "Vỏ và Kính"
	quest.1482F2D45E8F761D.title: "Cơ bản về Xây dựng Lò Phản ứng Phân hạch"
	quest.148A33CC36B2563A.quest_desc: ["&dKệ Rồng&r là Kệ cuối cùng chúng ta cần để thiết lập hoàn hảo. \n\n\n\nNó có thể chỉ cho &aEterna&r nhưng có lượng &aEterna&r tối đa là &a100&r. \n\n\n\nĐể chế tạo nó, chúng ta cần 5 &3Hạt Ender&r và một &dĐầu Rồng&r. Đó là điều khiến nó trở nên &dRồng&r! \n\n\n\nĐể lấy chúng, bạn có thể sử dụng &a&lMA&r hoặc tìm thấy chúng trên &dTàu End&r. &dTàu End&r là Cấu trúc trong &d&lThe End&r, ở mũi (phía trước) là &dĐầu Rồng&r."]
	quest.148A33CC36B2563A.title: "&dKệ End Rồng"
	quest.149BD1A9F82FA19A.quest_subtitle: "&f6 &cSát thương"
	quest.14B3542ECB59869C.quest_desc: ["Máy &5Loot Fabricator&r là máy giúp bạn có được những chiến lợi phẩm ngọt ngào từ Dự đoán Quái vật.\n\n\n\nKhi được cấp năng lượng và có một Dự đoán Quái vật thành công, bạn sẽ có thể chọn món đồ nào bạn muốn nhận từ Mô hình Dữ liệu của quái vật đó. Máy sẽ ghi nhớ lựa chọn của bạn, vì vậy nó có thể được tự động hóa.\n\n\n\nVí dụ về Dự đoán Quái vật:\n\n\n\n- &dEnder Dragons&r để lấy &dDragon Eggs\n\n - &2Zombies&r để lấy Sắt\n\n - &0Withers&r để lấy &5Nether Stars"]
	quest.14B3542ECB59869C.title: "Tạo &dChiến lợi phẩm"
	quest.14D772808D1BEAE2.quest_desc: ["Ma trận cảm ứng cho phép bạn tùy chỉnh lượng năng lượng bạn có thể lưu trữ và truyền bằng cách thêm Tế bào cảm ứng và Bộ cung cấp cảm ứng bên trong cấu trúc nhiều khối.\n\n\n\nTế bào cảm ứng tăng tổng lượng năng lượng có thể lưu trữ.\n\n\n\nBộ cung cấp cảm ứng tăng tốc độ truyền tổng cả vào và ra khỏi Ma trận.\n\n\n\nBạn có thể tùy chỉnh số lượng bạn muốn của mỗi loại bên trong cấu trúc nhiều khối, nhưng bạn sẽ cần ít nhất một của mỗi loại. Chúng cũng có các cấp độ cao hơn để tăng tổng dung lượng lưu trữ và truyền của bạn.\n\n\n\n{image:atm:textures/questpics/mek/induction_inside.png width:300 height:200 align:1}"]
	quest.14D772808D1BEAE2.title: "&aTùy chỉnh &9Giới hạn Năng lượng"
	quest.1515B32545F51266.quest_desc: ["Cho phép bạn gắn năng lượng vào Lò."]
	quest.1515B32545F51266.title: "Nâng cấp Đun nóng"
	quest.151D836C7B0E6FAF.title: "&3Khiên Vibranium"
	quest.15540271BF17C2E4.quest_desc: ["&lChào mừng đến với XyCraft!&r\n\n\n\nLoạt mod này chủ yếu dành cho XyCraft: World và Machines!\n\nWorld cung cấp cho chúng ta những Viên ngọc có thể được tìm thấy khi khai thác."]
	quest.15540271BF17C2E4.title: "&lXyCraft"
	quest.15564C11744D6AA0.quest_desc: ["Khi bạn đã có đủ bộ &eInscriber Presses&r yêu cầu, đã đến lúc bắt đầu chế tạo một số &eProcessors&f. Chúng là nguyên liệu chế tạo quan trọng được dùng để làm phần lớn các thiết bị kết nối ME."]
	quest.15564C11744D6AA0.title: "Bộ xử lý"
	quest.156FF8B7B724DC38.quest_desc: ["Thêm bộ lọc cho các vật thể được bơm vào hoặc ra từ Ba lô."]
	quest.158F872A3A2C3650.quest_desc: ["Bây giờ chúng ta đã có &aEterna&r tối đa là &a80&r, chúng ta có thể bắt đầu &d&lthấm nhuần&r &dDragon's Breath&r! \n\n\n\n&dDragon's Breath&r có thể được thu được khi chiến đấu với &d&lEnder Dragon&r. Khi nó đậu trên tổ, nó có thể phát một làn &dPink&r sương mù về phía bạn. Khi ở trong làn sương đó, bạn có thể Nhấp Chuột Phải với một Chai Trống, để thu được &dDragon's Breath&r! \n\n\n\nCách tốt nhất để có được các Mức cấp của chúng ta là với 4 &9Echoing Sculkshelves&r, 4 &9Soul-Touched Sculkshelves&r, và 6 &6Geode-Encased Bookshelves of Stability&r. \n\n\n\nChúng sẽ cho chúng ta &a80 Eterna&r, &c25% Quanta&r và &5100% Arcana&r. Hoàn hảo cho &d&lthấm nhuần&r!"]
	quest.158F872A3A2C3650.title: "&dDragon's Breath thấm nhuần"
	quest.15CD4BFDC56E9510.quest_subtitle: "Thêm tùy chọn lọc"
	quest.15CD4BFDC56E9510.title: "&eNâng cấp Công cụ Trao đổi Nâng cao"
	quest.15FEA03A2CDBA33B.quest_desc: ["&b&lThe Other&r đã chứng kiến hàng chục thay đổi qua những năm nhưng nó luôn là vùng đất cho những cuộc phiêu lưu! \n\n\n\nCó hàng chục sinh thái mới, khối, và tất nhiên là các công trình! \n\n\n\nCác Công trình là: Piglin Village, Ancient Pyramid, và Dungeon. Tất cả chứa đựng những món loot tuyệt vời với một số thứ là độc nhất cho công trình của chúng! \n\n\n\nBạn cũng có thể khai thác &3Vibranium&r (và các quặng khác!) hoặc tìm thấy nó và tốt hơn trong các công trình! \n\n\n\nTuy nhiên, bạn không thể thiết lập máy khai thác hoặc nhiều khối trong &b&lThe Other&r, không gian lận gì ở đây."]
	quest.15FEA03A2CDBA33B.title: "&l&bThe Other&r"
	quest.161A90E134592D0E.quest_desc: ["Giống như Raw Beef thông thường, bạn có thể nấu &cEverlasting Beef&r để nhận được &4Eternal Steak&r!\n\n\n\nHoạt động giống như &cEverlasting Beef&r nhưng có nhiều Điểm Thức Ăn và Độ Bão hòa hơn."]
	quest.161A90E134592D0E.quest_subtitle: "Độc nhất"
	quest.161A90E134592D0E.title: "&4Bít tết Bất diệt"
	quest.16255FB20F35A9D9.quest_desc: ["Chiếc &3Ống hít&r cung cấp cho bạn một lượng nhỏ Khả năng Thở Nước khi bạn đi vào &9Nước&r. Tương tự như Mũ Rùa! Cẩn thận vì nó sẽ hết."]
	quest.16255FB20F35A9D9.quest_subtitle: "Đầu"
	quest.16255FB20F35A9D9.title: "&3Ống hít"
	quest.16299B9AE87257DC.quest_desc: ["&bWireless Terminal&f hoạt động giống hệt như một terminal thông thường, nhưng không dây.\n\n\n\nTrước khi có thể sử dụng để truy cập mạng, nó trước tiên phải được &eliên kết&f vào mạng bằng cách đặt nó vào ô trên cùng bên phải của &eWireless Access Point&r. Nếu nó không được liên kết với mạng, hoặc nằm ngoài phạm vi hoặc nguồn điện, terminal sẽ không hoạt động.\n\n\n\nWireless terminals cũng có thể được nâng cấp với &eEnergy Cards&f để cung cấp pin nội bộ lớn hơn."]
	quest.16299B9AE87257DC.quest_subtitle: "Đây là lý do bạn ở đây"
	quest.16299B9AE87257DC.title: "Wireless Terminals"
	quest.162CE44400A63575.quest_desc: ["Metallurgic Infuser được dùng để chế tạo các linh kiện chính trong suốt Mekanism.\n\n\n\nMáy hoạt động bằng cách thấm một vật liệu (ô giữa bên trái) với một \"infuser\" (ô xa bên trái).\n\n\n\nĐây cũng là cách bạn nhận được Phôi thép."]
	quest.162CE44400A63575.quest_subtitle: "Máy Khởi Đầu"
	quest.1659A59303C15CC9.quest_desc: ["Thùng hoạt động giống như Rương, chỉ là chúng không thể kết hợp thành một khối. Tuy nhiên chúng trông rất ngầu."]
	quest.166971866A9234C7.quest_desc: ["Tẩm một &6Phôi đồng&r với &4Bụi Redstone&r trong Máy tẩm kim loại sẽ tạo ra &cHợp kim tẩm&r."]
	quest.166971866A9234C7.quest_subtitle: "Hợp kim cơ bản để chế tạo vật phẩm"
	quest.166971866A9234C7.title: "&cHợp kim tẩm"
	quest.167E1474644C9908.quest_desc: ["Thạch anh sẽ làm ngược lại với vật phẩm kia đối với Máy sinh quái. Khi cầm Thạch anh ở tay phụ và vật phẩm chỉnh sửa Máy sinh quái khác ở tay chính, nó sẽ thực hiện vai trò ngược lại. Cùng Thạch anh và Thanh Blaze thay vì tăng Phạm vi sinh thì sẽ giảm nó. Cùng Thạch anh và Nước mắt Ghast sẽ giảm Số lượng tối đa."]
	quest.167E1474644C9908.title: "Ngày Đảo Ngược"
	quest.1697CC05D08B388D.quest_subtitle: "Gà rán ngon lành!"
	quest.1697CC05D08B388D.title: "Gà phải đi"
	quest.16A6C47E35F3B9D0.quest_desc: ["Một khi đã có &9Máy ly tâm đồng vị&r, chúng ta có thể đưa &2Uranium Hexafluoride&r vào và tạo ra &3Nhiên liệu phân hạch&r!\n\n\n\nThấy không, chuyện đó không tệ chứ?"]
	quest.16A6C47E35F3B9D0.title: "&3Nhiên liệu phân hạch"
	quest.16AAC61729C44881.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2cộng tác viên cộng đồng&r để sử dụng trong các gói AllTheMods Modpacks.\n\n\n\nVì tất cả các gói &6AllTheMods&r được cấp phép theo &eAll Rights Reserved&r, nhiệm vụ này không được phép sử dụng trong bất kỳ gói công cộng nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng.\n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.16B4A00948D1F60D.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2cộng tác viên cộng đồng&r để sử dụng trong các gói AllTheMods Modpacks.\n\n\n\nVì tất cả các gói &6AllTheMods&r được cấp phép theo &eAll Rights Reserved&r, nhiệm vụ này không được phép sử dụng trong bất kỳ gói công cộng nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng.\n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.16D0F1E3CEB60ABF.title: "Cần câu sắt"
	quest.1710B3D05215A71E.quest_desc: ["&bP2P&f (peer-to-peer) là một hệ thống mạnh mẽ trong AE2, cho phép truyền item, chất lỏng và thậm chí nhiều hơn mà không cần bất kỳ bộ lưu trữ ME trung gian nào.\n\n\n\nNhấp chuột phải vào đường hầm P2P với một số item nhất định sẽ &eđiều chỉnh&f đường hầm thành loại có khả năng truyền thứ khác, chẳng hạn như item qua ống, năng lượng qua cáp, tín hiệu redstone và (mặc định) thậm chí cả kết nối ME.\n\n\n\nCác đường hầm P2P phải được liên kết với nhau bằng cách sử dụng một &eMemory Card&f, được chi tiết trong nhiệm vụ tiếp theo."]
	quest.1710B3D05215A71E.quest_subtitle: "Bỏ qua trung gian"
	quest.1710B3D05215A71E.title: "Đường hầm P2P"
	quest.172D2A634E849562.quest_desc: ["Với khả năng thu hoạch &cIesnium&r, chúng ta có thể triệu hồi các Quỷ để làm theo yêu cầu của chúng ta trong các mỏ... ý tôi là... giúp chúng ta thu thập quặng. Chắc chắn không khai thác Quỷ hay bất cứ điều gì.\n\n\n\nĐể làm điều này, chúng ta cần tạo một &dDimensional Mineshaft&r để truy cập Thế giới Khai thác Quỷ. Bạn cũng sẽ cần một Mining Demon bị giam trong một chiếc đèn, mà bạn sẽ đặt bên trong Mineshaft để nó hoạt động. Mặc dù bất kỳ cấp độ nào cũng sẽ hoàn thành nhiệm vụ này, các cấp độ cao hơn hoạt động nhanh hơn và có cơ hội cao hơn trong việc khai thác Iesnium cho bạn.\n\n\n\nCác Mineshaft không tự động xuất hàng. Bạn sẽ cần trích xuất các item bằng cách sử dụng Hoppers, Transporting Demons, hoặc một số phương pháp khác như Item Pipes. Nó sẽ hủy bất kỳ item nào vượt quá giới hạn lưu trữ của nó."]
	quest.172D2A634E849562.title: "&cKhai thác Quỷ"
	quest.174D18D9D732EC10.quest_subtitle: "8 Block xanh ướt"
	quest.17542D7633FBF098.quest_desc: [""]
	quest.17542D7633FBF098.quest_subtitle: "&oThật đáng tiếc SpongeBob không phải là Ngôi sao."
	quest.17542D7633FBF098.title: "&d&lPatrick &aNgôi sao&r"
	quest.177396B9C4F9B3E2.quest_desc: ["Tại sao phải chờ? Ồ, bạn có lý do chính đáng để chờ? Như những vật phẩm có thể biến mất. Hừ, tôi đã không nghĩ đến chúng. \n\n\n\nVới Pickup Delay Augment, Vacuum Module sẽ chờ 10 ticks với mỗi Augment trong nó để nhặt các vật phẩm rơi!"]
	quest.17A68C4E9E9EA2B7.quest_desc: ["&eÁo giáp vàng&r nằm đúng giữa Áo giáp sắt và &7Áo giáp da&r. Nhưng độ bền của nó gần với &7Áo giáp da&r hơn. \n\n\n\nNó không có nhiều công dụng ngoài việc làm cho Piglins trung lập với bạn khi bạn mặc một số &eÁo giáp vàng&r."]
	quest.17A68C4E9E9EA2B7.quest_subtitle: "11"
	quest.17A68C4E9E9EA2B7.title: "&eÁo giáp vàng"
	quest.17DC77F7F8C68AE6.quest_desc: ["Thùng rác hoạt động như một cách để hủy bỏ các vật phẩm không mong muốn, chất lỏng và năng lượng."]
	quest.17DC77F7F8C68AE6.quest_subtitle: "Loại bỏ phần dư"
	quest.17DC77F7F8C68AE6.title: "Thùng rác"
	quest.17F3AC15ADCFB175.title: "&l&9Phần thưởng The End:&r&e Endermen"
	quest.17FE0C7748DD65CA.quest_desc: ["&5Cấp 4&r là cấp độ công cụ kim cương, dùng để lấy Obsidian và Netherite. Cũng như một số quặng từ mod như Uranium và Platinum."]
	quest.17FE0C7748DD65CA.title: "&5Cấp thu hoạch 4"
	quest.1823CC81D613892B.quest_desc: ["Sinh vật không tấn công -> Nhiều Pink Slime hơn\n\nSinh vật thù địch -> Nhiều Thịt hơn"]
	quest.18246A48C20B29D8.quest_desc: ["Infusion Pylon hoạt động tương tự như Beacon nhưng tốt hơn và rẻ hơn nhiều! \n\nKhi một Hiệu ứng thuốc được đưa vào bởi Potion Filter, nó sẽ liên tục cho bạn Hiệu ứng thuốc trong khi bạn're ở trong khu vực khối đã đặt."]
	quest.1827DEEA2DF1B144.quest_desc: ["Chào mừng đến với chương Thực phẩm và Nông nghiệp!\n\n\n\nTại đây, bạn sẽ tìm thấy những cách khác nhau để trồng và làm thực phẩm!"]
	quest.1827DEEA2DF1B144.title: "Thực phẩm và Nông nghiệp"
	quest.1848F431D0380DA9.quest_desc: ["Tương tự như chức năng Sửa chữa bằng Phấn của &aStrigeor's Higher Binding&r, &cSevira's Permanent Confinement&r có thể được dùng để sửa chữa vật dụng bằng sức mạnh của một Afrit Demon.\n\n\n\nNghi lễ này có thể sửa chữa gần như mọi thứ, vì vậy &eDemon Miners&r, công cụ và áo giáp đều có thể được khôi phục độ bền ban đầu! \n\n\n\nTất cả vật dụng được sửa chữa bằng nghi lễ này đều giữ nguyên thuộc tính ban đầu (affixes, enchantments, v.v), vì vậy đừng lo lắng về những phép thuật quý giá của bạn!"]
	quest.1848F431D0380DA9.quest_subtitle: "Độ bền gần như miễn phí!"
	quest.1848F431D0380DA9.title: "Sửa chữa Vật dụng"
	quest.185074907753AE77.quest_desc: ["Nếu bạn đang sử dụng Routers, tôi hy vọng bạn có một chút kiến thức về trò chơi. \n\n\n\nTrong trường hợp bạn không biết, để void một Item có nghĩa là xóa nó. \n\n\n\nBất kỳ vật dụng nào đi vào Router, sẽ bị xóa vĩnh viễn! \n\n\n\nKhuyến nghị sử dụng Filters với cái này..."]
	quest.186593EBCE3FE8D8.quest_desc: ["Phạm vi sinh là khu vực mà quái vật có thể xuất hiện. Khu vực càng lớn, không gian để chúng sinh càng nhiều. Khu vực càng nhỏ thì nhà máy càng rẻ."]
	quest.186593EBCE3FE8D8.title: "Phạm vi sinh"
	quest.1873205CF5247E3E.quest_desc: ["Cuối cùng và vĩ đại nhất trong số &7Kệ sách&r, &dKệ End&r! \n\n\n\nChúng được tạo từ 6 &eGạch Đá End&r, 1 &3Hạt Ender&r, 1 &7Kệ sách&r, và tất nhiên là &dHơi thở Rồng Đã Kết Tinh&r. \n\n\n\nChỉ số của chúng hiện tại chưa phải tốt nhất, chỉ cung cấp 5 cho mỗi cái. Nhưng &aEterna&r tối đa của chúng là &a90&r thì kinh ngạc! \n\n\n\nỒ đúng rồi, hơn nữa chúng có thể được Chế tạo với các vật phẩm khác để nâng cấp chúng!\n\n{image:atm:textures/questpics/apothic/enchant_endshelf.png width:100 height:100 align:center}"]
	quest.1873205CF5247E3E.title: "&dKệ End"
	quest.187A3F5B41D1C923.quest_desc: ["Hãy lấy &2Axit Sunfuric&r của chúng ta và kết hợp với &bFluorite&r trong &9Buồng Hòa tan Hóa học&r để tạo ra &bAxit Hydrofluoric&r.\n\n\n\nChúng ta gần xong rồi!"]
	quest.187A3F5B41D1C923.title: "&bAxit Hydrofluoric"
	quest.18D88932916C7A98.quest_desc: ["Máy Tách Điện ly (cái tên hoành tráng) được dùng để tách hóa chất từ một số chất lỏng và khí.\n\n\n\nBạn sẽ cần một loạt những cái này nếu bạn định làm Nhà máy Xử lý Quặng.\n\n\n\nĐể bắt đầu, hãy làm một cái và chúng ta sẽ phân tích chất lỏng cơ bản nhất: Nước."]
	quest.18D88932916C7A98.quest_subtitle: "Đến Lúc Phân Tích"
	quest.18DB8C875F2331B2.quest_desc: ["Tên lửa có quá đắt không? Bạn có thể dùng &7Máy đẩy Elytra&r thay vì Tên lửa. Mặc cả Elytra và &7Máy đẩy Elytra&r, sau đó Đổ nhiên liệu vào Máy đẩy. Nó chấp nhận bất kỳ nhiên liệu Lò nướng nào: Than, Lava, Khúc gỗ, thậm chí Khối Tảo biển khô. Sau đó khi bay với Elytra, nhấn Left Alt để tăng tốc! Bây giờ bạn đang bay với nhiên liệu Thân thiện Môi trường rẻ hơn nhiều!"]
	quest.18DB8C875F2331B2.quest_subtitle: "Tìm thấy ở Thành phố End và Tàu End"
	quest.18DFB25DC48D8BF7.quest_desc: ["Cấu trúc Chứa Không gian (SCS) bao gồm một lưới các &bSpatial Pylons&f bao phủ thể tích bạn muốn đặt trong một ô Spatial IO. Tối thiểu, một SCS yêu cầu ba hàng khối spatial pylon, mỗi hàng cho một chiều của không gian được chứa (dài, rộng, cao). \n\n\n\nTuy nhiên, Spatial IO là một tính năng cực kỳ tốn năng lượng, đặc biệt khi cố gắng chứa các không gian lớn hơn (lên tới 128x128x128). Việc có thêm nhiều spatial pylons trong SCS xung quanh thể tích mong muốn sẽ tăng tổng &eefficiency&f của nó, cho phép nó sử dụng ít năng lượng hơn để chứa. \n\n\n\nNgoài ra, hãy lưu ý rằng mỗi pylon riêng lẻ (bất kể chiều dài) chiếm một kênh. Đối với các không gian đặc biệt lớn, bạn có thể muốn xây dựng một mạng lưới chuyên dụng với một bộ điều khiển để chứa tất cả các pylon cần thiết."]
	quest.18E0F5A78F696FA3.quest_desc: ["Mảnh Echo tạo hiệu ứng đặc biệt cho bộ phát sinh. Bất kỳ sinh vật nào được sinh ra sẽ có lượng vật phẩm rơi ra nhân lên."]
	quest.18E0F5A78F696FA3.title: "Vang vọng"
	quest.18EADBAFC932F864.quest_desc: ["Để xén lông cừu bạn cần kéo, bạn sẽ không lấy được lông bằng cách khác... phải không?"]
	quest.18EADBAFC932F864.quest_subtitle: "Chạy hòa bình"
	quest.18EADBAFC932F864.title: "Đến lúc cắt rồi"
	quest.191A7F3C9FBA4C13.quest_desc: ["Chúng ta có thể chế tạo &bInfused Seashelves&r với &bPrismarine Crystals&r để có được &bCrystalline Seashelves&r. \n\n\n\nCác &bCrystalline Seashelves&r sẽ giữ nguyên &a5 Eterna&r, &55% Arcana&r, và giờ có thêm &c3% Quanta&r. \n\n\n\nVới 12 cái, chúng ta có thể đủ cấp độ để &d&lThấm nhuần&r &9Dormant Deepshelves&r thành &9Deepshelves&r thông thường!"]
	quest.191A7F3C9FBA4C13.title: "&bCrystalline Seashelf"
	quest.19542103E042BDB5.quest_desc: ["{image:atm:textures/questpics/iron_spells/spells_outfit_shadow.png width:60 height:100 align:center}"]
	quest.19542103E042BDB5.title: "&dBộ đồ Shadow-Walker"
	quest.195729280394ABFB.quest_desc: ["Máy này tạo ra hai phôi cực mạnh: Refined Glowstone và Refined Obsidian.\n\n\n\nNó thấm một vật phẩm với Osmium để tạo ra một phôi mạnh hơn."]
	quest.195729280394ABFB.quest_subtitle: "Thực ra Chỉ Tốt Cho 2 Điều"
	quest.1985CFD1F0425E88.quest_subtitle: "Thêm Tùy Chọn Lọc"
	quest.1985CFD1F0425E88.title: "&eNâng Cấp Nhặt Nâng Cao"
	quest.19B393433FB0C62F.quest_desc: ["Bí mật của Strider để đi trên &cLava&r nằm ở chân chúng. Vì vậy chúng tôi đã lấy chân của chúng và để bạn sử dụng thay thế! \n\n\n\nKhi kéo lén bạn có thể đi an toàn trên &cLava&r! Khi bạn ngừng kéo lén, bạn sẽ rơi vào &cLava&r. Chúng cũng cho phép bạn đi an toàn qua khối Magma và các khối nóng khác!"]
	quest.19B393433FB0C62F.quest_subtitle: "Chân"
	quest.19B393433FB0C62F.title: "&4Giày Strider&r"
	quest.19E356E67EF17E4A.quest_desc: ["Chỉ là Công Cụ Vĩ Đại Nhất Lịch Sử! Giống như dao đa năng Thụy Sĩ nhưng còn tốt hơn! \n\n\n\nTầng Khai Thác Cao Nhất, chặt cây như bơ, tạo đường, và tất nhiên là đánh rất nhiều để bị đánh lại!"]
	quest.19E356E67EF17E4A.title: "&6Allthemodium &5Hợp Kim &3Paxel"
	quest.1A0368CB49B8CBFF.quest_desc: ["Cuốn &eSách Phép&r này là một vật rơi hiếm từ &cBlaze&r. Tôi nhớ như vậy vì tôi đã bối rối khi lấy được 1 từ Trang trại &cBlaze&r của tôi. \n\n\n\nNó tăng cường &cPhép Lửa&r và có 10 &3Ô Phép&r."]
	quest.1A0368CB49B8CBFF.quest_subtitle: "Nóng! Nóng! Nóng!"
	quest.1A0368CB49B8CBFF.title: "&cSách hướng dẫn Blaze"
	quest.1A05C605A52A4218.quest_desc: ["&5Unobtainium&r kết hợp với &6Allthemodium&r!"]
	quest.1A05C605A52A4218.title: "&5Unobtainium&r - &6Allthemodium&r Phôi hợp kim"
	quest.1A739D36D5E3B1AD.quest_subtitle: "Thêm tùy chọn lọc"
	quest.1A739D36D5E3B1AD.title: "&eNâng cấp cấp liệu nâng cao"
	quest.1A806C1A54B26EB5.quest_desc: ["Bạn không muốn mọi thứ hoạt động ở phạm vi lớn hơn? Bạn muốn Máy hút chân không của bạn để lại chỗ để rơi vật phẩm trong Thế giới của bạn? Vậy tôi đoán bạn có thể giảm phạm vi."]
	quest.1AA81C41431FD145.quest_desc: ["Kéo..! Kéo..! Kéo..! \n\n\n\nMáy kéo (Puller) trái ngược với Máy gửi (Sender), nó kéo vật phẩm từ Tủ đồ vào Bộ đệm của Router. \n\n\n\nTủ đồ phải liền kề với Router."]
	quest.1AAF0B31B47AF23D.quest_desc: ["Các thiết bị ME riêng lẻ cũng có thể được cấu hình để phản hồi tín hiệu redstone. Khi nâng cấp với &bThẻ Redstone&f, một thiết bị có thể được cấu hình để làm việc chỉ khi được cấp nguồn redstone hoặc theo nhu cầu.\n\n\n\nHành vi này cũng có thể áp dụng cho toàn bộ &ophần&r của mạng ME bằng cách sử dụng &bME Toggle Bus&f. Điều này cho phép một phần của mạng ở phía bên kia của bus chỉ hoạt động khi bus được cấp nguồn redstone, hoặc ngừng hoạt động nếu sử dụng bus chuyển đổi &einverted&f."]
	quest.1AAF0B31B47AF23D.title: "Điều khiển ME bằng Redstone"
	quest.1AD87CB3226ED224.quest_desc: ["Len chỉ làm một việc với máy sinh quái và đó là làm nó im lặng. Không thích nghe tiếng ồn của máy sinh quái ngốc nghếch? Hãy dùng Len! Bất kỳ màu sắc, số sợi hay kiểu dáng nào!"]
	quest.1AD87CB3226ED224.title: "Im nào, đừng đánh thức quái!"
	quest.1B0087400B0B8B49.quest_desc: ["Lò phản ứng (&9Reactor&r) là một máy phát điện nhiều khối 3x4x3 đốt &aUrananite&r làm nhiên liệu để sản xuất FE.\n\n\n\nĐể xây nó, bạn cần tổng cộng 36 Khối Lò phản ứng. Khi cầm 36 trong tay, đặt một khối sẽ tự động xây lò phản ứng. Đảm bảo dọn chỗ trước!\n\n\n\nBạn sẽ muốn làm mát lò phản ứng để nó tạo ra nhiều FE hơn, và bạn có thể làm điều này với chất làm mát rắn hoặc lỏng &bcoolant&r. Để dùng chất làm mát rắn, bạn cũng cần cung cấp cho nó một ít chất làm mát lỏng. &bDry Ice&r là một chất làm mát rắn tuyệt vời! (Lưu ý: 1 Xô Nước là đủ).\n\n\n\nBạn cũng có thể tăng sản lượng FE bằng cách giữ đầy bộ đệm nhiên liệu, cũng như thêm cả Than và Đá Đỏ vào Lò phản ứng. Dùng Khối của cả hai cũng sẽ hoạt động!"]
	quest.1B0087400B0B8B49.title: "Lò phản ứng (Khởi đầu)"
	quest.1B5177A774FCEF64.quest_desc: ["Trước khi chúng ta bắt đầu nhờ sự giúp đỡ của bạn bè Ác quỷ, chúng ta sẽ cần tạo ra vật phẩm quan trọng nhất cho Nghi lễ: &aChalk&r.\n\n\n\nCó một số màu phấn cần thiết, với Nghi lễ cấp cao hơn yêu cầu nhiều màu để kích hoạt. Để bắt đầu, &bWhite Chalk&r là dễ có nhất.\n\n\n\nBắt đầu bằng cách ném Otherstone vào lò nung, và ném Otherworld Logs vào &dSpiritfire&r. Với các vật phẩm bạn tạo ra, bạn sẽ có thể làm Impure White Chalk.\n\n\n\nĐể tinh khiết bất kỳ mảnh Chalk nào, chỉ cần ném nó vào &dSpiritfire&r để làm sạch. Dùng Purified Chalk trên mặt đất sẽ vẽ các ký hiệu &mdemonic&r đẹp trên mặt đất. Chúng là một đau khổ để gỡ bỏ, trừ khi tất nhiên, bạn tự làm cho mình &aChalk Brush&r. Làm đi, nó đáng giá."]
	quest.1B5177A774FCEF64.title: "Chuẩn bị cho Nghi lễ: &ePhấn"
	quest.1B686954D34A0F23.quest_desc: ["Cờ lắc &bQuartz Wrench&f làm đúng như một cờ lắc mod công nghệ thông thường. Nó xoay các khối và thiết bị theo mặt bạn nhấp chuột phải vào và tháo dỡ chúng khi nhấp chuột phải trong khi lén.\n\n\n\nCờ lắc này có cả hai loại Certus Quartz và Nether Quartz."]
	quest.1B686954D34A0F23.quest_subtitle: "Làm đúng như bạn mong đợi"
	quest.1B686954D34A0F23.title: "Cờ lắc Thạch anh"
	quest.1B6DDF50D00CBB31.quest_desc: ["Pha trộn Sắt với Than hoặc Than củi trong một Metallurgic Infuser sẽ cho bạn Enriched Iron.\n\n\n\nPha trộn Enriched Iron với thêm Than hoặc Than củi sẽ cho bạn Steel Dust, có thể nung chảy thành Thép.\n\n\n\nĐây là thành phần chế tạo chính trong nhiều công thức trong Mekanism."]
	quest.1B6DDF50D00CBB31.title: "Thép"
	quest.1BA3D15FFE7DBE59.quest_desc: ["Trong &bIndustrial Foregoing&r, một trong những tài nguyên chính là &fLatex.&r Nó được dùng để chế tạo Khung Máy, cần thiết để tạo máy và nâng cấp.\n\n\n\nViệc sản xuất Latex khá đơn giản, &aFluid Extractor&r chiết xuất Latex từ &6Gỗ&r (Acacia cho nhiều nhất).\n\n\n\n------------------------\n\n\n\nBây giờ về việc sản xuất Plastic: Plastic được tạo ra từ việc nung chảy Dry Rubber - được sản xuất trong &aLatex Processing Unit&r, biến Latex thành Dry Rubber.\n\n\n\n&bVậy về cơ bản Latex -> Dry Rubber -> Plastic."]
	quest.1BA3D15FFE7DBE59.quest_subtitle: "Latex và Plastic? Hả?"
	quest.1BA3D15FFE7DBE59.title: "Latex và Plastic? Hả?"
	quest.1BDB369FD243D4C6.quest_desc: ["Có thể nói là item hữu ích nhất bạn có thể tạo trong Occultism, &bIesnium Anvil&r là phiên bản siêu mạnh của Vanilla Anvil.\n\n\n\nĐược tạo bằng &9Uphyxes' Inverted Tower&r, nó:\n\n\n\n- Không thể phá hủy.\n\n- Tăng mức độ tối đa của mọi phép thuật khi kết hợp trên nó lên một cấp.\n\n- Chi phí XP chỉ một nửa so với ước tính (làm tròn xuống, vì vậy nếu nói 25, nó sẽ tốn 12).\n\n- Có mức tăng yêu cầu kinh nghiệm nhỏ hơn khi chỉnh sửa lặp lại trên cùng một item.\n\n- Tăng mức XP tối đa mà bạn có thể chỉnh sửa item (điểm mà nó nói \"Quá đắt!\")."]
	quest.1BE26A00A420DAE3.quest_desc: ["Trong mod này, bạn sẽ cần &aFlux Cores&r và &aFlux Blocks&r để chế tạo các phần cốt lõi của mạng lưới. Hãy làm vài cái của mỗi loại!"]
	quest.1BE26A00A420DAE3.quest_subtitle: "Các Core bạn cần"
	quest.1BE26A00A420DAE3.title: "Nguyên liệu chế tạo \"Core\""
	quest.1BE69992D2C5085B.quest_desc: ["&n&aEvocation:&r\n\nĐể triệu hồi một Spirit hoặc Deity. \n\n\n\n&a&lEvokation&r xoay quanh việc &aEvokers&r làm, chủ yếu là triệu hồi. Dù là &aFangs&r hay &aVexes&r, nếu nó được triệu hồi thì rất có thể là &aEvokation&r. \n\n\n\n&a&lEvokation's&r Focus Material là &aEmeralds&r. Bạn có thể chế tạo Rune hoặc lấy từ &a&lArchevoker&r. \n\n\n\n&aEvokation Scrolls&r có màu &fTrắng&r với chữ &0Đen&r."]
	quest.1BE69992D2C5085B.title: "&a&lEvocation"
	quest.1C273D9E046FD18A.quest_desc: ["Được dùng để nạp năng lượng cho vật thể bằng cách sử dụng Energizing Orb."]
	quest.1C27C74722A19FC1.quest_desc: ["Với một lượng lớn các vật phẩm Mekanism siêu đắt tiền &l&5Mekanism&r, bạn có thể nâng cấp &5Unobtainium Armor&r lên &aMekaSuit&r! \n\n\n\nBây giờ nó có thể chứa Năng lượng và thay vì mất máu khi bị tổn thương, nó sẽ tiêu hao Năng lượng. \n\n\n\nBạn có thể sử dụng Upgrade Units để làm cho nó tốt hơn nữa!"]
	quest.1C27C74722A19FC1.quest_subtitle: "Nhiều năng lượng nhất có thể cung cấp"
	quest.1C27C74722A19FC1.title: "&aMekaSuit"
	quest.1CAEC4C273EDDB99.quest_desc: ["Nó ở đây! Nó ở kia! Nó ở khắp mọi nơi và nó đã thối rữa! Bạn có thể tìm thấy chúng trong hầu hết các Rương. \n\n\n\nChúng có thể chứa 8 &3Spells&r nhưng cho bạn ít Spell Resistance hơn."]
	quest.1CAEC4C273EDDB99.title: "Sách phép thối rữa"
	quest.1CC627D3FB348C89.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_shaper.png width:100 height:150 align:center}"]
	quest.1CC627D3FB348C89.quest_subtitle: "Hoang tàn theo dấu"
	quest.1CC627D3FB348C89.title: "Trang trí giáp Shaper"
	quest.1CD2C6AFD788C35E.quest_desc: ["Nén các vật phẩm trong Ba lô thành công thức 2x2 của chúng."]
	quest.1CE7B24E7E62C25B.quest_desc: [""]
	quest.1CE7B24E7E62C25B.quest_subtitle: "&oĐiều chưa biết nhưng lại là tất cả những gì chúng ta biết."
	quest.1CE7B24E7E62C25B.title: "&d&llỗ đen &8xoay"
	quest.1D2EF12FD7FDD217.quest_desc: ["Gà sẽ đẻ ra chúng một cách tự nhiên. Tôi đoán nó không thực sự được coi là tự nhiên...\n\n\n\nTôi đoán gà chỉ đang... &oTập trung vào trứng!!!&r."]
	quest.1D2EF12FD7FDD217.quest_subtitle: "...hay là tôi?"
	quest.1D2EF12FD7FDD217.title: "Tôi sẽ không đùa về trứng."
	quest.1D3F11194EA3BB73.quest_subtitle: "Cấp: &b3"
	quest.1D48298525EEADC9.quest_desc: ["Bạn đã có mọi thứ cần thiết rồi."]
	quest.1D48298525EEADC9.quest_subtitle: "Đổ đường lên tôi!"
	quest.1D48298525EEADC9.title: "Bạn thật ngọt ngào."
	quest.1D91E37BFD8CC911.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_emerald.png width:100 height:150 align:center}"]
	quest.1D91E37BFD8CC911.title: "&2Ngọc lục bảo&r"
	quest.1DCAA0310AA55F1C.quest_desc: ["Nhưng ông ấy thường đóng cửa lúc 5 giờ, nên ai quan tâm?"]
	quest.1DCAA0310AA55F1C.quest_subtitle: "Willy Sẽ Tự Hào"
	quest.1DCAA0310AA55F1C.title: "Sự Khởi Đầu Của Người Đánh Cá"
	quest.1DE0F289821F55D1.quest_desc: ["Bây giờ chúng ta đã có Foliot Crusher, chúng ta có thể &muse&r lịch sự yêu cầu nó nghiền một ít &eĐá End&r, &9Obsidian&r và &7Canxit&r cho chúng ta. Chúng ta sẽ dùng chúng để làm một ít phấn mới!"]
	quest.1DE0F289821F55D1.title: "&aLàm Phấn"
	quest.1DE8B0C9A7195720.quest_desc: ["Sau khi bạn đã đặt xong tất cả các block cần thiết để xây dựng Lò phản ứng, nó sẽ phát ra các hạt đỏ để cho thấy nó đã hoàn thành.\n\n\n\nNhấp chuột phải vào bất kỳ đâu trên Lò phản ứng sẽ mở ra &aGiao diện&r. Nó sẽ chứa tất cả thông tin bạn cần để vận hành Lò phản ứng đúng cách, cũng như hai nút để bật và tắt Lò phản ứng.\n\n\n\nBên trái, bạn có 2 bể chứa: Một cho &bChất làm mát&r và một cho &3Nhiên liệu phân hạch&r. Bên phải, bạn có một cho &8Chất thải phóng xạ&r, và một cho &bChất làm mát đã đun nóng&r, mà rất có thể sẽ là &bHơi nước&r.\n\n\n\nThanh &cNhiệt độ&r sẽ cho bạn biết lò phản ứng nóng đến mức nào. Sau một nhiệt độ nhất định, Lò phản ứng sẽ bắt đầu nhận &4Sát thương&r, và cuối cùng sẽ khiến Lò phản ứng nổ.\n\n\n\nĐể điều chỉnh &cTỷ lệ đốt&r của Nhiên liệu phân hạch và xem thêm thống kê, nhấp vào tab (I) ở phía bên trái. Ở đây, bạn có thể điều chỉnh Giới hạn tỷ lệ, điều khiển lượng nhiên liệu lò phản ứng đốt mỗi tick.\n\n\n\n{image:atm:textures/questpics/mek/reactor_interface_1.png width:200 height:150 align:1}\n\n{image:atm:textures/questpics/mek/reactor_interface_2.png width:200 height:150 align:1}"]
	quest.1DE8B0C9A7195720.quest_subtitle: "Đó rõ ràng là các con số"
	quest.1DE8B0C9A7195720.title: "Giao Diện Lò Phản Ứng Phân Hạch"
	quest.1E00DBAACDF4404F.quest_desc: ["Máy Thu Thập hoạt động như một Ống hút Hấp thụ rất rẻ tiền.\n\n\n\nNó sẽ nhặt tất cả các vật phẩm trong bán kính 3 block và đặt vào kho hàng phía dưới hoặc kho của chính nó. Nó có thể được tắt bằng Redstone!"]
	quest.1E1EB7DC19DDCFB7.quest_desc: ["Để tạo công cụ và áo giáp Netherite, bạn cần tìm &6Mẫu rèn Netherite&r trong các rương nằm trong Bastion.\n\n\n\nChúng có thể kết hợp với một miếng &cNetherite&r và một công cụ hoặc áo giáp Kim cương trên một &aBàn rèn&r để nâng cấp chúng lên &cNetherite&r.\n\n\n\nMẹo: Đừng dùng hết các mẫu của bạn một lúc! Bạn có thể tạo bản sao bằng cách sử dụng công thức để tạo thêm một cái."]
	quest.1E1EB7DC19DDCFB7.title: "&6Mẫu rèn Netherite&r"
	quest.1E2A9446594638E2.quest_desc: ["&5Bộ ức chế Chorus&r là một &6Di vật&r đơn giản khác. Nó có thể dịch chuyển bạn đến khối bạn đang nhìn vào nếu nó nằm trong phạm vi. Phạm vi có thể được nâng cấp trong &6Cửa sổ nghiên cứu&r."]
	quest.1E2A9446594638E2.quest_subtitle: "Được tìm thấy trong Thành phố End và Tàu End"
	quest.1E2A9446594638E2.title: "&5Bộ ức chế Chorus"
	quest.1E3E688B3B52C4D2.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_raiser.png width:100 height:150 align:center}"]
	quest.1E3E688B3B52C4D2.quest_subtitle: "Tàn tích Đường mòn"
	quest.1E3E688B3B52C4D2.title: "Trang trí áo giáp Raiser"
	quest.1E40ACF3E69A4100.quest_desc: ["Bạn có cần phải uống nó không? Tôi không biết, nó cứ đứng đó và hoạt động... \n\n\n\nVới &6Bình kháng độc&r, các hiệu ứng tiêu cực (như Hủy diệt hay Độc) sẽ có thời gian bị rút ngắn! Rất hữu ích khi đối mặt với Phù thủy hoặc Xương sống Wither."]
	quest.1E40ACF3E69A4100.quest_subtitle: "Đai"
	quest.1E40ACF3E69A4100.title: "&6Bình kháng độc&r"
	quest.1E499F94A2A193E1.quest_desc: ["Thêm giao diện Lò nung vào Balo."]
	quest.1EABF2E7AE7B8F22.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_netherite.png width:100 height:150 align:center}"]
	quest.1EABF2E7AE7B8F22.title: "&8Netherite&r"
	quest.1EB887F8072439A3.quest_desc: ["Sau khi sử dụng &9Sức hấp dẫn được Khuyến khích của Fatma&r để triệu hồi &9Marid Crusher&r, bạn có thể biến Băng, Băng Đóng và Băng Xanh thành dạng nghiền, và dùng chúng để tạo Phấn Xanh Nhạt."]
	quest.1EB887F8072439A3.title: "&bPhấn Xanh Nhạt"
	quest.1F114EB0AAB86DB4.quest_desc: ["Chợ cung cấp cho bạn một người làng có thể bán bất cứ thứ gì nếu bạn có đủ lượng ngọc lục bảo.\n\n\n\nSpoiler: Thông thường chỉ 1 Ngọc lục bảo cho mỗi món, may mắn là họ có MỌI THỨ."]
	quest.1F114EB0AAB86DB4.quest_subtitle: "Người làng có nhiều hơn một cách để xuất hiện."
	quest.1F114EB0AAB86DB4.title: "Mua vật tư nông nghiệp"
	quest.1F18B64C84C8809D.title: "&l&9Phần thưởng Overworld:&r&e Nhện"
	quest.1F6C8117F3CED939.title: "&6Cung Allthemodium"
	quest.1F7DFA5AA65F2812.quest_desc: ["Thẻ &bAcceleration Card&f, tùy thuộc vào thiết bị được nâng cấp bằng nó, sẽ hoặc tăng tốc độ hoạt động của thiết bị hoặc cho phép thiết bị thực hiện nhiều thao tác hơn trong một lần.\n\n\n\nĐối với &eMolecular Assembler&f, một bộ đầy đủ 5 thẻ giảm thời gian để MA hoàn thành một món đồ từ một giây (không có thẻ) xuống một &otick&r."]
	quest.1F81EA5E45424308.quest_desc: ["Nếu bạn đang tìm kiếm những cách khác nhau để lấy năng lượng từ máy móc của mình, đây là nơi bạn có thể tìm thấy!\n\n\n\nCó một số tùy chọn, cả &acó dây&r và &9không dây&r, để truyền năng lượng."]
	quest.1F81EA5E45424308.title: "&f&lTruyền Năng Lượng"
	quest.1FAAF8216CDC3AC6.quest_desc: ["Bơm chất thải phóng xạ vào &9Solar Neutron Activator&r sẽ cho bạn &dPolonium&r.\n\n\n\nCho Polonium qua Pressurized Reaction Chamber với một ít Fluorite Dust và bạn sẽ nhận được &9Polonium Pellets&r. Bạn sẽ cần một lượng lớn những thứ này cho tương lai.\n\n\n\nLưu ý: Điều này cũng sẽ tạo ra phụ phẩm là &7Spent Nuclear Waste&r, cần được bơm vào Waste Barrel để lưu trữ."]
	quest.1FAFDB20F504688E.quest_desc: ["&5Phép thuật&r có một vài thay đổi với &5&lApotheosis&r. \n\n\n\nTóm lại, 15 &7Kệ sách&r sẽ không đủ nữa. \n\n\n\nCó &7Kệ sách&r mới và các hành động bạn có thể thực hiện với &5Bàn Phép thuật&r bây giờ và hy vọng những nhiệm vụ này sẽ giúp bạn hiểu."]
	quest.1FAFDB20F504688E.title: "&5&lApothic Enchanting"
	quest.1FC7ABEAB5018E79.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_redstone.png width:100 height:150 align:center}"]
	quest.1FC7ABEAB5018E79.title: "&4Redstone&r"
	quest.1FC7E9DBF92BE6AA.quest_desc: ["Món đồ này được dùng để lưu trữ năng lượng, và hoạt động như một bộ pin di động.\n\n\n\nNó cũng là một nguyên liệu chế tạo quan trọng trong Mekanism."]
	quest.1FC7E9DBF92BE6AA.quest_subtitle: "Bộ Pin Di Động"
	quest.1FE052F643401232.quest_desc: ["Bạn sẽ cần những thứ này để làm Nâng Cấp Ba Lô."]
	quest.1FE052F643401232.quest_subtitle: "Cơ Sở Nâng Cấp"
	quest.1FE17B1C7C639F88.quest_desc: ["Bộ Điều Khiển Kho cho phép bạn làm việc với nhiều kho như thể chúng là một khối kho lớn duy nhất.\n\n\n\nĐiều này cho phép một mạng lưới kho rất lớn, có thể kết hợp với các mod như Applied Energistics hoặc Integrated Dynamics, vì Bộ Điều Khiển Kho đóng vai trò là điểm vào/ra cho tất cả các kho được kết nối với nó.\n\n\n\nViệc kết nối có thể được thực hiện bằng cách đơn giản đặt các kho cạnh Bộ Điều Khiển Kho hoặc cạnh những kho đã được kết nối (cách này hoạt động trong phạm vi 14 khối từ bộ điều khiển theo mọi hướng)."]
	quest.201EE3566D4D3123.quest_desc: ["Để khai thác &6Allthemodium&r bạn sẽ cần một Cuốc thuộc &5Netherite&r Cấp hoặc cao hơn!\n\n\n\nMột khi bạn cuối cùng cũng có được Quặng (trước tiên tôi khuyên bạn nên xử lý nó bằng Fortune, Occultism, hoặc Mekanism để có nhiều hơn) thì bạn có một vài lựa chọn về việc làm gì với nó.\n\n\n\nTôi khuyên bạn nên làm 2 Bệnh Tự Động Dịch Chuyển với &6Nuggets&r! Bạn có thể dùng chúng để đến &7&lThế Giới Khai Thác&r tìm thêm &6Allthemodium&r hoặc &b&lThe Other&r tìm các cuộc phiêu lưu khác.\n\n\n\nSau đó tôi khuyên bạn nên nâng cấp Cuốc của mình để bạn có thể Khai Thác &3Vibranium&r. Phần còn lại tùy bạn!\n\n{image:atm:textures/questpics/allthemodium/all_1.png width:100 height:100 align:center}"]
	quest.201EE3566D4D3123.title: "&6Thỏi Allthemodium"
	quest.204B969DA081056A.quest_desc: ["Chúng có thể xuất hiện ở hầu hết mọi nơi &2Vanilla&r Quái Vật Thù Địch xuất hiện. Chúng không phải là trùm, chỉ là kẻ thù nhiều hơn!\n\n\n\nChúng có 25 Điểm &cMáu&r và có nhiều đòn tấn công: &aRăng Nanh&r từ mặt đất như &aEvokers&r làm và một quả &bTuyết Bóng&r chúng có thể bắn bạn.\n\n\n\nChúng cũng có thể triệu hồi Zombie và Skeleton để giúp đánh bạn. Chúng sẽ không rơi bất cứ thứ gì và xuất hiện với Giáp từ mặt đất.\n\n\n\nChúng sẽ rơi Arcane Essence khi chết cùng với đôi khi một &3Tòa Thư&r!\n\n{image:atm:textures/questpics/iron_spells/spells_necromancer.png width:100 height:200 align:center}"]
	quest.204B969DA081056A.title: "Pháp Sư Xác Sống"
	quest.2077D64428E9C067.quest_desc: ["Một khái niệm quan trọng trong AE2 là một kỹ thuật được gọi là '&emạng con&f', trong đó một mạng ME riêng biệt bổ sung (một &emạng con&f) hoạt động cùng với mạng chính để thực hiện một chức năng hoặc quy trình chuyên biệt.\n\n\n\nĐiều phân biệt một mạng con với một mạng riêng biệt hoàn toàn thường là việc sử dụng &bSợi Thạch Anh&f như một phần cáp. Khi được đặt giữa hai đoạn cáp không được kết nối, Sợi Thạch Anh không truyền dữ liệu hoặc kênh nào giữa chúng, thay vào đó chỉ truyền năng lượng.\n\n\n\nDo đó, một mạng con ở phía bên kia của Sợi Thạch Anh có thể được cấp nguồn hoàn toàn bởi nguồn năng lượng của mạng chính, mà không cần bất kỳ nguồn điện phụ trợ nào khác."]
	quest.2077D64428E9C067.quest_subtitle: "Điều này có công dụng bên ngoài việc chế tạo cáp."
	quest.2077D64428E9C067.title: "Quên không nhắc đến"
	quest.209DC1E9AD4C5A84.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2cộng đồng đóng góp&r để sử dụng trong AllTheMods Modpacks.\n\n\n\nVì tất cả các gói &6AllTheMods&r đều được cấp phép theo &eAll Rights Reserved&r, nhiệm vụ này không được phép sử dụng trong bất kỳ gói công cộng nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng.\n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.20D4568857887D38.quest_desc: ["Đôi khi Router có thể ở trong tình huống nguy hiểm, như triệu hồi Wither.\n\n\n\nĐể bảo vệ nó bạn sẽ cần Blast Upgrade.\n\n\n\nTNT sẽ không phá nó, Wither sẽ không phá nó, chỉ có bạn."]
	quest.20EC8001A05CE2C8.quest_desc: ["Wireless Heat là một cách thú vị và dễ dàng để cấp năng lượng cho Lò nung. Đầu tiên, đặt Wireless Heat Transmitter và đưa Năng lượng vào. Sau đó, đặt Receiver vào Transmitter để liên kết. Cuối cùng, đặt Receiver vào phần Nhiên liệu của Lò nung để bắt đầu cấp năng lượng!"]
	quest.211FD55DEB635A98.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_copper.png width:100 height:150 align:center}"]
	quest.211FD55DEB635A98.title: "&6Đồng&r"
	quest.215C9C2B2240FAA1.quest_desc: ["&e&lIron's Spells&r &5Electric Armor&r!"]
	quest.215C9C2B2240FAA1.quest_subtitle: "20"
	quest.215C9C2B2240FAA1.title: "&5Trang phục Electromancer"
	quest.217DF3B66A07A8DE.quest_desc: [""]
	quest.217DF3B66A07A8DE.quest_subtitle: "&oVườn Địa Đàng chỉ với một Hạt giống."
	quest.217DF3B66A07A8DE.title: "&3&lHạt giống &2Dimensional"
	quest.2188C52C1F384DE4.quest_desc: [""]
	quest.2188C52C1F384DE4.quest_subtitle: "&oNhiên liệu cháy mãi (không thật sự)."
	quest.2188C52C1F384DE4.title: "&c&lNhiên liệu Triết gia"
	quest.219932CB19258C16.quest_desc: ["Thành phần lưu trữ cấp ba, cung cấp &e16384&f byte lưu trữ."]
	quest.219932CB19258C16.quest_subtitle: "x4^2"
	quest.219932CB19258C16.title: "Thành phần lưu trữ 16k"
	quest.219AA017149C36E2.quest_desc: ["Thảm bẫy Thương nhân sẽ giết chết mọi Thương nhân lưu động xuất hiện gần nó ngay lập tức!\n\n\n\nChúng có thể là những vật phẩm tốt nhất trong toàn bộ pack."]
	quest.219AA017149C36E2.quest_subtitle: "Không còn Thương nhân khó chịu nữa!"
	quest.21BEE9867796933A.quest_desc: ["Cái này rất đơn giản. Mặc &9Găng tay&r vào, nhặt một ít &fTuyết&r, vò nó lại, và Bùm bạn đã có một &fQuả tuyết&r! Chúng tốt hơn &2Vanilla&r &fQuả tuyết&r, chúng được làm với &9Găng tay&r!"]
	quest.21BEE9867796933A.quest_subtitle: "Được tìm thấy trong các Làng ở Taiga hoặc Taiga tuyết"
	quest.21BEE9867796933A.title: "&9Găng tay len"
	quest.21EA29A8C7F950CE.quest_desc: ["&bKim cương&r là mặt hàng chính của &2Minecraft&r, và của các Lò nâng cấp dường như...\n\n \n\nChúng hoạt động nhanh hơn, chỉ mất 80 Tick hoặc 4 Giây để nung chảy vật phẩm. Điều đó còn nhanh hơn cả Lò nung phun! \n\n \n\nChúng chỉ được chế tạo bởi &eLò Vàng&r và có thể chế tạo thành &3Lò Pha lê&r hoặc &aLò Ngọc lục bảo&r."]
	quest.21EA29A8C7F950CE.title: "&bLò Kim cương"
	quest.2215FB0777D7029D.quest_desc: ["Gai, đinh, crampons, bất cứ thứ gì! \n\n\n\n&7Giày Kiên định&r giúp bạn vững chãi trên chân. Bạn sẽ không bị đẩy lùi bởi các đòn tấn công và bạn sẽ không trượt trên Băng nữa."]
	quest.2215FB0777D7029D.quest_subtitle: "Chân"
	quest.2215FB0777D7029D.title: "&7Giày Kiên định&r"
	quest.221C9EDA651144BA.quest_desc: ["Gì &9Nước&r? \n\n\n\nVới &3Bùa Chìm&r, bạn di chuyển qua &9Nước&r như thể đó là Không khí! Dù vậy bạn vẫn không thể thở dưới nước..."]
	quest.221C9EDA651144BA.quest_subtitle: "Dây chuyền"
	quest.221C9EDA651144BA.title: "&3Bùa Chìm&r"
	quest.224716A537F2FFA0.quest_desc: ["&8Sách Giáp&r được dùng để nhận &5Phép Thuật&r chỉ dùng trên Giáp. Tất cả &8Sách&r có thể nhận &5Bảo Vệ&f, &5Bảo Vệ Nổ&f, và &5Bảo Vệ Lửa&r. \n\n\n\nMỗi loại cũng cung cấp những phép dành riêng cho một phần Giáp. Giày sẽ cho &5Đi Bể&r và Mũ sẽ cho &5Ưng Nước&r. \n\n\n\nNếu bạn muốn cơ hội tốt nhất chỉ cho &5Bảo Vệ&r, hãy thử &8Sách Giáp Ngực&r!"]
	quest.224716A537F2FFA0.title: "&8Sách Giáp"
	quest.226B8B60AF864FEF.quest_desc: ["Để nâng cấp &6Allthemodium&r lên &3Vibranium&r, bạn sẽ cần một Smithing Template khác. \n\nBạn có thể tìm thấy nó bằng cách chải Suspicious Soul Sand. \n\n\n\nNó được tìm thấy trong Bastions ở &l&cThe Nether&r.\n\n\n\n{image:atm:textures/questpics/allthemodium/all_bastion.png width:200 height:100 align:center}\n\n{image:atm:textures/questpics/allthemodium/all_soul.png width:200 height:100 align:center}"]
	quest.226B8B60AF864FEF.title: "&3Mẫu Rèn Vibranium&r"
	quest.2278A98DCDF713D7.quest_desc: ["Bây giờ là lúc để tạo Tank! Trước tiên bạn cần Building Blocks và ít nhất 1 Valve. Kính và Item IOs là tùy chọn.\n\n\n\nTank phải được làm từ khung bằng building blocks. Building blocks là bất cứ thứ gì không trong suốt, bị ảnh hưởng bởi trọng lực, hoặc là Dirt hoặc Grass tự nhiên.\n\n\n\nCác vật phẩm như đá, gỗ, hoặc kim loại phải tạo khung và các cạnh. Kính, Valves, và Item IOs phải được đặt trong tường và bên trong phải rỗng.\n\n\n\nNó chỉ có thể lớn tối đa 13x13x13. Khi bạn đã làm xong tất cả, nhấp chuột phải vào Valve và nó sẽ hiển thị 'Formed' hoặc thông báo lỗi."]
	quest.2278A98DCDF713D7.title: "&lTank"
	quest.22C4318523A43B49.quest_desc: ["&eTerminals&f cung cấp quyền truy cập vào bất kỳ nội dung nào của mạng ME. ME Terminal tiêu chuẩn &eME Terminal&f đơn giản liệt kê mọi thứ trong mạng như một lưới lớn để lấy và chèn vào, giống như một kho đồng nhất.\n\n\n\nME Crafting Terminal &eME Crafting Terminal&f là một phần mở rộng của ME Terminal, cung cấp thêm lưới chế tạo tích hợp, cho phép chế tạo thuận tiện bằng bất kỳ vật phẩm nào có trong mạng và hiển thị qua màn hình terminal."]
	quest.22C4318523A43B49.quest_subtitle: "[Điều đùa về người dùng Linux ở đây]"
	quest.22C4318523A43B49.title: "Terminal"
	quest.2331FCDD2F2B709A.quest_desc: ["&9Supercharged Coils&r được đặt trên SPS Port ở trung tâm của hai mặt, như hình dưới đây. Khi được cấp năng lượng, chúng sẽ siêu nạc Polonium thành Antimatter. Chỉ cần 1, nhưng bạn có thể dùng 2 nếu muốn.\n\n\n\nĐể sản xuất 1mb Antimatter, bạn cần 40MRF. Nếu bạn chưa bắt đầu làm &cFusion Reactor&r, đây là thời điểm tốt để làm nó!\n\n\n\n{image:atm:textures/questpics/mek/sps_coils.png width:200 height:125 align:1}"]
	quest.2331FCDD2F2B709A.title: "Cuộn Siêu Nạc"
	quest.233C7CAA573D6045.quest_desc: ["Mô-đun xác định hành động mà Router thực hiện.\n\n\n\nChúng có thể khiến Router của bạn lấy vật phẩm từ Rương, hoặc đặt vật phẩm vào rương, hoặc thậm chí cả hai! Và còn nhiều hơn nữa!\n\n\n\nMô-đun được lắp vào chính Router và có thể lắp nhiều cái.\n\n\n\nLọc và Nâng cấp được lắp vào chính các Mô-đun."]
	quest.233C7CAA573D6045.title: "&lMô-đun"
	quest.233E438357CD89F6.quest_desc: ["&9Van turbine&r được dùng để bơm vào &bHơi nước&r, cũng như bơm ra năng lượng mà turbine tạo ra.\n\n\n\n&8Ống thông gió turbine&r được dùng để bơm ra nước dư thừa khi sử dụng &aMáy ngưng tụ bão hòa&r. Nếu không, chúng giúp tăng tổng lưu lượng hơi nước trong turbine. Tổng số ống thông gió cũng giới hạn tổng Lưu lượng Hơi nước. Ống thông gió cũng có thể dùng trên mặt trên của turbine, nhưng trong bản thiết kế này, chúng ta sẽ chỉ dùng chúng trên các mặt ngoài.\n\n\n\n&aMáy ngưng tụ bão hòa&r được dùng để chuyển đổi &bHơi nước&r trở lại thành nước. Chúng được đặt trên hoặc phía trên lớp chứa Cuộn dây điện từ."]
	quest.233E438357CD89F6.title: "Các &aCổng"
	quest.234DC1702333EB18.quest_desc: ["Phần mở rộng &dAEInfinityBooster&f cung cấp hai bộ khuếch đại không dây tùy chỉnh cho phép phạm vi kết nối vô hạn, với tùy chọn hỗ trợ xuyên chiều."]
	quest.234DC1702333EB18.quest_subtitle: "Tôi không viết dòng Toy Story"
	quest.234DC1702333EB18.title: "Bộ khuếch đại vô hạn"
	quest.2354BC5330350DF6.quest_desc: ["Nếu &aNgọc lục bảo&r không phải sở thích của bạn thì &3Lò Pha lê&r có thể là thứ bạn muốn! \n\n \n\nHoạt động giống như &aLò Ngọc lục bảo&r ở 40 Tick. \n\n \n\nĐược làm từ &bLò Kim cương&r và có thể biến thành &dLò Obsidian&r. \n\n \n\n(Không, bạn không thể thấy vật phẩm đang nung chảy bên trong, nó chỉ trong suốt thôi)"]
	quest.2354BC5330350DF6.title: "&3Lò Pha lê"
	quest.235E3C386E8D36A3.quest_desc: ["Đây là nơi sự phân tách giữa &4Kệ Địa ngục&r và &bKệ Biển&r kết thúc! \n\n\n\nĐầu tiên, chúng ta cần Chế tạo một &9Kệ Đại dương ngủ đông&r. Chúng chỉ là 6 &8Gạch Deepslate nứt&r và 3 &7Sách&r. \n\n\n\nSau đó, chúng ta cần &a60 Eterna&r, &c40% Quanta&r, và &540% Arcana&r. Chúng ta có thể lấy được với 12 &bKệ Biển Pha lê&r hoặc 12 &4Kệ Địa ngục Phát sáng&r! \n\n\n\nCuối cùng, chúng ta có thể &d&lHòa trộn&r &9Kệ Đại dương ngủ đông&r của mình thành &9Kệ Đại dương&r thông thường!\n\n{image:atm:textures/questpics/apothic/enchant_deepshelf.png width:100 height:100 align:center}"]
	quest.235E3C386E8D36A3.title: "&9Kệ sâu"
	quest.23AE395433AED3C0.quest_desc: ["&6&lATM Star&r cần một vài Khối để giữ các Item khác nhau lại, và tạo thành hình ngôi sao! \n\n\n\nNhững Khối đầu tiên là &5Unobtainium&r - &6Allthemodium&r &5Hợp kim&r &6Khối&r."]
	quest.23AE395433AED3C0.title: "&6&lVỏ của Ngôi sao&r"
	quest.23F165DEAD225B10.quest_subtitle: "Để Truyền Điện"
	quest.2405663C033CBDF1.quest_desc: ["MK3 không quan tâm đến trục XYZ, tầm nhìn hay Chiều không gian. \n\n\n\nChỉ cần Kho hàng (Inventory) nằm trong cùng Thế giới Minecraft, nó có thể di chuyển item vào đó. \n\n\n\nThậm chí tôi còn không chắc liệu Kho hàng có cần phải trong trò chơi Minecraft để gửi đến không!"]
	quest.24150DE600C2D761.quest_desc: ["Cái này đơn thân độc mã đưa chúng ta từ rating E10 lên Teen. &4&lMáu&r là về việc giết kẻ thù để phục hồi &cMáu&r của chính bạn! Hầu hết các đòn tấn công sẽ hồi máu cho bạn. \n\n\n\n&4&lMáu&r có Vật liệu Tập trung là &4Bình Máu&r, mà bạn nhận được bằng cách nấu một Mob hoặc Người chơi trong Nồi lớn. \n\n\n\n&4Cuộn giấy&r của nó có màu Nâu (không có màu cho Nâu) với chữ &4Đỏ thẫm&r."]
	quest.24150DE600C2D761.title: "&4&lMáu"
	quest.24174700F7FB771C.quest_desc: ["Trong chương này, chúng ta sẽ sử dụng các máy Mekanism tiên tiến để tạo ra &aLò phản ứng&r đa khối mạnh mẽ, cũng như các cách thức tiên tiến để tạo và lưu trữ năng lượng. Điều này cũng dẫn đến việc chế tạo &dViên Phản vật chất&r, được dùng để làm &6ATM Star&r, cũng như một số công cụ và vũ khí mạnh nhất trong pack."]
	quest.24174700F7FB771C.title: "&aMekanism&r: &dLò phản ứng"
	quest.243008D4DCD789D0.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_wild.png width:100 height:150 align:center}"]
	quest.243008D4DCD789D0.quest_subtitle: "Đền rừng"
	quest.243008D4DCD789D0.title: "Trang trí giáp hoang dã"
	quest.24391162F4FF0587.quest_desc: ["Với 15 &bTủ sách biển&r xung quanh &5Bàn phép&r, chúng ta có thể &d&lthổi hồn&r &bTủ sách biển&r cuối cùng! \n\n\n\n&bTủ sách biển được thổi hồn&r cho nhiều &aEterna&r hơn ở mức 5 với tối đa &a60&r. Cũng nhiều &5Arcana&r hơn ở &55%&r. \n\n\n\nChúng có thể được chế tạo thành các &7Tủ sách&r khác nhau, cái chúng ta cần, cho &6Phép tối đa&r là &bTủ sách pha lê&r. \n\n\n\nChúng ta cần 12 cái, vì vậy cần 12 &bTủ sách biển được thổi hồn&r. Chế tạo 8 cái và tôi sẽ thưởng bạn 4 cái còn lại!"]
	quest.24391162F4FF0587.title: "&bTủ sách biển được thổi hồn"
	quest.2447208F1DC74FFE.quest_desc: ["Router có thể ồn, và tiếng ồn chắc chắn cộng dồn khi bạn có hàng trăm cái.\n\n\n\nCó lẽ nên đầu tư vào Nâng cấp Giảm ồn thì!"]
	quest.247DAE5B4E1AC7F1.quest_desc: ["Nước vào. \n\nNước ra. \n\n\n\nModule chất lỏng sẽ lấy Nguồn chất lỏng từ gần Router và đặt vào một Bình chứa trong Bộ đệm hoặc lấy chất lỏng từ một Bình chứa trong Bộ đệm của nó và đặt ở phía trước nó. \n\n\n\nChỉ hoạt động với các khối liền kề Router, nếu bạn muốn phạm vi lớn hơn bạn sẽ cần..."]
	quest.24934231538B6492.quest_desc: ["Kim Tự tháp Cổ là một trong 3 Cấu trúc trong &b&lThe Other&r. \n\n\n\nRõ ràng nó là một Kim tự tháp và không, cái này không có tầng hầm! \n\n\n\nThay vào đó nó có Piglich.\n\n\n\n{image:atm:textures/questpics/allthemodium/all_pyramid.png width:200 height:100 align:center}"]
	quest.24934231538B6492.title: "Kim Tự tháp Cổ"
	quest.24A7B2902E7430A1.quest_desc: ["&7Giáp da&r chỉ với một chút Arcane rắc lên. \n\n\n\nTăng Mana cho Phép, chỉ một chút."]
	quest.24A7B2902E7430A1.quest_subtitle: "15"
	quest.24A7B2902E7430A1.title: "§9Đồ dùng Pháp sư Lưu lạc"
	quest.24BAC1C0392E950E.quest_desc: ["Tôi nghe nói bây giờ bạn có thể tham gia các lớp học trực tuyến để trở thành một người như vậy.\n\n{image:atm:textures/questpics/iron_spells/spells_outfit_priest.png width:60 height:100 align:center}"]
	quest.24BAC1C0392E950E.title: "§6Trang phục Linh mục"
	quest.24C757B8AA6841F6.quest_desc: ["§5§lApotheosis§r biết việc lấy §3Trident§r có thể khó khăn nên họ đã làm cho dễ hơn... cũng hơi dễ hơn! \n\n\n\nBây giờ bạn có thể chế tạo một §3Inert Trident§r và §d§lThổi hồn§r nó để có một §3Trident§r bình thường. \n\n\n\n§3Trident§r yêu cầu từ §a40 Eterna§r, §c20%-50% Quanta§r, và ít nhất §535% Arcana§r. \n\n\n\nBạn có thể làm được với 1 §7Kệ sách§r, 4 §9Kệ Sculk Vang vọng§r, và 1 §2Kệ Dưa hấu§r."]
	quest.24C757B8AA6841F6.title: "§3Chế tạo một Trident thật"
	quest.24C9BA6DC32CFAD9.quest_desc: ["Than đá là nguồn sức mạnh thực sự đầu tiên của bạn. Nếu bạn sắp hết và không tìm thấy Than đá, một lựa chọn thay thế tốt hơn cho bạn sẽ là Than gỗ."]
	quest.24C9BA6DC32CFAD9.quest_subtitle: "Nung khúc gỗ"
	quest.24FCFF18296ED907.quest_desc: ["Để nâng cấp §9Deepshelves§r xa hơn nữa, thật bất ngờ chúng ta không cần §d§lInfusion§r! Thay vào đó chúng ta cần nhiều chế tạo hơn! \n\n\n\nĐầu tiên, là 5 §3Sculk Blocks§r và một §3Sculk Catalyst§r. Cả hai đều có thể tìm thấy trong §9Deep Dark§r và sẽ cần §5Silk Touch§r để thu thập. \n\n\n\nCuối cùng là §9Warden Tendril§r... đây là vật rơi từ §9§lWarden§r... Đúng vậy, bạn sẽ cần giết §9§lWarden§r. \n\n\n\nKhi bạn có tất cả những thứ đó, bạn có thể chế tạo một trong những §7Bookshelves§r tốt nhất! Một cái cho §a10 Eterna§r, §c15% Quanta§r, và §510% Arcana§r. \n\n\n\nVà quan trọng nhất, cho chúng ta §aEterna§r tối đa là §a80§r! Gần đến 100 rồi!"]
	quest.24FCFF18296ED907.title: "§9Kệ Sculk Chạm Hồn"
	quest.25080E3295B1DF01.quest_desc: ["§5Lò Unobtainium§r nung vật phẩm nhanh hơn bất kỳ Lò nào khác trong pack!"]
	quest.25080E3295B1DF01.title: "&5Lò nung Unobtainium"
	quest.2559201BCF5D497C.quest_subtitle: "Sản xuất các vật liệu Overworld đa dạng"
	quest.25AFD10D008DF30B.quest_desc: ["Rương End đều chia sẻ cùng một kho đồ và kho đồ đó khác nhau cho mỗi người chơi. Chúng không thể kết hợp thành một."]
	quest.25DBA00422301EDC.quest_desc: ["Cấp độ lưu trữ MEGA thứ hai, cung cấp &e4194304&f (4096k) byte lưu trữ."]
	quest.25DBA00422301EDC.quest_subtitle: "x4"
	quest.25DBA00422301EDC.title: "Thành phần lưu trữ 4M"
	quest.25EFC21A3C48E0B6.title: "Cấp: &2Spirited"
	quest.2607F3DC07049785.quest_desc: ["Tại sao phải tốn thời gian ngồi xuống và ăn một bữa ăn nấu tại nhà ngon lành khi bạn có thể chỉ cần Ăn và Uống nhanh chóng! \n\n\n\nVới chiếc mũ rất thời trang &6 này, việc Ăn và Uống nhanh hơn rất nhiều."]
	quest.2607F3DC07049785.quest_subtitle: "Đầu"
	quest.2607F3DC07049785.title: "&6Mũ Uống Nhựa"
	quest.260C7F3C1F51221D.quest_desc: ["&e&lPhép thuật của Iron&r &aÁo giáp Hô vong&r!"]
	quest.260C7F3C1F51221D.quest_subtitle: "20"
	quest.260C7F3C1F51221D.title: "&aTrang phục Archevoker"
	quest.263220DCCDB90E29.quest_desc: ["Cho đến nay, để \"gấp đôi\" sản lượng phôi kim loại, hệ thống của bạn nên trông giống như thế này:\n\n\n\nQuặng thô được đưa vào &aBuồng thanh lọc&r của bạn, được cung cấp &aOxy&r từ &6Máy tách điện ly&r.\n\n\n\nSản phẩm sau đó được xuất ra &aMáy nghiền&r, chuyển đổi cụm quặng thành \"Bụi bẩn\". \"Bụi bẩn\" này được đưa vào &aBuồng làm giàu&r, chuyển đổi \"Bụi bẩn\" thành \"Bụi quặng\" thích hợp.\n\n\n\n&aBuồng làm giàu&r sau đó cung cấp cho lò nung bạn ưa thích."]
	quest.263220DCCDB90E29.quest_subtitle: "Nhà máy quặng Cấp 2"
	quest.2664388EBA1E8F90.quest_subtitle: "&f8 &cSát thương"
	quest.268F6E67AA79A7BD.quest_subtitle: "&f69 &cSát thương"
	quest.26988E22BD019628.quest_desc: ["Tự động nung chảy các vật phẩm trong Ba lô."]
	quest.26988E22BD019628.quest_subtitle: "Tự động"
	quest.26988E22BD019628.title: "&eNâng cấp Tự động Phun lửa"
	quest.26A9F402DAE15EA2.quest_desc: ["Thêm giao diện Lò hun khói (Smoker) vào Ba lô."]
	quest.26D306418545A2D6.quest_desc: ["Lò phản ứng &dFusion Reactor&r có thể sản xuất tới 200MRF/t khi tự vận hành, nhưng trước tiên chúng ta cần hiểu một số cơ chế.\n\n\n\nCách dễ nhất để sản xuất năng lượng là bơm riêng Deuterium và Tritium, sau đó điều chỉnh lượng nhiên liệu đốt cháy bằng &aTỷ lệ tiêm&r trong &cThẻ Nhiên liệu&r.\n\n\n\nGiá trị này phải là số chẵn với tối đa 98, vì nó kết hợp nhiên liệu D-T bên trong chính Lò phản ứng. Mức tiêu thụ của mỗi nhiên liệu bằng một nửa Tỷ lệ tiêm mỗi tick, nghĩa là 49mb/t cho mỗi loại ở mức tối đa.\n\n\n\nTuy nhiên, bạn có thể tiêm trực tiếp &dD-T Fuel&r, nhưng sẽ không thể điều chỉnh Tỷ lệ tiêm. Điều này sẽ tạo ra lượng năng lượng khổng lồ mỗi tick, nhưng với mức tiêu thụ nhiên liệu cao hơn nhiều là 500mb/t cho mỗi nhiên liệu.\n\n\n\n{image:atm:textures/questpics/mek/fusion_fuelui1.png width:175 height:150 align:1}"]
	quest.26D306418545A2D6.title: "&dNguồn Năng lượng Cuối Cùng"
	quest.2748ACEAB96A5F60.quest_desc: ["Lò Sắt (Iron Furnaces) (Đừng nhầm lẫn với các tựa đề, trong đó &lIron Furnaces&r là tên mod và tên Item) hoạt động nhanh hơn cả Lò Bình thường và Lò Đồng. Chúng mất 160 Tick để hoạt động, tương đương 8 giây.\n\n\n\nChúng có thể được chế tạo từ một Lò Bình thường hoặc &6Lò Đồng&r! Và chúng có thể được biến thành &7Lò Bạc&r hoặc &eLò Vàng&r."]
	quest.2748ACEAB96A5F60.title: "&fLò Sắt"
	quest.275D97BF0CE9DCD4.quest_subtitle: "Cấp: &b3"
	quest.2786D5AC19163524.quest_desc: ["Khối này kích hoạt các công thức nung trong cấu trúc nhà bếp multi-block của bạn!"]
	quest.2786D5AC19163524.quest_subtitle: "Không cần Bộ đếm thời gian"
	quest.2786D5AC19163524.title: "Honey, có một cái lò trong nhà bếp"
	quest.27A4FA38992448A0.quest_desc: ["Flux Networks cũng cung cấp cách để sạc đồ của bạn không dây, thậm chí xuyên qua các chiều không gian!\n\n\n\nMột khi bạn đã gắn một Plug vào hệ thống năng lượng, bạn sẽ muốn chế tạo &9Flux Controller&r và đặt nó xuống.\n\n\n\nNhấp chuột phải vào nó để mở giao diện, và chuyển đến thẻ \"Sạc không dây\". Từ đó, bạn có thể chọn từng phần trong kho đồ của mình mà bạn muốn giữ sạc. Để kích hoạt, hãy nhấn nút chuyển đổi ở dưới cùng để bật Sạc không dây, sau đó nhấn apply!\n\n\n\n{image:atm:textures/questpics/basic_power/wireless_ui.png width:125 height:150 align:center}"]
	quest.27A4FA38992448A0.title: "Sạc không dây"
	quest.27CF1A2587321A2C.quest_desc: ["Cuốn Sách Phép &eTốt nhất&r bạn có thể tưởng tượng! 15 &3Khe Phép&r! Có thật 15 &3Phép&r?!?! Ồ đúng rồi có 15, không phải nhiều lắm... \n\n\n\nLàm giống như trước: Sách trước, Phôi và Mẫu."]
	quest.27CF1A2587321A2C.title: "&5Unobtainium&r Sách Phép"
	quest.27E951F4F4F6F847.quest_desc: ["Tương tự &aDây chuyền Gai&r, chỉ nóng hơn một chút. Không, nóng hơn nhiều! \n\n\n\n&cDây chuyền Lửa&r có cơ hội đốt cháy kẻ tấn công bạn! Khi chúng bị cháy, &cDây chuyền&r cũng sẽ cho bạn Kháng Lửa."]
	quest.27E951F4F4F6F847.quest_subtitle: "Dây chuyền"
	quest.27E951F4F4F6F847.title: "&cDây chuyền Lửa&r"
	quest.282CE3A088AE5CFB.quest_desc: ["Tôi sẽ cho rằng bạn đã chế tạo rồi, đúng không? Cuối cùng thì đây là MineCRAFT mà.\n\n\n\nChắc chắn rồi, bạn có thể chế tạo trong túi đồ bằng lưới chế tạo 2x2, nhưng điều đó sẽ không đưa bạn đi xa. Chúng ta cần nâng cấp bằng cách làm một Bàn chế tạo!"]
	quest.282CE3A088AE5CFB.title: "Chế tạo trong Minecraft"
	quest.28408BFAA54E4FC6.quest_desc: ["&7Giáp Da&r là bộ giáp tệ nhất bạn có thể lấy được. \n\n\n\nĐiều đó chủ yếu vì &c&lMojang&r mong đợi bạn lấy nó trước bất kỳ thứ nào khác. \n\n\n\nTôi gần như không bao giờ lấy nó vì tôi khó tìm được nhiều &8C&fo&8w&fs, xin lỗi &c&lMojang&r!"]
	quest.28408BFAA54E4FC6.quest_subtitle: "7"
	quest.28408BFAA54E4FC6.title: "&7Áo giáp da"
	quest.2893F483C10293E6.quest_desc: ["&lChào mừng đến với &bApplied Energistics 2&f!\n\n\n\nApplied Energistics 2 (hay &oAE2&r) là một mod lưu trữ kỹ thuật số vô cùng linh hoạt, cho phép lưu trữ cực kỳ hiệu quả và nhiều khả năng tự động hóa để cải thiện đáng kể trải nghiệm Minecraft modded của bạn từ sớm cho đến endgame.\n\n\n\nĐể biết thêm thông tin về AE2 ngoài chương này, hãy tham khảo wiki tại\n\n&o&bappliedenergistics.github.io&f&r."]
	quest.2893F483C10293E6.quest_subtitle: "Hệ thống lưu trữ ảo"
	quest.2893F483C10293E6.title: "Applied Energistics 2"
	quest.2897FA291E5A38D8.quest_desc: ["&bSpatial Anchor&f là một thiết bị đi kèm từ dòng Spatial IO, đơn giản hoạt động như một chunk loader. Khi kết nối với mạng ME, Anchor sẽ giữ nguyên tải (force-load) tất cả các chunk do mạng ME chiếm dụng qua mọi cáp và thiết bị, ngoại trừ các mạng con, miễn là mạng vẫn được cấp nguồn."]
	quest.28C9EDBF6607E180.quest_desc: ["Khối này là một phần của nhà bếp multi-block.\n\n\n\nNó sẽ hiển thị mọi công thức có sẵn cho bạn với thức ăn bạn có trong kho đồ, hoặc được lưu trữ trong nhà bếp multi-block.\n\n\n\nBạn cuối cùng cũng có thể tạo một căn bếp đẹp trong Minecraft."]
	quest.28C9EDBF6607E180.quest_subtitle: "Betty White sinh ra trước cả bánh mì cắt lát"
	quest.28C9EDBF6607E180.title: "ĐIỀU TUYỆT VỜI NHẤT KỂ TỪ KHI CÓ BÁNH MÌ CẮT LÁT"
	quest.28E60192912BEBAD.quest_desc: ["Trong &l&2Vanilla&r, dân làng có thể rất khó chịu khi giao tiếp. Làm mới các giao dịch không hề dễ dàng, và chuyên nghiệp đôi khi cũng khó xử lý.\n\n\n\n&l&2Easy Villagers&r là một mod để làm tất cả những điều này dễ dàng hơn! Để bắt đầu, bạn có thể nhặt một dân làng lên bằng cách sneak-right click vào chúng. Chúng sau đó có thể dễ dàng đặt trong thế giới, hoặc trong các khối cụ thể từ mod &l&2Easy Villager&r!\n\n\n\nBạn có thể tìm kiếm &d@EasyVillagers&r trong JEI để xem các khối mod cung cấp!"]
	quest.28E60192912BEBAD.quest_subtitle: "Dân làng, dễ dàng"
	quest.28E60192912BEBAD.title: "&l&2Dân Làng Dễ"
	quest.29448D08C8777425.quest_desc: ["Đến tối nay anh ấy sẽ ngủ với cá.\n\n\n\n&cMũ Người Câu Cá&r giúp bạn dụ cá và làm tăng cơ hội nhận được vật phẩm hiếm!"]
	quest.29448D08C8777425.quest_subtitle: "Đầu"
	quest.29448D08C8777425.title: "&cMũ Người Câu Cá"
	quest.2960FFE0C53DFEB1.quest_desc: ["&cSự Giam Cầm Vĩnh Viễn Của Sevira&r là cấp độ thứ ba của &6Nghi Lễ Thấm Nhuần&r. Nó chủ yếu được dùng để tạo ra cấp độ tiếp theo của phấn nền tảng, Phấn Đen.\n\n\n\nNó cũng được dùng để tạo ra một vài vật phẩm có thể tăng tốc độ tạo và thực hiện nghi lễ một cách đáng kể."]
	quest.2960FFE0C53DFEB1.quest_subtitle: "Nghi Lễ \"Even More Everything\""
	quest.2960FFE0C53DFEB1.title: "&cSự Giam Cầm Vĩnh Viễn Của Sevira"
	quest.299F56B753286D0C.quest_subtitle: "Cấp độ: &e5"
	quest.29A05589E96C0569.quest_subtitle: "Cấp độ: &54"
	quest.29C83B00AC4AFC23.quest_desc: ["Bây giờ bạn đã đi được xa đến thế này, bạn có thể tự hỏi, điều gì tiếp theo? Ồ, còn rất nhiều thứ để khám phá trong Occultism!\n\n\n\nBạn có thể xem một danh sách toàn diện về mọi nghi lễ và vật phẩm trong &6Từ Điển Linh Hồn&r của bạn, bạn có thể thử xem qua tất cả kết quả của các nghi lễ để xem liệu bạn có thể tìm thấy thứ gì khiến bạn thích thú!\n\n\n\nNếu bạn chưa làm, bạn có thể bố trí và trang trí ba khu vực nghi lễ riêng biệt, một cho Mời Gọi, một cho Chiếm Hữu, và một cho Thấm Nhuần.\n\n\n\nLuôn luôn có những cách mới để sử dụng từng tính năng tưởng chừng bình thường để tối đa hóa trải nghiệm của bạn với modpack. Chúc bạn chế tạo nghi lễ vui vẻ!"]
	quest.29C83B00AC4AFC23.title: "Tiếp theo là gì?"
	quest.2A3683BF7E50EF83.quest_desc: ["Hầu hết các vật phẩm chúng ta cần từ &3Otherworld&r gần đây chỉ cần một ít Spiritfire. Tuy nhiên, chúng ta sẽ cần sự trợ giúp của &3Third Eye&r để tìm quặng &3Otherworld&r.\n\n\n\nChúng ta cũng cần một cuốc đặc biệt để có thể khai thác nó. Để làm được điều này, chúng ta cần Hòa trộn một con Demon vào &dSpirit Attuned Pickaxe Head&r để tạo ra một cuốc có thể phá vỡ loại quặng mới này."]
	quest.2A3683BF7E50EF83.title: "Công cụ nghề nghiệp: Cuốc Hòa trộn"
	quest.2A5004EB99AE4F96.quest_desc: ["Có nhiều vật phẩm Otherworld hơn mà bạn sẽ cần thu thập, và việc ăn &cDemon's Dream Fruit&r mỗi lần bạn cần hiệu ứng &7Third Eye&r thật phiền phức.\n\n\n\nĐây chính là lý do tại sao &dKính Otherworld&r tồn tại! Khi trang bị (ngay cả trong khe Curios), nó cung cấp hiệu ứng Third Eye!"]
	quest.2A5004EB99AE4F96.quest_subtitle: "Dừng ăn quả đó đi!"
	quest.2A5004EB99AE4F96.title: "Công cụ nghề nghiệp: Kính Spectral"
	quest.2A787B99A8B0C767.quest_desc: ["Một khối rất quan trọng và rất phổ biến! Có thể chế tạo hoặc tìm thấy trong hầu hết các Cấu trúc &lIron Spells&r. \n\n\n\nChúng được dùng để thêm và gỡ &3Scrolls&r khỏi &eSpell Books&r! Ném &eSpell Book&r vào khe Book rồi thêm &3Scroll&r bên dưới. Nếu bạn muốn gỡ một &3Scroll&r, nhấp vào nó rồi lấy từ bên phải và vào kho đồ của bạn.\n\n{image:atm:textures/questpics/iron_spells/spells_table_gui.png width:150 height:100 align:center}"]
	quest.2AC7BC448C007BDB.quest_desc: ["Củng cố Kivi với Nhôm và bạn sẽ nhận được Khung Máy, vốn cần để chế tạo máy móc."]
	quest.2AD68066C1948C90.quest_desc: ["Cái &eFoliot Crusher&r đầu tiên thật tuyệt, nhưng nếu tôi nói với bạn rằng bạn có thể triệu hồi một con demon cho bạn 6 bụi mỗi quặng thô nó nghiền?\n\n\n\n\& amp;9Marid Crusher&r làm chính xác điều đó. Để triệu hồi một con, bạn sẽ cần sử dụng &9Fatma's Incentivized Attraction&r."]
	quest.2AD68066C1948C90.quest_subtitle: "Triệu hồi Tối đa"
	quest.2AD68066C1948C90.title: "&9Sự Hấp Dẫn Được Khuyến Khích Của Fatma"
	quest.2AD78E22988A92D3.quest_desc: ["Tôi thấy bạn rồi! \n\n\n\nKhi đeo &2Kính nhìn đêm&r, bạn có khả năng nhìn trong bóng tối! Không có gì nhiều hơn về chúng..."]
	quest.2AD78E22988A92D3.quest_subtitle: "Đầu"
	quest.2AD78E22988A92D3.title: "&2Kính nhìn đêm"
	quest.2AEBE3F28996A6ED.quest_desc: ["Với các kim loại mới, chúng ta có thể nâng cấp Lò nung bằng mod &aIron Furnaces&r!\n\n\n\nIron Furnaces (các Lò nung từ mod đó, không chỉ phiên bản sắt) cho phép bạn thêm &aAugments&r để nâng cấp tốc độ, thay đổi chức năng của lò, và hơn thế nữa!\n\n\n\nNhững lò nung này làm cho tự động hóa dễ dàng hơn bằng cách cho phép bạn tự động kéo hoặc đẩy từ các cạnh bằng cấu hình ở bên trái giao diện."]
	quest.2AEBE3F28996A6ED.title: "&aNâng cấp Lò nung&r!"
	quest.2B05A29C62676EB2.title: "&l&9Săn thưởng Overworld:&r&e Zombies"
	quest.2B08B19B35EEBCBA.quest_desc: ["Những Di vật này có thể được tìm thấy trong &cThe Nether&r!"]
	quest.2B08B19B35EEBCBA.title: "&cThe Nether"
	quest.2B31E6C1707D8195.quest_desc: ["Thứ tiếp theo cần tạo để cho phép truy cập mạng không dây là &bME Wireless Access Point&f. Access Point được dùng để mở mạng cho truy cập không dây thông qua &ewireless terminal&f, và có phạm vi cố định (hữu hạn) tùy thuộc vào số lượng &bWireless Boosters&f được chèn vào access point."]
	quest.2B3F2F470E06BC40.quest_desc: ["Với tất cả các khối đã thu thập, đã đến lúc xây dựng thứ này. Dưới đây là hướng dẫn văn bản, hoặc bạn có thể xem Ponder!\n\n\n\nThe SPS sẽ có kích thước 7x7 khi xây, nhưng nó không phải là một khối lập phương. Nó tuân theo một mẫu đơn giản, mà bạn có thể làm theo các hình ảnh bên dưới như một hướng dẫn xây dựng. Mẫu trông như thế này:\n\n\n\n{image:atm:textures/questpics/mek/basic_sps_shape.png width:250 height:225 align:1}\n\n\n\nMỗi mặt, bao gồm đáy và đỉnh, sẽ tuân theo mẫu này. Các Cuộn dây Siêu nạp (Supercharged Coils) nên được đặt đối diện nhau ở trung tâm của các mặt tương ứng, và hai cổng còn lại sẽ được dùng để bơm vào Polonium, và bơm ra Khí Antimatter.\n\n{@pagebreak}\n\nDưới đây là cấu trúc hoàn thành:\n\n\n\n{image:atm:textures/questpics/mek/sps_complete.png width:300 height:250 align:1}"]
	quest.2B5E14A47062F83C.quest_subtitle: "Chữ R trong Roy G. Biv"
	quest.2B5E14A47062F83C.title: "§cViên ngọc Xychorium Đỏ"
	quest.2B60D123123A5E8E.quest_desc: ["Tại sao đặt một vị trí để Năng lượng có thể đi đến? Tại sao không để nó tự do! \n\n\n\nGiống như thả một đàn Ong, Năng lượng sẽ đi khắp mọi nơi gần như tức thì (với ít tiếng ù ù hơn). Bất kỳ khối nào cần Năng lượng ở gần sẽ được sạc không dây."]
	quest.2B76B2F18C2C47D2.quest_desc: ["Khi đốt nhiên liệu, Lò phản ứng phân hạch tạo ra một lượng nhiệt lớn. Để ngăn Lò phản ứng biến thành TNT, chúng ta cần đảm bảo nó được làm mát đúng cách.\n\n\n\nCách dễ nhất là cung cấp cho Lò phản ứng §9Nước§r từ một Cái bồn (Sink). Cái bồn là nguồn nước vô hạn, điều này §othực sự tuyệt vời trong tình huống như thế này§r.\n\n\n\nBơm nước vào một trong các Cổng của Lò phản ứng được đặt thành §ađầu vào§r để đổ đầy Lò phản ứng bằng nước. Nước này sẽ được đun nóng khi Lò phản ứng chạy và chuyển thành §bHơi nước§r, mà bạn có thể dùng để tạo năng lượng trong một §9Tuabin Công nghiệp§r.\n\n\n\n§eNatri§r cũng có thể được dùng như một chất làm mát hiệu quả hơn nhiều. Điều này cho phép tỷ lệ đốt cao hơn và nhiệt độ lõi thấp hơn."]
	quest.2B76B2F18C2C47D2.quest_subtitle: "H2O Chất lượng cao"
	quest.2B76B2F18C2C47D2.title: "Làm mát Lò phản ứng"
	quest.2B901ECF97FFA181.quest_desc: ["Khi bạn cuối cùng kết hợp các Mảnh Ancient Knowledge, bạn sẽ nhận được... §9Bản thảo Eldritch§r! Đó là lớp cuối cùng! \n\n\n\n§9Eldritch§r là lớp cuối, mạnh nhất trong tất cả §3Phép thuật§r. Chúng được chế tạo với §9Mảnh Echo§r và cần được học từ §9Bản thảo§r để sử dụng. Mỗi §9Bản thảo§r chỉ dùng một lần."]
	quest.2B901ECF97FFA181.title: "§9§lEldritch"
	quest.2B9AF0D6ED8BA628.quest_subtitle: "§f6 §cSát thương Tấn công"
	quest.2BB5769119BA2472.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2người đóng góp cộng đồng&r để sử dụng trong các Modpack AllTheMods. \n\n\n\nVì tất cả các gói &6AllTheMods&r được cấp phép theo &eAll Rights Reserved&r, nhiệm vụ này không được phép sử dụng trong bất kỳ gói công cộng nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng. \n\n\n\nNhiệm vụ này được ẩn có chủ ý, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.2BB910B217DF3A12.quest_subtitle: "Tại sao nó ướt? Nó đã ở trong hồ à?"
	quest.2BB910B217DF3A12.title: "&dEnder&r Quả cầu nâng cấp"
	quest.2BD077EFE77B8EBB.quest_desc: ["Thây ma có các biến thể khác nhau xuất hiện ở các sinh cảnh khác.\n\n\n\nHusks - xuất hiện ở sa mạc.\n\nDrowned - xuất hiện dưới nước."]
	quest.2BD077EFE77B8EBB.title: "Biến thể Thây ma"
	quest.2C04B3BA507D5673.quest_desc: ["&bMẫu&f là những thứ chứa một công thức đã mã hóa để được thực hiện bởi Nhà cung cấp Mẫu. Để mã hóa một công thức lên Mẫu, &bGiao diện mã hóa Mẫu ME&f phải được sử dụng.\n\n\n\nMẫu có thể được đặt để chứa một công thức &echế tạo&f thông thường, điều này sẽ yêu cầu sử dụng &eBộ lắp ráp phân tử&f trên mặt của Nhà cung cấp Mẫu, hoặc một công thức '&exử lý&f' tổng quát hơn, trong đó bất kỳ vật phẩm đầu vào nào có thể được gửi ra bởi nhà cung cấp vào một khối máy khác hoặc nhà máy chế biến chuyên biệt."]
	quest.2C04B3BA507D5673.title: "Mẫu"
	quest.2C4299D33D419AA0.quest_desc: ["Đặt Teleport Pad trong &2&lOverworld&r để đi đến &7&lMining Dimension&r."]
	quest.2C4299D33D419AA0.title: "&2&lOverworld"
	quest.2C4ECA4F5B1639F4.quest_desc: ["Light Field không chiếu nhiều ánh sáng, nhưng nó hoạt động như một Mega Torch.\n\n\n\nQuái vật sẽ không xuất hiện trong một khu vực xung quanh nó. Khu vực đó có bán kính khoảng 32 khối."]
	quest.2C4ECA4F5B1639F4.title: "&fTrường ánh sáng"
	quest.2C7D62231AD6406A.quest_desc: ["XyCraft có một cấu trúc bể chứa chất lỏng rất tuyệt!"]
	quest.2C7D62231AD6406A.title: "&bLưu trữ và Thao tác Chất lỏng"
	quest.2CCAA7C0FEDEB573.quest_desc: ["Nếu bạn giống như hầu hết mọi người, đây là nguồn năng lượng bạn đang tìm kiếm. Tất cả những gì bạn cần làm là đặt nó càng cao càng tốt và nhận năng lượng miễn phí."]
	quest.2CCAA7C0FEDEB573.title: "Năng lượng gió"
	quest.2CCFEE98FE3B2E97.quest_desc: ["Những cỗ máy này được dùng để tự động hóa việc đặt/phá khối. Chúng đặc biệt hữu ích khi tự động hóa latex."]
	quest.2CCFEE98FE3B2E97.title: "Khối"
	quest.2CF6EA138B53CE1B.quest_desc: ["&3Vibranium&r kết hợp với &5Unobtainium&r!"]
	quest.2CF6EA138B53CE1B.title: "&5Unobtainium&r - &3Vibranium&r Thỏi hợp kim"
	quest.2CF96A264EB5522C.quest_desc: ["&9Tháp Đảo Ngược của Uphyxes&r là cấp độ cao nhất của &6Nghi thức Truyền&r. Nó không có nhiều công dụng như ba cấp độ khác, nhưng vẫn cần thiết cho \"giai đoạn cuối\" của Occultism. \n\n\n\nChủ yếu, nó được dùng để tạo Bụi Dragonyst, là nguyên liệu chính cho Phấn Hồng."]
	quest.2CF96A264EB5522C.quest_subtitle: "Infusion Tối Đa"
	quest.2CF96A264EB5522C.title: "&9Tháp Đảo Ngược của Uphyxes"
	quest.2D64EF8D803AF9DA.quest_desc: ["Cổng đắt nhất chúng ta có thể làm. Đầu tiên, cho &dTrứng Rồng&r, bạn không cần phải liên tục vắt sữa &dCon Rồng&r, bạn có thể dùng &l&bHNN&r hoặc &l&2MA&r để lấy chúng, hoặc dùng Extrator để làm thêm! \n\n\n\nSau đó, bạn sẽ cần &dHơi Thở Rồng Được Hòa Trộn&r từ Enchanting. \n\n\n\nỞ đó bạn sẽ cần &9Kệ Sculk Được Chạm Bởi Linh Hồn&r để Enchant nó và để làm Cổng. \n\n\n\nNếu bạn đang tự hỏi tại sao Cổng không hoạt động, đó là vì bạn đã ở trong &2&lOverworld&r! Đùa thôi, bạn không thể dùng nó!"]
	quest.2D8026E10FBA7A72.quest_desc: ["Một cái cuốc rất nhanh."]
	quest.2D8026E10FBA7A72.title: "&6Allthemodium &5Hợp Kim &3Cuốc"
	quest.2D84DA544D7A24FA.quest_desc: ["Nhiệm vụ này được tạo bởi &6Nhân viên AllTheMods&r, hoặc một &2Người đóng góp cộng đồng&r để sử dụng trong các Modpack AllTheMods. \n\n\n\nVì tất cả các pack &6AllTheMods&r được cấp phép theo &eAll Rights Reserved&r, Nhiệm vụ này không được phép sử dụng trong bất kỳ pack công khai nào không được phát hành bởi &6Đội AllTheMods&r mà không có sự cho phép rõ ràng. \n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn thấy cái này, bạn đang ở chế độ chỉnh sửa."]
	quest.2DD5F0693780B10A.quest_desc: ["Khi dùng với Extruder MK2, các khối được ép sẽ mô phỏng chính xác khối thật. Khối Redstone sẽ phát Redstone, Khối Glowstone sẽ phát sáng, Đất cỏ sẽ trong suốt. Nhưng chỉ với Augment này! \n\nKhông hoạt động với Block Entities như Lò nướng hay Buồng Làm Giàu."]
	quest.2E274BEEF2B0B8C7.quest_desc: ["Được rồi, hãy bắt đầu bằng cách làm Sulfur Dioxide trước.\n\n\n\nBắt đầu bằng cách đặt Gunpowder vào một &aChemical Injection Chamber&r riêng với Hydrogen Chloride để tạo Sulfur Dust. HOẶC bạn có thể nghiền Sulfur từ Thermal Series thành Sulfur Dust, tùy bạn.\n\n\n\nĐưa Sulfur Dust vào máy này, &aChemical Oxidizer&r, sẽ tạo ra Sulfur Dioxide. Bây giờ chúng ta cần tạo Sulfur Trioxide.\n\n\n\nGửi Sulfur Dioxide vào Chemical Infuser để kết hợp với Oxygen tạo Sulfur Trioxide. Gửi Trioxide vào Chemical Infuser khác để kết hợp với Water Vapor tạo Sulfuric Acid.\n\n\n\nNhiều thứ quá."]
	quest.2E68E1D96B25336D.quest_desc: ["Sau khi chiến đấu với vài &6Zombified Piglins bị Ám bởi Quỷ&r được triệu hồi bởi &6Open Commanding Conjure của Abras&r, bạn có thể dùng &6Thịt Quỷ&r rơi từ chúng để chế tạo một ít Phấn Hồng."]
	quest.2E68E1D96B25336D.title: "&dPhấn Hồng"
	quest.2E6D11A5F5626A6C.quest_subtitle: "Cấp: &f2"
	quest.2E6F1C8718EB8C66.title: "&4Máu&r Quả cầu nâng cấp"
	quest.2E85D6E2CFCC356E.quest_desc: ["Lò &3Vibranium&r còn tốt hơn cả Lò &6Allthemodium&r!"]
	quest.2E85D6E2CFCC356E.title: "&3Lò Vibranium"
	quest.2E9C035EEE7E5C34.quest_desc: ["Dây cương cổ điển. Dùng cái này để đưa động vật vào khu vực trang trại của bạn.\n\n\n\nĐây không phải là cùng một thứ với quặng."]
	quest.2E9C035EEE7E5C34.quest_subtitle: "Đi nào, chú chó nhỏ"
	quest.2E9C035EEE7E5C34.title: "Chúng ta làm việc này theo cách cổ điển"
	quest.2E9FC7DC2AC6FD8E.quest_desc: ["&8Chất thải phóng xạ&r có thể được đưa vào Máy ly tâm đồng vị để tạo ra &9Plutonium&r.\n\n\n\nĐưa Plutonium vào Buồng phản ứng áp suất với một ít nước và &7Bột Fluorite&r sẽ cho bạn &9Viên Plutonium&r. Chúng được dùng để chế tạo vật liệu cuối game!\n\n\n\nLưu ý: Điều này cũng sẽ tạo ra sản phẩm phụ là &7Chất thải phóng xạ đã qua sử dụng&r, cần được bơm vào Thùng chứa chất thải để lưu trữ."]
	quest.2EB7784D5296F410.quest_desc: ["Nhấp chuột phải vào một khối Flux Network hoạt động sẽ cho bạn giao diện này.\n\n\n\nMỗi Phích cắm hoặc Điểm có thể được đặt tên, có mức độ ưu tiên tùy chỉnh và giới hạn truyền năng lượng tùy chỉnh. Điều này cho phép kiểm soát hoàn toàn tất cả các phần của hệ thống.\n\n\n\n&aBypass Limit&r bỏ qua giới hạn đã đặt.\n\n\n\nCó một số thẻ khác để xem, chủ yếu là để thống kê trên mạng lưới của bạn!\n\n\n\n{image:atm:textures/questpics/basic_power/flux_ui.png width:125 height:150 align:center}"]
	quest.2EC2FA680076C07D.quest_desc: ["Để nâng cấp &9Kệ sâu&r xa hơn, thật bất ngờ là chúng ta không cần &d&lPhép thấm&r! Thay vào đó chúng ta cần nhiều chế tạo hơn!\n\n\n\nĐầu tiên, là 5 &3Khối Sculk&r và một &3Chất xúc tác Sculk&r. Cả hai đều có thể tìm thấy trong &9Deep Dark&r và sẽ cần &5Lụa chạm&r để thu thập.\n\n\n\nCuối cùng là &9Xúc tu Warden&r... đây là vật rơi từ &9&lWarden&r... Đúng vậy, bạn sẽ cần giết &9&lWarden&r.\n\n\n\nKhi bạn có tất cả những thứ đó, bạn có thể chế tạo một trong những &7Kệ sách&r tốt nhất! Một cái cho &a10 Eterna&r, &c10% Quanta&r, và &515% Arcana&r.\n\n\n\nVà quan trọng nhất, cho chúng ta tối đa &aEterna&r là &a80&r! Gần đến 100!"]
	quest.2EC2FA680076C07D.title: "&9Kệ Sculk Vang vọng"
	quest.2EC9668ED4EA47CB.quest_desc: ["Nhiệm vụ này chỉ yêu cầu bạn chế tạo một công cụ kim cương hoặc một mảnh áo giáp, nhưng có lẽ tốt hơn nên làm một bộ đầy đủ!\n\n\n\nCông cụ kim cương có độ bền cao, và áo giáp cung cấp khả năng bảo vệ tốt tổng thể.\n\n\n\nĐể chế tạo công cụ và áo giáp tốt hơn trong trò chơi, bạn sẽ cần các vật liệu kim cương làm nền tảng!"]
	quest.2EC9668ED4EA47CB.title: "&9Trang bị"
	quest.2EDE91023F7924FB.quest_desc: ["Đặt Teleport Pad trong &d&lThe End&r để đến &5&lThe Beyond&r."]
	quest.2EDE91023F7924FB.title: "&d&lThe End"
	quest.2EE4E88FC814AFA4.quest_subtitle: "Cấp: &91"
	quest.2EE8FCB63A338BC4.quest_desc: ["The &cR&6a&ei&2n&3b&9o&5w &cF&6u&er&2n&3a&9c&5e&r thực sự cần mọi lò khác để chế tạo. 8 &cR&6a&ei&2n&3b&9o&5w &cP&6l&ea&2t&3i&9n&5g&r và 1 &cR&6a&ei&2n&3b&9o&5w &cC&eo&3r&5e&r mang lại cho chúng ta lò tốt nhất có thể tưởng tượng!\n\n\n\nCó, nó mất 20 Tick để nấu chảy hoặc 1 Giây để nấu chảy, nhưng nó không nấu chảy 1 vật phẩm. Bạn hỏi bao nhiêu vật phẩm? Có bao nhiêu vật phẩm trong một chồng?"]
	quest.2EE8FCB63A338BC4.title: "&cR&6a&ei&2n&3b&9o&5w &cF&6u&er&2n&3a&9c&5e"
	quest.2EF4DD5CC254CC80.quest_subtitle: "Để Truyền Dịch"
	quest.2F16B6A173525277.quest_desc: ["Mảnh ghép cuối cùng cho bất kỳ mạng ME lớn nào là &bME Controller&f. \n\n\n\nMột bộ điều khiển cung cấp cho Mạng ME số kênh lớn hơn rất nhiều so với 8 kênh tiêu chuẩn cho mạng tạm thời, cung cấp 32 kênh từ mỗi mặt của khối, tổng cộng 216 kênh. \n\n\n\nĐiều đó chỉ dành cho bộ điều khiển một khối, tuy nhiên, vì ME Controller thực chất là một cấu trúc nhiều khối. Bộ điều khiển có thể lên đến kích thước 7x7x7 khối và có thể có bất kỳ sắp xếp tự do nào trong kích thước tối đa đó. Mỗi khối riêng lẻ có thể cung cấp một bộ kênh riêng biệt, miễn là không có khối điều khiển nào bị bao quanh bởi 4 khối khác trên cùng một mặt phẳng. \n\n\n\nMột Mạng ME chỉ có thể chứa một bộ điều khiển nhiều khối tại bất kỳ thời điểm nào. Cố gắng kết nối nhiều hơn một bộ điều khiển ở các phần riêng biệt của mạng sẽ gây ra xung đột, tắt toàn bộ mạng."]
	quest.2F556E7919582D2D.quest_desc: ["&bCell Workbench&f cho phép các cell được 'phân vùng' để giữ các item cụ thể, tức là áp dụng bộ lọc danh sách trắng. Nó cũng cho phép nâng cấp cell với các thẻ nâng cấp như Inverter Card, biến danh sách trắng thành danh sách đen thay thế.\n\n\n\nCác cell cũng có thể được gán mức 'ưu tiên' cao hơn hoặc thấp hơn thông qua workbench, tức là cho phép cell nhận item trước cho đến khi đầy, hoặc buộc phải chờ các cell ưu tiên cao hơn khác lấp đầy trước."]
	quest.2F69010E1FA2787D.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2Community contributor&r để sử dụng trong các modpack AllTheMods. \n\n\n\nVì tất cả các pack &6AllTheMods&r được cấp phép dưới &eAll Rights Reserved&r, nhiệm vụ này không được phép sử dụng trong bất kỳ pack công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng. \n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.2F9B0C642A6BE30C.title: "&fBa lô Sắt"
	quest.2FB231069D2E4E77.quest_desc: ["Mỗi cell riêng lẻ có một dung lượng nhất định do &ecomponent&f mà cell được chế tạo quyết định.\n\n\n\nComponent đầu tiên là &b1k ME Storage Component&f, cung cấp &e1024&f 'bytes' lưu trữ cho một cell cụ thể. Thêm chi tiết về điều đó sau."]
	quest.2FB231069D2E4E77.quest_subtitle: "Kilobyte đầu tiên."
	quest.2FB231069D2E4E77.title: "Tạo Cell lưu trữ đầu tiên của bạn"
	quest.2FC15D3916DBF4E4.quest_subtitle: "Thêm tùy chọn lọc"
	quest.2FC15D3916DBF4E4.title: "&eNâng cấp Void Nâng cao"
	quest.2FD22502E6481269.quest_desc: ["Sử dụng &dRonaza's Contact&r, bạn có thể nâng cấp Soul Gem của mình để tạo ra Trinity Gem. Nó về cơ bản chỉ là phiên bản mạnh hơn của Soul Gem có thể bắt các kẻ thù lớn hơn, mặc dù nó vẫn không thể chứa hầu hết các boss."]
	quest.2FD22502E6481269.title: "Trinity Gem"
	quest.2FE4B7B70D90A455.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2cộng tác viên cộng đồng&r để sử dụng trong các Modpack AllTheMods.\n\n\n\nVì tất cả các pack &6AllTheMods&r được cấp phép theo &eAll Rights Reserved&r, Nhiệm vụ này không được phép sử dụng trong bất kỳ pack công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng.\n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.3009018DEC1EC952.quest_desc: ["Có 6 cấu trúc trong &2Overworld&r mà các boss có thể xuất hiện! (Có một cấu trúc thứ 7 nhưng không có boss ở đó)."]
	quest.3009018DEC1EC952.title: "&lThời Gian Phiêu Lưu!"
	quest.300F2E45D185A9A1.quest_desc: ["&lIron&r đã mang đến cho chúng ta một Magic Mod tuyệt vời và rất vui vẻ! &lIron's Spells 'N Spellbooks!&r \n\n\n\n&lIron's Spells&r xoay quanh việc tạo ra và sử dụng &3Spells&r! Mỗi &3Spell&r có Độ hiếm, Cấp và Lớp! Và tất cả chúng đều có thể được sử dụng trong một Spellbook. \n\n\n\nBạn sẽ không thể chỉ tạo bất cứ thứ gì bạn muốn với &7Iron&r và &cRedstone&r, bạn sẽ cần phải đứng dậy, Phiêu lưu và Chiến đấu!"]
	quest.300F2E45D185A9A1.title: "&lIron's Spells 'N Spellbooks"
	quest.3025081DA6D2B398.quest_desc: ["Thông thường Router điều khiển các Module nhưng với Augment này, Module trở nên hỗn loạn! AWOl! Hoàn toàn vô chính phủ! \n\n\n\nNó sẽ lắng nghe kích hoạt Redstone của chính nó thay vì của Router."]
	quest.3027584AA6138E6D.title: "Chèn \& Trích xuất Băng chuyền"
	quest.309B6B8368E535A0.quest_desc: ["Một Router thực hiện hành động mỗi khi nó có một tick. \n\n\n\nMặc định là 20 Tick hoặc 1 Giây. \n\n\n\nĐiều này có thể được giảm số Tick với Speed Upgrade!"]
	quest.30B0240543253EFB.quest_desc: ["Pylons là một mod tuyệt vời được tạo bởi &aMutant Gumdrop&r của chúng ta!\n\n\n\nĐừng để kích thước của mod khiến bạn đánh giá thấp nó! Nó cung cấp nhiều Pylon có thể được sử dụng cho nhiều mục đích để giúp chơi Minecraft dễ dàng hơn.\n\n\n\nĐể bắt đầu, bạn sẽ cần một ít Polished Blackstone để chế tạo chúng."]
	quest.30B0240543253EFB.title: "&lPylons"
	quest.30B7AF815D9D7553.quest_desc: ["&cTháp bị cháy&r của &c&lPháp sư Hỏa&r. Một số người nói rằng nếu bạn đủ gần để nhìn thấy &cTháp&r, thì bạn cũng đủ gần để cảm nhận nhiệt từ nó. \n\n\n\n&cTháp Pháp sư Hỏa&r là một tháp bị cháy chủ yếu bằng đá, bên trong được làm từ gỗ sam và gỗ sồi. Còn có một Tòa nhà thứ hai gần &cTháp&r cũng là một phần của cấu trúc. \n\n\n\nỞ đỉnh, bạn sẽ thấy thứ gây ra khói cũng như một &5Đống áo giáp&r. \n\n\n\nNếu bạn muốn tìm &c&lPháp sư Hỏa&r, bạn sẽ cần phải mạo hiểm xuống Tầng hầm!\n\n{image:atm:textures/questpics/iron_spells/spells_pyromancertower.png width:200 height:100 align:center}"]
	quest.30B7AF815D9D7553.title: "&cTháp Pháp sư Hỏa"
	quest.30C5B597610F4AFB.quest_desc: ["Món đầu tiên và quan trọng nhất cần tạo bằng Eziveus' Spectral Compulsion là Bụi Mảnh Nghiên cứu. Nó được kết hợp với một ít Ngọc lục bảo nghiền để tạo ra Phấn vôi!"]
	quest.30C5B597610F4AFB.title: "&aPhấn vôi"
	quest.30E853CE699E669B.quest_desc: ["Trước khi bạn có thể thực hiện một công việc tự động chế tạo, bạn cần một thiết bị để lưu trữ yêu cầu cùng với các item trung gian cho các công việc nhiều bước. Thiết bị này được gọi là &ecrafting CPU&f.\n\n\n\nMột crafting CPU là một cấu trúc nhiều khối yêu cầu ít nhất một khối &bCrafting Storage&f, tùy chọn cùng với bất kỳ Crafting Unit nào khác. Cấu trúc nhiều khối có thể được làm với bất kỳ kích thước nào, nhưng phải là một hình hộp chữ nhật vững chắc để hình thành và hoạt động cho phù hợp."]
	quest.30E853CE699E669B.quest_subtitle: "Tải thêm RAM"
	quest.30EB438C66324213.quest_desc: ["Một Nether Star sẽ làm những gì Prismarine Shards làm nhưng tốt hơn nhiều. Người chơi không còn cần phải ở gần spawner. Miễn là nó được tải chunk, nó sẽ sinh ra."]
	quest.30EB438C66324213.title: "Bỏ qua Người chơi"
	quest.310969B8FE0A94DE.quest_desc: ["Một thay đổi game khác mà Apotheosis mang lại là cho Spawners. Bạn có nhớ khả năng khai thác Spawners bằng Silk Touch? Vâng, nó đã trở lại nhờ Apotheosis! Cũng có nhiều Sửa đổi mới bạn có thể thêm vào Spawners bằng cách nhấp chuột phải vào bất kỳ item nào trong số này."]
	quest.310969B8FE0A94DE.title: "Apothic Spawners"
	quest.3195A7AA874163CD.quest_desc: ["Thẻ &bEqual Distribution Card&f là một nâng cấp cho các ô lưu trữ, nó phân bổ trước một số lượng vật phẩm nhất định mà bất kỳ loại nào cũng có thể lấy.\n\n\n\nHành vi này giống như một Functional Storage drawer, mỗi ngăn chứa một số stack cố định thay vì để vật phẩm từ một ngăn tràn sang ngăn khác và chiếm chỗ của các loại vật phẩm khác."]
	quest.3195A7AA874163CD.quest_subtitle: "Ngăn kéo ME Storage &mCells&r"
	quest.31B0267C47DB9D98.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2Community contributor&r để sử dụng trong AllTheMods Modpacks.\n\n\n\nVì tất cả các gói &6AllTheMods&r được cấp phép theo &eAll Rights Reserved&r, Nhiệm vụ này không được phép sử dụng trong bất kỳ gói công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng.\n\n\n\nNhiệm vụ này được ẩn có chủ ý, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.31B73D16C0199785.title: "Obsidian tinh chế"
	quest.31E7F7464D79F881.quest_desc: ["Không chỉ &7Kệ sách&r mới có thể được &d&lCấp!&r"]
	quest.31E7F7464D79F881.title: "Các vật phẩm &d&lCấp&r khác"
	quest.31EEE2875595F315.quest_desc: ["Bạn đã nên đã làm &2Axit Sunfuric&r cho cơ sở chế biến quặng cấp 4 của mình, nhưng đây là lời nhắc về cách lấy nó.\n\n\n\nBắt đầu bằng cách lấy &eLưu huỳnh&r bằng cách tìm thấy nó dưới lòng đất, hoặc bằng cách trộn &bHydrogen Chloride&r với &3Gunpowder&r trong một Chemical Injection Chamber.\n\n\n\nLấy Bụi Lưu huỳnh và chạy nó qua một &9Chemical Oxidizer&r để có được &eLưu huỳnh dioxide&r. Kết hợp nó với &bOxygen&r trong một Chemical Infuser để có được &eLưu huỳnh trioxide&r.\n\n\n\nTiếp theo, chúng ta sẽ kết hợp &bHơi nước&r với Lưu huỳnh Trioxide để làm &2Axit Sunfuric&r."]
	quest.31EEE2875595F315.quest_subtitle: "Tóm tắt nhanh"
	quest.31EEE2875595F315.title: "&2Axit Sunfuric"
	quest.320CC038A64A3195.quest_desc: ["Để xem hình ảnh, hãy xem Ponder bằng cách giữ &aW&r khi di chuột qua Laser Focus Matrix.\n\n\n\nMục tiêu là nhắm mỗi Laser vào một Laser Amplifier. Sử dụng một cái khá chậm, vì vậy chúng ta sẽ làm vài cái.\n\n\n\nTrong hình dưới đây, bạn có thể thấy một ví dụ về cách thiết lập. Gắn các Laser trực tiếp vào nguồn năng lượng như Energy Cube có thể hoạt động, hoặc bạn có thể đặt chúng trên ống hoặc cáp. Bạn muốn để một khối không gian trống giữa các laser và Laser Amplifier.\n\n\n\nLaser Amplifier có một chấm đỏ trên một mặt. Đây là thứ bạn muốn chỉ về Laser Focus Matrix.\n\n\n\nHãy chắc chắn tắt Laser Amplifier (hoặc kích hoạt điều khiển Redstone) và đợi nó lưu trữ &cít nhất 400MRF&r, sau đó nó sẽ sẵn sàng.\n\n\n\n{image:atm:textures/questpics/mek/laser_example.png width:200 height:150 align:1}"]
	quest.320CC038A64A3195.title: "Phương pháp khởi động: &dLaser Focus Array"
	quest.321F16645640C462.quest_desc: ["Hạt ender là một cách di chuyển vui vẻ! (Hữu ích cho Bumblezone, tôi tự hỏi liệu chúng ta có nhận được một chương nhiệm vụ cho mod đó không!) Nhưng bạn có ghét việc hạt ender bị tiêu hao khi sử dụng và mất 2 trái tim mỗi lần dùng không? \n\n\n\nVới &9Warp Drive&r thì tất cả những điều đó biến mất, rõ ràng làm cho hạt ender trở thành phương tiện di chuyển tốt nhất! Đói được tiêu hao thay vì hạt ender và không còn mất máu khi dùng hạt ender. Khi tất cả thanh đói cạn kiệt, nó sẽ quay lại tiêu hao hạt ender."]
	quest.321F16645640C462.quest_subtitle: "Đai"
	quest.321F16645640C462.title: "&9Warp Drive&r"
	quest.321FA7348E532F4E.title: "Cao su"
	quest.326C63F7DC713E71.quest_desc: ["Bộ phân phối là anh em một nửa của các Mô-đun gửi. (Chính xác là MK3, ở phía MK2). \n\n\n\nThay vì gửi đến 1 kho, nó sẽ gửi đến nhiều kho được chọn. \n\n\n\nNó có thể gửi trong nhiều chế độ: Vòng tròn (Round Robin), Ngẫu nhiên (Random), Gần nhất trước (Nearest First), hoặc Xa nhất trước (Farthest First). Vòng tròn phân phối lượng đều cho mỗi kho lần lượt, như một người chia bài trong Poker. Ngẫu nhiên sẽ chọn ngẫu nhiên một kho để cung cấp. Những chế độ khác được xác định bởi khoảng cách từ Router."]
	quest.32AE664113F01CF7.quest_desc: ["&eSpace Dissector&r nên được đặt tên là &eWormhole Creator&r, nó tạo ra cổng từ một điểm đến điểm khác. Để đặt các điểm, giữ Chuột Phải để đặt cổng đầu tiên, sau đó di chuyển và ngừng giữ Chuột Phải để đặt cổng thứ hai. Bạn có thể nâng cấp chúng để tăng khoảng cách giữa chúng và thời gian chúng tồn tại. Hehe không gian và thời gian, cổng... nếu bạn thông minh hơn bạn sẽ cười."]
	quest.32AE664113F01CF7.quest_subtitle: "Tìm thấy trong Cổng bị phá hủy, Pháo đài Nether và Pháo đài (Bastions)"
	quest.32AE664113F01CF7.title: "&eSpace Dissector"
	quest.32C7D8AE859BF89E.quest_desc: ["Nó có thể là &dObsidian&r nhưng đừng lo bạn không cần một &bDiamond Pickaxe&r để lấy nó, chỉ cần để chế tạo nó.\n\n\n\nNó hoạt động mỗi 20 Tick hoặc mỗi Giây. Đúng không phải Giây mà chỉ là Giây.\n\n\n\nNó có thể được chế tạo với một &3Crystal Furnace&r hoặc &aEmerald Furnace&r, và có thể được chế tạo thành một &5Netherite Furnace&r!"]
	quest.32C7D8AE859BF89E.title: "§dLò Đá Obsidian"
	quest.32D2CE292E088939.title: "§cQuả Cầu Nâng Cấp Lửa§r"
	quest.32E52AD6EF194A60.quest_desc: ["Cột Đuổi Người hoạt động như một cách để giữ người khác khỏi sân nhà bạn.\n\n\n\nKhi được đặt xuống, nó sẽ giữ mọi Người chơi không có trong danh sách trắng khỏi một số lượng Khu vực xác định xung quanh nó.\n\n\n\nCác Khu vực được đặt trong GUI của nó ở góc trái trên từ 1x1, 3x3, hoặc 5x5 Khu vực.\n\n\n\nNgoài ra, không thể đặt nó quá gần Điểm Sinh. Chúng tôi biết các bạn troll muốn gì và chúng tôi sẽ không cho phép!\n\n\n\nĐể thêm người chơi vào danh sách trắng, hãy xem Nhiệm vụ Lọc Người chơi!"]
	quest.32E52AD6EF194A60.quest_subtitle: "Ra khỏi sân nhà tôi!"
	quest.33106E24A3B5DDD8.quest_desc: ["Bước tiếp theo trong hành trình của bạn sẽ là tìm &eQuặng Iesnium&r trong Nether.\n\n\n\nKhông có hiệu ứng của &3Con Mắt Thứ Ba&r, nó sẽ trông giống hệt Netherrack. Hãy đảm bảo đã trang bị &dKính Otherworld&r!\n\n\n\nĐể định vị quặng, hãy thử dùng &aGậy Chiêm Bạc&r. Bạn cần đồng hòa nó với Netherrack trước, sau đó giữ chuột phải để sử dụng. Sau vài giây, bạn sẽ thấy một hạt phát ra theo hướng về Quặng Iesnium gần nhất. Bạn chỉ có thể khai thác quặng bằng &dCuốc Đã Ngâm Tẩm&r!\n\n\n\nVì bạn không thể phá quặng này thành bụi gấp đôi bằng phương pháp thông thường, hãy thử dùng Máy Nghiền Foliot để nhân đôi số ingot từ mỗi quặng thô!\n\n\n\nLưu ý: Nếu bạn không thấy hạt, hãy đảm bảo cài đặt hạt của bạn được bật!\n\n\n\n{image:atm:textures/questpics/occultism/iesniumexample.png width:200 height:175 align:1}"]
	quest.33106E24A3B5DDD8.title: "§cIesnium: Quặng của Thế Giới Khác§r"
	quest.33436ED0D9F128BD.quest_desc: ["§4Nâng Cấp§r: Hun khói biến Lò Sắt của bạn thành Lò Hun. Giờ nó chỉ hun Thực phẩm nhưng nhanh gấp đôi! Giống như §4Nâng Cấp§r: Blasting, cái này cũng có thể chồng với các nâng cấp khác!"]
	quest.33436ED0D9F128BD.title: "§4Nâng Cấp§r: Hun khói"
	quest.33532408B21A5378.quest_desc: ["Máy Phát Điện Thương Hại tạo ra một lượng nhỏ FE sử dụng nhiên liệu đốt được như Than."]
	quest.3371F9248D403664.title: "§l§cPhần Thưởng Nether:§r§e Xương Khô Wither"
	quest.33816AF0E699F19F.quest_desc: ["Khối này sẽ rút FE từ bất kỳ vật thể được nạp năng lượng nào."]
	quest.33882172DA8021F6.quest_desc: ["Giữ kho đồ của người chơi được xếp chồng từ các vật thể bên trong Ba lô."]
	quest.338BD467EBE6EE1F.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_sentry.png width:100 height:150 align:center}"]
	quest.338BD467EBE6EE1F.quest_subtitle: "Tiền đồn Kẻ cướp"
	quest.338BD467EBE6EE1F.title: "Trang trí giáp Lính canh"
	quest.339DF320DDCAD98B.title: "Vận chuyển Vật thể \& chất lỏng"
	quest.33AADC1B97E9F7A9.quest_desc: ["Xe lửa có Rương là xe lửa có rương bên trong. Bạn không thể lái những cái này nhưng chúng có thể hữu ích để vận chuyển vật thể qua hệ thống Đường ray."]
	quest.33ADE41526C39AFD.quest_desc: ["Hành vi này có thể so sánh với một ngăn kéo Lưu trữ Chức năng, trong đó mỗi ngăn chứa một số lượng xếp chồng cố định, thay vì để vật thể từ một ngăn tràn sang ngăn khác và chiếm chỗ của các loại vật thể khác."]
	quest.341486C9F277FEB7.title: "Lò phản ứng (Spirited)"
	quest.3446803FB59D8875.quest_desc: ["Trao cho bạn Gai nhọn. Không phải giáp của bạn, mà là bạn! Giống như Cá nóc!"]
	quest.3446803FB59D8875.quest_subtitle: "Dây chuyền"
	quest.3446803FB59D8875.title: "&aMặt dây chuyền gai&r"
	quest.346860B8EBC4C28C.quest_desc: ["Bây giờ bạn đã có tất cả Lava này, bạn sẽ làm gì với nó? Sức mạnh đầu game nhiều hơn!"]
	quest.346860B8EBC4C28C.title: "Sức mạnh Lava"
	quest.346B9339E3D66478.quest_desc: ["Năng lượng là thứ được sử dụng bởi hầu hết mọi thứ, vì vậy bạn cần gửi nó đến hầu hết mọi nơi. May mắn thay, Energy Module sẽ giúp bạn với việc đó! \n\n\n\nEnergy Module sẽ di chuyển bất kỳ năng lượng nào được đưa vào nó, đến một nơi khác! Đến bất kỳ nơi nào bạn đặt nó!"]
	quest.34CD54347E9821B5.quest_desc: ["Khi bạn tạo ra Data Model đầu tiên, bạn sẽ cần nâng cấp nó để hữu ích.\n\n\n\nData Models bắt đầu ở cấp đầu tiên: &7Hỏng hóc&r. Bạn sẽ cần ít nhất nâng nó lên &aCơ bản&r nếu bạn muốn chạy một số mô phỏng trên nó!\n\n\n\nKhi được đặt bên trong Deep Learner, HUD sẽ cho bạn biết cần bao nhiêu lần giết để nâng cấp nó. Bạn cũng có thể thấy thông tin này trong tooltip của chính Data Model."]
	quest.34CD54347E9821B5.title: "Nâng cấp Data Models"
	quest.351159C55159C316.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_spire.png width:100 height:150 align:center}"]
	quest.351159C55159C316.quest_subtitle: "Thành phố End và Tàu End"
	quest.351159C55159C316.title: "Trang trị giáp Spire"
	quest.3514E9C1A8C7400C.quest_subtitle: "Bậc: &b2"
	quest.3514E9C1A8C7400C.title: "&bKhung Máy Đơn Giản"
	quest.3525D5DCC3A534D9.quest_desc: ["Bây giờ đây là một trong những món yêu thích của tôi! \n\n\n\n&9Móng Vuốt Đào&r sẽ 1. Tăng Tốc Độ Khai Thác của bạn, về cơ bản là cấp độ Hiệu Quả trên tất cả các Cuốc, và 2. Làm cho nắm đấm của bạn hoạt động như một Cuốc Đá! \n\n\n\nRất hữu ích cho việc xây dựng và chơi nói chung!"]
	quest.3525D5DCC3A534D9.quest_subtitle: "Tay"
	quest.3525D5DCC3A534D9.title: "&9Móng Vuốt Đào&r"
	quest.3543563DF036D461.quest_desc: ["Để tạo Bụi Dragonyst, bạn sẽ cần thực hiện &9Tháp Đảo Ngược Uphyxes&r. Tuy nhiên, để tạo Phấn Đỏ Hồng, bạn cũng sẽ cần một số nguyên liệu mà bạn chỉ có thể lấy được thông qua &9Máy Nghiền Marid&r."]
	quest.3543563DF036D461.title: "&#AD00C8Phấn Đỏ Hồng"
	quest.355244420EA47546.quest_desc: ["Fabricator chính là Máy Tự Động Chế Tạo. Nó sẽ lấy vật phẩm từ kho bên dưới và tạo theo công thức đã định.\n\n\n\nBạn có thể khóa công thức bằng CTRL Click. Tuy nhiên, nó sẽ cần ống dẫn để đưa các vật phẩm đã tạo ra."]
	quest.355244420EA47546.quest_subtitle: "Máy Tự Động Chế Tạo"
	quest.3591EAA8E397F992.quest_desc: ["Hãy kiểm tra danh sách &o một lần nữa&r để đảm bảo chúng ta có mọi thứ sẵn sàng trước khi khởi động:\n\n\n\n1. Mặc Quần áo Phòng hạt nhân (an toàn là trên hết).\n\n2. Bơm Nước/Chất làm mát vào một Cổng đầu vào.\n\n3. Bơm Nhiên liệu Phân hạch vào một Cổng đầu vào.\n\n4. Một Cổng được cài đặt để xuất Chất làm mát Nóng, hoặc vào thùng rác hoặc vào Tuabin Công nghiệp.\n\n5. Một Cổng được cài đặt để xuất Chất thải Phóng xạ dẫn đến Thùng Chất thải Phóng xạ hoặc máy móc để xử lý nó, hoặc cả hai!\n\n\n\nNếu bạn đã sẵn sàng, hãy nhấn nút &eKích hoạt&r! Bạn cũng có thể điều chỉnh &3Tỷ lệ Đốt&r để sản xuất nhiều Chất thải Phóng xạ hơn, nhưng hãy bắt đầu chậm."]
	quest.3593D955361B0C6D.quest_desc: ["Để khởi động lò phản ứng nhiệt hạch, chúng ta cần một liều nhiên liệu D-T ngay lập tức. Nó được tạo ra bằng cách kết hợp &cDeuterium&r và &eTritium&r cùng nhau trong một Máy Phun Hóa Chất.\n\n\n\nBắt đầu bằng cách chế tạo một &4Hohlraum&r và đặt nó vào Máy Phun (nơi có biểu tượng cộng) để lấp đầy bằng nhiên liệu D-T. Bây giờ chúng ta đã sẵn sàng khởi động Lò Phản ứng!"]
	quest.3593D955361B0C6D.title: "Máy Phun Nhiên Liệu"
	quest.35ABB0DEE70DF7FD.quest_desc: ["Tin hay không, mod &aPowah&r có một số tùy chọn tuyệt vời để có được... sức mạnh.\n\n\n\nHãy chắc chắn xem chương nhiệm vụ &cPowah&r để tìm hiểu thêm!"]
	quest.35ABB0DEE70DF7FD.title: "Thêm &aPowah&r!"
	quest.35CC898E0E49FE58.quest_desc: ["&9Flux Networks&r là một mod nhằm trở thành giải pháp cho mọi nhu cầu về nguồn năng lượng không dây của bạn.\n\n\n\nMod này bản thân không có cách để tạo ra năng lượng, nhưng nó có thể lưu trữ và truyền năng lượng không dây, thậm chí xuyên qua các chiều không gian. Nó thậm chí có thể sạc các vật phẩm trong kho đồ của bạn.\n\n\n\nBạn thậm chí có thể sạc Jetpacks khi đang bay với mod này.\n\n\n\nĐể bắt đầu với mod, bạn sẽ cần một ít Flux Dust. Đi đến Bedrock, sau đó ném một ít Redstone lên trên một số Bedrock. Đặt một số Obsidian ngay phía trên Redstone đang bay, sau đó nhấp trái vào Obsidian."]
	quest.35CC898E0E49FE58.quest_subtitle: "Giải Pháp Năng Lượng Không Dây Tối Ưu"
	quest.35CC898E0E49FE58.title: "&8Flux Networks"
	quest.361CCBD353D6FF34.quest_desc: ["Với 1k Storage Component, bạn giờ đây có thể chế tạo một 1k ME Item Storage Cell để bắt đầu hệ thống lưu trữ vật phẩm kỹ thuật số của mình. Bạn có thể sẽ muốn phần lớn dung lượng lưu trữ dành cho vật phẩm, vì vậy bạn có thể sẽ muốn làm một vài &bME Item Storage Cells&f. \n\n\n\nME Item Storage Cells mỗi cái có thể chứa tới 63 loại vật phẩm khác nhau. Mỗi loại vật phẩm mới được thêm vào ô sẽ chiếm một phần nhất định của tổng dung lượng ô lưu trữ tính bằng byte. Đối với mỗi loại đã có sẵn, 1 'byte' tính cho 8 vật phẩm cùng loại đó. \n\n\n\nVí dụ, một 1k Item Storage Cell chỉ chứa đá sỏi có thể chứa tới 8128 đá sỏi (8*1024b - 8b/type * 1 type). \n\n\n\nNếu một ô trống, nó có thể được tái sử dụng bằng cách tháo nó thành component và housing tương ứng. Điều này được thực hiện bằng cách nhấn Shift và nhấp phải vào không trống khi ô ở trong tay."]
	quest.361CCBD353D6FF34.title: "Lưu Trữ Vật Phẩm"
	quest.361DFDB1E1352D6B.quest_desc: ["Tìm một số Cây Kẽm gần nước."]
	quest.361DFDB1E1352D6B.title: "Sugar Sugar"
	quest.361EF9E4973E3522.quest_desc: ["&e&lPhép thuật Sắt&r &dÁo giáp Ender&r!"]
	quest.361EF9E4973E3522.quest_subtitle: "20"
	quest.361EF9E4973E3522.title: "&dBộ đồ Shadow-Walker"
	quest.3663E93E169EF8E3.quest_desc: ["Sử dụng một &9Máy pha hóa chất&r khác, chúng ta muốn kết hợp &baxit hydrofluoric&r của chúng ta với &eoxit uranium&r để tạo ra &2hexafluorua uranium&r."]
	quest.3663E93E169EF8E3.title: "&2Hexafluorua uranium"
	quest.367E891A50991436.quest_desc: ["Sử dụng &cSevira's Permanent Confinement&r, chúng ta có thể kết hợp một số vật liệu Wither khác nhau và một ít Netherite để tạo ra ba bụi Witherite. Với những thứ này, chúng ta có thể tạo ra dạng phấn nền cao nhất, phấn đen."]
	quest.367E891A50991436.title: "Phấn đen"
	quest.3685B52446DEC809.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_gold.png width:100 height:150 align:center}"]
	quest.3685B52446DEC809.title: "&eVàng&r"
	quest.36A3ECD4F6CA2732.quest_subtitle: "&f8 &cSát thương tấn công"
	quest.36B1995B495AA674.quest_desc: ["Để bắt đầu hành trình vào thế giới của các Lò phản ứng Mekanism, chúng ta sẽ bắt đầu bằng việc chế tạo một &aLò phản ứng phân hạch&r. Đây là những cấu trúc nhiều khối tạo ra một lượng nhiệt khổng lồ bằng cách đốt cháy &3Nhiên liệu phân hạch&r. Lò phản ứng này không tự sản xuất năng lượng, nhưng nhiệt độ sinh ra có thể được dùng để đun nóng &bChất làm mát&r để tạo năng lượng trong một &aTua-bin công nghiệp&r.\n\n\n\nLò phản ứng phân hạch có thể rất nguy hiểm, vì một sự cố nóng chảy có thể gây ra một &cvụ nổ&r cũng như &2Bức xạ&r lan ra trong bán kính 5 chunk, kéo dài trong vài tuần trong game. \n\n\n\nNhưng chúng ta sẽ chuẩn bị cho điều đó. Hãy chế tạo một Bộ đồ phòng xạ, đề phòng trường hợp... đúng chứ?"]
	quest.36B1995B495AA674.quest_subtitle: "Màu cam = Bảo vệ phóng xạ"
	quest.36B1995B495AA674.title: "Trang bị phòng xạ cho Lò phản ứng"
	quest.36BCE35215B2B6E9.quest_desc: ["Tự động nung chảy các vật phẩm trong Ba lô."]
	quest.36BCE35215B2B6E9.quest_subtitle: "Tự động"
	quest.36BCE35215B2B6E9.title: "&eNâng cấp Tự động Hun khói"
	quest.36CF8D1DD1EF6307.quest_subtitle: "2 Khối Xanh Nhạt Ướt"
	quest.36DEA17CBB696CC7.quest_desc: ["Nếu bạn nhấp chuột phải vào Phích cắm, bạn sẽ thấy Giao diện Flux Network. Ở góc trên cùng bên phải, nhấn vào nút + để tạo mạng lưới đầu tiên của bạn. Bạn sẽ cần đặt mật khẩu để tạo mạng lưới, nhưng bạn cũng có thể đặt màu!\n\n\n\nTừ đây, bạn có thể chuyển đến tab Lựa chọn Mạng lưới để kích hoạt mạng lưới của mình trên Phích cắm. Nếu Phích cắm được kết nối với một nguồn năng lượng, bây giờ bạn có thể sử dụng nguồn năng lượng đó ở bất kỳ đâu trong hệ thống của mình bằng cách sử dụng một Flux Point!\n\n\n\nMẹo chuyên gia: Bạn có thể tạo nhiều mạng lưới nếu bạn muốn các nguồn năng lượng khác nhau cung cấp năng lượng cho các phần khác nhau của hệ thống của bạn!"]
	quest.36DEA17CBB696CC7.quest_subtitle: "Trở thành Quản trị viên Mạng lưới!"
	quest.36DED7099E80ED51.quest_desc: ["Cái này hoạt động đúng như tên gọi: nó sẽ đặt các Khối. \n\n\n\nThiết lập Hướng bạn muốn Khối được đặt, tốt nhất là đặt Bộ lọc, sau đó ném Module và Khối vào Router! Khi Redstone được thiết lập, các Khối sẽ được đặt!"]
	quest.36DF0D83EBC2B6A9.quest_desc: [""]
	quest.36DF0D83EBC2B6A9.quest_subtitle: "&oSự thiếu hiểu biết đã là quá khứ với thứ này."
	quest.36DF0D83EBC2B6A9.title: "&3&lThiết Bị Xác Suất Bất Khả Xảy Ra"
	quest.36F87173D8CD1D68.quest_desc: ["Cưỡi &5Lôi Điện&r! &5&lLôi Điện&r xoay quanh việc sử dụng Điện để giết chóc và hỗ trợ bản thân. Một số đòn tấn công thậm chí còn hoạt động như &5Lôi Điện&r thật! \n\n\n\n&5&lLôi Điện's&r Vật Liệu Trọng Tâm là &5Chai 'O Lôi Điện&r mà bạn nhận được bằng cách dùng Chai Rỗng lên Creeper Đã Có Điện. Bạn cần &5Lôi Điện&r để tạo ra nhiều &5Lôi Điện&r hơn! \n\n\n\nCác &5Cuộn&r của nó có màu &7Xám&r với chữ &bXanh Nhạt&r."]
	quest.36F87173D8CD1D68.title: "&5&lLôi Điện"
	quest.3705D303CF423804.quest_desc: ["Mặt khác của &aMóng Vuốt Đồng Hồ&r, chúng tăng Sát Thương bạn gây ra khi đeo chúng."]
	quest.3705D303CF423804.quest_subtitle: "Bàn Tay"
	quest.3705D303CF423804.title: "&eGăng Tay Sức Mạnh&r"
	quest.3708A4780ACEB34E.quest_desc: ["Trong modpack này, nhiệm vụ là tùy chọn. Các mod không bị chặn sau khi hoàn thành bất kỳ nhiệm vụ nào!\n\n\n\nNhiều chuỗi nhiệm vụ riêng lẻ bên ngoài Chuỗi Nhiệm Vụ Chính được thiết kế để đóng vai trò hướng dẫn mod. Nếu bạn muốn theo tiến trình, hãy đảm bảo xem Chuỗi Nhiệm Vụ Chính!"]
	quest.371A382CF1DDF2B2.quest_desc: ["Thẻ &bDung Lượng&f cho phép một đường truyền được nâng cấp với nó chứa được một bộ lọc lớn hơn. Các đường truyền Nhập/Xuất được nâng cấp bằng thẻ dung lượng có thể từ chỉ hỗ trợ một vật phẩm lọc mỗi cái lên tối đa chín ô lọc, trong khi các đường truyền Lưu trữ sẽ từ 18 ô lên tối đa 63 ô."]
	quest.377D6CF86BC1C64F.quest_desc: ["&8Tome of Scrapping&r chỉ sẽ tách đi một nửa các &5phép&r, trong khi &8Tome of Superior Scrapping&r sẽ tách mọi &5phép&r ra khỏi vật phẩm! \n\n\n\nCả hai &8Tomes&r này sẽ làm vỡ vật phẩm khi dùng. \n\n\n\nĐể &d&lHòa trộn&r &8Tome of Scrapping&r của chúng ta thành &8Tome of Superior Scrapping&r, chúng ta có thể dùng 3 &9Soul-Touched Sculkshelves&r và 1 &dDraconic Endshelf&r."]
	quest.377D6CF86BC1C64F.quest_subtitle: "Tất cả phép, làm vỡ vật phẩm"
	quest.377D6CF86BC1C64F.title: "&8Tome of Superior Scrapping"
	quest.378BF828DC931F0C.quest_desc: ["Tôi thực sự ghét phải chạy đến một khối chỉ để chế tạo. Đó là lúc &2Bàn chế tạo trên gậy&r xuất hiện!\n\n\n\nĐồ này hoạt động như một &aBàn chế tạo cầm tay&r!\n\n\n\nMẹo: Bạn cũng có thể đặt nó vào ô &aCurios&r và gán một &bphím tắt&r để mở nó!"]
	quest.378BF828DC931F0C.title: "Chế tạo, nhưng trên gậy"
	quest.378C95C18798D413.quest_desc: ["Một cách nhanh chóng để chuyển đổi giữa các công cụ.\n\n\n\nNâng cấp với túi đeo thắt lưng ở đe để tăng dung lượng."]
	quest.378C95C18798D413.title: "Thắt lưng công cụ"
	quest.37CA6F9F0226F10E.quest_desc: ["Khối này lưu trữ vật phẩm để nấu ăn.\n\n\n\nBạn cũng có thể đặt các vật phẩm đa khối nhà bếp khác lên nó, như máy nướng bánh và Bò trong lọ."]
	quest.37CA6F9F0226F10E.quest_subtitle: "Chúng ta cần thêm không gian nấu ăn"
	quest.37CA6F9F0226F10E.title: "Cần thêm không gian nấu ăn?"
	quest.37D4E5ACB35D8BF1.quest_subtitle: "Yêu cầu Hydrogen để hoạt động!"
	quest.37EBB8E0D6E5F821.quest_desc: ["&6Hostile Neural Networks&r (viết tắt HNN) là một mod xoay quanh việc mô phỏng việc giết quái vật để có loot!\n\n\n\nĐể làm điều này, bạn sẽ thu thập \"dữ liệu\" về quái vật, sau đó chạy mô phỏng từ dữ liệu để tạo ra item rơi ra của chúng!\n\n\n\n{image:atm:textures/questpics/hnn.png width:150 height:150 align:center}"]
	quest.37EBB8E0D6E5F821.title: "Chào mừng đến với &9Hostile Neural Networks&r!"
	quest.37F2BE3C2BAF7C2D.quest_desc: ["Tag là một phần thiết yếu của Minecraft. \n\n\n\nĐối với những người không biết, chúng hoạt động như một công cụ tổ chức để giúp chọn các item tương tự cho cùng một nhiệm vụ. Ví dụ: Bàn chế tạo được làm với bất kỳ loại Tấm gỗ nào, hoặc Cây được chặt nhanh nhất với bất kỳ loại Rìu nào. \n\n\n\nĐể lọc theo Tag, hãy đặt một item vào, sau đó chọn tag từ các nhóm. Ví dụ: Quặng sắt cho nhóm Quặng."]
	quest.38954551309F42A7.quest_desc: ["Sender Module MK2 hoạt động tương tự MK1 nhưng với ít ràng buộc hơn. \n\n\n\nMK2 không cần tầm nhìn trực tiếp hay cùng trục XYZ. \n\n\n\nTuy nhiên phải ở cùng Dimension, trừ khi bạn có..."]
	quest.38A1295878B68F83.quest_desc: ["Không, không phải loại đó.\n\n\n\n&cAfrit Demons&r là Quỷ của &cLửa&r. Chúng là những Quỷ tiên tiến hơn, trong đó một số là bạn bè và một số thì... không. Tất cả phụ thuộc vào mức độ nghi lễ có thể kiểm soát &cAfrit&r. \n\n\n\nBởi vì chúng ta chưa có Red Chalk, tất cả những gì chúng ta có thể triệu hồi là một &9Unbound&r Demon, có nghĩa là nó không thể được kiểm soát và sẽ bạo lực."]
	quest.38A1295878B68F83.quest_subtitle: "Quỷ Nóng!"
	quest.38A1295878B68F83.title: "&6Lễ triệu hồi mở của Abras"
	quest.3917DECAEF56A06A.quest_desc: ["&fTier 2&r là cấp độ của xúc xích đá. Nó gần như chỉ để khai thác item sắt."]
	quest.3917DECAEF56A06A.title: "&fCấp thu hoạch 2"
	quest.395668FBCB6537AF.quest_desc: ["Những 'Babes' thích &eBling&r! &eBastion Ring&r rất phù hợp cho người trao đổi. Khi đeo nó, Piglins sẽ trung lập với bạn giống như khi bạn đeo &eGold&r. Điều này không có nghĩa là bạn có thể tự do lục soát rương của chúng. &eRing&r cũng sẽ cho bạn cơ hội nhận thêm chiến lợi phẩm từ việc trao đổi. \n\n \n\n(Khi đeo &eRing&r, Piglins có thể chỉ bạn đến Bastion gần nhất)."]
	quest.395668FBCB6537AF.quest_subtitle: "Có thể tìm thấy ở Ruined Portals, Nether Fortresses và Bastions."
	quest.395668FBCB6537AF.title: "&eBastion Ring"
	quest.395A33977B18B9AD.quest_desc: ["Sau khi cố gắng thu hoạch &5Piles of Armor&r, chúng dường như sống dậy như thể có một cơ thể đang sử dụng chúng. \n\n\n\nChúng có 60 Trái tim và chúng khác với các boss khác vì chúng không sử dụng phép thuật, mà tôi tin rằng chúng là thứ được tạo ra từ phép thuật. Chúng sẽ tấn công bằng thanh kiếm của mình, hoặc vung kiếm hoặc xông vào bạn. \n\n\n\nTheo những gì tôi đã thấy, chúng sẽ tấn công mọi thứ chúng thấy ngoại trừ các &5&lKnights&r khác! \n\n\n\nKhi bị giết, chúng rơi Netherite Scraps và Cinder Essence, chắc chắn sẽ rất hữu ích!\n\n{image:atm:textures/questpics/iron_spells/spells_knight.png width:100 height:200 align:center}"]
	quest.395A33977B18B9AD.title: "&5&lKnight Cổ xưa"
	quest.39605F1FEB1A5A1C.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2Community contributor&r để sử dụng trong các Modpack AllTheMods. \n\n\n\nVì tất cả các pack &6AllTheMods&r được cấp phép theo &eMọi quyền được bảo lưu&r, Nhiệm vụ này không được phép sử dụng trong bất kỳ pack công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng. \n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.39605F1FEB1A5A1C.title: "Mọi quyền được bảo lưu"
	quest.39647A2473F6F7D7.quest_desc: ["Bước tiếp theo của chúng ta là thử nghiệm với &6Infusion Rituals&r. Các nghi lễ này được sử dụng để thổi hồn vào các vật phẩm với ma thuật của quỷ dữ.\n\n\n\nTầng đầu tiên của &6Infusion Rituals&r là &eEziveus' Spectral Compulsion&r. Chúng ta sẽ sử dụng nghi lễ này để tạo ra một số vật phẩm mà bạn sẽ cần trong suốt mod này.\n\n\n\nKhuyến nghị tạo nghi lễ này ở một khu vực riêng biệt với nghi lễ đầu tiên của bạn, vì ba loại nghi lễ chính xây dựng dựa trên tầng trước đó."]
	quest.39647A2473F6F7D7.quest_subtitle: "Thêm một ít Demon Dust™ vào!"
	quest.39647A2473F6F7D7.title: "&eEziveus' Spectral Compulsion"
	quest.39796D8EE440F318.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_dune.png width:100 height:150 align:center}"]
	quest.39796D8EE440F318.quest_subtitle: "Kim tự tháp sa mạc"
	quest.39796D8EE440F318.title: "Trang trí giáp Dune"
	quest.3999760881C855FA.quest_desc: ["Máy này sẽ là máy thứ 3 trong Nhà máy Chế biển Quặng Cấp 4 của bạn.\n\n\n\nNó lấy Slurry Quặng Sạch từ Máy Rửa Hóa chất và biến nó thành Tinh thể, mà sau đó Máy Tiêm Hóa chất có thể xử lý tiếp."]
	quest.3999760881C855FA.quest_subtitle: "Biến Slurry Quặng thành Tinh thể"
	quest.39B4F361EF611927.quest_desc: [""]
	quest.39B4F361EF611927.quest_subtitle: "&oQuyền năng trên cái chết bản thân."
	quest.39B4F361EF611927.title: "&l&8La bàn của Wither"
	quest.39E4FC9BA89E44BC.quest_desc: ["Balloon on a Stick là nguồn bay sáng tạo sớm và bị hạn chế.\n\n\n\nĐặt cây cọc xuống và bạn sẽ được gắn với một quả bóng bay! Nhấn space hai lần để bắt đầu bay nhưng đừng đi quá xa. Đi quá xa bạn sẽ bị tách ra và rơi."]
	quest.39E4FC9BA89E44BC.quest_subtitle: "Lên!"
	quest.3A1D07AED2A841E4.quest_desc: ["Tự nung chảy vật phẩm trong Ba lô."]
	quest.3A1D07AED2A841E4.quest_subtitle: "Tự động"
	quest.3A1D07AED2A841E4.title: "&eNâng cấp Tự động Nung chảy"
	quest.3A4C17878FC8315B.quest_desc: ["Lò &6Allthemodium&r gần như giống với Lò Netherite. Bạn sẽ cần nó để chế tạo Lò &3Vibranium&r."]
	quest.3A4C17878FC8315B.title: "&6Lò Allthemodium"
	quest.3AA836E8EDB52097.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_lapis.png width:100 height:150 align:center}"]
	quest.3AA836E8EDB52097.title: "&9Lapis Lazuli&r"
	quest.3ABE7074E500494D.quest_desc: ["&7Thép&r được dùng cho hầu hết Máy trong &5&lMekanism&r... và cả Áo giáp, thật tuyệt!"]
	quest.3ABE7074E500494D.quest_subtitle: "20"
	quest.3ABE7074E500494D.title: "&7Áo giáp Thép"
	quest.3ADCAD65EA6900BA.quest_desc: ["&2Khảo cổ&r cho phép người chơi tìm thấy vật phẩm bên trong các khối &aNghi ngờ&r như Cát và Sỏi.\n\n\n\nCác khối này có thể được tìm thấy trong các cấu trúc khác nhau như Đổ nát Đại dương Ấm, Kim tự tháp Sa mạc, Giếng Sa mạc, và &eĐổ nát Đường mòn&r.\n\n\n\nĐể lộ ra một vật phẩm từ khối Nghi ngờ, bạn cần tạo một &aBàn chải&r để chải khối và lộ ra vật phẩm."]
	quest.3ADCAD65EA6900BA.title: "&2Khảo cổ&r!"
	quest.3AE0198177A8E91B.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_coast.png width:100 height:150 align:center}"]
	quest.3AE0198177A8E91B.quest_subtitle: "Tàu đắm và Kho báu chôn giấu"
	quest.3AE0198177A8E91B.title: "Trang trí giáp ven biển"
	quest.3AF4E5D4839CEF8B.quest_desc: ["Khi chúng ta có được &eBánh uranium vàng&r, chúng ta có thể đưa nó qua một &aMáy oxy hóa hóa học&r để tạo ra khí, &2Oxit uranium&r."]
	quest.3AF4E5D4839CEF8B.title: "&eOxit uranium"
	quest.3B3BD39BA02DCA13.quest_desc: ["Với &6Pocket Piston&r, các đòn tấn công của bạn sẽ đánh trúng kẻ thù ở khoảng cách xa hơn! \n\n\n\nTôi tự hỏi cái nào sẽ thắng, &6Pocket Piston&r hay &7Giày kiên định&r?"]
	quest.3B3BD39BA02DCA13.quest_subtitle: "Tay"
	quest.3B3BD39BA02DCA13.title: "&6Pocket Piston&r"
	quest.3B42CCC19D23EC6D.quest_desc: ["Thành phần lưu trữ cấp hai, cung cấp &e4096&f byte lưu trữ."]
	quest.3B42CCC19D23EC6D.quest_subtitle: "x4"
	quest.3B42CCC19D23EC6D.title: "Thành phần Lưu trữ 4k"
	quest.3B43DB1A6B0A7B44.quest_desc: ["Máy nghiền cũng có thể nghiền các chất tự nhiên thành Nhiên liệu Sinh học!"]
	quest.3B4BF42C55C8BBBF.quest_desc: ["Bạn có ghét khi đang phá vật thể và các Khối rơi ra ngoài tầm với không! \n\n\n\nĐừng lo nữa vì chúng tôi có &4Magnet&r! Chỉ cần Nhấp Chuột Phải khi cầm &4Magnet&r để bật nó. Sau đó, tất cả các Vật phẩm và Khối rơi trong phạm vi 5 Khối sẽ bay đến bạn. \n\n\n\nBạn cũng có thể trang bị &4Magnet&r trong Curios để tiếp tục sử dụng nó! \n\n\n\nNếu bạn không muốn tiếp tục sử dụng &4Magnet&r (Tôi thấy điều này xảy ra gần Mob Farms) thì chỉ cần Nhấp Chuột Phải với nó lần nữa để tắt. \n\n\n\nNó cũng có thể được nâng cấp để tăng phạm vi!"]
	quest.3B4BF42C55C8BBBF.title: "&l&9Đơn giản &4Magnet"
	quest.3B542DC05240242C.quest_subtitle: "&f6 &cSát Thương"
	quest.3B6F1BD64C0C570F.quest_desc: ["Giống như phát điện gió, cái này sẽ cung cấp cho bạn rất nhiều năng lượng mà không cần bất kỳ tài nguyên nào. Điểm duy nhất là nó chỉ hoạt động vào ban ngày."]
	quest.3B6F1BD64C0C570F.title: "Năng Lượng Mặt Trời"
	quest.3B81800EE6E77EF2.quest_desc: ["Lò phản ứng phân hạch cần &3Nhiên liệu Phân hạch&r để vận hành. Nếu bạn tìm Nhiên liệu Phân hạch ngay bây giờ trong JEI, tôi cá bạn sẽ bị choáng ngợp với tất cả những thứ bạn cần để làm nó. Không sao, bạn làm được. Hãy cùng từng bước một.\n\n\n\nTất cả đều bắt nguồn từ việc tạo ra &eUranium Hexafluoride&r. Để làm điều này, hãy tập trung vào việc tạo ra hai khí này: &bHydrofluoric Acid&r, và &eUranium Oxide&r."]
	quest.3BC0A50886A3222B.quest_desc: ["ATM10 là một modpack đầy đủ cho phép bạn khám phá thế giới Minecraft mod theo cách của riêng bạn!\n\n\n\nModpack này là phiên bản của ATM10 được xây dựng để có trải nghiệm tương tự như modpack chính, đồng thời tập trung mạnh vào hiệu năng, để có thể chạy trên các hệ thống cấu hình thấp.\n\n\n\nNếu bạn có bất kỳ câu hỏi hoặc vấn đề nào, hãy thoải mái tham gia máy chủ discord của ATM!"]
	quest.3BC0A50886A3222B.title: "§dChào mừng đến với All The Mods 10 - LITE!"
	quest.3BD73FEAE853D350.quest_desc: ["Bạn có bao giờ ghét tốc độ chậm của §bBăng§r trừ khi dùng thuyền? Điều đó vẫn chưa có ý nghĩa với tôi! §bGiày băng§r thay đổi điều đó, giờ bạn tăng tốc trên §bBăng§r khi đeo §bGiày băng§r. Bạn có thể nâng cấp chúng để tăng tốc nhanh hơn! \n\n \n\nSau khi nâng cấp, bạn có thể nhận được Khả năng thứ hai cho phép bạn gây sát thương cho Quái vật bằng cách chạy vào chúng khi đeo §bGiày băng§r."]
	quest.3BD73FEAE853D350.quest_subtitle: "Tìm thấy trong các làng ở Taiga hoặc Taiga tuyết"
	quest.3BD73FEAE853D350.title: "§bGiày băng"
	quest.3BDB94F17765EE77.quest_desc: ["Nếu bạn muốn tạo ra một lượng lớn năng lượng, bạn có thể bắt đầu bằng cách mở rộng một số tùy chọn từ phần §9Năng lượng Trung cuộc§r. Làm cho §aLò phản ứng§r của bạn lớn hơn. Nâng cấp §9Máy phát nhiệt§r của bạn lên Nitro. Tự do phát triển.\n\n\n\nTuy nhiên, bạn có thể cần thậm chí nhiều năng lượng hơn nữa."]
	quest.3BDB94F17765EE77.quest_subtitle: "Nhiều Năng Lượng Hơn Bạn Cần"
	quest.3BDB94F17765EE77.title: "Tùy Chọn Năng Lượng Cuối Cùng"
	quest.3BF1900346772703.quest_subtitle: "Cấp: §f2"
	quest.3C49F2EEDCCAF1DF.quest_desc: ["Nếu bạn giống tôi, bạn có lẽ đã lạc 55 lần trong vài bước cuối này. Đây là một hệ thống phức tạp.\n\n\n\nBố cục cơ bản của nhà máy bạn nên là:\n\n\n\nQuặng thô đi vào Buồng Hòa tan Hóa chất > bơm MỘT KHÍ đến Máy Rửa Hóa chất > bơm MỘT KHÍ đến Máy Kết tinh Hóa chất >  xuất tinh thể đến Buồng Tiêm Hóa chất > xuất mảnh đến Buồng Thanh lọc > xuất cục đến Máy nghiền > xuất bụi bẩn đến Buồng Làm giàu > xuất bụi sạch đến Lò nung.\n\n\n\n{image:atm:textures/questpics/mek/mekanism_flowchart.png width:300 height:150 align:1 fit:true}"]
	quest.3C49F2EEDCCAF1DF.quest_subtitle: "Tôi biết, đây là nhiều."
	quest.3C54C36CE97A48DC.quest_desc: ["Droppers thả,\n\nDispensers phát, \n\nVà Flingers ném! \n\n\n\nThay vì đặt items từ Buffer một cách gọn gàng, Flinger Module sẽ ném chúng? Xa bao xa? Bạn quyết định!"]
	quest.3CB6DC5B09C62CFE.quest_desc: ["&5Cổng Ender&r được dùng để truyền năng lượng không dây đến và từ một khối liền kề vào &7Ender Network&r.\n\n\n\nHãy nghĩ chúng như các điểm truy cập không dây đến mạng năng lượng không dây của bạn.\n\n\n\nLưu ý: Bạn chỉ có thể thêm &akhả năng lưu trữ năng lượng&r bằng Ender Cell."]
	quest.3CB7884B7B32CF00.quest_desc: ["Lấy được &bEther Gas&r đầu tiên có thể hơi đáng sợ.\n\n\n\n&bEther Gas&r được tạo từ việc khoan Wither, dùng Fluid Drill với &5Purple Lens&r.\n\n\n\nNhưng đừng lo về Wither, Industrial Foregoing có một máy giúp bạn với nhiệm vụ đó. &4Stasis Chamber&r là máy đóng băng mọi thứ trên nó trong khu vực 3x3, bao gồm Wither.\n\n\n\n&cHy vọng bạn không hết năng lượng, vì nếu hết... Tôi hy vọng bạn sẵn sàng chiến đấu với &0Wither&c."]
	quest.3CB7884B7B32CF00.quest_subtitle: "Ether Gas? Hả?"
	quest.3CE3D9245F8EC005.quest_desc: ["Thành phần lưu trữ cấp MEGA thứ tư, cung cấp &e67108864&f (65536k) byte lưu trữ."]
	quest.3CE3D9245F8EC005.quest_subtitle: "x4^3"
	quest.3CE3D9245F8EC005.title: "Thành phần lưu trữ 64M"
	quest.3D31B94CC42BCE43.quest_desc: ["&8Tome of Extraction&r là &8Tome&r chúng ta đang tìm! Nó sẽ bỏ tất cả &5Enchantments&r và giữ nguyên Item! \n\n\n\nĐể làm nó, chúng ta cần &d&lInfuse&r &8Tome of Superior Scrapping&r của mình. \n\n\n\nChúng ta chỉ cần thêm một &9Soul-Touched Sculkshelf&r khác vào bảng trước đó để có đủ!"]
	quest.3D31B94CC42BCE43.quest_subtitle: "Tất cả phép thuật, không làm hỏng"
	quest.3D41D0092D94636B.quest_desc: ["Nếu tôi nói với bạn Demon's Fruit dễ cháy thì sao?\n\n\n\nNém &cDemon's Dream Fruit&r xuống và đốt nó sẽ tạo ra &dSpiritfire&r. Đây là cách chúng ta chuyển đổi một số item overworld thành vật liệu &9Otherworld&r.\n\n\n\nNó cũng khá đẹp."]
	quest.3D41D0092D94636B.title: "Ngọn lửa của &9Thế giới khác"
	quest.3D5F87F8E6B89C1B.quest_desc: ["Máy &7Furnator&r sẽ đốt các vật phẩm như than và gỗ để tạo ra FE."]
	quest.3D72E3E53E7306FA.quest_desc: ["&e&lPhép thuật của Iron&r &cÁo giáp lửa&r!"]
	quest.3D72E3E53E7306FA.quest_subtitle: "20"
	quest.3D72E3E53E7306FA.title: "&cTrang phục pháp sư lửa"
	quest.3D77DE9CC51C866F.quest_desc: ["OreBerries có thể được chế tạo hoặc tìm thấy trong thế giới.\n\n\n\nChúng cũng tương thích với Pylon Thu hoạch từ mod Pylons, và sản lượng của chúng đã được tăng cường khi sử dụng pylon để tự động hóa."]
	quest.3D77DE9CC51C866F.title: "OreBerries"
	quest.3DCD38634176BD92.quest_desc: ["Kết hợp &6Allthemodium&r &eSách phép&r với một Phôi Vibranium và Mẫu trong Bàn rèn.\n\n\n\nMẫu này có thể được lấy từ việc làm sạch Soul Sand đáng ngờ trong một Bastion."]
	quest.3DCD38634176BD92.title: "&3Sách phép Vibranium&r"
	quest.3DDB0DDA7571B2C1.quest_desc: ["&bME Level Emitter&f, khi được cấu hình với một vật phẩm cụ thể và số lượng để phản hồi, sẽ phát ra tín hiệu redstone tùy thuộc vào việc vật phẩm đó trong mạng lưới có ít hơn, nhiều hơn hoặc bằng số lượng cho trước.\n\n\n\nĐiều này có thể được sử dụng, ví dụ, để tự động bật một số máy với redstone nhằm tự động chế tạo một tài nguyên khi số lượng của nó giảm dưới một mức tối thiểu cho trước."]
	quest.3DDB0DDA7571B2C1.title: "Bộ phát mức ME"
	quest.3DDF87A1E5F5D009.quest_desc: ["Ban đầu, bạn có thể tạm thời chế tạo các máy cấp &7Starter&r và &bBasic&r bằng sắt, nhưng về sau bạn sẽ cần tạo vật liệu được nạp năng lượng bằng &9Energizing Orb&r.\n\n\n\n&9Energizing Orb&r sẽ nạp năng lượng cho các vật phẩm bằng các &aEnergizing Rod&r ở gần trong phạm vi 9x9 xung quanh nó, tạo ra vật liệu tốt hơn để bạn sử dụng tiến qua các &eTiers&r trong Powah.\n\n\n\nĐể cấp năng lượng cho quả cầu, bạn cần gắn các Energizing Rod vào các Energy Cable đang được cung cấp năng lượng. Nếu bạn muốn Orb nạp năng lượng nhanh hơn, hãy làm nhiều rod hơn, nâng cấp lên các rod cấp cao hơn, hoặc cả hai! Để kiểm tra xem các Rod có được kết nối không, hãy đặt &aWrench&r của bạn vào chế độ liên kết và bạn có thể liên kết bất kỳ Rod nào với Orb.\n\n\n\n{image:atm:textures/questpics/powah/powah_energizing.png width:200 height:200 align:1}"]
	quest.3DDF87A1E5F5D009.title: "&9Energizing Orb&r"
	quest.3E0643EA9183CDAE.quest_desc: ["'Đó là chiếc mũ của ông ấy, Mr Krabs! Ông ấy là số 1!' \n\n\n\nLàm đúng giống như chiếc &6Drinking Hat&r thông thường, chỉ là trông ngầu hơn nhiều!"]
	quest.3E0643EA9183CDAE.quest_subtitle: "Đầu"
	quest.3E0643EA9183CDAE.title: "&9Mũ uống độc đáo&r"
	quest.3E1A3BC8642390B3.quest_desc: ["'Tôi là Marry Poppins các bạn ơi!' \n\n\n\n&4Chiếc ô&r là một công cụ rất hữu ích được thêm bởi &l&3Artifacts&r! Nó có thể được cầm trước mặt bạn để hoạt động như một khiên, bằng cách giữ Right Click. Hoặc nó có thể được sử dụng để làm chậm cú ngã của bạn chỉ bằng cách cầm nó!"]
	quest.3E1A3BC8642390B3.quest_subtitle: "Độc nhất"
	quest.3E1A3BC8642390B3.title: "&4Ô&r"
	quest.3E2A411FF5B4B0E7.quest_desc: ["Phạm vi kích hoạt là khoảng cách gần bao nhiêu Người chơi (Bạn) phải ở gần Máy sinh quái để nó hoạt động. Khoảng cách thấp nhất có thể là cách 1 khối và cao nhất là bán kính 48 khối."]
	quest.3E2A411FF5B4B0E7.title: "Phạm vi kích hoạt"
	quest.3E33730DC2115D26.title: "&eRương vàng"
	quest.3E3CBDCEAB0FF28F.quest_desc: ["&9Deep Learner&r là một trong những thành phần cốt lõi của HNN.\n\n\n\nVới vật phẩm này, bạn có thể nhấp chuột phải để mở HUD và lưu trữ &6Data Models&r để thu thập dữ liệu khi giết quái.\n\n\n\nMỗi Learner có thể chứa 4 Data Models, và miễn là bạn có Learner ở bất kỳ đâu trong túi đồ, nó sẽ thu thập dữ liệu cho các Data Models được đặt bên trong!\n\n\n\nLưu ý: Bạn có thể có nhiều Deep Learner trong túi đồ, và nó sẽ đếm số lần giết cho tất cả Data Models bên trong tất cả các Learner."]
	quest.3E3CBDCEAB0FF28F.quest_subtitle: "HUD Học tập"
	quest.3E3CBDCEAB0FF28F.title: "&aQuái học tập"
	quest.3E3DF8E967D95DB0.quest_desc: ["Khi sử dụng thành phần lưu trữ 64k trở lên, Matter Condenser có thể ngưng tụ nhiều hơn để tạo ra một &bSingularity&f. Một Singularity đơn lẻ yêu cầu 256000 vật phẩm để hủy bỏ. Đó chính xác là &o4000 stack&r!\n\n\n\nHãy xem điều gì xảy ra khi bạn ném Singularity này xuống đất cùng một mảnh &eEnder Dust&f. Bạn sẽ phải gây một số thiệt hại cho môi trường xung quanh khi làm việc này, nhưng may mắn thay AE2 cung cấp &bTiny TNT&f riêng của nó để giảm thiểu điều đó."]
	quest.3E3DF8E967D95DB0.quest_subtitle: "Vật chất Siêu Đặc"
	quest.3E3DF8E967D95DB0.title: "Vật chất Siêu Đặc"
	quest.3E6706BC4C318A40.quest_desc: ["Máy cống được dùng để sản xuất Nước thải, và Nước thải được dùng để sản xuất Phân bón."]
	quest.3E6706BC4C318A40.title: "Máy cống"
	quest.3E8077AB45C79E6A.quest_desc: ["Chắc chắn tốt hơn một Cái Nồi Minecraft thông thường! \n\n\n\nCái Nồi Giả Kim Thuật có thể: \n\n1. Được dùng để lấy &4Máu&r bằng cách nấu các Quái vật hoặc Người chơi. \n\n2. Làm và nâng cấp các Thuốc. \n\n3. Có một nửa cơ hội để lấy Mực từ một Cuộn Giấy. \n\n4. Kết hợp 4 Mực của một Độ Hiếm để lấy Độ Hiếm cao hơn. \n\n{image:atm:textures/questpics/iron_spells/spells_cauldron.png width:100 height:100 align:center}"]
	quest.3E8BA5E075ABD136.quest_desc: ["&7Ice Breakers&r Khả năng đầu tiên là làm cho Cân Bằng của bạn vững chắc như đá. Lực Đẩy Lùi bị giảm và trượt trên &bBăng&r cũng bị giảm. \n\n \n\nKhả năng thứ hai là Động Đất! Khi đang rơi, chọn Động Đất với Left Alt và khi bạn hạ cánh, nó sẽ tạo ra một sóng xung dưới chân bạn, gây sát thương cho tất cả quái vật gần đó."]
	quest.3E8BA5E075ABD136.quest_subtitle: "Được tìm thấy trong các Làng ở Taiga hoặc Taiga Tuyết"
	quest.3E8BA5E075ABD136.title: "Ice Breakers"
	quest.3E970E76372AB094.quest_desc: ["Cái &2Accelerated Planter&r hoạt động tương tự như Đất Canh Tác thông thường nhưng với một số thay đổi.\n\n\n\nNó được tưới nước tự động và nhanh hơn Đất Canh Tác thông thường."]
	quest.3E970E76372AB094.title: "&2Accelerated Planter"
	quest.3E99F4CD379DE9D7.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2Người đóng góp Cộng đồng&r để sử dụng trong các Modpack AllTheMods.\n\n\n\nVì tất cả các pack &6AllTheMods&r được cấp phép theo &eAll Rights Reserved&r, Nhiệm vụ này không được phép sử dụng trong bất kỳ pack công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng.\n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.3EA3A6414AB8A39C.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_flow.png width:100 height:150 align:center}"]
	quest.3EA3A6414AB8A39C.quest_subtitle: "Trial Chambers"
	quest.3EA3A6414AB8A39C.title: "Flow Armor Trim"
	quest.3EA883C0BB7BD38F.quest_desc: ["Hãy thu thập một ít sợi len!"]
	quest.3EA883C0BB7BD38F.quest_subtitle: "Lông cừu của ai đã... Cầu vồng?"
	quest.3EA883C0BB7BD38F.title: "Mary có một con cừu con"
	quest.3EC8A0B89788D079.quest_desc: ["Tôi không có tay, tôi có &9Bơm chân&r. \n\n\n\n&9Bơm chân&r sẽ hoạt động như một thuộc tính Đi bộ dưới nước tốt hơn nhiều. Bạn có thể bơi và đi bộ qua &9Nước&r nhanh hơn rất nhiều!"]
	quest.3EC8A0B89788D079.quest_subtitle: "Chân"
	quest.3EC8A0B89788D079.title: "&9Bơm chân&r"
	quest.3EC9D0DA61B45328.quest_desc: ["Máy phát điện này có thể đốt cả Hydrogen và Ethylene để tạo ra năng lượng.\n\n\n\nLưu ý: Việc đốt Hydrogen sẽ không tạo ra nhiều năng lượng hơn chi phí để chạy một Máy tách điện ly. Hãy dùng cho Ethylene thay vào đó."]
	quest.3EC9D0DA61B45328.quest_subtitle: "Đốt khí để tạo điện!"
	quest.3F5010269469EBE0.quest_desc: ["Bên trong lò phản ứng được xây dựng từ các cột sử dụng một số khối &aLắp ráp nhiên liệu phân hạch&r, với một &aLắp ráp thanh điều khiển&r đặt ở đỉnh mỗi cột. Những cột này có thể cao từ 1 đến 15 khối, tùy thuộc vào kích thước của lò phản ứng.\n\n\n\nĐối với bản thiết kế này, chúng ta sẽ đặt 2 Lắp ráp nhiên liệu phân hạch ở trung tâm của multiblock, và sau đó đặt Lắp ráp thanh điều khiển ngay phía trên nó.\n\n\n\n{image:atm:textures/questpics/mek/rod_example.png width:250 height:200 align:1}"]
	quest.3F5010269469EBE0.title: "Bên trong Lò phản ứng: Điều khiển Nhiên liệu"
	quest.3F68BA498E877C8C.quest_subtitle: "Tên đệm của Roy Biv"
	quest.3F68BA498E877C8C.title: "&aNgọc Xychorium Xanh"
	quest.3F8D515D7B81B0E3.quest_desc: ["Một Mẫu Rèn Khác nữa?!?!?!\n\n\n\nMay mà bạn không cần Khảo cổ cho cái này!\n\n\n\nBạn sẽ phải kiếm được chúng bằng cách đánh bại Máy sinh quái thử thách, được tìm thấy trong cấu trúc Hầm ngục ở &b&lThe Other&r. Cụ thể hơn là các Phòng Thư viện!\n\n\n\n{image:atm:textures/questpics/allthemodium/all_library.png width:200 height:100 align:center}"]
	quest.3F8D515D7B81B0E3.title: "&5Mẫu Rèn Unobtainium"
	quest.3FCEF8FF45E51608.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_quartz.png width:100 height:150 align:center}"]
	quest.3FFF9018DA2A2763.quest_desc: ["Khi chúng ta bắt đầu đốt Nhiên liệu Phân hạch trong lò phản ứng, chúng ta sẽ có &bCoolant&r nóng và &8Nuclear Waste&r.\n\n\n\nĐây là nơi Bức xạ phát sinh. Miễn là nó được giữ &oan toàn trong một số container hoặc máy&r, bạn sẽ không có đổ vỡ....phải không?\n\n\n\nCách tốt nhất để lưu trữ bất kỳ chất phóng xạ nào là sử dụng &2Radioactive Waste Barrel&r. Chúng sẽ lưu trữ phế liệu một cách an toàn, đồng thời làm phân rã khí một cách chậm mà không gây đổ vỡ bức xạ. Bạn không muốn Nuclear Waste của mình nằm trong Reactor vì nó khiến nó sản xuất nhiều nhiệt hơn, vì vậy hãy đặt một cổng để &axuất Waste&r và vận chuyển nó đến thùng!\n\n\n\n&9Lưu ý quan trọng&r: Phá hủy &nbất kỳ&r máy, thùng, ống, hay &obất cứ thứ gì&r có khí Phóng xạ bên trong &csẽ gây rò rỉ Bức xạ&r. Điều đó bao gồm các sản phẩm của Nuclear Waste, như Polonium hay Plutonium."]
	quest.3FFF9018DA2A2763.title: "Xử lý &8Nuclear Waste"
	quest.4007DFA7CC3A5FF2.quest_desc: ["Để tiết kiệm bạn khỏi việc &ocả phần nhiệm vụ này&r bị phủ ngập bằng các nâng cấp, hãy xem các nâng cấp Sophisticated Backpack\n\n\n\nBạn sẽ cần tạo ra phiên bản tương đương của Sophisticated Storage, nhưng chúng hoạt động gần như giống nhau."]
	quest.4007DFA7CC3A5FF2.quest_subtitle: "Nền tảng Nâng cấp"
	quest.40096ED0B04C3EC5.quest_desc: ["Điều cần thiết cho tất cả các Máy sinh quái. Khi nó nói bỏ qua tất cả điều kiện, nó có nghĩa là hầu hết. Bỏ qua mức độ ánh sáng, các khối cần thiết để sinh quái, và sinh thái. Tuy nhiên, điều kiện không gian vẫn cần thiết, ví dụ như slime cần khu vực 3x3 để sinh quái, và tương tự với người chơi cần ở gần."]
	quest.40096ED0B04C3EC5.title: "Bỏ qua tất cả điều kiện"
	quest.401BB95B740385B7.title: "&6Thánh Quả Cầu Nâng Cấp&r"
	quest.403F76908A8A5661.quest_desc: ["Cột Phóng Đẩy (Pylon) sẽ đẩy người chơi ra khỏi khu vực, nhưng nếu bạn muốn &lmột số&r người chơi ở gần thì sao! Khi đó bạn sẽ cần một Bộ lọc Người chơi (Player Filter). \n\n\n\nDùng click phải vào người chơi với Bộ lọc để thêm họ vào, sau đó đặt Bộ lọc vào Cột Phóng Đẩy để đưa họ vào Danh sách Trắng (Whitelist)! \n\n\n\nVậy khi mọi người khác bị đẩy ra, bạn bè của bạn sẽ không bị! \n\n\n\nNgoài ra, mặc định Chủ sở hữu (Owner) của Cột Phóng Đẩy sẽ không bị đẩy ra."]
	quest.40788326E791845D.quest_desc: ["Ép là một từ khá nhàm chán. \n\n\n\nMáy Ép (Extruder) sẽ đặt các khối trong Bộ đệm của Router thành một hàng phía trước Router khi được cấp Tín hiệu Đá đỏ. Khi Tín hiệu bị tắt, nó sẽ phá tất cả các khối đó. \n\n\n\nRất hữu ích cho Cửa!"]
	quest.407EFAF528871014.quest_desc: ["Để bắt đầu phân tách nước, chúng ta cần một nguồn nước. Bồn rửa (Kitchen Sink) cung cấp nước vô hạn và có thể dễ dàng được thiết lập để bơm nước ra.\n\n\n\nMột cách khác, bạn luôn có thể sử dụng nguồn nước vô hạn kinh điển với một Máy bơm từ Mekanism.\n\n\n\nBơm nước vào Máy Tách Điện Hóa (Electrolytic Separator) của bạn để tách nước thành Hydrogen và Oxygen."]
	quest.407EFAF528871014.quest_subtitle: "Nguồn Nước Vô Hạn Toàn Năng"
	quest.407EFAF528871014.title: "Nguồn Nước"
	quest.40AB457E37919ABE.quest_desc: ["Bạn thích Bay? Bạn thích Đốt cháy? Bạn thích cả hai? Khi đó Blazing Flask hoàn hảo cho bạn! Click phải Blazing Flask gần nguồn Lửa và một vòng tròn sẽ được tạo ra xung quanh nó. Trong vòng tròn đó, bạn sẽ được ban tặng Khả năng Bay Sáng tạo (Creative Flight). Vòng tròn có thể được làm lớn hơn thông qua việc nâng cấp nó trong &6Cửa sổ Nghiên cứu&r và bằng cách thêm nhiều Lửa hơn!"]
	quest.40AB457E37919ABE.quest_subtitle: "Có thể tìm thấy ở Cổng bị phá hủy, Pháo đài Nether và Bastion"
	quest.40AB457E37919ABE.title: "&5Bình Lửa Rực"
	quest.4104ABDC0E577350.title: "&2Linh Hồn Nâng Cấp Thiên Nhiên&r"
	quest.417B88FEB1B8F44E.quest_desc: ["Chúng hút mạnh thật! 'Nghĩa đen'! \n\n\n\nMô-đun Chân Không sẽ hút mọi vật phẩm trong khu vực được chọn và chuyển chúng vào Bộ Đệm của Router. Tương tự như Absorption Hopper. \n\n\n\nCũng có thể dùng kèm với Experience Augment!"]
	quest.4189BC3DFB551F4C.quest_desc: ["Nếu bạn đã lắp đặt Turbine đúng cách, bạn sẽ thấy các hạt đỏ xung quanh cấu trúc. Nhấp chuột phải vào Turbine sẽ mở giao diện.\n\n\n\nGiao diện này sẽ cung cấp mọi thông tin bạn cần biết, bao gồm Tổng Lưu Lượng Hơi Nước, cũng như Tổng Lượng Hơi Nước bên trong Turbine.\n\n\n\nBên phải, bạn sẽ thấy một thanh hiển thị Lượng Điện đang được lưu trữ trong Turbine. Nếu thanh này đầy, Turbine sẽ tắt, trừ khi bạn đặt nó ở chế độ Vent Overflow (Thải Dư).\n\n\n\nHãy cùng chạy thử nào!\n\n\n\nKhi bạn đã có một Lò Phản Ứng Phân Hạch hoạt động hoàn toàn, bơm &bHơi Nước&r trực tiếp vào Van Turbine của bạn. Vì chúng ta đang sử dụng Saturating Condensers trong thiết kế này, bạn có thể bơm nước từ một Cửa Thải của Turbine ngược trở lại Lò Phản Ứng nếu muốn."]
	quest.4189BC3DFB551F4C.title: "Tạo Điện bằng Turbine!"
	quest.418E57E34FFC19E1.quest_desc: ["Gợi ý: Dùng loại Kính Chống Wither nào đó."]
	quest.418E57E34FFC19E1.quest_subtitle: "Máy Khai Thác Vùng Đất Trống"
	quest.418E57E34FFC19E1.title: "Máy Khoan Laser"
	quest.41C0948CD9D50322.quest_desc: ["Tại đây bạn sẽ tìm thấy tất cả phần thưởng có thể nhận được khi giết kẻ thù."]
	quest.41C0948CD9D50322.quest_subtitle: "Giết Mọi Thứ"
	quest.41C0948CD9D50322.title: "Bảng Phần Thưởng"
	quest.41E8550FC36ABCA5.title: "Công cụ Vô hạn"
	quest.41EB0C570FC54F43.quest_desc: ["Khối này lưu trữ khí."]
	quest.41EB0C570FC54F43.quest_subtitle: "Lưu trữ Tất Cả Khí"
	quest.4204702AA6FBF40B.quest_desc: ["Đứng trên vật phẩm này sẽ sạc bất kỳ vật phẩm có nguồn năng lượng từ bất kỳ mod nào.\n\n\n\nĐiều này cũng cần thiết cho Robit."]
	quest.420FE84DEE12CCE0.quest_desc: ["Lò &eVàng&r tốt hơn các lò Sắt với thời gian nấu là 120 Tick.\n\n\n\nNó có thể được chế tạo từ &7Bạc&r hoặc Lò Sắt và có thể chế tạo thành lò &bKim Cương&r!"]
	quest.420FE84DEE12CCE0.title: "&eLò Vàng"
	quest.4236B9F071BE18F3.quest_desc: ["Để làm Axit Sunfuric, bạn cần tạo &aHơi Nước&r.\n\n\n\nBơm một ít nước vào máy này và nó sẽ chuyển nó thành hơi nước."]
	quest.427014BDE06DE631.quest_desc: ["Mọi thứ tôi đánh, đều bùng cháy!!!!!"]
	quest.427014BDE06DE631.quest_subtitle: "Tay"
	quest.427014BDE06DE631.title: "&cGăng tay Lửa&r"
	quest.42746659C66CF17F.quest_desc: ["Thư viện Alexandria &6&o&r là một phiên bản tốt hơn của &5Thư viện phép thuật&r. \n\n\n\nNó có thể chứa cấp độ &5Sách phép thuật&r cao hơn, nhưng vẫn cần cấp độ của &5Sách&r để lấy ra ở cấp độ đó. \n\n\n\nNó cũng có thể chứa nhiều Điểm hơn. &5Thư viện phép thuật&r có thể chứa 32768, trong khi &6&oThư viện Alexandria&r có thể chứa 1.1 Tỷ Điểm của mỗi &5Sách&r! \n\n\n\nĐể có được nó, chúng ta cần &d&lHòa trộn&r &5Thư viện phép thuật&r. \n\n\n\nSử dụng 4 &9Soul-Touched Sculkshelves&f, 4 &9Echoing Sculkshelves&f, 1 &dDraconic Endshelf&f, 5 &6Geode-Encased Bookshelves of Stability&r, và một Skeleton Skull."]
	quest.42746659C66CF17F.quest_subtitle: "Hãy tưởng tượng nếu Roma chưa bao giờ bị cháy..."
	quest.42746659C66CF17F.title: "&6&oThư viện Alexandria"
	quest.427C3AFC0FF131CD.title: "Chất lỏng"
	quest.42822B1E8A53D051.title: "&l&9Phần thưởng Overworld:&r&e Skeleton"
	quest.429B5A81DF6C43FE.quest_desc: ["&6Abras' Open Commanding Conjure&r được dùng để đưa một con quỷ &cAfrit&r vào một con Lợn. Vì nghi lễ này được thực hiện mà không dùng Phấn đỏ, nên nó chỉ đủ mạnh để triệu hồi một con quỷ &9chưa ràng buộc&r.\n\n\n\nCụ thể, nghi lễ này sẽ tạo ra một &cAfrit&r chiếm hữu Zombified Piglin, sẽ rơi ra một ít Demonic Meat, được dùng để chế tạo Phấn hồng.\n\n\n\n&4CẢNH BÁO: BẠN CÓ THỂ PHẢI LÀM NGHI LỄ NÀY NHIỀU LẦN ĐỂ CÓ ĐỦ THỊT QUỶ."]
	quest.429B5A81DF6C43FE.quest_subtitle: "Sao... Đầy thịt..."
	quest.429B5A81DF6C43FE.title: "&6Abras' Open Commanding Conjure"
	quest.42D173B9FF8D16E4.quest_desc: ["Đang tìm kiếm các lựa chọn năng lượng ở giai đoạn đầu? Đây là những cách tốt để bắt đầu tạo ra năng lượng.\n\n\n\nChúng không tạo ra nhiều năng lượng, nhưng thường dễ có được hoặc rẻ ở giai đoạn đầu!"]
	quest.42D173B9FF8D16E4.quest_subtitle: "Năng lượng khởi đầu"
	quest.42D173B9FF8D16E4.title: "&8&lCác Lựa Chọn Nguồn Điện Giai Đoạn Đầu"
	quest.42D7C8CD8E6F5CD7.quest_desc: ["Bằng cách sử dụng một Quả Hợp Xướng trên một Spawner, bạn hút linh hồn ra khỏi các sinh vật sẽ được sinh ra, chỉ còn lại một cái vỏ rỗng của những gì chúng từng là. Các sinh vật sẽ mất toàn bộ AI nên chúng sẽ làm cơ bản như một Kệ Áo Giáp. Chúng không thể đánh bạn, không thể dịch chuyển, không thể tự di chuyển. Chúng ngồi đó sẵn sàng bị giết, thật thú vị!"]
	quest.42D7C8CD8E6F5CD7.title: "Không AI"
	quest.42F50CE7FE715583.quest_desc: ["Để nâng cấp số lượng stack mà kho lưu trữ phép thuật của bạn có thể chứa, bạn sẽ cần tạo &dStorage Stabilizers&r.\n\n\n\nSau khi tạo, chúng phải chỉ thẳng vào phần Dimensional Matrix của Storage Actuator của bạn, không phải phần đếm. Chúng có thể cách xa tới 5 khối, nhưng phải có tầm nhìn trực tiếp đến Ma trận.\n\n\n\nBất cứ khi nào bạn muốn nâng cấp lên Stabilizer cấp cao hơn, phá nó sẽ không phá hủy các item bên trong. Tuy nhiên, bạn sẽ không thể thêm thêm item nào vào kho lưu trữ của mình cho đến khi nó được thay thế hoặc nâng cấp.\n\n\n\nDưới đây là một ví dụ về thiết lập đơn giản!\n\n\n\n{image:atm:textures/questpics/occultism/storageupgradeexample.png width:200 height:150 align:1}"]
	quest.42F50CE7FE715583.title: "&aNâng Cấp Kho Phép Thuật Của Chúng Ta"
	quest.43021923E220CF68.quest_desc: ["Để cày Đất thành Đất Canh Tác, bạn sẽ cần một Cuốc."]
	quest.43021923E220CF68.quest_subtitle: "Chờ đến khi bạn có Máy Móc cho việc này..."
	quest.43021923E220CF68.title: "Máy Gieo Trồng"
	quest.43167C59036E79A7.quest_desc: ["Cuốn &8Tome of Miners&r sẽ giúp bạn với tất cả việc Khai Thác. Nó sẽ cho &5Hiệu Quả&f, &5May Mắn&f, và &5Chạm Lụa&r. \n\n\n\nNhững phép này hoạt động cho Xẻng Đào, Rìu, Xẻng Xúc, và thậm chí cả Cuốc! \n\n\n\nCuốn &8Tome of the Fishers&r sẽ chỉ cho Cần Câu &5Phép&r, và ừ thì có nhiều lắm."]
	quest.43167C59036E79A7.title: "&8Sách Công Cụ"
	quest.431A8FDF15701BA4.quest_desc: ["Thắt lưng Săn sóc &2&r hoạt động giống như Thắt lưng da, nó có thể đựng Bùa hộ mệnh. Đó là khả năng đầu tiên có thể nâng cấp để đựng nhiều hơn! \n\n \n\nKhả năng thứ hai tăng sát thương mà thú cưng của bạn gây ra. Thú cưng là Sống vật đã thuần hóa có thể gây sát thương lên Sống vật khác, như sói!"]
	quest.431A8FDF15701BA4.quest_subtitle: "Tìm thấy trong Nhà hàng thịt của bất kỳ Làng nào."
	quest.431A8FDF15701BA4.title: "Thắt lưng Săn sóc &2&r"
	quest.436E4E3515BCCDE9.quest_desc: ["Khi trang bị &bĐám mây trong chai&r, bạn có thể nhấn Space Bar hai lần để nhảy đôi! Rất hữu ích cho parkour! \n\n\n\nNó cũng tăng chiều cao bạn có thể rơi từ, giống như &dBunny Hoppers&r!"]
	quest.436E4E3515BCCDE9.quest_subtitle: "Thắt lưng"
	quest.436E4E3515BCCDE9.title: "&bĐám mây trong chai&r"
	quest.43D83CFA824B0A70.quest_desc: ["&9Mekanism&r có một lựa chọn sức mạnh cuối game khó vượt qua. &dLò phản ứng Nhiệt hạch&r có thể sản xuất đến 80MRF/t, và nếu bạn muốn học cách xây dựng nó, hãy chắc chắn xem chương nhiệm vụ &aMekanism: &dLò phản ứng&r!"]
	quest.43D83CFA824B0A70.quest_subtitle: "Kích hoạt Nhiệt hạch!"
	quest.43D83CFA824B0A70.title: "&9Mekanism: &dLò phản ứng Nhiệt hạch"
	quest.43F08B510FC1C06F.quest_desc: ["Item IOs cho phép chúng ta vận chuyển vật phẩm vào và ra khỏi Bể chứa. Chúng có thể chuyển đổi giữa Đầu ra và Đầu vào."]
	quest.43F08B510FC1C06F.quest_subtitle: "Nơi vật phẩm ra vào"
	quest.43F08B510FC1C06F.title: "Vật phẩm IO"
	quest.4407BD7B5F033765.quest_desc: ["Một cuốn Sách Phép khác có thể chế tạo &eSpell Book&r và theo mẫu, cuốn này thậm chí còn đắt hơn. Nó yêu cầu Arcane Clothes, Gold, và một Enchanted Book. Nó không kén chọn sách nào, chỉ cần là Enchanted! \n\n\n\nNó có 10 &3Spell&r Slots và cấp một lượng Mana Boost khổng lồ!"]
	quest.4407BD7B5F033765.title: "Sách Phép Phép thuật"
	quest.4434D7B66521D69A.quest_subtitle: "Để chuyển khí"
	quest.445C21949ADA1FE3.quest_desc: ["Kết hợp một Ancient Codex với một &6Allthemodium Ingot&r và Template trong một Smithing Table.\n\n\n\nBạn có thể lấy Template từ việc chải Suspicious Clay trong một &9Ancient City&r."]
	quest.445C21949ADA1FE3.title: "&6Allthemodium&r Sách Phép"
	quest.44D5EDB8711EC7A0.quest_desc: ["&2&lVanilla&r không thể tận hưởng trọn vẹn niềm vui với Maces! Vì vậy tất nhiên có một nâng cấp &6Allthemodium&r cho chúng! \n\n\n\nNâng cấp một Mace với một &6Allthemodium Block&r để có được &6Allthemodium Mace&r. \n\n\n\nNó gây nhiều sát thương cơ bản hơn, nhiều sát thương rơi hơn, và cùng các Enchantments!"]
	quest.44D5EDB8711EC7A0.title: "&6Allthemodium Chùy"
	quest.45161821C221EF0B.quest_desc: ["Khi chúng ta có 15 &4Hellshelves&r xung quanh &5Enchantment Table&r của mình, chúng ta sẽ có &a45 Eterna&r và &c30% Quanta&r trong &5Table&r của mình. \n\n\n\nĐây là lượng hoàn hảo để &d&lInfuse&r &4Hellshelves&r của chúng ta! \n\n\n\n&4Infused Hellshelves&r cấp &a5 Eterna&r với tối đa &a60 Eterna&r, cùng với &c5% Quanta&r. \n\n\n\nChúng có thể được chế tạo với các vật phẩm khác để làm ra các &7Bookshelves&r khác nhau, cho loại chúng ta muốn chúng ta sẽ cần 12 &4Infused Hellshelves&r! \n\n\n\nTất nhiên, với tôi rất hào phóng, bạn chỉ cần thu thập 8!"]
	quest.45161821C221EF0B.title: "&4Kệ Địa Ngục Đã Tinh Chế"
	quest.45268A619787288F.title: "&eTúi Vàng"
	quest.452DC5EB02D592B8.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_amethyst.png width:100 height:150 align:center}"]
	quest.452DC5EB02D592B8.title: "&5Thạch anh tím&r"
	quest.4564B577CB4EC046.quest_desc: ["Khi giết hàng trăm con Bò, bạn có thể tìm thấy một miếng Thịt Bò Hiếm. Không phải bị bệnh điên (Mad Cow Disease), tôi muốn nói là &cThịt Bò Vĩnh Cửu&r!\n\n\n\n&cThịt Bò Vĩnh Cửu&r có thể ăn như một miếng Thịt Bò Thường, nhưng nó sẽ không bị xóa khi ăn! Thay vào đó, nó sẽ có thời gian hồi trước khi bạn có thể ăn lại.\n\n\n\n(Cũng hoạt động với túi tự động cho ăn!)"]
	quest.4564B577CB4EC046.quest_subtitle: "Độc nhất"
	quest.4564B577CB4EC046.title: "&cThịt Bò Vĩnh Cửu&r"
	quest.4597D3B3BDC2BED5.quest_desc: ["&bMáy Lắp Ráp Phân Tử&f là thiết bị tương đương với bàn chế tạo tự động trong AE2, cần thiết để thực hiện mọi công việc &echế tạo&f theo mẫu.\n\n\n\nMáy Lắp Ráp Phân Tử có khả năng truyền năng lượng và kênh đến các thiết bị ME khác được kết nối với nó, nhưng bản thân chúng không chiếm kênh. Có thể kết nối tối đa 6 Máy Lắp Ráp Phân Tử với một Pattern Provider (nếu được sử dụng) để cho phép thực hiện nhiều chế tạo song song.\n\n\n\nMỗi Máy Lắp Ráp Phân Tử cũng có một khe dành riêng cho một mẫu chế tạo, cho phép chúng hoạt động độc lập khi được cấp năng lượng. Khi vận hành theo cách này, bất kỳ vật phẩm phù hợp nào được đưa vào Máy Lắp Ráp Phân Tử sẽ được tự động chế tạo thành kết quả của mẫu."]
	quest.45F83C2750F70F9B.quest_desc: ["Cứ làm đi, đặt một Cuốn Sách vào Lò và nung chảy nó."]
	quest.45F83C2750F70F9B.quest_subtitle: "Hoàn toàn sẽ không bắt lửa..."
	quest.45F83C2750F70F9B.title: "Làm Căn Bếp với Sách"
	quest.460A8F17F3ED6CAF.quest_desc: ["Có một thời điểm trong bất kỳ lần chơi modpack lớn nào mà ngay cả ô chứa lưu trữ cấp cao nhất cũng không đủ cho số lượng vật phẩm và tài nguyên bạn tích lũy.\n\n\n\nĐây là nơi mà tiện ích mở rộng &dMEGA Cells&f xuất hiện, mở rộng các cấp lưu trữ có sẵn sang lĩnh vực megabyte. Cấp đầu tiên trong số các cấp mới này được cung cấp bởi &b1M MEGA Storage Component&f, cung cấp 1024 &okilo&rbytes, hay &e1048576&f bytes, dung lượng lưu trữ."]
	quest.460A8F17F3ED6CAF.quest_subtitle: "Megabyte đầu tiên."
	quest.460A8F17F3ED6CAF.title: "Thành phần Lưu trữ 1M"
	quest.46D756F4DC6CC894.title: "&dBa lô Netherite"
	quest.47106CE1937C4340.quest_desc: ["Để có một Tấm HDPE, hãy đặt 3 Viên HDPE vào Buồng Làm giàu."]
	quest.47358ADC1470C82A.quest_desc: ["&cQuả Mơ Ác Quỷ&r hoàn toàn tốt cho sức khỏe của bạn. Có thể có một số tác dụng phụ bạn nên biết.\n\n\n\nKhi bạn tiêu thụ một quả, bạn có cơ hội nhận được hiệu ứng của &3Mắt Thứ Ba&r, cho phép bạn nhìn thấy &9Thế Giới Khác&r. Một số vật phẩm trong thế giới có thể không như vẻ ngoài, và bạn sẽ cần thị giác \"này\" để tìm thấy một số vật phẩm cần thiết cho sự tiến trình.\n\n\n\nHoặc bạn có thể đốt nó và bỏ qua việc tìm phần lớn chúng. Đó là tùy bạn."]
	quest.47358ADC1470C82A.quest_subtitle: "Sẵn Sàng cho Chuyến Đi"
	quest.47358ADC1470C82A.title: "&cQuả Ác Quỷ"
	quest.475E1B94A61B9EB0.quest_desc: ["Giống như MK1, cái này cũng hút! Không chỉ từ các Kho hàng liền kề, mà còn từ bất kỳ Kho hàng nào gần đó!"]
	quest.47750F3CB020104C.quest_desc: ["&lGenerator's Galore&r và &lIron Furnaces&r là hai mod khác nhau nhưng cũng tương tự. Cả hai đều bắt đầu từ cái lò huyền thoại!"]
	quest.47750F3CB020104C.quest_subtitle: "Tất cả bắt đầu từ đây"
	quest.47750F3CB020104C.title: "Lò"
	quest.47764EFC822E462A.quest_desc: ["Khối này sản xuất sữa theo thời gian, và mở khóa công thức sữa cho bếp đa khối.\n\n\n\nĐể đặt con bò vào lọ, hãy đặt lọ vào một lỗ. Dẫn con bò rơi xuống lỗ đó phía trên lọ, sau đó thả một búa anvil xuống.\n\n\n\nTôi không biết lớp kính này làm từ gì, nhưng nó cứng hơn mối quan hệ của tôi với Chicken."]
	quest.47764EFC822E462A.quest_subtitle: "Sức mạnh vắt sữa phi thường....Không gian sống nhỏ xíu"
	quest.47764EFC822E462A.title: "Con bò trong lọ"
	quest.477B411F84342EEA.quest_desc: ["Mekanism là một trong những mod tốt nhất để lưu trữ năng lượng, đặc biệt là ở giai đoạn đầu.\n\n\n\nBasic Energy Cube dễ cấu hình, dễ chế tạo và lưu trữ nhiều năng lượng. Nó cũng có thể nâng cấp, và có thể sạc các vật phẩm bên trong giao diện!\n\n\n\nĐể tìm hiểu thêm về nâng cấp Energy Cube cũng như mod, hãy chuyển sang chương nhiệm vụ &aMekanism&r!"]
	quest.477B411F84342EEA.title: "&9Mekanism: &aEnergy Cubes"
	quest.47AED7219704EB3E.quest_subtitle: "&f18 &cSát thương tấn công"
	quest.47F734CDD5793F26.title: "&5Nỏ Unobtainium"
	quest.480FA9FE57743B66.quest_subtitle: "&f5 &cSát thương"
	quest.485AFAE5BBEF2FC7.title: "Động vật"
	quest.4869C413646CC4CC.quest_desc: ["Việc truyền năng lượng từ các máy phát của bạn có lẽ là một ý tưởng tốt, nhưng làm thế nào để thực hiện?\n\n\n\nĐể bắt đầu, bạn có thể sử dụng cáp từ &9Mekanism&r, hoặc bạn có thể sử dụng &9Powah&r &cEnergy Cables&r nếu bạn đã bắt đầu sử dụng mod đó."]
	quest.488DBE69595F38F8.quest_desc: ["Máy này nung chảy các vật phẩm.\n\n\n\nNó có thể được nâng cấp thành Nhà máy Nung chảy, tăng tổng số khe nung lên tối đa 9."]
	quest.488DBE69595F38F8.quest_subtitle: "Lò Nung Điện của Mekanism"
	quest.489833A2A6C39151.quest_desc: ["Anh ta thô bạo, bạn có thể lấy nó, tôi không quan tâm.\n\n{image:atm:textures/questpics/iron_spells/spells_outfit_cryomancer.png width:60 height:100 align:center}"]
	quest.489833A2A6C39151.title: "&bBộ trang phục Cryomancecr"
	quest.48C68664319B0294.quest_desc: ["Để có được Cuốn sách Phép thuật đặc biệt này, bạn cần phải giết chết &4&lDead King&r! \n\n\n\nNó có 10 &3Khe phép&r nhưng 4 khe đã bị chiếm. &4Blood Slash&r, &4Blood Step&r, &4Ray of Siphoning&r, và &4Blaze Storm&r đã có sẵn trên đó và không thể tháo ra."]
	quest.48C68664319B0294.title: "Necronomicom"
	quest.48DC9E8E9D21A2FA.quest_desc: ["Mekanism cung cấp một số cách để tạo năng lượng bằng các tài nguyên tái tạo.\n\n\n\nCác &9Máy phát năng lượng Mặt trời&r tận dụng năng lượng của Mặt trời để đáp ứng nhu cầu năng lượng cơ bản. Nó không hoạt động vào ban đêm và phải có tầm nhìn trực tiếp lên bầu trời. Kính là được.\n\n\n\nCác &9Máy phát gió&r cung cấp năng lượng thông qua gió. Trừ khi bạn đã tìm ra cách để nhân vật của mình quay nó thủ công, tốc độ quay của nó dựa trên mức Y mà nó được đặt. Nó cũng cần có tầm nhìn trực tiếp lên bầu trời mà không có khối nào phía trên."]
	quest.48DC9E8E9D21A2FA.quest_subtitle: "Sức mạnh của Mặt Trời..."
	quest.48DC9E8E9D21A2FA.title: "&9Mekanism: &aNăng lượng tái tạo"
	quest.4933CF4675E77D50.quest_desc: ["Sau khi bạn nhận sát thương Lửa, &5Sọ Obsidian&r sẽ kích hoạt, cho bạn một khoảng thời gian Kháng Lửa. Hy vọng đủ lâu để thoát khỏi ngọn lửa!"]
	quest.4933CF4675E77D50.quest_subtitle: "Thắt lưng"
	quest.4933CF4675E77D50.title: "&5Sọ Obsidian&r"
	quest.49675EA8CBCA1388.quest_subtitle: "Công cụ Tất cả trong Một của Mekanism"
	quest.497D222F74A52DF5.quest_desc: ["Đây là thứ tôi thích! Sắt rất phổ biến và áo giáp sắt tuyệt vời cho giai đoạn đầu. \n\n\n\nZombie và Skeleton gần như không có cơ hội!"]
	quest.497D222F74A52DF5.quest_subtitle: "15"
	quest.49EDAA2F57D3BF1D.quest_desc: ["Nhiệm vụ này được tạo bởi &6Nhân viên AllTheMods&r, hoặc một &2Người đóng góp cộng đồng&r để sử dụng trong các Modpack AllTheMods. \n\n\n\nVì tất cả các pack &6AllTheMods&r được cấp phép theo &eMọi quyền được bảo lưu&r, Nhiệm vụ này không được phép sử dụng trong bất kỳ pack công khai nào không được phát hành bởi &6Đội ngũ AllTheMods&r mà không có sự cho phép rõ ràng. \n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.49F08DE190AAD0D8.quest_desc: ["&3Bổ trợ&r: Nhà máy làm cho Lò nung của bạn giống hệt Nhà máy Nung chảy từ Mekanism. Thay vì sử dụng Nhiên liệu, nó bây giờ sẽ sử dụng Năng lượng! Dẫn một ít Năng lượng vào và nó sẽ bắt đầu Nung chảy."]
	quest.49F08DE190AAD0D8.title: "&3Tăng cường&r: Nhà máy"
	quest.4A03A671757B2EBF.quest_desc: ["Độ bền, Mức chất lỏng, Mức năng lượng, Cấp độ phép thuật và Giá trị dinh dưỡng đều là các danh mục chúng ta có thể sử dụng với Bộ lọc Kiểm tra.\n\n\n\nSau đó chúng ta chọn nếu muốn nó Lớn hơn, Nhỏ hơn, Bằng nhau, hoặc kết hợp với Số lượng.\n\n\n\nTiếp theo chúng ta đặt Số lượng và bấm nút Cộng để thêm vào Bộ lọc.\n\n\n\nĐiều này có thể được dùng để chỉ giữ lại Công cụ có Độ bền cao hoặc Thực phẩm có Giá trị dinh dưỡng cao."]
	quest.4A079D40C0AF6BC3.quest_desc: ["Không, nó không được tìm thấy trong &5&lThe Beyond&r. \n\n\n\nBạn có thể tìm thấy &5Quặng Unobtainium&r rất hiếm ở Vùng đất cao của End. Những nơi này thường là nơi End Cities xuất hiện! \n\n\n\nBạn sẽ cần một &3Cuốc Vibranium&r (hoặc cùng Cấp) để Khai thác quặng. \n\n\n\nTôi có cần phải nói với bạn để Xử lý quặng không?\n\n{image:atm:textures/questpics/allthemodium/all_3.png width:100 height:100 align:center}"]
	quest.4A079D40C0AF6BC3.title: "&5Thỏi Unobtainium&r"
	quest.4A1C8125896F7F1A.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Nhân sự&r, hoặc một &2Người đóng góp cộng đồng&r để sử dụng trong AllTheMods Modpacks.\n\n\n\nVì tất cả các gói &6AllTheMods&r được cấp phép theo &eMọi quyền được bảo lưu&r, Nhiệm vụ này không được phép sử dụng trong bất kỳ gói công cộng nào không được phát hành bởi &6AllTheMods Đội ngũ&r mà không có sự cho phép rõ ràng.\n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.4A4C71C43519D5FE.quest_desc: ["Để triệu hồi boss của Nether, chúng ta cần thu thập một vài vật phẩm trước. \n\n\n\nChúng ta cần có ít nhất 3 &5Đầu Xương Wither&r. Những thứ này là vật rơi hiếm khi giết &7Wither Skeletons&r, hoặc có thể chế tạo từ vật rơi phổ biến hơn, &3Mảnh Đầu Wither&r. \n\n\n\nBạn cũng sẽ cần ít nhất 4 miếng Soul Sand, và có lẽ một số áo giáp khá tốt."]
	quest.4A4C71C43519D5FE.title: "&6Triệu Hồi &5Wither"
	quest.4A7AEBEB87CEC274.quest_desc: ["Tôi không nghĩ tôi có quyền sử dụng một thương hiệu cụ thể của &cGiày Chạy Bộ&r nên hãy dùng trí tưởng tượng của bạn về chúng là gì. \n\n\n\n&cGiày Chạy Bộ&r sẽ cho bạn Tăng Tốc khi Xé, vì vậy bạn sẽ nhanh hơn nữa khi Chạy! Cũng cung cấp nhảy tự động khi Xé..."]
	quest.4A7AEBEB87CEC274.quest_subtitle: "Chân"
	quest.4A7AEBEB87CEC274.title: "&cGiày Chạy Bộ&r"
	quest.4A854CD5EC70733E.quest_desc: ["Thêm giao diện bàn chế tạo vào ba lô."]
	quest.4A92237E17ED5F1C.quest_desc: ["Kho Void biến mọi kho đồ thành thùng rác. Đặt nó lên trên kho đồ và không còn item nào nữa!"]
	quest.4AB0DD227471FDBF.quest_desc: ["Chương này dành cho mọi thứ liên quan đến năng lượng!\n\n\n\nTại đây bạn sẽ tìm thấy các cách cơ bản để tạo, lưu trữ và truyền năng lượng."]
	quest.4AB0DD227471FDBF.quest_subtitle: "Tất Cả Năng Lượng!"
	quest.4AB0DD227471FDBF.title: "§cNăng Lượng Cơ Bản"
	quest.4ABF0727AA569DD9.quest_desc: ["Để cung cấp nhiên liệu cho Lò phản ứng nhiệt hạch, chúng ta cần tạo hai loại khí khác nhau, loại này là §cĐơteri§r.\n\n\n\nĐể làm được điều này, chúng ta cần tạo một số bơm điện và lắp cho chúng Bộ lọc Nâng cấp. Đặt chúng lên một khối nguồn nước, cấp cho chúng một ít năng lượng, và chúng sẽ bơm ra §5Nước Nặng§r.\n\n\n\nBơm Nước Nặng vào Máy tách điện ly để thu được §cĐơteri§r."]
	quest.4ABF0727AA569DD9.title: "Cung cấp nhiên liệu cho Lò phản ứng: §cĐơteri"
	quest.4AFF81D3D0E78255.quest_desc: ["Máy này cần nước để vận hành, và sử dụng nước để làm sạch \"Bùn Quặng\" thành \"Bùn Quặng Sạch\".\n\n\n\nNó sẽ là phần 2 của Nhà máy Chế biến Quặng Cấp 4 của bạn."]
	quest.4AFF81D3D0E78255.quest_subtitle: "Cho Quặng Một Bữa Tắm"
	quest.4B2146C9527C54E7.quest_desc: ["Rõ ràng bây giờ bạn đang ở Chương 2, bạn đã đánh bại §2§lMinecraft Gốc§r!\n\n\n\nĐến lúc này bạn nên có §5Netherite§r và đã giết tất cả các boss mà §2§lMinecraft§r có. Vậy tiếp theo là gì?\n\n\n\n§6§lAllthemodium§r là tiếp theo! Để bắt đầu lấy §6Allthemodium§r, bạn sẽ cần §5Netherite§r. Hãy bắt đầu từ đó!"]
	quest.4B2146C9527C54E7.title: "&6&lAllthemodium"
	quest.4B62AF0405F68041.quest_desc: ["Thêm một bộ lọc cho phép bạn chỉ định Balo nên giữ những vật phẩm nào. Shift + chuột phải vào kho sẽ tự động đổ đầy."]
	quest.4B62AF0405F68041.quest_subtitle: "Đã lưu trữ đủ"
	quest.4B65100885AE762D.quest_desc: ["&e&lPhép thuật Sắt&r &6Áo giáp Thánh&r!"]
	quest.4B65100885AE762D.quest_subtitle: "20"
	quest.4B65100885AE762D.title: "&6Trang phục Linh mục"
	quest.4B76FE0348DB0E45.quest_desc: ["Quantum Bridge Card là một phương pháp thay thế để có được truy cập không dây xuyên chiều kích vào hệ thống Applied Energistics của bạn. Bạn sẽ cần một Quantum Bridge được kết nối tại căn cứ và một Quantum Bridge Card trong terminal của bạn. Các đường hầm này sau đó được liên kết với nhau bằng một Quantum Entangled Singularity để có thể truy cập ở bất cứ đâu bạn đi."]
	quest.4B9C54DA5CB6D5C9.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_host.png width:100 height:150 align:center}"]
	quest.4B9C54DA5CB6D5C9.quest_subtitle: "Hoang tàn Lối mòn"
	quest.4B9C54DA5CB6D5C9.title: "Trang trí áo giáp Host"
	quest.4BDE773C3359D584.quest_subtitle: "Một Robot Mini Đồng Hành Cùng Bạn Trong Chuyến Đi"
	quest.4BF0BB763BFFACF0.quest_desc: ["Có thể nói, tài nguyên quan trọng tiếp theo bạn cần là &eFluix&f, được sử dụng trong hầu hết các thiết bị AE2 và đóng vai trò là nguyên liệu cơ bản để chế tạo mọi cáp trong mạng ME.\n\n\n\nBạn thường sẽ muốn sản xuất số lượng lớn chúng, và cách làm là tạo ra một &bTinh thể Fluix&f bằng cách ném &eQuặng Nether&f, &e&ođược nạp điện&r&e Certus quartz&r và &eĐá đỏ&f cùng vào một vũng nước. Điều này sẽ cho bạn một &eTinh thể Fluix&r mà bạn có thể biến thành bụi trong một Máy khắc."]
	quest.4BF0BB763BFFACF0.title: "Fluix"
	quest.4C0BDD483CCB40C4.title: "&bRương kim cương&f"
	quest.4C0EAB9F795686D0.quest_subtitle: "Thêm Tùy Chọn Lọc"
	quest.4C0EAB9F795686D0.title: "&eNâng Cấp Kho Chứa Nâng Cao&f"
	quest.4C2A60FC1F1E0328.quest_desc: ["Thêm một viên pin vào Ba-lô."]
	quest.4C366515E3CCB0B2.quest_desc: ["Thịt qua ống, ngon quá."]
	quest.4C873491F6F0FFAF.quest_desc: ["Sử dụng &dSpiritfire&r, chúng ta có thể chuyển đổi một số vật liệu Overworld thành biến thể Otherworld của chúng. Bạn cũng có thể tìm thấy một số vật liệu Otherworld bằng cách chịu tác động của &bCon mắt thứ ba&r và phiêu lưu vào thế giới. Bạn có thể ngạc nhiên với những gì bạn tìm thấy. Để dễ dàng hơn, có các công thức chế tạo cho vật liệu cơ bản bằng cách ném chúng vào &dSpiritfire&r.\n\n\n\n&bAndesite&r chuyển thành &3Otherstone&r, có thể được dùng để thắp sáng một &dSpiritfire&r vĩnh cửu.\n\n\n\n&aCây non sồi&r chuyển thành &9Cây non sồi&r nhưng chúng không giống nhau. Khi trưởng thành, chúng sẽ trông giống hệt một cây sồi thông thường. Tuy nhiên, dưới tác động của &bCon mắt thứ ba&r, bạn sẽ có thể thu hoạch biến thể Otherworld.\n\n\n\nNếu bạn gặp khó khăn trong việc thu thập các khúc gỗ (nếu chúng biến thành khúc gỗ sồi thông thường ngay cả khi có &bCon mắt thứ ba&r), hãy thử thu thập chúng từ phía trên.\n\n\n\n&eKim cương&r sẽ biến thành &dNgọc linh hồn&r được dùng trong một số công thức chúng ta sẽ cần sau này."]
	quest.4C873491F6F0FFAF.title: "&dChuyển Đổi Bằng Spiritfire&r"
	quest.4C8C56F960D92E9D.quest_subtitle: "&f51 &cSát thương"
	quest.4CC963F5AECF285A.quest_desc: ["Bình thường Router di chuyển 1 vật phẩm mỗi xung của nó. Điều này có thể được nhân đôi và chồng! với Nâng cấp Chồng. \n\n\n\n1 Nâng cấp Chồng là 2 Vật phẩm, 2 Chồng là 4 Vật phẩm, và 6 Chồng là 64 Vật phẩm một giây."]
	quest.4CCA1E2AAA9AB9D9.quest_desc: ["Khi nào cái này sẽ được thêm vào Mod?\n\n{image:atm:textures/questpics/iron_spells/spells_outfit_electromancer.png width:50 height:100 align:center}"]
	quest.4CCA1E2AAA9AB9D9.title: "&5Trang phục Điện Ảnh Thuật Sư"
	quest.4CE571F942461909.quest_desc: ["Túi Nghi Lễ rất tiện, nhưng mất rất nhiều thời gian để đặt tất cả các khối. Bây giờ bạn có thể thực hiện nghi lễ &cGiam Cầm Vĩnh Viễn của Sevira&r, bạn có thể tạo ra Túi Nghi Lễ Thủ Công!\n\n\n\nTúi Nghi Lễ Thủ Công hoạt động gần như giống hệt Túi Nghi Lễ thông thường, ngoại trừ nó lập tức đặt tất cả các vật phẩm cần thiết cho nghi lễ, và có thêm khả năng nhấp chuột phải vào Bát Vàng để xóa tất cả Ký hiệu Phấn và thu thập tất cả các vật phẩm khác (Sọ, Nến và Tinh Thể) và trả chúng vào Túi.\n\n\n\nKhông, nó không khôi phục độ bền của Phấn."]
	quest.4CE571F942461909.title: "Dụng cụ Của Nghề: Túi Nghi Lễ Thủ Công"
	quest.4D07B0A4A2E77CDA.quest_desc: ["Số lượng thực thể tối đa là số lượng quái vật có thể được sinh ra bởi máy sinh quái và giữ lại. Nếu nó chỉ là 6 thực thể tối đa khi 6 quái vật đã được sinh ra thì sẽ không sinh thêm cho đến khi chúng chết hoặc di chuyển. Mỗi Nước mắt Ghast làm tăng hoặc giảm 2 Thực thể. Tối đa 16 Thực thể và Tối thiểu 1."]
	quest.4D07B0A4A2E77CDA.title: "Số lượng thực thể tối đa"
	quest.4D3379D38237F830.quest_desc: ["Khi đeo &bnhững thứ này&r ở Chân bạn có thể thực hiện một phép lạ! Đi trên &9Nước&r! \n\n\n\nThực ra là chạy trên &9Nước&r, bạn phải đang Chạy nước rút để có thể chạy qua &9Nước&r. Khi bạn dừng Chạy nước rút bạn sẽ bắt đầu Chìm."]
	quest.4D3379D38237F830.quest_subtitle: "Chân"
	quest.4D3379D38237F830.title: "&bAqua-Dashers&r"
	quest.4D7D4C718837BCA5.quest_desc: ["Phần chính trong công thức chế tạo Miniature Nether Portal là &3Kệ Địa Ngục Tầm Nhìn Bậc Thầy&r. Thông thường nó được dùng để xem bạn sẽ nhận được phép thuật nào, nhưng chúng ta ở đây vì &6&lATM Star&r chứ không phải vì phép thuật.\n\n\n\nBạn chỉ cần enchant lên &4Kệ Địa Ngục Được Thổi Ông&r, có thể lấy từ vài cái Kệ thôi. Sau đó bạn cần chế tạo với nó để nâng cấp nó thêm nữa!\n\n\n\nSau đó bạn có thể chế tạo Miniature Nether Portal, nhưng không, bạn không thể đi qua vì bạn quá lớn!"]
	quest.4DB5DD6E20619B4D.quest_desc: ["Dùng để làm máy móc tốt hơn."]
	quest.4DE1158931F84F22.quest_desc: ["Khi bạn đã có Cuốc cấp Sắt hoặc tốt hơn, bạn sẽ có thể khai thác &cRedstone&r. \n\n\n\nRedstone bắt đầu hành trình của bạn vào nhiều mod kỹ thuật, như tạo năng lượng hoặc làm các thiết bị kỹ thuật xinh xắn. \n\n\n\nĐây là tài nguyên bạn sẽ muốn rất nhiều!"]
	quest.4DE1158931F84F22.title: "&cRedstone&r"
	quest.4DF0D7B85065ADC9.quest_subtitle: "Chém và chặt!"
	quest.4DF0D7B85065ADC9.title: "Dụng cụ nghề nghiệp: Dao Thịt"
	quest.4DF683461225690F.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_iron.png width:100 height:150 align:center}"]
	quest.4DF683461225690F.title: "&7Sắt&r"
	quest.4E28B67554CBDAB7.quest_desc: ["Xếp thứ hai về sát thương trong tất cả các Kiếm. Kiếm xếp đầu về sát thương có sát thương Vô Hạn, và không có gì có thể cạnh tranh với Vô Hạn."]
	quest.4E28B67554CBDAB7.title: "§6Allthemodium §5Hợp kim §3Kiếm"
	quest.4E3355FDCB65BB63.quest_desc: ["§aEvoker§r được biết đến là một Miniboss mạnh mẽ và nguy hiểm của Minecraft. Tất nhiên, §lIron§r đã thêm một phiên bản còn mạnh hơn và nguy hiểm hơn! Và đúng vậy, §eBook§r này là một vật rơi hiếm từ cả hai! \n\n\n\nNó có 10 ô phép nhưng 3 đã bị chiếm. §aFang Strike§r, §aFang Ward§r, và §aVex Swarm§r đều đi kèm với §eBook§r và không thể di chuyển. \n\n\n\nNgoài ra còn tăng cường §a§lTriệu hồi§r!"]
	quest.4E3355FDCB65BB63.title: "§aSách phép Triệu hồi"
	quest.4E5238F00CEED8B2.quest_desc: ["Luyện kim quặng thô ngay từ đầu là cần thiết, nhưng bạn đang bỏ lỡ nguồn tài nguyên dư thừa!\n\n\n\nCó một số cách để nhân đôi sản lượng từ mỗi quặng thô, nhưng một trong những cách dễ nhất là tạo và sử dụng một §eOre Hammer§r.\n\n\n\nChúng sẽ phân hủy 1 quặng thô thành 2 bụi, có thể được luyện thành phôi, hiệu quả nhân đôi sản lượng phôi của bạn!\n\n\n\nMuốn nhiều hơn từ mỗi quặng thô? Hãy xem mod §5Occultism§r!"]
	quest.4E5238F00CEED8B2.title: "§eNhân đôi quặng cơ bản"
	quest.4E737C490DCC5D6C.quest_desc: ["Áo giáp cơ bản tốt nhất bạn có thể có!\n\n\n\nSẽ cần để chế tạo Mekasuit, mặc dù nó tốt hơn!\n\n{image:atm:textures/questpics/allthemodium/all_armor_uno.png width:100 height:175 align:center}"]
	quest.4E737C490DCC5D6C.title: "§5Áo giáp Unobtainium"
	quest.4E82E843737045D9.quest_desc: [""]
	quest.4E82E843737045D9.quest_subtitle: "§oTinh hoa của những sinh vật mạnh mẽ nhất."
	quest.4E82E843737045D9.title: "§d§lHồn rồng"
	quest.4E895C54651A3CB3.quest_desc: ["§8Sách phép§r là §7Sách§r... chỉ là §7Sách§r hữu ích hơn!\n\n\n\nMỗi §8Sách phép§r được chế tạo với §7Sách§r, §7Gậy§r, §cBlaze Rods§r và §cBột§r.\n\n\n\n§8Sách phép§r có thể được §5thêm phép§r, như §7Vật phẩm§r, để có được §5phép§r nhất định.\n\n\n\nCòn có §8Tomes of Scrapping§r có thể được dùng trong §7Anvil§r để lấy §5phép§r khỏi §7Vật phẩm§r."]
	quest.4E895C54651A3CB3.title: "&8&lSách"
	quest.4E8A05C3BFA80540.quest_desc: ["Có thể nói khía cạnh quan trọng nhất của Applied Energistics 2 là hệ thống lưu trữ của nó, sử dụng các &eStorage Cells&f kỹ thuật số. Các cell này có thể truy cập thông qua một &eME Chest&r cho cell đơn lẻ, hoặc một &eME Drive&r cho nhiều cell.\n\n\n\n&bME Chest&f giữ một cell tại một thời điểm, có thể được đọc và ghi từ bất kỳ terminal nào khác trên cùng mạng. ME Chest cũng cung cấp màn hình terminal riêng ở phía trên với quyền truy cập chỉ dành cho cell chứa bên trong.\n\n\n\n&bME Drive&f có thể chứa tới 10 Storage Cells khác nhau trong không gian của một block và một kênh ME. Tuy nhiên, nó không cung cấp màn hình terminal riêng, đòi hỏi một terminal bên ngoài nào đó khác trên mạng để truy cập lưu trữ."]
	quest.4E8A05C3BFA80540.quest_subtitle: "Vật phẩm như hệ thống tệp"
	quest.4E8A05C3BFA80540.title: "Kho lưu trữ"
	quest.4EAFE7B240AF0A4D.quest_desc: ["Không thể với tới thứ bạn cần? Hãy thử Ranging Up! \n\n\n\nVới cái này mọi thứ sẽ thực hiện hành động nhưng xa hơn. Vacuum có phạm vi cao hơn để nhặt vật phẩm. Năng lượng đi xa hơn. Flinger ném mạnh hơn!"]
	quest.4EDD96EB60EF5814.quest_desc: ["Nếu bạn đang tự hỏi liệu có nên nâng cấp cái này không, câu trả lời là có.\n\n\n\nPhiên bản này có thể được dùng để thêm nhiệt vào Thermal Evaporation Plants."]
	quest.4EDD96EB60EF5814.quest_subtitle: "Tạo ra khoảng 410FE/t"
	quest.4F1C04C0F6769825.quest_desc: ["Máy này là bước tiếp theo cho nhà máy chế biến quặng của bạn. Thêm máy này vào bên trái Purification Chamber để xây dựng thêm cho nhà máy quặng hiện tại của bạn!\n\n\n\nMáy này yêu cầu &aHydrogen Chloride&r để vận hành. Để tìm cách tạo Hydrogen Chloride, hãy làm theo nhiệm vụ phía trên!"]
	quest.4F1C04C0F6769825.quest_subtitle: "Chuyển 3 Quặng thô thành 8 Mảnh quặng"
	quest.4F1FFC02F4EAA2E6.title: "Cấp: &4Nitro"
	quest.4F35D04721DFC9FF.quest_desc: ["Loại nghi lễ đầu tiên chúng ta sẽ thực hiện là &9Nghi lễ Triệu hồi&r. Những nghi lễ này được dùng để triệu hồi các loại Quỷ hữu ích khác nhau để hỗ trợ bạn trong việc nghiền nát, luyện kim, và hơn thế nữa khi bạn đạt đến các cấp độ nghi lễ cao hơn.\n\n\n\nĐối với nghi lễ đầu tiên, chúng ta muốn triệu hồi một Quỷ &aFoliot Crusher&r. Quỷ này sẽ nghiền nát đồ vật cho chúng ta, điều mà chúng ta cần để chế tạo một số loại Phấn (Chalk) cấp cao hơn!\n\n\n\nĐể bắt đầu, kết hợp Sách Chưa Ràng Buộc (Unbound Book) của bạn với &aTừ điển Linh hồn&r (Dictionary of Spirits) trong lưới chế tạo. Điều này sẽ ràng buộc một Quỷ vào Sách, đó là thứ chúng ta cần cho nghi lễ.\n\n\n\nNói về Từ điển Linh hồn của bạn, đã đến lúc mở nó ra! Ở bên trái, nhấp vào tab &dPentacles&r và nhấp vào &bVòng tròn Aviar&r. Bạn có thể phải đọc một chút để mở khóa nó. Cũng có cách nhấp \\"Đánh dấu Tất cả Đã Đọc\\" để mở khóa mọi thứ trong Sách.\n\n\n\nĐây là thứ chúng ta sẽ dùng để triệu hồi bạn mới. Ở phía bên phải, bạn có thể nhấp vào biểu tượng mắt ở góc dưới bên trái của hình ảnh để xây dựng đường nét nghi lễ cho bạn trong thế giới. Điều này rất hữu ích!\n\n\n\nKhi bạn đã hoàn thành nghi lễ nhiều khối, đặt 4 (hoặc nhiều hơn cho các nghi lễ sau) Cái bát hiến tế (Sacrificial Bowls) ở bất kỳ đâu trong bán kính ngang 8 khối từ Cái bát hiến tế trung tâm và sử dụng các vật phẩm cần thiết trên chúng. Khi bạn đặt Sách Đã Ràng Buộc (Bound Book) vào Cái bát hiến tế Vàng, nghi lễ sẽ bắt đầu!\n\n\n\nĐây là hình dạng của nghi lễ.\n\n\n\n{image:atm:textures/questpics/occultism/aviarcircle_v2.png width:200 height:200 align:1}"]
	quest.4F35D04721DFC9FF.quest_subtitle: "Vòng tròn Aviar"
	quest.4F35D04721DFC9FF.title: "&bNghi lễ Đầu tiên &dcủa chúng ta"
	quest.4F436770D30D8520.quest_desc: ["Chúng ta sẽ cần thêm 3 máy vào cấu hình hiện tại.\n\n\n\nPhần đầu tiên của quy trình là Buồng Hòa tan Hóa học (Chemical Dissolution Chamber).\n\n\n\nMáy này yêu cầu &aAxit Sunfuric&r để phá vỡ quặng thô thành \"Bùn Quặng\" (Ore Slurry).\n\n\n\nĐể có Axit Sunfuric, chúng ta sẽ cần một cấu hình mới, được giải thích thêm trong các nhiệm vụ tiếp theo."]
	quest.4F436770D30D8520.title: "Sự Khởi đầu của Nhà Máy Quặng Cấp 4"
	quest.4F7F8F4ED1CA0550.quest_desc: ["Một Lửa trại (Campfire) được dùng trên máy sinh quái sẽ khiến quái sinh ra đang bốc cháy. Hoàn hảo cho một miếng Bít tết (Steak) ngon."]
	quest.4F7F8F4ED1CA0550.title: "Cháy"
	quest.4FA5192164E4A427.quest_desc: ["Chất lỏng (Fluid) không chất chồng như Đồ vật (Items), vì vậy nâng cấp của nó hơi khác. Vẫn di chuyển nhiều hơn chỉ với tốc độ khác."]
	quest.501A0AEEC73C0790.quest_desc: ["&6Piglich&r là một Trùm được thêm bởi &6&lAllthemodium&r, sống trong Kim Tự tháp Cổ xưa ở &l&bThe Other&r.\n\n\n\nKhi chết, hắn sẽ rơi 1 Trái tim của hắn! Bạn sẽ cần giết 9 con để chế tạo một Khối của nó...\n\n\n\nMay mắn thay, có cách để canh tác chúng!"]
	quest.501A0AEEC73C0790.title: "&6Khối Trái tim Piglich"
	quest.5034A9137E0F3D3D.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2Người đóng góp cộng đồng&r để sử dụng trong các Modpack AllTheMods.\n\n\n\nVì tất cả các pack &6AllTheMods&r được cấp phép theo &eAll Rights Reserved&r, nhiệm vụ này không được phép sử dụng trong bất kỳ pack công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng.\n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.5040B3D29F238BC0.quest_desc: ["Thỏ, nhảy. Thỏ, nhảy. Thỏ, nhảy.\n\n\n\nKhi đeo &dBunny Hoppers&r, bạn có thể nhảy cao gấp đôi và nhận một nửa sát thương từ rơi so với bình thường! Nó không làm bạn bất khả xâm phạm với Sát thương từ rơi, bạn vẫn có thể chết, chỉ là khó hơn."]
	quest.5040B3D29F238BC0.quest_subtitle: "Chân"
	quest.5040B3D29F238BC0.title: "&dBunny Hoppers&r"
	quest.5047792C6EF6D2AD.quest_desc: ["Khi Bio Fuel kết hợp với Water và Hydrogen trong một &aPressurized Reaction Chamber&r, nó tạo ra Substrates. Nó cũng tạo ra Ethylene như một sản phẩm phụ.\n\n\n\nChúng được cần để tạo HDPE pellets, được dùng cho các craft cuối game như Meka-suit."]
	quest.50A32AC6EDBC5854.quest_desc: ["Đồ ăn một mình có thể khá nhàm chán, nhưng nó trở nên tốt hơn nhiều khi bạn có một món ăn kèm! Cụ thể hơn là một ít (một) &6Onion Ring&r!\n\n\n\nKhi đeo &6Onion Ring&r, mọi thứ bạn ăn sẽ cho bạn một chút Tăng Tốc."]
	quest.50A32AC6EDBC5854.quest_subtitle: "Tay"
	quest.50A32AC6EDBC5854.title: "&6Onion Ring&r"
	quest.511562EA5811306B.title: "Cần Câu Kim Cương"
	quest.51236544BFEF487B.quest_desc: ["Đã đến lúc tìm &eMeteorites&f chứa &bSky Stone&f. Chúng có thể ở trên mặt đất hoặc dưới lòng đất, và chứa một &bMysterious Cube&f ở trung tâm.\n\n\n\nKhối này chứa tất cả các &ePresses&f khác nhau được dùng trong Inscriber để tạo các thành phần chế tạo đặc biệt của AE2.\n\n\n\nCách dễ nhất để định vị một meteorite là chế tạo một &eMeteorite Compass&r bằng cách đặt một la bàn vào bên trong Charger."]
	quest.51236544BFEF487B.quest_subtitle: "'Truyện tranh #42: tìm kiếm 4 bobby [Fischer]'"
	quest.51236544BFEF487B.title: "Săn thiên thạch"
	quest.512396B331108BAF.quest_subtitle: "Cấp: &e5"
	quest.5151CDD8FCDE7A07.quest_desc: ["Chào mừng đến với Công cụ Cơ bản!\n\n\n\nBạn đã bao giờ có một công cụ mà bạn chưa từng thấy hay nghe thấy và muốn biết nó nằm ở đâu giữa các công cụ khác? Khi đó, những nhiệm vụ này hoàn hảo cho bạn!\n\n\n\n(Các thanh kiếm được sắp xếp theo sát thương cơ bản, các thanh kiếm có thể nâng cấp hoặc dùng để tăng sát thương không được bao gồm).\n\n\n\nCác nhiệm vụ cho tất cả các cuốc và thanh kiếm là TÙY CHỌN!"]
	quest.5151CDD8FCDE7A07.quest_subtitle: "Tất cả Công cụ"
	quest.5151CDD8FCDE7A07.title: "Công cụ Cơ bản!"
	quest.516E66BE01EE5B31.quest_desc: ["&8Tomes of Weaponry&r sẽ cung cấp &5phép thuật&r cho Kiếm và Rìu. \n\n\n\nChủ yếu là những phép thuật giúp giết chết mục tiêu! Như &5Sharpness &f và &5Fire Aspect&r. \n\n&8Tomes of Archery&r sẽ cung cấp &5phép thuật&r cho vũ khí tầm xa, cung và nỏ. \n\n\n\n&5Piercing&f, &5Power&f, và &5Knockback&r!"]
	quest.516E66BE01EE5B31.title: "&8Weapon Tomes"
	quest.51A57E142C686C8F.quest_desc: ["Cấp MEGA thứ năm và cuối cùng của thành phần lưu trữ, cung cấp &e268435456&f (262144k) byte lưu trữ."]
	quest.51A57E142C686C8F.quest_subtitle: "x4^4"
	quest.51A57E142C686C8F.title: "Thành phần Lưu trữ 256M"
	quest.51DBE688ED630DB1.quest_subtitle: "Cấp: &54"
	quest.51DE3157DE3E57B8.quest_desc: ["Việc lưu trữ thì tốt và hữu ích, nhưng hệ thống lưu trữ sẽ có ích gì nếu nó bị tắc nghẽn bởi nguyên liệu thô cần được chế tạo và xử lý thành sản phẩm, trong khi bạn vẫn phải tự tay làm tất cả? \n\n\n\nHệ thống &etự động chế tạo&f của AE2 bắt đầu bằng &bME Pattern Provider&f. Pattern Provider giữ các item gọi là &bPatterns&f (được đề cập trong nhiệm vụ tiếp theo) được lập trình để giữ một công thức nào đó biến đầu vào thành đầu ra cụ thể. Lên đến 9 pattern có thể xếp vào một provider. \n\n\n\nBạn thường sẽ sử dụng nhiều pattern provider rải rác khắp căn cứ, đó là lý do tại sao hữu ích khi có &bPattern Access Terminal&f để truy cập từ xa nội dung của tất cả các provider trên mạng ME rộng lớn của bạn."]
	quest.51DE3157DE3E57B8.quest_subtitle: "Đặt hàng"
	quest.51DE3157DE3E57B8.title: "Tự động chế tạo"
	quest.51E554305FFEBA1D.quest_desc: ["Bằng cách kết hợp &4Infused Hellshelf&r với một ít &eGlowstone&r chúng ta có thể tạo ra &4Glowing Hellshelves&r! \n\n\n\nChúng có cùng &aEterna&r và &cQuanta&r, nhưng cho &53% Arcana&r. \n\n\n\nĐiều này sẽ hữu ích trong các &d&lHòa trộn&r sau này, như nếu chúng ta muốn dùng 12 cái để &d&lHòa trộn&r một &9Dormant Deepshelf&f thành &9Deepshelf&r!"]
	quest.51E554305FFEBA1D.title: "&4Blazing Hellshelf"
	quest.5233A447BAA4593C.quest_desc: ["&bME Smart Cable&f và &bDense Smart Cable&f hoạt động giống hệt các cáp có vỏ bọc về việc phân phối kênh, nhưng cũng sẽ hiển thị rõ ràng số lượng kênh chúng đang sử dụng dưới dạng các đường màu dọc theo chính nó."]
	quest.5233A447BAA4593C.quest_subtitle: "'S.M.R.T.'"
	quest.5233A447BAA4593C.title: "Cáp Nâng Cao"
	quest.523853C1C4E688BA.quest_desc: ["Thành phần lưu trữ cấp bốn, cung cấp &e65536&f byte dung lượng."]
	quest.523853C1C4E688BA.quest_subtitle: "x4^3"
	quest.523853C1C4E688BA.title: "Thành phần lưu trữ 64k"
	quest.523DC411241B470A.quest_desc: ["Tất cả &5Phép thuật&r từ &5Bàn phép thuật&r được xác định bởi Cấp độ của &aEterna&r, &cQuanta&r, và &5Arcana&r. \n\n\n\nChúng ta có thể thấy Nhóm &5Phép thuật&r có sẵn bằng cách nhấn ? ở Góc trên bên phải của Giao diện &5Bàn phép thuật&r khi một Đồ vật đang được &5Phép thuật&r. \n\n\n\nCàng cao &cQuanta&r, càng có cơ hội nhận được một &5Phép thuật&r tồi tệ hơn. Như những thứ như &5Nguyền rủa biến mất &và &5Ràng buộc&r! \n\n\n\nVới &6Kệ sách trong Đá Geode Ổn định&r nó sẽ loại bỏ cơ hội tăng lên của những &5Phép thuật&r tồi tệ. \n\n\n\nBạn vẫn có thể nhận được &cNguyền rủa&r với nó, chỉ là với tỷ lệ thấp hơn nhiều!\n\n{@pagebreak}\n\nĐể Chế tạo nó, chúng ta sẽ cần một &7Kệ sách&r, 7 Calcite, và 1 &5Amethyst đang nảy mầm&r. \n\n\n\n&5Amethyst đang nảy mầm&r không thể thu thập từ Khai thác, ngay cả với &5Silk Touch&r. Bạn sẽ cần một Nghi lễ hoặc Infusion để lấy được nó!"]
	quest.523DC411241B470A.title: "&6Loại bỏ Phép thuật Tiêu cực"
	quest.525F25F4ADE45B50.quest_desc: ["&bME Formation Plane&f hoạt động tương tự như Bus lưu trữ, nhưng coi cả thế giới là phương tiện lưu trữ của nó. Nói cách khác, nó sẽ đặt bất kỳ khối nào trong bộ lọc của nó ngay phía trước nó. \n\n\n\nĐiều này có thể hữu ích trong các tình huống mà một khối có thể được xử lý chỉ bằng cách đặt nó và phá nó bằng một công cụ nhất định."]
	quest.525F25F4ADE45B50.quest_subtitle: "RA ĐI"
	quest.52672B7FFFD51D16.quest_desc: ["Thêm giao diện Máy cắt đá vào Ba lô."]
	quest.52E59FCB39D66BCF.quest_desc: ["Một trong những lựa chọn tốt nhất cho \"Nguồn Động lực Thụ động\", &9Máy phát nhiệt&r sẽ tạo ra FE khi được đặt trên một &cNguồn Nhiệt&r và được cung cấp nước ổn định.\n\n\n\nHiện tại có 3 khối bạn có thể đặt nó lên: một khối Magma tạo ra ít nhất, một khối nguồn dung nham tốt hơn một chút, hoặc một &cKhối Pha lê Rực lửa&r, cung cấp nhiều nhiệt nhất."]
	quest.5316DF321B45D2CA.quest_desc: ["Chào mừng đến với &dOccultism&r!\n\n\n\nMod này nhằm mục đích giúp người chơi theo nhiều cách khác nhau bằng cách tuyển dụng sự giúp đỡ của &c&mQuỷ&r &bLin hồn&r! Đừng lo, hầu hết chúng đều thân thiện. &oHầu hết&r.\n\n\n\nĐể bắt đầu, bạn sẽ cần lấy một ít &aHạt giống Trái cái của Quỷ&r."]
	quest.5316DF321B45D2CA.title: "&dMơ về &cQuỷ"
	quest.531E3FF1F2865C67.quest_subtitle: "Để Truyền Nhiệt"
	quest.538821E23E39BE97.quest_desc: ["&2Bổ sung&r: Hiệu quả Nhiên liệu dành cho tất cả những người yêu Trái Đất, ôm cây, ủng hộ Captain Planet và hippie. Lò nung tiêu thụ một nửa lượng Nhiên liệu nhưng chỉ cần một nửa thời gian. Than sẽ không nung chảy 8 vật phẩm mà là 16!"]
	quest.538821E23E39BE97.title: "&2Bổ sung&r: Hiệu quả Nhiên liệu"
	quest.5391385A75535EC8.quest_desc: ["&e&lPhép thuật Sắt&r &2Áo giáp Thiên nhiên&r!"]
	quest.5391385A75535EC8.quest_subtitle: "20"
	quest.5391385A75535EC8.title: "&2Trang phục Dịch bệnh"
	quest.53A5F5E49EA8D5AF.quest_desc: ["Đây là một ví dụ hay về việc sử dụng Bộ định tuyến Mô-đun để tạo một Trang trại Quái vật dễ tổ chức. (Không bao gồm cách giết quái vật). \n\n\n\nĐể minh họa, tôi sẽ dùng Trang trại Xương Khô Wither làm ví dụ. \n\n\n\nĐầu tiên, bạn muốn đưa Vật phẩm vào Bộ đệm bằng Mô-đun Chân không. Tiếp theo, loại bỏ Thanh kiếm Đá bằng Mô-đun Hư không. Để đảm bảo nó không xóa mọi thứ, hãy sử dụng Bộ lọc Danh sách trắng với Thanh kiếm Đá trong đó và không khớp Sát thương. Sau đó, bạn sẽ cần một nơi để đặt Loot, tôi khuyên dùng Hệ thống Ngăn kéo. Sau đó, dùng Mô-đun Gửi để gửi Loot đến Hệ thống Lưu trữ. \n\n\n\nĐó là tất cả những gì bạn cần!\n\n{image:atm:textures/questpics/router/router_mob.png width:200 height:65 align:center}"]
	quest.53A5F5E49EA8D5AF.title: "Bộ định tuyến cho Trang trại Quái vật"
	quest.53B58FC3958750E7.quest_desc: ["Bạn có chơi với Bộ đặt quá nhiều và cần Phá những Khối đó không? \n\n\n\nCấp bậc và Phép thuật của nó được xác định bởi Cuốc dùng để Chế tạo. \n\n\n\nBây giờ hãy đặt vùng và hy vọng đặt một Bộ lọc rồi chạy! \n\n\n\nCó thể dùng với Bộ đặt để làm những việc như biển Quặng thành Vật phẩm."]
	quest.53DEA3DFEDC4809E.quest_desc: ["Đừng lo, đây là nghi lễ cuối cùng trong loạt nghi lễ Abras. Nó được dùng để triệu hồi quỷ &9Marid&r, nhưng mặc dù sử dụng Phấn Đỏ, nó không đủ mạnh để &9trói&r Quỷ. Điều này có nghĩa là, thật không may, bạn sẽ phải chiến đấu với nó.\n\n\n\nNghi lễ này sử dụng một Thương như một vật tế, điều này gây nhầm lẫn vì hầu hết các vật tế là sinh vật sống. Vì vậy, thay vì giết một sinh vật trên vòng tròn nghi lễ đã hoàn thành, bạn chỉ cần ném Thương vào bát ở trung tâm để bắt đầu nghi lễ."]
	quest.53DEA3DFEDC4809E.quest_subtitle: "Đó là Chim? Đó là Máy bay? Không, đó là một &9Marid&r chưa bị trói!"
	quest.53DEA3DFEDC4809E.title: "&4Thần Chú Củng Cố Của Abras"
	quest.53F861876B991C36.quest_desc: ["Thêm giao diện Máy hát vào Ba lô."]
	quest.53F861876B991C36.quest_subtitle: "Bây giờ chúng ta đang chơi nhạc"
	quest.540B857F043C24D5.quest_desc: ["Bioreactor sử dụng Biofuel được tạo từ Biofuel Generator để tạo ra FE."]
	quest.540B857F043C24D5.title: "Năng lượng Sinh học"
	quest.541446863A72B96C.title: "&7Mực Thông Thường&r"
	quest.54378277B8D28B1D.quest_desc: ["Một \"nâng cấp\" cho Phấn Cầu Vồng, dành cho những người không thích những ký hiệu nhanh chóng chuyển màu làm hỏng thẩm mỹ được tạo công sức.\n\n\n\nCó chức năng giống như Phấn Cầu Vồng, ngoại trừ tất cả các ký hiệu sẽ hiện lên màu trắng."]
	quest.544791880F315D5A.quest_desc: ["Thuyền có Rương là những chiếc thuyền có rương trên đó. Bạn có thể mở rương khi bạn đang ở trong Thuyền hoặc bạn có thể nhấp chuột phải vào nó. Chỉ một người có thể lái thuyền cùng một lúc."]
	quest.54822638CC243004.quest_desc: ["Cá nóc khá ngầu, tương tự với Guardians và Thorns! Mỗi sát thương gây ra khi đeo &9Reflecting Necklace&r sẽ tích lũy điểm. Sau 5 giây kể từ lần sát thương cuối hoặc khi điểm đầy, &9Reflecting Necklace&r sẽ bắn ra &5Obsidian Spikes&r theo mọi hướng, gây sát thương lên tất cả kẻ lân cận."]
	quest.54822638CC243004.quest_subtitle: "Có thể tìm thấy ở Cổng bị phá hủy, Pháo đài Nether và Bastions."
	quest.54822638CC243004.title: "&9Reflecting Necklace"
	quest.548F85EE6B6F1811.quest_desc: ["Giống như Piglins mà &2&lApotheocarist&r giống, hắn cũng Trung lập. Hắn không quan tâm đến &eGold&r như các Piglin khác, chỉ tấn công những ai đánh hắn. \n\n\n\nBạn có thể giao dịch với hắn: đưa cho hắn Emeralds hoặc Potion Ingrediants để lấy Potions, Potion Ingrediants, và &2Nature Scrolls&r. \n\n\n\nNếu bạn muốn giết hắn, hắn có 60 trái tim. Hắn sẽ tấn công bạn bằng Potions và &2Nature Spells&r. Khi bị thương, hắn sẽ cố hồi phục bằng Potions, (tôi nghĩ hắn thực sự thích Potions). \n\n\n\nKhi bị giết, hắn sẽ rơi Arcane Essence, Inks, &2Nature Runes&r, và &2Nature Scrolls&r!\n\n{image:atm:textures/questpics/iron_spells/spells_apotheocarist.png width:100 height:200 align:center}"]
	quest.548F85EE6B6F1811.title: "&2&lApothecarist"
	quest.54B1A876E9F6707A.quest_desc: [""]
	quest.54B1A876E9F6707A.quest_subtitle: "&oSức mạnh và sự hủy diệt vượt trội!"
	quest.54B1A876E9F6707A.title: "&5&lOblivion Shard"
	quest.54D3D6806C1F33F3.quest_subtitle: "&f5 &cSát thương tấn công"
	quest.54D8B9CB3F98040F.quest_desc: ["Hohlraum chứa đầy D-T Fuel? &oCheck!&r\n\n\n\nDeuterium và Tritium sẵn sàng được bơm vào Lò phản ứng? &oCheck!&r\n\n\n\nMột Laser Amplifier có ít nhất 400MRF sẵn sàng bắn vào Laser Focus Matrix? &oCheck!&r\n\n\n\nKhi bạn đã sẵn sàng, đặt &5Hohlraum&r vào &aFusion Reactor Controller&r, bơm nhiên liệu, sau đó kích hoạt Laser Amplifier của bạn.\n\n\n\nNếu làm đúng, &nbạn sẽ thấy Lò phản ứng kích hoạt!&r\n\n\n\n{image:atm:textures/questpics/mek/fusion_activated.png width:225 height:150 align:1}"]
	quest.54D8B9CB3F98040F.title: "&dTôi nghĩ chúng ta đã sẵn sàng"
	quest.55186B8602689B66.quest_desc: ["Thẻ nhớ &bMemory Card&f là một công cụ có hai chức năng khác nhau. Chức năng đơn giản nhất là lưu cấu hình của các thiết bị khác nhau (như bộ lọc whitelist) để sao chép sang thiết bị cùng loại khác.\n\n\n\nChức năng thứ hai của thẻ nhớ là liên kết các &eP2P tunnel&f với nhau. Khi làm vậy, P2P tunnel được liên kết sẽ được gán một ID duy nhất, được lưu trên thẻ nhớ để liên kết tiếp."]
	quest.551A4916F032ACCF.quest_desc: ["Lò rèn phép thuật có nhiều công dụng nhất trong các khối của &lIron Spells&r.\n\n\n\nBạn có thể kết hợp &3Spell&r cùng loại Mực để nâng cấp nó.\n\nNó có thể kết hợp &3Scroll&r thành Vũ khí để sử dụng cùng chúng, như một thanh Kiếm.\n\nBạn cũng có thể thiết lập Affinity cho Nhẫn bằng Upgrade Orbs, hoặc thêm Upgrade Orbs vào Vũ khí và Trang bị.\n\n{image:atm:textures/questpics/iron_spells/spells_anvil_gui.png width:100 height:100 align:center}"]
	quest.552F0B9B00F4F914.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2Community contributor&r để sử dụng trong AllTheMods Modpacks.\n\n\n\nVì tất cả các gói &6AllTheMods&r được cấp phép theo &eAll Rights Reserved&r, nhiệm vụ này không được phép sử dụng trong bất kỳ gói công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng.\n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.553220A2CD7CAFE4.quest_desc: ["Trong mùa Giáng sinh, tất cả các Rương trông như Quà tặng... nhưng các Lò nung thì lòi ra như ngón tay cáu! Bây giờ điều đó có thể thay đổi với Giấy bọc quà! Bạn có thể Nhấp Chuột Phải lên bất kỳ &lIron Furnace&r nào và nó sẽ sẵn sàng cho mùa lễ hội! Và sau khi mùa lễ hội kết thúc, bạn có thể Shift + Nhấp Chuột Phải để mở bọc!"]
	quest.553220A2CD7CAFE4.quest_subtitle: "Tất cả đã bọc"
	quest.553C44F85E508DE3.quest_desc: ["Cái này là duy nhất vì nó không chỉ dùng cho 1 Router mà cho nhiều Router.\n\n\n\nNếu bạn muốn nhiều Router hoạt động cùng lúc thì mỗi Router cần một Sync Upgrade.\n\n\n\nCần được điều chỉnh trong GUI riêng của nó."]
	quest.554F47A0AF7506EC.quest_subtitle: "59,049 Đá End"
	quest.555ED1E39131D91B.quest_desc: ["Bạn không nên bước vào &bTower&r, &b&lCryomancer&r không thích Người chơi, chúng thù địch với bạn.\n\n\n\n&b&lCryomancer&r sẽ ngay lập tức tấn công bạn bằng &bIce Spells&r. Thậm chí có thể sử dụng động vật chống lại bạn! Hy sinh động vật để thắng một trận chiến, hắn thật lạnh lùng!\n\n\n\nKhi bị giết, hắn sẽ rơi Arcane Essence, Inks, &bIce Runes&r, và &bIce Scrolls&r.\n\n{image:atm:textures/questpics/iron_spells/spells_cryomancer.png width:100 height:200 align:center}"]
	quest.555ED1E39131D91B.title: "&b&lCryomancer"
	quest.5560F303C452E110.quest_desc: ["Extruder đẩy khối và entity, tại sao không đẩy thêm nữa!\n\n\n\nCác entity, không phải khối."]
	quest.55820773BDD5319D.quest_desc: ["&bIndustrial Foregoing&r (IF viết tắt) là một mod công nghệ bổ sung nhiều máy móc với các công dụng khác nhau.\n\n\n\nĐể bắt đầu, chế tạo một &aPity Machine Frame&r."]
	quest.55820773BDD5319D.quest_subtitle: "Cấp: &a1"
	quest.55820773BDD5319D.title: "Industrial Foregoing"
	quest.55A9EB63F4964FCF.quest_subtitle: "&f7 &cSát thương tấn công"
	quest.55C4824DAD905512.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2cộng tác viên cộng đồng&r để sử dụng trong các modpack AllTheMods.\n\n\n\nVì tất cả các modpack &6AllTheMods&r được cấp phép theo &eAll Rights Reserved&r, nhiệm vụ này không được phép sử dụng trong bất kỳ modpack công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng.\n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.562BD37539EE318E.title: "Cấp: &cBlazing"
	quest.56B6ABF3D6EA0D84.quest_desc: ["Khi đã cắm Plug, chúng ta có thể sử dụng nguồn năng lượng từ mạng lưới. &9Flux Point&r làm chính xác điều đó. Nó dẫn nguồn năng lượng từ mạng lưới của bạn đến bất kỳ khối nào nó được gắn vào, bao gồm Pipes hoặc Cables, hoặc trực tiếp trên máy móc!\n\n\n\nKhi bạn đã đặt Point trên máy móc hoặc khối bạn muốn cấp năng lượng, nhấp chuột phải vào nó và chọn mạng lưới của bạn trong tab \"Network Selection\". Giống như Plug, bạn có thể điều chỉnh lượng năng lượng Point lấy, mức ưu tiên, v.v."]
	quest.56B6ABF3D6EA0D84.title: "Truy cập Nguồn năng lượng Mạng lưới"
	quest.56B80A7EBFE21428.quest_subtitle: "Thêm tùy chọn lọc"
	quest.56B80A7EBFE21428.title: "&eNâng cấp Bơm Nâng cao"
	quest.56EC79AF11B0869E.quest_desc: ["&9Xeovrenth Adjure&r là cấp độ cao nhất của &5Possession Rituals&r. Nó chỉ có hai công dụng: tạo ra Cruelty Essence, thành phần chính trong Brown Chalk, và tạo ra một Iesnium Golem, về cơ bản chỉ là Golem sắt bất tử và gây nhiều sát thương hơn."]
	quest.56EC79AF11B0869E.quest_subtitle: "Sở Hữu Tối Đa"
	quest.56EC79AF11B0869E.title: "&9Xeovrenth Adjure"
	quest.57282D7E31EE61EE.quest_desc: ["Khi bạn đã thu thập được một ít &aRaw Iesnium Ores&r, bạn có thể sẽ muốn dùng vài thanh đầu tiên để làm một &dIesnium Pickaxe&r. Điều này không chỉ khai thác Iesnium giống như Infused Pickaxe, mà còn bền hơn nhiều.\n\n\n\nHãy tự làm một cái cho mình!"]
	quest.57282D7E31EE61EE.title: "&aCuốc Thế Giới Khác&r"
	quest.57534FA0E09C4975.quest_desc: ["Đến lúc này, bạn đã đang sản xuất &aLithium&r. Bơm nó vào một Solar Neutron Activator để tạo ra &eTritium&r."]
	quest.57534FA0E09C4975.title: "Nhiên Liệu Cho Lò Phản Ứng: &eTritium"
	quest.5758645223B4B5BA.quest_desc: ["Với &3Aqua Walkers&r, bạn có thể sử dụng khả năng của nó để đi trên &9Water&r! Bạn có thể giữ Shift để chìm xuống &9Water&r và bơi lội. Tôi nghĩ tôi đã từng đọc về một câu chuyện như thế?"]
	quest.5758645223B4B5BA.quest_subtitle: "Tìm thấy trong Tàu Đắm và Đổ Nát Đại Dương"
	quest.5758645223B4B5BA.title: "&3Aqua Walkers"
	quest.57C4A0BAE739E903.quest_desc: ["Buồng Hòa Tan được dùng để chế tạo các máy móc tiên tiến hơn.\n\n\n\nBạn sẽ cần đổ một loại chất lỏng cụ thể vào cùng với các vật liệu cần thiết để chế tạo. Hãy kiểm tra JEI."]
	quest.57C4A0BAE739E903.quest_subtitle: "Bàn chế tạo?"
	quest.57CF8C6C867B9BDA.quest_subtitle: "Thêm tùy chọn lọc"
	quest.57CF8C6C867B9BDA.title: "&eNâng cấp bộ lọc nâng cao"
	quest.57F47BA495B27F83.quest_desc: ["&9Cấp 1&r Cấp độ khai thác là cấp độ cuốc thấp nhất, cần có một cuốc. Bất kỳ cuốc nào cũng có thể khai thác chúng. Các vật phẩm cấp 1 bao gồm Đá, Lò và Quặng Than."]
	quest.57F47BA495B27F83.title: "&9Cấp khai thác 1"
	quest.5831B3192C0E8C56.quest_desc: ["Bạn muốn truy cập kho từ xa? Điều này có thể thực hiện bằng &eWormhole Ổn định&r hoặc &aBộ truy cập kho&r.\n\n\n\nĐể sử dụng &eWormhole Ổn định&r, shift-click (nhấn giữ Shift và click) vào một &dBộ kích hoạt kho&r để liên kết. Sau đó bạn có thể đặt Wormhole để hoạt động như một vị trí kho khác.\n\n\n\n&Bộ truy cập kho&r được liên kết theo cách tương tự, nhưng hoạt động như một remote không dây thậm chí có thể hoạt động xuyên qua các chiều không gian!"]
	quest.5831B3192C0E8C56.title: "&aTruy cập từ xa"
	quest.58445E5B3957ACC8.title: "Đá phát sáng tinh chế"
	quest.58495CFBF4F20CE9.quest_desc: ["Nó hoạt động giống như bàn bếp, ngoại trừ là ở trong không khí.\n\n\n\nVà bạn không thể đặt vật gì lên trên nó."]
	quest.58495CFBF4F20CE9.quest_subtitle: "Nhiều không gian cho hoạt động!"
	quest.58495CFBF4F20CE9.title: "Kho chứa nhiều hơn nữa"
	quest.58514FDE153FD971.quest_subtitle: "Rương sắt?"
	quest.58514FDE153FD971.title: "&fRương sắt"
	quest.5865951E4F81C91F.quest_desc: ["&7Osmium&r + &6Đá phát sáng&r = &eGlowstone tinh chế&r!"]
	quest.5865951E4F81C91F.quest_subtitle: "20"
	quest.5865951E4F81C91F.title: "&eÁo giáp Glowstone tinh chế"
	quest.586D5DE28EEC8014.quest_desc: ["&cQuanta&r giúp trộn lẫn &5Kho phép thuật&r, làm cho việc có được nhiều &5phép thuật&r khác nhau dễ dàng hơn.\n\n\n\nTuy nhiên, &cQuanta&r có thể phản tác dụng, bạn càng có nhiều, &5phép thuật xấu&r càng trở nên phổ biến. &5Phép thuật xấu&r như &5Lời nguyền ràng buộc&r!\n\n\n\nTrước đây chúng ta dùng &eRectification&r, thay vào đó bây giờ chúng ta dùng &6Geode-Encased Bookshelves of Stability&r!\n\n\n\nMặc định &cQuanta&r là &c15%&r và tối đa là &c100%&r."]
	quest.586D5DE28EEC8014.title: "&cQuanta"
	quest.587A19FC348387C5.quest_desc: ["Kết hợp khí, vật thể rắn và chất lỏng để sản xuất một vật phẩm và sản phẩm phụ.\n\n\n\nMáy này cần thiết để tạo ra vật liệu và áo giáp cuối game."]
	quest.589F1D502F680075.quest_desc: ["Hoàn hảo cho các bữa tiệc bể bơi! \n\n\n\nNgoài việc trông dễ thương và vui nhộn, &dHelium Flamingo&r cho phép bạn bơi trong không khí. Đúng vậy, bạn nghe đúng rồi! Bơi... trong... không khí... \n\n\n\nKhi ở trong không khí, giống như khi nhảy, bạn có thể nhấn CTRL để bắt đầu bơi trong không khí. Bạn có thể di chuyển xung quanh giống như trong nước: Bơi lên, Bơi xuống, Bơi khắp nơi!"]
	quest.589F1D502F680075.quest_subtitle: "Thắt lưng"
	quest.589F1D502F680075.title: "&dHelium Flamingo&r"
	quest.58B125BD4876054C.quest_desc: ["Mekanism là một mod công nghệ sẽ thay đổi cách bạn chơi Minecraft.\n\n\n\nMod này tập trung vào việc phân tích vật liệu thành thành phần hóa học, và lấy ra những gì tốt nhất từ mọi vật liệu bạn gặp.\n\n\n\nMod này có tính năng Jetpacks chạy bằng Hydro, một người bạn robot thu nhỏ, lò phản ứng, Máy Khai Thác Số để tự động hóa khai thác, và nhiều, nhiều hơn nữa."]
	quest.58B125BD4876054C.quest_subtitle: "Khởi đầu nhà máy của bạn"
	quest.58B125BD4876054C.title: "&dMekanism&r"
	quest.58C2ABED43B2EA61.quest_desc: ["&9Khung Mô Hình&r là điểm khởi đầu để tạo Mô Hình Dữ Liệu.\n\n\n\nĐể bắt đầu thu thập dữ liệu về một sinh vật cụ thể, bạn sẽ muốn tạo một cái trong số chúng rồi &9nhấp chuột phải&r vào sinh vật bạn muốn thu thập dữ liệu. Khi thực hiện đúng, Khung Mô Hình sẽ biến thành Mô Hình Dữ Liệu của sinh vật bạn vừa nhấp vào.\n\n\n\nĐể thu thập dữ liệu cho sinh vật đó, đặt Mô Hình Dữ Liệu mới tạo vào bên trong một &aMáy Học Sâu&r, sau đó bắt đầu giết sinh vật cụ thể đó với Máy Học Sâu trong túi đồ của bạn."]
	quest.58C2ABED43B2EA61.quest_subtitle: "\"Thu Thập Dữ Liệu\""
	quest.58C2ABED43B2EA61.title: "&9Mô Hình Sinh Vật"
	quest.58D5BD3106BFD94A.quest_desc: ["Chế tạo phiên bản tiếp theo của cuốn sách. Tôi hứa với bạn, nó đáng giá.\n\n\n\nTôi thậm chí sẽ trả lại cho bạn một Viên Kim Cương."]
	quest.58D5BD3106BFD94A.quest_subtitle: "Cái này hoàn toàn đáng giá"
	quest.58D5BD3106BFD94A.title: "Nấu ăn với sức mạnh của Kim cương"
	quest.59E68086A8B99EA7.quest_desc: ["&c&lPyromancer&r (khác với Pie Romancer) là một Mobs Trung lập khác được thêm bởi &lIron's Spells&r. Anh ấy có thể sẽ đốt cháy các Mobs ở gần anh ấy bằng &clửa&r... \n\n\n\nBạn có thể giao dịch với anh ấy tất cả các thứ &cLửa&r, Mực, và thậm chí cả &cLửa Cuộn&r. \n\n\n\nNếu bạn muốn mạo hiểm tất cả tóc trên cơ thể bằng cách chiến đấu với anh ấy, hãy chuẩn bị, anh ấy có 60 Trái tim. Anh ấy sẽ đốt bạn bằng &cLửa&r với &cLửa Phép thuật&r, không cần hỏi. \n\n\n\nKhi chết, anh ấy sẽ rơi Tinh hoa Bí ẩn, Mực, &cLửa Runes&r, và &cLửa Phép thuật&r!\n\n{image:atm:textures/questpics/iron_spells/spells_pyromancer.png width:100 height:200 align:center}"]
	quest.59E68086A8B99EA7.title: "&c&lPyromancer"
	quest.5A1DCD6C7F712A78.title: "Cần câu Neptunium"
	quest.5A23107C363A209E.quest_subtitle: "Tạo ra các vật liệu End đa dạng"
	quest.5A94A2664BFDD7B9.quest_desc: ["Chào mừng đến với Chương Lưu trữ Cơ bản!\n\n\n\nBạn sẽ tìm thấy tất cả các cách cơ bản để lưu trữ item mà không cần nguồn năng lượng, cũng như các item hữu ích cho nhu cầu lưu trữ của bạn!"]
	quest.5A94A2664BFDD7B9.title: "Lưu trữ Cơ bản"
	quest.5A9C646718EE92C2.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_vibranium.png width:100 height:150 align:center}"]
	quest.5A9C646718EE92C2.title: "&3Vibranium&r"
	quest.5AA3E5DFECB4AC4D.quest_desc: ["Tất nhiên, AE2 cung cấp cách riêng để tăng tốc độ phát triển tinh thể một cách đáng kể.\n\n\n\nĐặt chúng xung quanh Budding Crystals của bạn, cấp cho chúng một ít năng lượng, và quan sát tinh thể của bạn phát triển!"]
	quest.5AAF6CA41209B365.title: "&3Công cụ Vibranium"
	quest.5AC1BE754210429E.quest_desc: ["Nếu bạn muốn tạo một nhóm cho bạn và bạn bè, hãy sử dụng lệnh &a/ftbteams party create (tên nhóm)&r để tạo nhóm!"]
	quest.5AC497F76A086A5C.title: "&l&9Phần thưởng Overworld:&r&e Phù thủy"
	quest.5ACE97EE75813006.quest_desc: ["Đây là nguồn thông tin chính về &dNghi lễ&r. Dưới đây là những kiến thức cơ bản:\n\n\n\n&lCấp độ của Nghi lễ&r:\n\n\n\nNghi lễ có (về cơ bản) bốn cấp độ dựa trên sức mạnh của Quỷ mà bạn đang triệu hồi. Cấp độ đầu tiên là &eFoliot&r, sau đó là &aDijini&r, &cAfrit&r, và &9Marid&r. Một số nghi lễ rơi vào các cấp độ trung gian, chẳng hạn như cấp độ &6Unbound Afrit&r.\n\n\n\n&lCác loại Nghi lễ&r:\n\n\n\nCó năm loại nghi lễ chính, nhưng chúng ta chỉ cần bốn loại cho sự tiến hóa. Ba loại chính là &9Nghi lễ Triệu hồi&r, &5Nghi lễ Chiếm hữu&r, và &6Nghi lễ Thấm nhuần&r. Mỗi loại sẽ được giải thích lần đầu tiên khi chúng xuất hiện trong các nhiệm vụ này. Loại nghi lễ thứ tư là một loại &dNghi lễ không có Quỷ&r, nghĩa là nó sử dụng các phần từ cả ba loại để thực hiện một hành động đặc biệt mà không cần sử dụng trực tiếp Quỷ.\n\n\n\nLoại thứ năm, &eNghi lễ Thân quen&r, không cần thiết cho sự tiến hóa. Nhưng chúng vẫn có thể triệu hồi một số người bạn hữu ích để giúp đỡ bạn!\n\n\n\n&lPhấn (Chalks)&r:\n\n\n\nCó hai loại phấn: Phấn nền (Foundation Chalks) và Phấn màu (Colored Chalks).\n\n\n\nPhấn nền được sử dụng trong mọi nghi lễ, và mỗi cấp độ cao hơn sẽ có màu tối hơn, bắt đầu từ Phấn trắng (White Chalk) và kết thúc bằng Phấn đen (Black Chalk).\n\n\n\nPhấn màu là loại được sử dụng phổ biến nhất, nhưng màu sắc của Phấn không trực tiếp tương quan với sức mạnh của nó giống như Phấn nền."]
	quest.5ACE97EE75813006.title: "Những kiến thức cơ bản về Nghi lễ"
	quest.5AE80FF518B1BBA6.quest_desc: ["Mệt mỏi vì phải mang theo Phấn, Nến, Đầu lâu và Tinh thể? Hãy tạo một Túi Nghi lễ (Ritual Satchel)!\n\n\n\nBằng cách nhấn Shift + chuột phải với Túi Nghi lễ trong tay, bạn có thể đổ đầy nó với tất cả nguyên liệu cần thiết để vẽ một vòng tròn nghi lễ.\n\n\n\nKhi bạn đã chất đầy Túi, chỉ cần chuột phải vào bất kỳ khối xem trước nào để bắt đầu (từ từ) tự động đặt tất cả các ký hiệu (runes) cho nghi lễ được chọn.\n\n\n\nNếu một mảnh phấn bên trong túi giảm dưới 40% độ bền, hiệu ứng phép thuật lấp lánh trên vật phẩm này sẽ biến mất để báo hiệu rằng có thể đã đến lúc sửa chữa hoặc thay thế một số Phấn của bạn."]
	quest.5AE80FF518B1BBA6.quest_subtitle: "Nghi lễ túi!"
	quest.5AE80FF518B1BBA6.title: "Công cụ của nghề nghiệp: Túi Nghi lễ"
	quest.5B013A3A37D6902B.quest_desc: ["Bạn có thể tìm thấy các mảnh Tri thức Cổ xưa phân tán trong các Rương của &9Thành phố Cổ xưa&r. \n\n\n\nBạn cũng sẽ cần &9Mảnh Tiếng vang&r để 1. Kết hợp các Mảnh để học về &9Phép thuật&r và 2. Thực sự tạo ra &9Phép thuật&r."]
	quest.5B013A3A37D6902B.title: "Vào Thành Phố Cổ"
	quest.5B46B5BF4ADB2BE9.quest_desc: ["Có, nó có thể tạo đường đi, đừng lo!"]
	quest.5B46B5BF4ADB2BE9.title: "&6Allthemodium &5Hợp kim &3Xẻng"
	quest.5B5FC539BD1F4A73.quest_desc: ["Pylon này dùng để chặn Spawn quái vật.\n\n\n\nBạn có thể dùng Bộ lọc Quái vật để chặn spawn của chỉ một số quái vật nhất định, hoặc dùng Bộ lọc Vô Hồn để chặn mọi spawn quái vật!\n\n\n\nBạn có thể xếp chồng nhiều Bộ lọc Quái vật để chặn thêm nhiều spawn. Hơn nữa, bạn có thể thay đổi Khu vực Làm việc để xem nó chặn những spawn quái vật ở khoảng cách bao xa.\n\n\n\nNếu bạn dùng Bộ lọc Vô Hồn, nó sẽ bỏ qua tất cả các cài đặt đó."]
	quest.5B681BC43371CC5C.quest_subtitle: "Để Chuyển Đồ"
	quest.5BA986D7928BF09F.quest_desc: ["Piglich là một Trùm được thêm bởi &6&lAllthemodium&r.\n\n\n\nHắn có 1000 Trái tim và hiện tại không có đòn tấn công nào, nhưng hãy tin tôi khi hắn có chúng chúng sẽ là hủy diệt!\n\n\n\nKhi bị giết, hắn sẽ rơi Trái tim của mình, cần thiết để tạo Hợp kim và ATM Star!\n\n\n\n(Tìm cách farm chúng như với HNN hoặc EnderIO!)"]
	quest.5BA986D7928BF09F.title: "Trùm Piglich"
	quest.5BB887411B8B38FA.quest_desc: ["Về việc mở rộng Mạng ME một cách không dây, bước đầu tiên là khá không truyền thống.\n\n\n\n&bMatter Condenser&f là cách AE2 tiếp cận với thùng rác, hủy bỏ bất kỳ vật phẩm nào được đưa vào. Tuy nhiên, khi được trang bị &eStorage Component&f, máy nén có thể khai thác một số năng lượng dư thừa từ vật phẩm bị hủy và lưu trữ nó để tạo ra hai vật phẩm chế tạo đặc biệt từ năng lượng đủ nồng độ.\n\n\n\nVật phẩm đầu tiên trong hai vật này là &bMatter Ball&f, yêu cầu ít nhất một thành phần lưu trữ 1k và 256 vật phẩm bị hủy."]
	quest.5BB887411B8B38FA.title: "Chất Đã Nén"
	quest.5BCA3F716348ECCD.quest_desc: ["&9Energy Hopper&r sẽ sạc bất kỳ vật phẩm có thể sạc nào trong kho của khối nó chỉ đến, như một cái rương."]
	quest.5C22E3103544B120.quest_desc: ["Để kết nối phần lớn mạng ME của bạn, bạn sẽ cần một số cáp. &eCáp kính ME&f là loại cáp đầu tiên và cơ bản nhất, và bạn sẽ chế tạo nó xuyên suốt như bước đầu tiên để chế tạo các loại cáp khác.\n\n\n\nCả cáp kính và phiên bản &ecó vỏ bọc&f của chúng đều có thể mang tới 8 kênh dọc theo một phần cáp. Khác với cáp kính, cáp có vỏ bọc sau đó có thể được chế tạo thành &ecáp có vỏ đặc&f, có khả năng mang tới 32 kênh. Tuy nhiên, hầu hết các thiết bị 'đa phần' như bus và đầu cuối không thể gắn trực tiếp vào cáp đặc, mà yêu cầu cáp chiều rộng bình thường để tạo kết nối.\n\n\n\nTất cả các cáp cũng có thể được chế tạo với thuốc nhuộm để tô màu. Cáp không màu ('Fluix') có thể kết nối với bất kỳ màu cáp nào khác, nhưng nếu không thì các cáp màu khác nhau sẽ không bao giờ kết nối với nhau."]
	quest.5C22E3103544B120.title: "Cáp cơ bản"
	quest.5C2C29ECA67F9B49.quest_desc: ["Với Bộ lọc Vô sinh, bạn sẽ không bao giờ phải lo lắng về bất kỳ sự sinh ra của Mob nào trong khu vực 25x25 khối. \n\n\n\nĐiều đó đủ để bao phủ mọi khoảng cách Mob xuất hiện gần người chơi. Thù địch hay Hòa bình. \n\n\n\nĐiều này bao gồm mọi Tầng Y, trên hoặc dưới Pylon, vì vậy không còn phải lo lắng về việc thắp sáng hang động! \n\n\n\nKhông có Danh sách trắng với Bộ lọc này, nó sẽ ngăn chặn mọi sự sinh ra của Mob."]
	quest.5C2C29ECA67F9B49.quest_subtitle: "Cuối cùng cũng được yên tĩnh."
	quest.5C47935A3B2877FF.quest_desc: ["Mekanism cung cấp một Cáp trông đẹp mắt để truyền năng lượng của bạn.\n\n\n\nNếu máy bạn đang kết nối tới đã kéo hoặc đẩy năng lượng, bạn sẽ không cần cấu hình Cáp. Nếu không, bạn sẽ cần một &9Bộ cấu hình&r để cấu hình Cáp. Shift + chuột phải sẽ thay đổi Cáp sang chế độ kéo hoặc đẩy."]
	quest.5C47935A3B2877FF.quest_subtitle: "Ống Dẫn Năng Lượng của Mekanism"
	quest.5C47935A3B2877FF.title: "&9Mekanism: &aCáp Toàn Năng"
	quest.5C73247A48E72FB3.quest_desc: ["Nếu bạn muốn xóa một &5phép thuật&r cụ thể khỏi &5Kho phép thuật&r, bạn có thể sử dụng cái &bKệ sách&r này trong bộ thiết lập &5phép thuật&r của bạn! \n\n\n\nĐặt một &5Sách phép thuật&r, bạn muốn đưa vào Danh sách đen, vào một vị trí trống trong cái &bSeashelf&r này. \n\n\n\nSau đó, khi bạn &5phép thuật&r, &5phép thuật&r này sẽ không xuất hiện trên Đồ vật hoặc Sách."]
	quest.5C73247A48E72FB3.title: "Xóa &5Phép thuật&r khỏi Kho"
	quest.5C83D5CDD980FD9A.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_snout.png width:100 height:150 align:center}"]
	quest.5C83D5CDD980FD9A.quest_subtitle: "Tàn tích Pháo đài"
	quest.5C83D5CDD980FD9A.title: "Trang trí giáp mõm"
	quest.5CD8D169181C7339.quest_desc: ["Ba vật phẩm cuối cùng này đại khái là một số đồ chơi bổ sung do AE2 cung cấp và không nhất thiết phù hợp với bất kỳ cây nhiệm vụ nào.\n\n\n\n&bCharged Staff&f đơn giản chỉ là một cây gậy có năng lượng, gây 3 tim sát thương và tiêu thụ 300AE mỗi lần đánh. Nó cũng sử dụng cơ chế chiến đấu trước phiên bản 1.9, nghĩa là bạn có thể spam-click như những ngày xưa cũ.\n\n\n\n&bEntropy Manipulator&f, khi &oused&r trên một số khối trong thế giới, sẽ nung chúng ngay tại chỗ, như cát thành kính và quặng kim loại thành phôi kim loại. Nếu không, nó sẽ đơn giản đốt lửa trên khối.\n\n\n\nCuối cùng, &bMatter Cannon&f hoạt động tương tự Color Applicator như một ô dành riêng để chứa các vật phẩm 'đạn' như Matter Balls và nugget sắt/vàng, sau đó có thể bắn ra để gây sát thương cho quái vật hoặc phá khối. 'Đạn' nặng hơn là Matter Balls trong Matter Cannon có thể được thay thế bằng &bPaint Balls&f, sẽ tạo hiệu ứng bắn phết sơn lên mặt của bất kỳ khối nào bị bắn trúng. &bLumen Paint Balls&f là một biến thể của paint balls chỉ dùng riêng cho Matter Cannon, mà sơn phết của chúng cũng phát ra một chút ánh sáng khi hiện diện trong thế giới."]
	quest.5CD8D169181C7339.quest_subtitle: "Quá nóng cho ATF"
	quest.5CD8D169181C7339.title: "Những... Vũ khí?"
	quest.5CE44C58A470E48E.quest_desc: ["&l&3Artifacts&r là một mod tuyệt vời bổ sung &l&3Artifacts&r sẽ làm trải nghiệm Minecraft của bạn dễ dàng và vui vẻ hơn!\n\n\n\nTất cả &l&3Artifacts&r đều có thể được tìm thấy từ việc khám phá, khai quật, hoặc giết Kẻ mạo danh!\n\n\n\nKẻ mạo danh được tìm thấy trong các trại lửa dưới lòng đất, trông giống như Rương bình thường! Nhưng một khi bạn đến quá gần, chúng sẽ tấn công!"]
	quest.5CE44C58A470E48E.title: "&l&3Bảo vật"
	quest.5CF320E9C4C1B1E1.quest_desc: ["ATM10 là một bộ mod &aKitchensink&r, nghĩa là bạn có tự do khám phá và chơi bộ modpack theo cách bạn muốn!\n\n\n\nTuy nhiên, có một mục tiêu cuối cùng: Tạo ra &6ATM Star&r!\n\n\n\nChuỗi nhiệm vụ này phục vụ như một hướng dẫn cho tất cả người chơi, cho dù bạn mới bắt đầu Minecraft hay đã chơi qua các bộ ATM trước đó.\n\n\n\nGiống như gần như mọi bộ modpack, hãy thu thập một ít gỗ để bắt đầu!"]
	quest.5CF320E9C4C1B1E1.title: "&eChào mừng đến với phần Bắt đầu&r!"
	quest.5D82340E9BED9C79.quest_desc: ["Những Di vật này có thể được tìm thấy ở &dThe End&r!"]
	quest.5D82340E9BED9C79.title: "&dThế Giới Cuối"
	quest.5DDC15AAFD2CAF47.quest_desc: ["&bÁo giáp kim cương&r là phần tiếp theo trong chuỗi &l&2Vanilla&r, đây cũng thường là nơi chúng ta bắt đầu phép thuật cho nó! \n\n\n\nTôi khuyên dùng Protection và các dạng khác của nó, chúng ta không cần quá kén chọn với các mod!"]
	quest.5DDC15AAFD2CAF47.quest_subtitle: "20"
	quest.5DDC15AAFD2CAF47.title: "&bÁo giáp kim cương"
	quest.5DE45BC0258D1B0B.quest_desc: ["The &dPearlescent Endshelf&r là một loại &7kệ&r khá ổn, đặc biệt là về giá. \n\n\n\nNó được tạo ra bằng cách kết hợp một &dEndshelf&r với 4 &7Cột End&r và 2 &3Hạt End&r. \n\n\n\nNó sẽ cho chúng ta tối đa &aEterna 90&r, nhưng đây không phải là thứ chúng ta muốn để đạt &5Enchanting&r tối đa."]
	quest.5DE45BC0258D1B0B.title: "&dPearlescent Endshelf"
	quest.5DE7C4FD5FA29236.quest_desc: ["Bạn có ghét khi sắp giết một Enderman và nó dịch chuyển đi không? Không, bạn không ghét nó, bạn yêu nó! Bạn chỉ tức giận vì bạn ghen tị! Bạn muốn nó! \n\n\n\nVà với &5Chorus Belt&r bạn có thể có nó! Bạn sẽ dịch chuyển tức thời khỏi một đòn đánh sẽ giết chết bạn."]
	quest.5DE7C4FD5FA29236.quest_subtitle: "Đai"
	quest.5DE7C4FD5FA29236.title: "&5Chorus Belt&r"
	quest.5DE863C3FB6492BE.quest_desc: ["{image:atm:textures/questpics/iron_spells/spells_outfit_cultist.png width:60 height:100 align:center}"]
	quest.5DE863C3FB6492BE.title: "&4Trang phục Cultist"
	quest.5E02AE661945306C.quest_desc: ["Nhiệm vụ này được tạo bởi &6Nhân sự AllTheMods&r, hoặc một &2người đóng góp Cộng đồng&r để sử dụng trong các Modpack AllTheMods. \n\n\n\nVì tất cả các pack &6AllTheMods&r đều được cấp phép theo &eTất cả các quyền được bảo lưu&r, Nhiệm vụ này không được phép sử dụng trong bất kỳ pack công khai nào không được phát hành bởi &6Đội ngũ AllTheMods&r mà không có sự cho phép rõ ràng. \n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn' đang thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.5E090C9BB4DAA5D4.title: "Cấp: &aSinh năng lượng"
	quest.5E116409DC7D30BB.quest_desc: ["Vật phẩm này được dùng để cấu hình nhiều vật phẩm trong Mekanism, từ thay đổi ống dẫn thành \"Kéo hoặc Đẩy\" hay xoay máy móc."]
	quest.5E116409DC7D30BB.quest_subtitle: "Cờ lê Mekanism"
	quest.5E1D4169C083ACEF.quest_desc: ["&cBảng đánh lửa&r tạo ra lửa phía trước nó khi được cấp Tín hiệu Đá đỏ.\n\n\n\nNó sẽ dập tắt lửa khi Tín hiệu dừng lại."]
	quest.5E1D4169C083ACEF.title: "&cBảng đánh lửa"
	quest.5E24012A3D9B72A1.quest_desc: ["Vật phẩm không phải là thứ duy nhất có thể lưu trữ trong các ô ME. &bÔ lưu trữ Dung dịch ME&f có thể lưu trữ chất lỏng như nước, lava và bất kỳ loại dầu và nhiên liệu modded nào, chỉ để đưa ra một vài ví dụ. \n\n\n\nLưu ý rằng tất cả các ô lưu trữ, bất kể chúng' được thiết kế để lưu trữ thứ gì, chỉ khác nhau về phần vỏ; cả ô vật phẩm và ô dung dịch đều sử dụng cùng một loại thành phần lưu trữ để chế tạo. \n\n\n\nĐối với dung dịch, 1 byte tương đương với 8 xô (8000mb)."]
	quest.5E41363F9AE243F3.quest_desc: ["Bạn không thể dùng Than để cung cấp năng lượng cho căn cứ mãi mãi! Nếu bạn' có một lượng tài nguyên đáng kể, đã đến lúc nâng cấp hệ thống năng lượng của bạn!\n\n\n\nNhững lựa chọn này thường yêu cầu một chút thiết lập, nhưng tạo ra đủ năng lượng để đưa bạn đi xa trong quá trình chơi."]
	quest.5E41363F9AE243F3.title: "&b&lTùy chọn Năng lượng Giai đoạn Giữa"
	quest.5E4BC0F59C90433A.quest_desc: ["Sophisticated Storage cho phép bạn nâng cấp Rương và Thùng của mình bằng kim loại để tăng dung lượng lưu trữ! Bạn cũng có thể thêm các nâng cấp để tăng tính năng.\n\n\n\nNhững chiếc rương này giống hệt như một Rương hoặc Thùng thường, nhưng chúng có một ô cho Nâng cấp Lưu trữ!"]
	quest.5E4BC0F59C90433A.quest_subtitle: "\"Rương thường\""
	quest.5E4BC0F59C90433A.title: "Sophisticated Storage"
	quest.5E4FE420B6D2C97F.quest_desc: ["Nén các vật phẩm trong ba lô thành công thức 3x3 của chúng."]
	quest.5E4FE420B6D2C97F.quest_subtitle: "Thêm tùy chọn lọc"
	quest.5E4FE420B6D2C97F.title: "&eNâng cấp nén cao cấp"
	quest.5E6585F7627247E3.quest_desc: ["Khi được áp dụng như một nâng cấp cho bất kỳ thiết bị được hỗ trợ nào như Interface hoặc Export Bus, &bCrafting Card&f cho phép thiết bị đó tự động gửi yêu cầu chế tạo của chính nó cho một vật phẩm được yêu cầu (được lọc). Crafting CPUs có thể được thiết lập để chỉ phản hồi các yêu cầu này, ngăn không cho chiếm dụng CPU dành cho các yêu cầu chế tạo từ người chơi.\n\n\n\nKhi &eLevel Emitter&f được nâng cấp với Crafting Card, nó có thể được cấu hình để phát ra redstone nhằm trực tiếp hỗ trợ chế tạo, bằng cách phát tín hiệu &owhile&r một công việc chế tạo cho vật phẩm được chỉ định được phát hiện hoặc cụ thể &oto&r chế tạo vật phẩm đó. Trường hợp sau áp dụng cho các trường hợp chỉ cần tín hiệu redstone để chế tạo một vật phẩm, mà không cần thậm chí một mẫu chế tạo."]
	quest.5E6585F7627247E3.quest_subtitle: "Tự động hóa dưới dạng nâng cấp!"
	quest.5E799B92358A8732.quest_desc: ["Trong &cNether&r, bạn sẽ gặp &6Đổ vỡ cổ xưa&r. Điều này có thể được nung chảy thành &6Mảnh vụn&r, có thể kết hợp với thỏi vàng để tạo ra &6Phôi Netherite&r, một kim loại endgame dùng để chế tạo một số công cụ và áo giáp mạnh nhất trong trò chơi."]
	quest.5E799B92358A8732.title: "&dKim loại cổ xưa"
	quest.5E7CCDE9229A646A.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_allthemodium.png width:100 height:150 align:center}"]
	quest.5E7CCDE9229A646A.title: "&6Allthemodium&r"
	quest.5E7E35CCAF1C88EE.quest_desc: ["Chiếc &bME Import Bus&f định kỳ hút vật phẩm từ kho lưu trữ bên ngoài mà bus đang đối mặt. Nó có thể được lọc để chỉ lấy các vật phẩm nhất định từ kho đó."]
	quest.5E7E35CCAF1C88EE.quest_subtitle: "Chiếc I"
	quest.5EB7CE3A1DCD3E9B.quest_desc: ["Đó là một &cNam châm&r."]
	quest.5EB7CE3A1DCD3E9B.quest_subtitle: "Đai"
	quest.5EB7CE3A1DCD3E9B.title: "&cBẫy hút vạn năng&r"
	quest.5EB87CE5F6DEFAAA.quest_desc: ["Chiếc &6Magma Walkers&r cho phép bạn 2 điều: đi trên &cKhối magma&r mà không nhận sát thương, và đi trên &4Lava&r trong một chút. &cKhối magma&r không có thời gian hồi nhưng đi trên &4Lava&r thì có. Sau khi thời gian kết thúc, chiếc &6Giày&r sẽ quá nhiệt và gây sát thương cho bạn."]
	quest.5EB87CE5F6DEFAAA.quest_subtitle: "Tìm thấy ở Cổng đổ nát, Pháo đài Nether và Di tích Bastion"
	quest.5EB87CE5F6DEFAAA.title: "&6Magma Walkers"
	quest.5ED368C926E5F32C.quest_desc: ["Có một lớp cuối cùng về &3Phép thuật&r mà tôi quên đề cập. Thật ra, mọi kiến thức về những &9Phép thuật&r này đã bị lãng quên, nên không chỉ riêng tôi. \n\n\n\nĐể lấy lại ký ức, chúng ta cần đi, lặng lẽ, xuống con đường ký ức. Con đường đó chính là &9Thành phố cổ&r."]
	quest.5ED368C926E5F32C.title: "Lớp Cuối Cùng..."
	quest.5F078A574A783B02.quest_desc: ["Đồ vật đầu tiên bạn cần để bắt đầu Flux Network là một &9Flux Plug&r.\n\n\n\nPlug được dùng để \"rút\" năng lượng từ khối nó được gắn vào. Ngoài một bộ đệm nhỏ, Plug không tự lưu trữ bất kỳ năng lượng nào, nên đừng lo nó sẽ hút cạn năng lượng của bạn.\n\n\n\nNên đặt Plug lên một khối lưu trữ năng lượng như Energy Cube. Nó có thể kết nối với Cables, Pipes, hoặc đầu ra của bất kỳ máy móc sản xuất năng lượng nào.\n\n\n\nĐể học cách thiết lập mạng lưới đầu tiên, hãy xem nhiệm vụ tiếp theo!"]
	quest.5F078A574A783B02.quest_subtitle: "Chỉ cần cắm vào!"
	quest.5F078A574A783B02.title: "Bắt Đầu Mạng Lưới Của Bạn"
	quest.5F56892CD904C40F.quest_desc: ["Cấp độ lưu trữ thứ năm và cuối cùng theo chuẩn AE2, cung cấp &e262144&f byte lưu trữ."]
	quest.5F56892CD904C40F.quest_subtitle: "x4^4"
	quest.5F56892CD904C40F.title: "Thành phần Lưu trữ 256k"
	quest.5F5E43B3F51CAE9E.quest_desc: ["'Chúng thật kỳ diệu và ngon!' \n\n\n\nChiếc &aSuperstitious Hat&r cấp cho bạn một cấp độ Looting thêm vào với Mobs bạn giết! \n\n\n\nNó có thể chồng lên Enchants!"]
	quest.5F5E43B3F51CAE9E.quest_subtitle: "Đầu"
	quest.5F5E43B3F51CAE9E.title: "&aMũ mê tín"
	quest.5F6152CF085D75D6.title: "Lò phản ứng (Cơ bản)"
	quest.5FA9BC0D8476D322.quest_desc: ["Tự động cho bạn ăn bằng thức ăn trong Ba lô."]
	quest.5FB29F3F4DF17765.quest_desc: ["Đôi khi bạn không muốn mọi Module di chuyển nhiều stack cùng lúc, vì vậy khi bạn chỉ muốn 1 Module làm vậy, hãy dùng Augment! Tuy nhiên, cái này không chồng chéo với Upgrades... thực tế nó ghi đè chúng."]
	quest.5FD6A738754F6013.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2Community contributor&r để sử dụng trong AllTheMods Modpacks. \n\n\n\nVì tất cả các gói &6AllTheMods&r đều được cấp phép theo &eAll Rights Reserved&r, Nhiệm vụ này không được phép sử dụng trong bất kỳ gói công cộng nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng. \n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn đang thấy cái này, bạn đang ở chế độ chỉnh sửa."]
	quest.5FDB48511EC1C580.quest_desc: ["Sợ làm nổ Lò phản ứng phân hạch của bạn và gây ra rò rỉ Bức xạ lớn? Đừng lo, chúng ta đều thế. &o*chèn ký ức khủng khiếp ở đây*&r\n\n\n\nVậy làm thế nào để ngăn chặn thảm họa thảm khốc như vậy? Bằng cách tạo một &aCircuit Breaker&r bằng &dFission Reactor Logic Adapters&r. Bây giờ những cái này không được đảm bảo 100% sẽ ngăn được vụ nổ, nhưng chúng thực sự tốt để có.\n\n\n\nVề cơ bản, những Adapter này cho phép chúng ta điều khiển Lò phản ứng bằng &cRedstone&r. Chỉ với một cái, bạn có thể dùng cần gạt để bật và tắt lò phản ứng. Tuy nhiên, chúng ta sẽ dùng chúng để kiểm soát thiệt hại.\n\n\n\nBạn cũng có thể thiết lập chúng để phát tín hiệu Redstone dựa trên một điều kiện nhất định trong Lò phản ứng, như &cDamage Critical&r hoặc &8Insufficient Fuel&r. Điều này hữu ích để thiết lập circuit breaker để tắt Lò phản ứng nếu những điều đó xảy ra.\n\n\n\n{image:atm:textures/questpics/mek/logic_adapter.png width:150 height:125 align:1}"]
	quest.5FDB48511EC1C580.quest_subtitle: "Bởi vì Chúng ta đều đã làm nổ Lò phản ứng trước đây"
	quest.5FDB48511EC1C580.title: "Hệ thống an toàn lò phản ứng"
	quest.5FE631066CAB7397.quest_desc: ["Được dùng để bẫy và vận chuyển quái vật dễ dàng."]
	quest.603877AB96321F1A.quest_desc: ["Để lấy Hydrogen Chloride cho máy móc của chúng ta, chúng ta cần đầu tiên tạo &aBrine&r.\n\n\n\nĐể làm điều này, chúng ta cần một Thermal Evaporation Plant. Đây là một cấu trúc nhiều khối.\n\n\n\nĐể bắt đầu, tạo một cấu trúc 4x3x4 rỗng ở giữa, ngoại trừ phần đáy. Bạn có thể thay thế bất kỳ mặt nào bằng một Controller hoặc Valve.\n\n\n\nBạn sẽ cần ít nhất 1 controller, và ít nhất 2 valves.\n\n\n\nBơm nước vào, và bạn sẽ bắt đầu thu thập brine, có thể được bơm vào một &aElectrolytic Separator&r để chiết xuất &6Chlorine&r từ khí.\n\n\n\n{image:atm:textures/questpics/mek/thermalplant.png width:100 height:100 align:1}"]
	quest.603877AB96321F1A.quest_subtitle: "Nước biến thành Nước muối!"
	quest.603877AB96321F1A.title: "Nhà máy Hơi nước Nhiệt"
	quest.6063F4B7BE4D394C.quest_desc: ["Các Mô-đun Gửi sẽ di chuyển các Mặt hàng trong Khe Đệm của Router sang một Kho đồ khác. \n\n\n\nMK1 chỉ di chuyển mặt hàng vào các Kho đồ trên cùng trục XYZ với Router và có tầm nhìn trực tiếp. Nếu có một khối chắn đường, MK1 Sender sẽ không gửi."]
	quest.60850E717C747A78.quest_desc: ["Bạn có bao giờ dành 3 tháng nghiên cứu &oGalatic Code&r để cuối cùng hiểu ngôn ngữ &5Bàn Phép thuật&r chỉ để nó là thứ vô nghĩa? \n\n\n\nKhông? \n\n\n\nTôi cũng không, nhưng &9Gợi ý Phép thuật&r là bản dịch thực tế cho nó! \n\n\n\nMỗi &9Gợi ý Phép thuật&r sẽ cho bạn biết 1 &5Phép thuật&r trước khi bạn thực sự sử dụng nó."]
	quest.60850E717C747A78.title: "&3Gợi ý Phép thuật"
	quest.609D03E335CF32E2.quest_subtitle: "Cấp độ: &d6"
	quest.60CECAAE2D43EC6E.quest_desc: ["&2Ender Hand&r làm hai việc: một Khả năng Thụ động và một Khả năng Chủ động. Thụ động khiến &5Endermen&r không tức giận khi bạn nhìn chúng. Chủ động cho phép bạn đổi chỗ với một sinh vật bạn đang nhìn bằng Left Alt."]
	quest.60CECAAE2D43EC6E.quest_subtitle: "Tìm thấy trong End Cities và End Ships"
	quest.60CECAAE2D43EC6E.title: "&2Ender Hand"
	quest.60FAD8BF235E381B.title: "&bMực Hiếm&r"
	quest.6141DE779232C8AA.title: "&l&cPhần thưởng Nether:&r&e Blazes"
	quest.6144202A97C6CD1C.quest_desc: ["&bCon dao cắt Quartz&f, giống như cái mỏ lết, có cả phiên bản nether và certus quartz và là một công cụ chế tạo hữu ích nên có sẵn.\n\n\n\nCáp cũng có thể được tách ra mà không cần phải tô màu bằng cách gắn một &bCable Anchor&f giữa chúng, được chế tạo bằng con dao này và có thể chế tạo đến 50 lần với cùng một con dao trước khi nó hỏng.\n\n\n\nCable Anchor cũng có thể được dùng để chế tạo &bCable Facades&f, cho phép bạn ngụy trang cáp trong tường bằng cách che chúng bằng mặt của một khối bất kỳ. Mặc dù công thức facade bị ẩn trong JEI, bạn vẫn có thể chế tạo chúng bằng cách lấy bất kỳ khối thông thường nào và bao quanh nó bằng 4 cable anchor trong lưới chế tạo.\n\n\n\nNgoài việc chế tạo anchor, con dao cắt còn có một công dụng khác: nhấp chuột phải với con dao sẽ mở một GUI nhỏ cho phép bạn chế tạo &bInscriber Name Presses&f. Khi được đặt tên, những cái press này có thể được dùng bên trong Inscriber để đổi tên bất kỳ vật phẩm đầu vào nào thành tên của press. Hai press này có thể được nối tiếp trong inscriber để đổi tên vật phẩm thành tên của press trên, tiếp theo là press dưới."]
	quest.6144202A97C6CD1C.quest_subtitle: "Dưới lưỡi dao"
	quest.6144202A97C6CD1C.title: "Cable Anchor"
	quest.615B9062FE8CCD36.quest_desc: ["Tự động chuyển sang công cụ hiệu quả nhất cho khối bạn đang nhìn vào."]
	quest.615C3E012B2DECD3.quest_desc: ["&eSách phép&r! Bạn sẽ để &3Phép thuật&r ở đâu khác? \n\n\n\nBạn có thể thêm &3Cuộn giấy&r vào một &eSách phép&r bằng cách đặt cả hai vào Bàn Khắc Chữ (Inscription Table). Chúng có một số lượng nhất định có thể chứa nhưng không còn phải lo lắng về Độ hiếm (Rarity). \n\n\n\nKhi &3Cuộn giấy&r được thêm vào &eSách phép&r của bạn, chúng sẽ không bị tiêu hao mà thay vào đó là Mana sẽ bị tiêu hao."]
	quest.615C3E012B2DECD3.title: "&eSách phép&r!"
	quest.61847F47CCA225D9.quest_desc: ["Theo cùng mẫu hình, những cái này nung chảy trong 140 Tick hoặc 7 Giây.\n\n\n\nChúng có thể được chế tạo bằng &6Lò Đồng&r hoặc Lò Sắt và có thể được dùng để chế tạo một &eLò Vàng&r."]
	quest.61847F47CCA225D9.title: "Lò Bạc"
	quest.61999669BDE127F9.quest_desc: ["Nếu bạn chưa nhận ra, việc làm và làm lại nghi lễ nhiều lần rất làm hao mòn độ bền của Phấn (Chalk) của bạn. \n\n\n\nNếu bạn lo lắng về việc Phấn của bạn bị gãy, nhưng không muốn làm lại toàn bộ nghi lễ để tạo một phấn mới, thì nghi lễ này dành cho bạn!\n\n\n\nSử dụng sức mạnh của một &aDijinni&r, bạn có thể sửa chữa bất kỳ màu nào của Phấn đến mức tối đa!\n\n\n\nNgoài ra, bạn có thể dùng thứ như &aEternal Stella&r từ mod Forbidden Arcanus để bảo tồn vĩnh viễn Phấn của bạn!"]
	quest.61999669BDE127F9.quest_subtitle: "Bạn phá nó, &mwe&r Quỷ sửa nó!"
	quest.61999669BDE127F9.title: "Sửa chữa bằng Phấn"
	quest.61A8FAEC4FF18449.quest_desc: ["Chúng có thể được dùng để sạc các vật phẩm trong túi đồ của bạn, hoặc có thể dùng để tăng tổng dung lượng năng lượng của một kênh &7Ender Network&r."]
	quest.61C49BC2B384FB80.quest_desc: ["Khi bạn đã thu thập đủ Ender Pearls và Blaze Powders, bạn có thể tìm đường đến Cổng End ở Overworld.\n\n\n\nĐể làm điều này, chế tạo một số &dEyes of Ender&r và nhấp chuột phải để ném chúng lên trời. Chúng sẽ chỉ hướng đến Cổng End gần nhất.\n\n\n\nĐi đến Stronghold, tìm Cổng End, và hoàn thành khung bằng cách sử dụng Eyes of Ender để tạo cổng đến &dThe End&r."]
	quest.61C49BC2B384FB80.title: "&aTìm &dThe End"
	quest.61DCECE1FC38E151.title: "Lò phản ứng (Nitro)"
	quest.62161BDE9AAAA4BF.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_wayfinder.png width:100 height:150 align:center}"]
	quest.62161BDE9AAAA4BF.quest_subtitle: "Di tích đường mòn"
	quest.62161BDE9AAAA4BF.title: "Trang bị giảm Wayfinder"
	quest.6220EDE42C813C1B.quest_desc: ["Điều tệ nhất về &eCharms&r là chúng dễ vỡ! Tại sao các hiệu ứng Potion mạnh này lại phải có độ bền! \n\n\n\nĐừng lo, &5&lApotheosis&r có cách chữa cho điều đó... bằng &d&lInfusions&r! \n\n\n\nBạn sẽ cần &a100 Eterna&r, từ &c8.5% &fđến &c13.5% Quanta&r, và từ &532.5% &fđến &537.5% Arcana&r. \n\n\n\nBạn có thể dùng 10 &4Glowing Hellshelves&r, 4 &6Geode-Encased Bookshelves of Stability&r, 2 &dDraconic Endshelves&r, và một Skeleton Skull! \n\n\n\nĐúng vậy, một số Skeleton Skull và các vật phẩm khác ngoài &7Bookshelves&r cũng cung cấp chỉ số!"]
	quest.6220EDE42C813C1B.title: "Bất khả phá hủy &eBùa"
	quest.623796B1D7981E59.quest_desc: ["'Cũng hãy thử Terraria!'\n\n\n\nKhi được trang bị, bạn sẽ nhận thêm 5 trái tim! Tức là 10 điểm máu! Làm tổng số máu lên đến 30 mặc định."]
	quest.623796B1D7981E59.quest_subtitle: "Thắt lưng"
	quest.623796B1D7981E59.title: "&4Trái tim pha lê&r"
	quest.623E6A855B363C8D.quest_desc: ["Khối &9Nước&r hoạt động như Nước nhưng không có phần di chuyển.\n\n\n\nMáy sinh đá có thể được làm từ chúng, Đất canh tác có thể được tưới bằng nó, bạn chỉ không thể dùng nó để MLG clutch. (Cá cũng sẽ cố bơi vào nhưng vẫn sẽ chết)."]
	quest.623E6A855B363C8D.quest_subtitle: "Nước nhưng rắn, có phải là Băng?"
	quest.623E6A855B363C8D.title: "&9Khối Nước"
	quest.62622137648A4F56.quest_desc: ["Bạn có ghét phải khai thác rồi nung chảy quặng của mình bằng hai vật phẩm khác nhau không? Thế thì bây giờ bạn có thể lười hơn bao giờ hết với &7Bếp nung cuốc&r!\n\n\n\nKhi đeo &7Bếp nung cuốc&r, quặng bạn khai thác sẽ tự động được nung chảy!\n\n\n\nBạn có thể muốn cẩn thận với nó nếu bạn muốn xử lý quặng."]
	quest.62622137648A4F56.quest_subtitle: "Tay"
	quest.62622137648A4F56.title: "&7Bếp nung cuốc&r"
	quest.62B5A84753ADFC35.quest_subtitle: "8 Khối hồng đậm khô"
	quest.62D39F68DE6E44A4.quest_desc: ["&5Arcana&r là một chỉ số rất quan trọng, nó làm tăng số lượng &5Enchantments&r bạn nhận được; và khiến các &5Enchantments&r hiếm trở nên phổ biến hơn. \n\n\n\nVí dụ với Swords, &5Smite&r là một &5Enchantment&r rất phổ biến nhưng &5Looting&r thì hiếm hơn nhiều. \n\n\n\nMặc định của &5Arcanas&r là &50%&r và tối đa là &5100%&r."]
	quest.62D39F68DE6E44A4.title: "&5Arcana"
	quest.6313B18820445882.quest_desc: ["&9Industrial Turbine&r là một cấu trúc đa khối khổng lồ được dùng để chuyển đổi &cHeated Coolant&r thành năng lượng. Kích thước tối thiểu là 5x5x5, với kích thước tối đa là 17x17x18.\n\n\n\nĐể xây dựng Turbine, chúng ta sẽ cần một số khối nên hãy bắt đầu với những thứ cơ bản.\n\n\n\nGiống như hầu hết các multiblock của Mekanism, khung phải được làm từ &eTurbine Casings&r. Tuy nhiên, thay vì Reactor Glass, bạn có thể dùng &bStructural Glass&r hoặc Casings cho mỗi mặt.\n\n\n\nChúng ta sẽ xây dựng Turbine này, và nhiệm vụ yêu cầu chính xác các vật liệu cần thiết.\n\n\n\n{image:atm:textures/questpics/mek/turbine_completed.png width:200 height:225 align:1}"]
	quest.6313B18820445882.quest_subtitle: "Xây dựng khung"
	quest.6313B18820445882.title: "&9Industrial Turbine"
	quest.635620A03E3505BF.quest_desc: ["Tôi không muốn biết bạn lấy chúng từ đâu."]
	quest.635620A03E3505BF.quest_subtitle: "Nhưng....Bò không thể được xén lông..."
	quest.635620A03E3505BF.title: "Da"
	quest.637C87D8968CD51A.title: "&aMực Hiếm&r"
	quest.639531AB27DCD267.quest_desc: ["&7Rune&r là cách chúng ta tạo ra Class và các bộ phận của chúng. Để có được &7Blank Rune&r, bạn có thể giết &4&lDead King&r hoặc dùng Shriving Stone để làm sạch một Inscribed Rune. \n\n\n\nCó 8 Class khác nhau (1 Class bí mật), mỗi Class có &3Scrolls&r, Focus Material, Upgrades và Outfits riêng."]
	quest.639531AB27DCD267.title: "&lClass"
	quest.63E4529AF8894018.quest_desc: ["&lModular Routers&r là một mod hậu cần. \n\n\n\nTất cả bắt đầu từ Router! Vì vậy hãy làm một cái! \n\n\n\nBuffer là khe vật thể duy nhất trong Router nơi các vật thể sẽ đi vào và ra. Và nó sẽ cần tín hiệu Redstone để hầu hết các module hoạt động."]
	quest.63E4529AF8894018.title: "&lModular Routers"
	quest.64141B720662B652.quest_desc: ["Chào mừng đến với &6&lRelics&r! \n\n \n\nMod &6Relics&r tương tự như Artifacts, bạn nhận được nhiều vật thể độc nhất và mạnh mẽ khắp các Thế giới. \n\n \n\nChúng có nhiều Khả năng khác nhau được nhận và nâng cấp thông qua &6Research Window&r (Giữ shift trên relic). Tại đó bạn có thể đổi &aVanilla XP&r để reroll chỉ số trên khả năng, xem &eRelic XP&r hiện tại (nhận được từ việc sử dụng &6Relics&r), và nâng cấp khả năng của chúng! \n\n \n\nĐể sử dụng Khả năng của &6Relic&r, mặc định là Left Alt."]
	quest.64141B720662B652.title: "&l&6Relics"
	quest.641888DC7BC40AA9.quest_desc: ["Pháo đài được canh gác nghiêm ngặt &aFortress&r là nơi ở của &a&lArchevoker&r và các tín đồ của ông. \n\nBạn sẽ nhận ra nó bởi những bức tường Spruce khổng lồ và pháo đài đá &aFortress&r khổng lồ bên trong chúng. \n\n\n\nIllagers, Vindicators, &aEvokers&r và Ravagers có thể được tìm thấy trong các bức tường và &aFortress&r. Một khi bạn vượt qua chúng, bạn có thể tìm đường lên cầu thang, parkour lên Nóc, và gặp &a&lLãnh đạo Pháo đài&r ở đỉnh. \n\n\n\nVì nó được canh gác nghiêm ngặt, tất nhiên có một lượng lớn chiến lợi phẩm trong &aFort&r.\n\n{image:atm:textures/questpics/iron_spells/spells_evokerfort.png width:200 height:100 align:center}"]
	quest.641888DC7BC40AA9.title: "&aPháo đài Evoker"
	quest.6431A384DDFBF439.quest_desc: ["&bNetwork Tool&f là một công cụ quan trọng trong AE2, được sử dụng để hiển thị nhiều chi tiết khác nhau của mạng lưới trên màn hình như tổng mức tiêu thụ năng lượng và dung lượng lưu trữ. \n\n\n\nNhư một phần thưởng bổ sung, nó còn cung cấp kho đồ nhỏ của riêng mình để giữ &eupgrade cards&f, có thể truy cập khi nhìn vào màn hình của bất kỳ thiết bị có thể nâng cấp nào để thay thế dễ dàng. Tuy nhiên, nó không thể xoay các khối gắn vào mạng ME như một cái mỏ vít thông thường, chỉ có thể tháo dỡ chúng khi đang rình."]
	quest.6431A384DDFBF439.title: "Công cụ Mạng"
	quest.643FB1A3ED0EA9EC.quest_desc: ["Van là trái tim của bể chứa của bạn. Đây là nơi bạn sẽ bơm hoặc dẫn chất lỏng vào."]
	quest.643FB1A3ED0EA9EC.quest_subtitle: "Nơi chất lỏng đến và đi"
	quest.643FB1A3ED0EA9EC.title: "Van"
	quest.6451D5022BCB5E7E.quest_desc: ["Thịt bò vĩnh cửu, à sai mod rồi. §cInfinity Ham§r hoạt động như một nguồn thức ăn vô hạn. Ăn hết thịt trên xương và nó sẽ tái tạo sau một thời gian. Bạn có thể nâng cấp nó để lấp đầy bụng nhiều hơn.\n\n\n\nKhả năng thứ hai của §cInfinity Ham§r là ướp nó trong các Potion. Khi bạn làm vậy, mỗi lần ăn từ §cHam§r bạn sẽ nhận được hiệu ứng Potion đó. Tuy nhiên, nếu bạn ăn hết thịt, nó sẽ mất hiệu ứng."]
	quest.6451D5022BCB5E7E.quest_subtitle: "Có thể tìm thấy trong Hầm mỏ hoặc Pháo đài"
	quest.6451D5022BCB5E7E.title: "§cInfinity Ham"
	quest.64D0D69ADB8820DA.quest_desc: ["§8Fluid Void§r là một khối chặn mọi nước được kết nối với nó.\n\n\n\nCác khối nguồn hoặc nước chảy, bất cứ gì trong bán kính 1 khối đều biến mất."]
	quest.64D0D69ADB8820DA.title: "§8Fluid Void"
	quest.652A14E17DDE97E6.quest_desc: ["Một cái khác cần Ruined Book để chế tạo. Bạn có thể tìm thấy Ruined Books trong các Rương của §9Ancient City§r.\n\n\n\nBạn cũng cần Dragon Skin rơi từ §dEnder Dragon§r!\n\n\n\nNó sẽ có 12 §3Spell§r Slot và tăng cường §dEnder Spells§r!"]
	quest.652A14E17DDE97E6.title: "§dDragonskin Spell Book"
	quest.654F5C84114A31A1.quest_desc: ["Rất đơn giản và rẻ, &e&lbộ giáp Iron's Spells&r, hữu ích cho giai đoạn đầu!"]
	quest.654F5C84114A31A1.quest_subtitle: "20"
	quest.654F5C84114A31A1.title: "&4Bộ đồ bù nhìn"
	quest.6581D4AF1A6DE230.quest_desc: ["Quỷ thích nến. Tôi nghĩ vậy.\n\n\n\nGần như mọi nghi lễ triệu hồi bạn bè đều cần một ít nến. Bạn có thể tạo &aCon dao lưỡi búa&r và giết một số heo, bò, cừu, ngựa, hoặc thậm chí Lạc đà thương gia để lấy một ít &aMỡ&r để làm chúng. Thực tế, bạn nên tìm Lạc đà thương gia. Tôi nghe nói chúng làm nến rất tốt. &mTôi hoàn toàn không vừa mới bịa ra chuyện đó&r.\n\n\n\nNếu không, nến Vanilla cũng có thể dùng được!\n\n\n\n&9Tinh thể linh hồn&r cũng được dùng trong một số nghi lễ, vậy nên hãy làm một ít ngay bây giờ!"]
	quest.6581D4AF1A6DE230.title: "Chuẩn bị cho một nghi lễ: &aNến"
	quest.659A903F97F93BE2.quest_subtitle: "Nhanh chóng và đơn giản"
	quest.659A903F97F93BE2.title: "Bánh mì của sự sống"
	quest.65A529C8238E89F1.quest_desc: ["Nhờ &5&lMekanism&r chúng ta giờ có thể làm giáp từ &9Lapis Lazuli&r! \n\n\n\nNó khá tệ thôi..."]
	quest.65A529C8238E89F1.quest_subtitle: "9"
	quest.65A529C8238E89F1.title: "&9Giáp Lapis Lazuli"
	quest.65E733AACBE62EDB.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_ward.png width:100 height:150 align:center}"]
	quest.65E733AACBE62EDB.quest_subtitle: "Thành phố cổ đại"
	quest.65E733AACBE62EDB.title: "Trang trí giáp Ward"
	quest.6601450C63FEEE61.quest_desc: ["&bCấp 3&r tương đương với Cuốc sắt, nó khai thác được hầu hết các quặng như Kim cương, Ngọc lục bảo và Vàng."]
	quest.6601450C63FEEE61.title: "&bCấp thu hoạch 3"
	quest.66039B738CF0718A.quest_desc: ["&3Vibranium&r kết hợp với &6Allthemodium&r!"]
	quest.66039B738CF0718A.title: "&3Vibranium&r - &6Allthemodium&r Thỏi hợp kim"
	quest.661C072E48F8D41F.quest_desc: ["&6Đồng&r là một trong những quặng phổ biến nhất bạn có thể tìm thấy, vậy tại sao không dùng một đống &6đồng&r thừa để nâng cấp lò nung của bạn!\n\n\n\nLò nung thông thường mất 200 Tick để nung chảy 1 vật phẩm, (20 Tick = 1 Giây) trong khi &6Lò đồng&r chỉ mất 180 Tick.\n\n\n\nChúng có thể được chế tạo thành &7Bạc&r hoặc &fLò sắt&r."]
	quest.661C072E48F8D41F.title: "&6Lò đồng"
	quest.6648BC7D14233006.quest_desc: ["Mở rộng tương tự như Nâng cấp nhưng dành cho từng Module riêng lẻ!"]
	quest.6648BC7D14233006.title: "&lTăng cường"
	quest.666EA8B8F13EB292.quest_desc: ["Vật phẩm này dùng để bắt quái vật để vận chuyển hoặc lưu trữ. Nó cũng cần thiết cho &6ATM Star&r."]
	quest.666EA8B8F13EB292.title: "&dHồn ngọc trống"
	quest.66762A4743104157.quest_desc: ["Một quyển &eSách phép&r có thể chế tạo khác, quyển này đắt hơn một chút! Nó cần Hogskin, một vật rơi từ Hoglins. \n\n\n\nQuyển này có thể chứa 8 &3phép&r, về kỹ thuật thì vẫn còn thấp nhưng tốt hơn rồi!"]
	quest.66762A4743104157.title: "Sách phép của học đồ"
	quest.668C313FF46B6005.quest_desc: ["Thêm giao diện Lò nung vào Ba lô."]
	quest.66B5A8D259E12BF5.quest_desc: ["Khoan, bạn đang nói với tôi là nó có cùng chỉ số với &cNetherite&r? Cộng thêm Tăng cường phép? Và không cần Smithing Templates để chế tạo? \n\n\n\nTại sao ai lại muốn &cNetherite&r thông thường!"]
	quest.66B5A8D259E12BF5.quest_subtitle: "20"
	quest.66B5A8D259E12BF5.title: "&4Trang phục Chiến binh phép Netherite"
	quest.66C21934DAFFAC7F.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_tide.png width:100 height:150 align:center}"]
	quest.66C21934DAFFAC7F.quest_subtitle: "Rơi từ Guardian già"
	quest.66C21934DAFFAC7F.title: "Trang trí áo giáp Thủy triều"
	quest.66ECC26BC81D0093.title: "Cấp độ: &bCơ bản"
	quest.672134A1A620EEAB.quest_desc: ["Có nhiều cách để lưu trữ năng lượng! \n\n\n\n&9Powah&r cung cấp lưu trữ tuyệt vời bằng &aEnergy Cells&r có thể nâng cấp, hoặc bạn luôn có thể chọn phong cách multiblock của &aRFTools&r dùng &aPowercells&r! Lựa chọn thuộc về bạn. \n\n\n\nLưu ý: Bạn chỉ cần tạo một trong các vật phẩm để hoàn thành nhiệm vụ."]
	quest.673FCBF8685D0EEE.quest_desc: ["Gần như mọi multiblock của Mekanism được xây dựng theo cùng một cách.\n\n\n\nBạn sẽ cần tạo một cấu trúc hình hộp chữ nhật. Các cạnh phải được làm từ &8Induction Casings&r. Các mặt có thể làm từ Casings, &aStructural Glass&r, hoặc &cInduction Ports&r. Tốt nhất nên có 2 Ports: một cho đầu vào, một cho đầu ra. Chúng có thể thay đổi bằng &eConfigurator&r.\n\n\n\nĐối với công trình này, chúng ta sẽ làm một khối 5x5x5. Nhiệm vụ này yêu cầu chính xác số vật liệu cần thiết để xây dựng.\n\n\n\n{image:atm:textures/questpics/mek/induction_matrix.png width:200 height:200 align:1}"]
	quest.673FCBF8685D0EEE.quest_subtitle: "Bố của Energy Cube"
	quest.673FCBF8685D0EEE.title: "Xây dựng &9Induction Matrix"
	quest.674F28BCA2E4A3C8.quest_desc: ["Khi di chuyển vật phẩm, Routers có thể trở nên rất tham lam, lấy mọi vật phẩm mà chúng có thể với được bằng ăng-ten bẩn thỉu của mình! \n\n\n\nVới Regulator Augment, bạn có thể giới hạn lượng vật phẩm được di chuyển."]
	quest.6754612E9AD4B9C0.title: "Lò phản ứng (Rực lửa)"
	quest.67704F7341EDCC49.title: "&bBa lô Kim cương"
	quest.677365A816994C8B.quest_desc: ["Máy Phát Người Chơi &9 sẽ sạc đồ của người chơi mà không dây. Trước tiên, bạn phải ràng buộc nó với một người chơi bằng &9Thẻ Ràng Buộc&r. Đây là thẻ cơ bản cho phép máy phát chỉ hoạt động trong cùng một chiều không gian. Bạn có thể nâng cấp bằng cách sử dụng &dThẻ Ràng Buộc (Dimensional)&r thay thế. \n\n\n\nLưu ý: Để nhận được Player Aerial Pearl, hãy sử dụng Aerial Pearl lên một Zombie hoặc Husk."]
	quest.677A701E06422CF3.quest_desc: ["Cho phép bạn di chuyển nhanh hơn trên mọi khối bằng cách tăng tốc khi chạy trên chúng! Cảnh báo: trơn trượt hơn nhiều! Nâng cấp để di chuyển nhanh hơn nữa."]
	quest.677A701E06422CF3.quest_subtitle: "Tìm thấy trong Hầm mỏ hoặc Pháo đài."
	quest.677A701E06422CF3.title: "&cGiày Trượt"
	quest.67884BFA27870CCE.quest_desc: ["&dLời Triệu Hồi Không Ràng Buộc của Osorin&r là cấp độ thứ hai của &dNghi Lễ Không Quỷ&r. Cấp độ đầu tiên không hữu ích cho sự tiến triển chút nào, nó chỉ được dùng để hồi sinh Familiars và biến Vexes thành Allays. \n\n\n\nNghi lễ này được dùng để tạo ra rất nhiều khối, vật phẩm và nguyên liệu hiếm mà bạn có thể không thể (hoặc khó) có được cách khác."]
	quest.67884BFA27870CCE.quest_subtitle: "Dành cho những người ít thích thử nghiệm phòng thí nghiệm."
	quest.67884BFA27870CCE.title: "&dLời Triệu Hồi Không Ràng Buộc của Osorin"
	quest.67A587F4BAD76C70.quest_desc: ["&eSách Phép&r cơ bản nhất, cũng là sách rẻ nhất! \n\n\n\nNó chỉ có thể chứa tổng cộng 5 &3Phép&r."]
	quest.67A587F4BAD76C70.title: "Nhật Ký Mỏng Manh"
	quest.67D40A1A9332C03D.title: "&6Mực Huyền Thoại&r"
	quest.682034C680FDEDC2.quest_desc: ["&9Mekanism's&r &aInduction Matrix&r là cách tối ưu để lưu trữ năng lượng của bạn.\n\n\n\nNếu bạn đang tìm kiếm kho lưu trữ năng lượng tốt nhất trong game, hãy xem chương nhiệm vụ &aMekanism:&r &dReactors&r.\n\n\n\n{image:atm:textures/questpics/mek/mek_induction_matrix_small.png width:125 height:150 align:center fit:true}"]
	quest.682034C680FDEDC2.title: "Lưu trữ Năng lượng Nhiều hơn"
	quest.6827836C8E675A94.quest_desc: ["Xương trắng có các biến thể khác nhau, giống như Zombie! \n\n\n\nStrays- xuất hiện ở Vùng lạnh. \n\nBogged- xuất hiện ở Đầm lầy và Phòng thử nghiệm. \n\nMurks- xuất hiện dưới nước ở Rạn san hô. \n\nVerdants- xuất hiện ở Rừng nhiệt đới."]
	quest.6827836C8E675A94.title: "Biến thể Xương trắng"
	quest.6852BEFDD4DE4E4B.quest_desc: ["&9Soul-Touched Deepshelves&r là phiên bản nâng cấp của &9Deepshelves&r. \n\n\n\nChúng được chế tạo với một &bSoul Lantern&r và 3 &3Sculk Blocks&r. Bạn sẽ cần &5Silk Touch&r để nhặt &3Sculk Blocks&r. \n\n\n\nSau đó, chúng ta có thể chế tạo phiên bản &9Soul-Touched&r. Chúng sẽ cung cấp nhiều &cQuanta&r hơn ở mức &c15%&r! \n\n\n\nNó cũng tăng max &aEterna&r lên &a75&r."]
	quest.6852BEFDD4DE4E4B.title: "&9Soul-Touched Deepshelf"
	quest.686B25F2E9D8CC97.quest_desc: ["Khi viết điều này, tháng 7 đã kết thúc nên tôi có khoảng 3 tháng cho đến Halloween. Nhưng chưa bao giờ là quá sớm để bắt đầu trải nghiệm không khí Spooky! Giống như Spirit Halloween, chúng ta có thể trải nghiệm Spooky 3 tháng trước khi nó thực sự bắt đầu. Lần này bằng cách Nhấp chuột phải một Lò nung với Spook-alator! Một khi đã đến lúc bắt đầu chuẩn bị cho Thanksgiving, Shift + Nhấp chuột phải chúng để Un-Spook-Alate!"]
	quest.686B25F2E9D8CC97.quest_subtitle: "\"Đây là Halloween\""
	quest.686EB173C94301C0.quest_desc: ["&e&lIron's Spells&r &bIce Armor&r!"]
	quest.686EB173C94301C0.quest_subtitle: "20"
	quest.686EB173C94301C0.title: "&bBộ đồ Băng Pháp Sư"
	quest.6884E25641A1020C.quest_desc: ["&5Thư viện Phép thuật&r là nơi lưu trữ &5Sách phép&r tuyệt vời nhất, chưa từng có! \n\n\n\nĐể chế tạo, bạn cần 4 &3Rương End&r, 1 &5Bàn phép thuật&r, và 4 trong số &d&lKệ sách Infused&r: &4Infused Hellshelf&r, &bInfused Seashelves&r, và &9Deepshelves&r. \n\n\n\nĐể sử dụng, bạn có thể nhấn Shift + Click trái vào &5Sách phép&r hoặc đặt chúng vào &9Khe xanh&r. Điều này sẽ thêm &5Sách&r vào &5Thư viện&r. \n\n\n\n&5Sách&r được sắp xếp theo tên và được lưu trữ bằng Điểm. Mỗi Cấp của &5Sách phép&r quyết định Cấp, và nó được phản ánh qua số &5Sách&r cần thiết để đạt Cấp đó. Cấp 1 là 1 Điểm. Cấp 2 là 2 Điểm. Cấp 3 là 4 Điểm. Cấp 4 là 8 Điểm. \n\n\n\nMỗi &5Sách&r được lưu trữ tối đa 32768 Điểm, và chúng có thể được lấy ra bằng cách Click trái vào &5Sách&r đã lưu. Mỗi lần Click sẽ thêm một Cấp vào &5Sách&r trong &6Khe cam&r. \n\n\n\nBạn có thể Click các &5Sách&r khác nhau để thêm vào &5Sách&r trong &6Khe cam&r, tương tự như kết hợp &5Sách&r trong Anvil. \n\n\n\nCấp tối đa của &5Sách phép&r được xác định bởi Cấp cao nhất của &5Sách&r bạn đã đưa vào. Không quan trọng bạn có 32000 Điểm, nếu bạn chỉ đưa vào &5Sắc nhọn III&r, bạn chỉ có thể lấy ra &5Sắc nhọn III&r."]
	quest.6884E25641A1020C.title: "&5Thư viện Phép thuật"
	quest.68B0B3DAF1145191.quest_desc: ["Hai thứ đầu tiên bạn cần để bắt đầu trong AE2 là &bMáy sạc&f và &bMáy in&f.\n\n\n\n&Máy sạc&f, khi được cung cấp năng lượng, sẽ lấy &eTinh thể Quạp Certus&r và sạc chúng. Những &eTinh thể Certus đã sạc&r này có thể được dùng để sản xuất &eFluix&f, một tài nguyên quan trọng khác trong mod. Nó cũng có thể dùng để sạc bất kỳ item nào lưu trữ năng lượng.\n\n\n\n&Máy in&f có thể dùng để biến các tinh thể quạp khác nhau trong AE2 thành bụi, nhưng quan trọng hơn là dùng để chế tạo &eMạch in đặc biệt&f và &eBộ xử lý&f, như sẽ rõ ràng hơn trong nhiệm vụ tiếp theo."]
	quest.68B0B3DAF1145191.quest_subtitle: "Trước hết"
	quest.68B0B3DAF1145191.title: "Trước hết"
	quest.68B44B9E939F4228.quest_desc: ["Ở đỉnh &aPháo đài&r là &a&lArchevoker&r. Chỉ thù địch với Người chơi và bất kỳ ai tấn công hắn. \n\n\n\nHắn có 60 Trái tim, và tấn công như một &aEvoker&r bình thường cộng với thêm! &aPháo hoa&r, &aKhiên&r, và &aLuồng gió bão&r! \n\n\n\nKhi bị giết, hắn sẽ rơi Arcane Essence, Mực, &aEvokation Runes&r, &aEvokation Scrolls&r, và rơi hiếm là &aGrimore of Evokation&r!\n\n{image:atm:textures/questpics/iron_spells/spells_evoker.png width:100 height:200 align:center}"]
	quest.68B44B9E939F4228.title: "&a&lArchevoker"
	quest.68DABFFB6B3E1A57.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_eye.png width:100 height:150 align:center}"]
	quest.68DABFFB6B3E1A57.quest_subtitle: "Pháo đài"
	quest.68DABFFB6B3E1A57.title: "Trang trí giáp mắt"
	quest.68E6AE1B9EBCEFFF.title: "&3Chùy Vibranium"
	quest.690B89D23134B624.quest_desc: ["Lấy phấn của bạn, vẽ nghi lễ &dLiên hệ Ronaza&r của bạn, và sẵn sàng tạo ra PHẤN TUYỆT ĐỐI!\n\n\n\nThay vì phải mang theo một bộ đầy đủ 16 cây phấn, bạn có thể sử dụng Phấn Cầu Vồng để vẽ một Rune đổi màu được tính là bất kỳ cái nào trong số chúng!"]
	quest.690B89D23134B624.title: "&cR&6a&ei&an&9b&5o&dw&r Phấn"
	quest.690CFF61CE787D43.quest_desc: ["Nhựa là tài nguyên chính của &bIndustrial Foregoing&r, bây giờ bạn có truy cập vào một số máy móc rất hữu ích!"]
	quest.695889817162EFC7.quest_desc: ["&aEXP&r rất quan trọng cho &5&lPhép thuật Apotheosis&r! Mỗi &5Phép thuật&r đều cần nó! (Tại sao bạn nghĩ tôi cho nó trong mỗi Phần thưởng?) \n\n\n\nVới &d&lInfusion&r chúng ta có thể biến &6Bình Mật ong&r thành &aBình Phép thuật&r. Thực tế chúng ta có 3 loại &d&lInfusion&r khác nhau cho nó! Nó từ 1 &aBình Phép thuật&r, đến 8, đến 32! \n\n\n\nĐầu tiên, là cho 1 &aBình&r và chỉ cần 2 &9Kệ Sculk Vang vọng&r. \n\n\n\nThứ hai, là cho 8 &aBình&r và cần 5 &9Kệ Sculk Vang vọng&r và 1 &9Kệ Sculk Chạm Hồn&r. \n\n\n\nCuối cùng, là cho 32 &aBình Phép thuật&r và sẽ cần 5 &9Kệ Sculk Vang vọng&f, 3 &9Kệ Sculk Chạm Hồn&f, và 1 &dDraconic Endshelf&r!"]
	quest.695889817162EFC7.title: "Chế tạo &aEXP&r?"
	quest.6963EC8A71D66AE3.quest_desc: ["Sâu trong Đầm lầy Mangrove bùn lầy là nơi trú ẩn của sinh vật ẩn sĩ gọi là &2&lApotheocarist&r. \n\n\n\nKhông có ai ở gần, và chỉ có những gì hắn cần cho bùa của mình xung quanh. \n\n\n\nBạn có thể tìm thấy &2&lApotheocarist&r trong &2Lều&r của hắn. \n\n\n\nỞ đó bạn cũng có thể tìm thấy Nồi lớn và Giá đỡ pha chế với Bùa!\n\n{image:atm:textures/questpics/iron_spells/spells_magrovehut.png width:200 height:100 align:center}"]
	quest.6963EC8A71D66AE3.title: "&2Lều Mangrove"
	quest.69763C2E2F454A73.quest_desc: ["&c&lLửa&r rõ ràng liên quan đến &cLửa&r. Hầu hết các Cuộn Scrolls đều sử dụng &cLửa&r để đốt và làm tổn thương thứ gì đó. \n\n\n\nVật liệu Tập trung của &c&lLửa&r là &cGậy Lửa&r. Bạn có thể chế tạo &cRune Lửa&r hoặc lấy chúng từ việc giết &c&lPháp sư Lửa&r. \n\n\n\nCác &cCuộn Scrolls&r của nó là &cĐỏ nhạt&r với chữ &8Xám&r."]
	quest.69763C2E2F454A73.title: "&c&lLửa"
	quest.69838E3F12218D68.quest_desc: ["Lò Rèn Cuộn, bạn có thể đoán nó làm gì! \n\n\n\nNó tạo ra &3Cuộn&r! \n\n\n\nThêm Mực để đặt Độ hiếm. Giấy cho &3Cuộn&r thực tế. Sau đó là Món đồ của loại &3Phép thuật&r bạn muốn (&cGậy Lửa&r cho &c&lLửa&r, &2Khoai Tây Độc&r cho &2&lThiên Nhiên&r, V.V). Cuối cùng, chọn &3Phép thuật&r bạn muốn và nó sẽ được tạo ra!\n\n{image:atm:textures/questpics/iron_spells/spells_scroll_gui.png width:150 height:100 align:center}"]
	quest.698A959C9E449592.quest_desc: ["Bước tiếp theo trong tiến trình là tạo một Cuốc sắt.\n\n\n\nCuốc này có thể khai thác một số quặng hiếm trong trò chơi, bao gồm Kim Cương!"]
	quest.698A959C9E449592.title: "Một &aCuốc Sắt&r"
	quest.69A517AB8A801939.quest_desc: ["&5Wither&r là một trong những trùm cuối khó giết nhất trong Minecraft. Chủ yếu vì nó bay. Và nổ. Và nhanh. Bạn hiểu rồi đó.\n\n\n\nĐể triệu hồi nó, đặt 4 Cát Linh Hồn thành hình chữ T. Đặt 3 Sọ Wither Skeleton lên trên 'T' và &5Wither&r sẽ xuất hiện.\n\n\n\nMẹo: Nó nổ. Rất nhiều. Đừng làm điều này gần căn cứ của bạn."]
	quest.69A517AB8A801939.title: "&6Giết &5Wither"
	quest.69B7DE2283B4EE6C.quest_desc: ["&bĐơn vị Xử lý Đồng thời Chế tạo&f giúp tăng tốc các công việc chế tạo bằng cách cho phép các nhà cung cấp mẫu gửi vật phẩm ra thiết bị kết nối nhanh hơn hoặc làm việc đồng thời để tạo nhiều nguyên liệu cần thiết.\n\n\n\nBộ đồng xử lý AE2 cơ bản cung cấp một 'luồng' đồng xử lý để hỗ trợ điều này, trong khi đơn vị đồng xử lý từ &dMEGA Cells&f cung cấp 4 luồng trong một khối duy nhất."]
	quest.69B7DE2283B4EE6C.quest_subtitle: "Tải thêm lõi CPU"
	quest.69F11A94D44AB5CF.quest_subtitle: "Quá nhiều ánh sáng!"
	quest.69F11A94D44AB5CF.title: "&fÁnh sáng Xychorium Gems"
	quest.6A07D09831428CB9.quest_desc: ["&4&lNether&r có thể khá đáng sợ, nếu bạn thích đi biển hơn là &bBiển&r, hãy dùng &bSeashelves&r! \n\n\n\n&bSeashelves&r là lối tiếp cận đầu tiên của bạn đến &5Arcana&r, chúng cấp &53% Arcana&r và &a3 Eterna&r. \n\n\n\nTốt hơn &7Kệ&r thông thường đúng không? \n\n\n\nBạn sẽ cần 16 cho &d&lCường hóa&r... à 15 cho &d&lCường hóa&r, 1 để &d&lĐã cường hóa&r! \n\n\n\nGiống như &4Hellshelves&r, tôi sẽ cho bạn thêm, chỉ cần thu thập 11 ngay bây giờ!\n\n{image:atm:textures/questpics/apothic/enchant_seashelf.png width:100 height:100 align:center}"]
	quest.6A07D09831428CB9.title: "&bSeashelves"
	quest.6A2B2C5E2ADCE366.quest_desc: ["Sophisticated Backpacks cung cấp những chiếc Ba lô có thể nâng cấp, sử dụng bộ lọc để thêm các tính năng tiện lợi!\n\n\n\nBa lô có thể được đặt vào ô Lưng của Curios và có thể được nhuộm màu."]
	quest.6A2B2C5E2ADCE366.quest_subtitle: "Kho đồ quá nhỏ"
	quest.6A2B2C5E2ADCE366.title: "Sophisticated Backpacks"
	quest.6A452BFC8A967C39.quest_desc: ["Đeo những &aMóng vuốt&r này chỉ khiến bạn cảm thấy một cách đặc biệt. Adrenaline dâng trào, suy nghĩ ngừng lại, sức mạnh trỗi dậy như không có gì so sánh được! \n\n\n\nVới &aMóng vuốt hoang dã&r, bạn sẽ tấn công nhanh hơn rất nhiều với Vũ khí hoặc Cú đấm của mình."]
	quest.6A452BFC8A967C39.quest_subtitle: "Tay"
	quest.6A452BFC8A967C39.title: "&aMóng vuốt hoang dã&r"
	quest.6A497B063CF32A5C.quest_desc: ["Mắt nhện lên men có thể được dùng để tăng số lượng quái vật có thể sinh ra từ một máy sinh quái. Số lượng quái vật sinh ra là ngẫu nhiên với số lượng tối đa được xác định bởi con số. Nó tăng hoặc giảm 1 cho mỗi mắt, tối đa là 16."]
	quest.6A497B063CF32A5C.title: "Số lượng sinh"
	quest.6B2027DA7AA6FF34.quest_desc: ["&9Powah&r là một mod công nghệ về việc tạo ra, lưu trữ và truyền tải &dNăng lượng&r. Từ sản xuất FE cơ bản đến &aLò phản ứng&r sản xuất &b250k FE/t&r, Powah đáp ứng mọi nhu cầu của bạn!\n\n\n\nĐể bắt đầu, hãy đi ra ngoài và khai thác một ít &aUraninite&r!"]
	quest.6B2027DA7AA6FF34.title: "&aChào mừng đến với &9Powah&r!!!"
	quest.6B40AF49F505A551.quest_desc: ["Bạn bao giờ muốn giống như Batman? Sống trong bóng tối mang lại công lý? Vậy thì &9Midnight Robe&r hoàn hảo cho bạn! {Nó cũng rất thời trang!) Khi mặc trong mức độ ánh sáng thấp, bạn sẽ trở nên Vô hình và được tăng Tốc độ. Điều này có thể được nâng cấp để mức độ ánh sáng cao hơn hoặc tăng thêm Tốc độ. \n\n \n\nKhả năng thứ hai mang lại cảm giác của hầu hết các trò chơi stealth. Khi bạn đánh một Quái vật khi đang Vô hình, bạn sẽ gây nhiều sát thương hơn nhưng mất khả năng ẩn náu và tốc độ cho đến khi bạn rời khỏi Vòng tròn được tạo ra xung quanh Quái vật."]
	quest.6B40AF49F505A551.quest_subtitle: "Có thể tìm thấy trong Hầm mỏ hoặc Pháo đài"
	quest.6B40AF49F505A551.title: "&9Midnight Robe"
	quest.6B671CB07D046BEC.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_diamond.png width:100 height:150 align:center}"]
	quest.6B671CB07D046BEC.title: "&bKim cương&r"
	quest.6B747129A85AA768.quest_desc: ["Bây giờ còn giống hơn Absorption Hopper! \n\n\n\nVacuum Module bây giờ sẽ nhặt cả Lõi XP và Vật phẩm. Bạn làm gì với XP là tùy bạn!"]
	quest.6C001E18093FC037.title: "Cây trồng"
	quest.6C1BBA559963B3DF.quest_desc: ["&aDictionary Of Spirits&r đóng vai trò như Sổ tay Hướng dẫn cho &dOccultism&r. Bạn chắc chắn cần làm cái này nếu bạn muốn tiếp tục với mod!\n\n\n\nTừ điển có một hướng dẫn theo kiểu nhiệm vụ bên trong nếu bạn thích đọc nó thay vì làm những nhiệm vụ này!\n\n\n\nBạn cũng sẽ cần cuốn sách này để chế tạo một số thứ trong pack, vì vậy bạn gần như phải làm nó. :)"]
	quest.6C1BBA559963B3DF.title: "Cuốn sách nhỏ về &cDemons"
	quest.6C25D42C36175BF4.quest_desc: ["Máy này \"Làm sạch\" quặng của chúng ta. Nó biến 1 Quặng thô thành 2 \"Vụn\", sau đó có thể đưa qua Máy nghiền để biến thành bụi bẩn, rồi qua Buồng làm giàu để được bụi sạch, rồi qua lò nung để biến thành phôi.\n\n\n\nĐiều này sẽ làm gấp đôi sản lượng phôi của bạn.\n\n\n\nMáy này cần &aOxygen&r để chạy, được tạo ra bằng cách bơm nước vào &6Máy tách điện ly&r."]
	quest.6C25D42C36175BF4.quest_subtitle: "Nó tạo ra Vụn."
	quest.6C2C135B9B7B9402.quest_desc: ["&d&lInfusion&r là một phiên bản đặc biệt của &5Phép thuật&r, mỉa mai là dùng để có &5Bùa phép&r tốt hơn. \n\n\n\nKhi đạt đủ lượng &aEterna&r, &cQuanta&r, và &5Arcana&r, &5Bùa phép&r sẽ cung cấp &d&lInfusion&r. \n\n\n\n(Để biết cấp độ cần thiết, bạn có thể kiểm tra EMI hoặc làm theo các Nhiệm vụ này)"]
	quest.6C2C135B9B7B9402.title: "&l&dHòa trộn"
	quest.6C57D64518FF22C0.quest_desc: ["Phần còn lại của &5Bùa phép&r đến từ &8Sách&r này. \n\n\n\n&5Bất diệt&r... Tôi thực sự không biết còn gì khác..."]
	quest.6C57D64518FF22C0.title: "&8Sách ETC."
	quest.6C5F9D0D447EFB9C.quest_desc: ["Bạn nghĩ &l&2Vanilla&r là tất cả những gì chúng ta có? \n\n\n\n&6Allthemodium Armor&r có nhiều Điểm Giáp và Độ Bền Giáp hơn, cộng thêm Tăng Cường Bảo Vệ chống lại Ma thuật và các buff khác bạn có thể đọc trong Trang Nhiệm vụ &6&lAllthemodium&r! \n\n\n\nNhân tiện bạn sẽ cần &cNetherite&r để chế tạo nó."]
	quest.6C5F9D0D447EFB9C.quest_subtitle: "24"
	quest.6C5F9D0D447EFB9C.title: "&6Allthemodium Armor"
	quest.6CAD67D21E1EA861.quest_desc: [""]
	quest.6CAD67D21E1EA861.quest_subtitle: "&oTruy cập từ xa phổ quát."
	quest.6CAD67D21E1EA861.title: "&7&lBộ phát Nexium"
	quest.6CC5FE34778F0DFA.quest_desc: ["Khi chơi modpack này, bạn chắc chắn sẽ có quá nhiều item. Nó chỉ đơn giản là hoạt động, và nếu bạn chưa giải quyết được vấn đề lưu trữ, thì &dDimensional Storage&r có thể là giải pháp phù hợp cho bạn!\n\n\n\nĐể bắt đầu với giải pháp lưu trữ kỳ diệu này, bạn cần chế tạo &dDimensional Storage Actuator&r và đặt nó xuống thế giới. Nó hoạt động giống như một Shulker Box, nghĩa là nếu bạn phá nó, nó sẽ không mất bất kỳ item nào được lưu bên trong.\n\n\n\nMặc định, nó có 128 ô lưu trữ, mỗi ô có thể chứa tối đa 16 chồng item, ngoại trừ các item có dữ liệu &5NBT&r. Chúng sẽ không chồng được và sẽ chiếm toàn bộ một ô, vì vậy hãy chắc chắn để những item này ra ngoài!\n\n\n\nNếu bạn không chắc chắn item nào có dữ liệu NBT, bạn luôn có thể xem nhiệm vụ \"NBT and You\" trong chuỗi nhiệm vụ Storage để biết thêm thông tin về NBT!"]
	quest.6CC5FE34778F0DFA.title: "&c&mDemonir&r &dKho lưu trữ Ma thuật&r!"
	quest.6CCDEEDA2C99DA66.quest_desc: ["Nhiệm vụ này được tạo bởi &6AllTheMods Staff&r, hoặc một &2Người đóng góp cộng đồng&r để sử dụng trong AllTheMods Modpacks. \n\n\n\nVì tất cả các pack &6AllTheMods&r được cấp phép theo &eAll Rights Reserved&r, nhiệm vụ này không được phép sử dụng trong bất kỳ pack công khai nào không được phát hành bởi &6AllTheMods Team&r mà không có sự cho phép rõ ràng. \n\n\n\nNhiệm vụ này được cố ý ẩn, nếu bạn thấy điều này, bạn đang ở chế độ chỉnh sửa."]
	quest.6CD1720B76F47806.quest_desc: ["Máy phát này sẽ đốt Bio Fuel thành năng lượng. Nó sản xuất khoảng 140FE/t."]
	quest.6CE7115DA2B23776.quest_desc: ["Không tốt hơn nhiều so với cái Đơn giản... \n\n\n\nNó có thể chứa thêm một &3Spell&r so với Journal Đơn giản! Đó là một &3Spell&r cực kỳ mạnh mẽ nữa sẵn sàng!"]
	quest.6CE7115DA2B23776.title: "Journal Bằng sắt"
	quest.6D0876A402C22067.quest_desc: ["XyCraft có một số chức năng lưu trữ và thao tác item. Tuy nhiên, không nhiều như lưu trữ và thao tác chất lỏng!"]
	quest.6D0876A402C22067.title: "&6Lưu trữ và Thao tác Item"
	quest.6D09511D64DDC282.quest_desc: ["&dWarden&r có thể được triệu hồi bằng cách kích hoạt &5Sculk Sensor&r nằm gần &3Sculk Shrieker&r ít nhất 3 lần.\n\n\n\nLời giải thích vui: Warden bị mù! Nó chỉ có thể tìm thấy bạn nếu nghe thấy bạn, vì vậy hãy bay xung quanh hoặc rình!\n\n\n\nMẹo: Dù bạn dùng tấn công tầm xa hay cận chiến cũng không quan trọng, vì nó sẽ tìm thấy bạn. Và nó sẽ đánh bạn. Nếu bạn đi quá xa, nó sẽ đào xuống đất và xuất hiện ngay bên cạnh bạn! Chúc may mắn :D"]
	quest.6D09511D64DDC282.title: "&5Giết Warden"
	quest.6D232F6D8E8DA546.quest_desc: ["Rất phổ biến vào dịp Halloween!\n\n{image:atm:textures/questpics/iron_spells/spells_outfit_plagued.png width:60 height:100 align:center}"]
	quest.6D232F6D8E8DA546.title: "&2Bộ trang phục Dịch bệnh"
	quest.6D54B45CDA70FEAB.quest_desc: ["&bEnergy Card&f có thể được áp dụng cho hầu hết các thiết bị có thể sạc như Portable Cells và Wireless Terminals (sẽ đề cập sau) để cũng tăng &otheir&r bộ đệm năng lượng."]
	quest.6D738730B371B152.quest_desc: ["&l&7Mining Dimension&r là một thế giới Superflat với hoàn toàn không có gì trên bề mặt. \n\n\n\nDưới bề mặt là gần như tất cả các loại Quặng. \n\n\n\n&l&7Mining Dimension&r không có Hang động, không có điểm Sinh quái, và không có gì cản trở bạn. Nó chỉ toàn các loại Đá và Quặng! \n\n\n\nSự sinh sản của quặng khác nhau tùy theo Y Level và lớp trong &l&7Mining Dimension&r.\n\n\n\nTôi khuyên bạn nên thiết lập một Quarry."]
	quest.6D738730B371B152.title: "&l&7Mining Dimension"
	quest.6D88C19F47D0D469.title: "Cấp: &7Nhỏ"
	quest.6DB1AAAD926486BC.quest_desc: ["Fluid Tanks lưu trữ chất lỏng.\n\n\n\nNó có chế độ xô có thể chuyển đổi để hút chất lỏng. Rất hữu ích cho lava vào đầu game!"]
	quest.6DB1AAAD926486BC.quest_subtitle: "Nó có CHẾ ĐỘ XÔ!"
	quest.6DB5732177AABB87.quest_desc: ["Cấu trúc lớn nhất và khó nhất từ &lIron's Spells&r. \n\n\n\nĐây là những cấu trúc sâu dưới lòng đất tương tự như Trial Chambers. Bạn cũng có thể sử dụng Wayward Compasses để giúp tìm thấy nó! \n\n\n\nBên trong có rất nhiều Spawners, Trial Spawners, và tất nhiên là Loot. \n\n\n\nPhòng quan trọng nhất là Throne Room, một khi bạn đến đó, bộ xương của &4&lDead King&r sẽ hồi sinh! (Nếu không, bạn có thể cần nhấp vào ông).\n\n{image:atm:textures/questpics/iron_spells/spells_catacombs.png width:200 height:100 align:center}"]
	quest.6DB5732177AABB87.title: "&4Hầm mộ"
	quest.6E0624750DF8CD18.quest_desc: ["Không thể chế tạo chúng nữa, giờ bạn cần nâng cấp &5Netherite&r lên nó luôn. \n\nĐúng, nó lưu Enchantments và sửa chữa nó!"]
	quest.6E0624750DF8CD18.title: "&6Công cụ Allthemodium"
	quest.6E15447FC3D678E0.quest_desc: ["Thẻ &bFuzzy Card&f cho phép một vật phẩm đã lọc được khớp bất kể bất kỳ (NBT) metadata nào như damage hay enchantments, trong khi thẻ &bInverter Card&f chuyển đổi bộ lọc trên các bus như vậy từ whitelist sang blacklist."]
	quest.6E15447FC3D678E0.quest_subtitle: "Hai thẻ IO còn lại"
	quest.6E15447FC3D678E0.title: "Nói đại khái"
	quest.6E17595887A051C2.quest_desc: ["&l&2Minecraft với mod&r giới thiệu chúng ta với các nghề nghiệp mới của người làng! \n\n\n\nForge Hammer: &5Industrialist&r \n\n\n\nCharger: &bFluix Researcher&r \n\n\n\nAdvanced Beehive: &6Beekeeper&r \n\n\n\nCoffee Maker: &9Engineer&r \n\n\n\nArcane Core: &dShady Wizard&r \n\n\n\nForagers Table: &aForager&r \n\n\n\nPowered Rolling Machine: &eCartman&r \n\nManual Rolling Machine: &eTrackman&r \n\n\n\nEngineer's Workbench: &7Gunsmith&r \n\nWhite Banner: &7Outfitter&r \n\nEngineer's Circuit Workbench: &7Electrician&r \n\nEngineer's Crafting Table: &7Machinist&r \n\nTurntable: &7Structural Engineer&r \n\n\n\nCharging Station: &4Pressure Mechanic&r \n\n\n\nSaw: &8Carpenter&r"]
	quest.6E17595887A051C2.title: "Các nghề nghiệp khác"
	quest.6E3D53D1C4569A89.quest_desc: ["Cho phép bạn bơm kinh nghiệm giữa bạn và Balo."]
	quest.6E3D53D1C4569A89.quest_subtitle: "Lưu trữ kinh nghiệm"
	quest.6E3D53D1C4569A89.title: "&aNâng cấp máy bơm kinh nghiệm"
	quest.6E5954C257726F86.quest_desc: ["Lọc theo từng mod có thể rất hữu ích.\n\n\n\nĐể sử dụng, hãy đặt một vật phẩm từ một mod cụ thể, sau đó nó sẽ hiển thị tên mod, và nhấn nút Cộng để thêm nó!"]
	quest.6E9041744C592573.quest_desc: ["Thêm khả năng bơm chất lỏng từ nâng cấp bể chứa."]
	quest.6ECDD26CCCBC07C3.quest_desc: ["Nâng cấp trực tiếp từ &5Netherite&r.\n\n{image:atm:textures/questpics/allthemodium/all_armor_all.png width:100 height:175 align:center}"]
	quest.6ECDD26CCCBC07C3.title: "&6Áo giáp Allthemodium"
	quest.6EDAB29FBD3C60A3.quest_desc: ["Vùng sinh thái này được giới thiệu trong Bản cập nhật Hoang dã!\n\n\n\nCẩn thận! Bạn có thể vô tình triệu hồi một người bạn mới.\n\n\n\nP.S. - Anh ta không thân thiện."]
	quest.6EDAB29FBD3C60A3.title: "&6Tham quan Vùng &dTối Sâu&r!"
	quest.6EE5BE5693E8ACE4.quest_desc: ["Trong &dThế giới Cuối&r, bạn sẽ tìm thấy trùm cuối cùng của Minecraft gốc: &5Rồng End&r.\n\n\n\nỞ đỉnh mỗi cột Đá Obsidian, bạn sẽ tìm thấy Pha lê End chữa lành cho Rồng. Hãy đảm bảo phá chúng trước tiên! Chúng cũng gây nhiều sát thương, nên hãy tạo khoảng cách!\n\n\n\nKhi đánh bại, một &dTrứng Rồng&r sẽ xuất hiện ở đỉnh Cổng Thoát. Nó không thể khai thác như các khối thường, nhưng bị ảnh hưởng bởi trọng lực."]
	quest.6EE5BE5693E8ACE4.title: "&5Thế giới Cuối"
	quest.6EE68EEFE388CF8A.quest_subtitle: "&f4 &cSát Thương Tấn Công"
	quest.6F3D0A248B5A9CA2.quest_desc: ["&bÔ Dự Trữ Không Gian&f được dùng để chứa một thể tích xác định mỗi cái, và có ba dung lượng khác nhau cho phép tối đa 2x2x2, 16x16x16 và 128x128x128 khối không gian. \n\n\n\nKhi mã hóa, một ô được cấp phát một phần không gian trong &ekhông gian lưu trữ&f, cùng với một ID duy nhất tương ứng với vùng được cấp phát cho ô. Một ô đã mã hóa vẫn có thể được dùng trong Cổng Vào/Ra Không Gian để lấy lại bất kỳ khối và thực thể nào đã lưu trữ. \n\n\n\nTừ đó, bất kỳ khối nào nằm trong vùng không gian của ô hoặc trong một SCS có cùng kích thước như cái dùng để mã hóa ban đầu đều có thể được di chuyển ngược lại về thế giới bình thường hoặc vào không gian tương ứng. Nếu có khối vừa trong vùng không gian vừa trong SCS, chúng sẽ đơn giản là hoán đổi vị trí cho nhau."]
	quest.6F3D0A248B5A9CA2.title: "Ô Dự Trữ Không Gian"
	quest.6F62B5510FA881CD.quest_subtitle: "Phôi Sắt Chế Tạo Cơ Bản"
	quest.6F62B5510FA881CD.title: "Osmium"
	quest.6F71FD826C29C31A.quest_desc: ["Cái này có thể mới với những người quay trở lại từ các phiên bản trước. Bằng cách dùng trứng rùa biển trên một bộ phát sinh, nó sẽ chỉ sinh ra các quái vật con của quái vật trong đó. Cái này chỉ hoạt động với các quái vật con vanilla, không phải modded."]
	quest.6F71FD826C29C31A.title: "Trẻ Trung"
	quest.6F76DA3BBAE8337B.quest_desc: ["Bộ áo giáp tuyệt vời nhất chúng ta có thể lấy từ &6&lAllthemodium&r, &5Unobtainium&r! \n\n\n\nBây giờ với 100% Kháng Đẩy Lùi và chỉ số cao hơn ở mọi nơi! \n\n\n\nCũng cần &3Áo Giáp Vibranium&r để chế tạo."]
	quest.6F76DA3BBAE8337B.quest_subtitle: "40"
	quest.6F76DA3BBAE8337B.title: "&5Áo Giáp Unobtainium"
	quest.6FBE5B5D5027B32C.quest_desc: ["Mặc cái &7mũ&r này khiến lũ sinh vật của bạn chạy như bay! \n\n\n\nNó cũng rất đẹp."]
	quest.6FBE5B5D5027B32C.quest_subtitle: "Đầu"
	quest.6FBE5B5D5027B32C.title: "&7Mũ cao bồi"
	quest.6FC55CF56BE22866.quest_subtitle: "531,441 Đất"
	quest.6FC7DC1F856A748D.quest_desc: ["Được rồi, đây là một phần dài, hãy kiên nhẫn với tôi. Kỹ năng đầu tiên cho phép hai chế độ, &6Thánh thiện&r và &7Bất thiện&r. &6Thánh thiện&r lấy một phần Hồi máu của bạn và dùng nó làm Sát thương lên kẻ thù. &7Bất thiện&r ngược lại, nó lấy Hồi máu của kẻ thù để giúp bạn gây nhiều sát thương hơn. Các sinh vật như &dEnder Dragon&r và &5Wither&r đều tự hồi máu. \n\n \n\nKỹ năng thứ hai là Sám hối, khi đang hoạt động nó sẽ Đốt cháy các sinh vật Undead (Zombie, Skeleton và họ hàng của chúng). \n\n \n\nKỹ năng thứ ba ban cho một khoảng thời gian ngắn miễn nhiễm."]
	quest.6FC7DC1F856A748D.quest_subtitle: "Tìm thấy trong tất cả các Làng"
	quest.6FC7DC1F856A748D.title: "&6Thánh&r &7Mặt dây chuyền&r"
	quest.6FEED25FFAC4101F.quest_desc: ["Sử dụng &aRàng buộc cao hơn của Strigeor&r, bạn có thể tạo Gray Paste. Thoa nó lên một mảnh White Chalk không tinh khiết để tạo Gray Chalk."]
	quest.6FEED25FFAC4101F.title: "&8Phấn xám"
	quest.6FF04DD735346BED.quest_desc: ["Biến Latex thành Dry Rubber."]
	quest.6FF54B5D953E1797.quest_desc: ["Nếu bạn biết thuật ngữ '§4Berserk§r' trong hầu hết các trò chơi, điều đó sẽ giúp bạn hiểu '§cRage Glove§r' hoạt động như thế nào. Nếu bạn không biết, cơ bản của §4Berserk§r là khi ai đó có máu thấp hoặc nhận nhiều sát thương, họ thường sẽ gây ra sát thương cao hơn và nhanh hơn. Đó là điều xảy ra với Khả năng Đầu tiên, khi bạn nhận sát thương, bạn tích lũy điểm có thể đổi lấy sát thương và tốc độ cao hơn! \n\n \n\nKhả năng Thứ hai làm điều đó một cách thụ động, và cho bạn Hồi sinh theo lượng máu bạn đã mất. \n\n \n\nKhả năng Thứ ba là một khả năng chủ động, khi sử dụng nó (Alt Tab) bạn sẽ lao và tấn công bất kỳ sinh vật nào bạn đang nhìn vào. Khi bị đánh trúng, nó sẽ đốt cháy chúng §cFire§r, gây chảy máu, và bất kỳ điểm §4Berserk§r tích lũy nào sẽ gây thêm sát thương!"]
	quest.6FF54B5D953E1797.quest_subtitle: "Có thể tìm thấy ở Cổng Phá hủy, Pháo đài Nether và Bastion"
	quest.6FF54B5D953E1797.title: "§cRage Glove"
	quest.6FFFAE334DFAAAAB.quest_desc: ["Như bạn có thể đã nhận thấy, nghi lễ thường... hơi chậm. Nhưng không còn nữa! Sử dụng §cSevira's Permanent Confinement§r, bạn có thể tạo ra §bIesnium Ritual Bowl§r.\n\n\n\nKhi sử dụng thay cho Golden Ritual Bowl, nó giảm đáng kể thời gian thực hiện nghi lễ, xuống còn một phần tư thời gian ban đầu!"]
	quest.6FFFAE334DFAAAAB.quest_subtitle: "Nghi lễ Siêu tốc độ!"
	quest.700F3FF7C23D0C0F.quest_desc: ["§5Ender Cell§r sẽ lưu trữ năng lượng cho một kênh trong §7Ender Network§r của bạn. Để tăng dung lượng năng lượng của mạng lưới, nhấp chuột phải vào Ender Cell để mở giao diện, sau đó thêm một §aBattery§r hoặc §9Energy Cell§r để tăng tổng dung lượng."]
	quest.70B6C9409AE69284.quest_desc: ["Nature's Compass cung cấp cho bạn danh sách các vùng sinh thái bạn có thể tìm kiếm.\n\n\n\nChọn một vùng sinh thái, sau đó nhấn 'Tìm kiếm.' Bạn sẽ thấy một số thông tin ở góc trái trên, và la bàn sẽ chỉ hướng đến vùng sinh thái đó.\n\n\n\nExplorer's Compass hoạt động tương tự nhưng dành cho cấu trúc, thay vì vùng sinh thái."]
	quest.70B6C9409AE69284.quest_subtitle: "Giúp tìm Vùng sinh thái/Cấu trúc"
	quest.70B6C9409AE69284.title: "La bàn để Tìm kiếm"
	quest.70C7D92844089DEB.quest_desc: ["Giống như các Pendant khác, cái này có cơ hội làm tổn thương kẻ tấn công bạn, chỉ với Tia chớp! \n\n\n\nNgoài ra còn khiến nếu bạn (không) may mắn bị Tia chớp đánh trúng, nó sẽ không làm bạn bị thương."]
	quest.70C7D92844089DEB.quest_subtitle: "Vòng cổ"
	quest.70C7D92844089DEB.title: "&bMặt dây chuyền Sấm sét&r"
	quest.70D2C5FAC661E01A.quest_desc: ["&bHeart-Forged Seashelf&r là một nâng cấp khác của &bInfused Seashelf&r. \n\n\n\nNó hơi đắt nhưng cho rất nhiều &5Arcana&r! \n\n\n\nĐiều này sẽ rất hữu ích cho các &d&lInfusions&r sau này cần rất nhiều &5Arcana&r."]
	quest.70D2C5FAC661E01A.title: "&bHeart-Forged Seashelf"
	quest.70ED849A2EB44DEE.quest_subtitle: "Cấp: &b3"
	quest.711DDD55CEC439E5.quest_desc: ["&aEmerald Furnace&r, tôi tự hỏi liệu Villagers có thể trao đổi nó không? \n\n \n\nNó hoạt động với 40 Ticks (chỉ 2 giây) để nấu chảy! Chớp mắt là bạn có thể bỏ lỡ. \n\n \n\nChúng được chế tạo từ &bDiamond Furnace&r và có thể biến thành &dObsidian Furnace&r."]
	quest.711DDD55CEC439E5.title: "&aEmerald Furnace"
	quest.7188DC06A28AE30E.quest_desc: ["Mặc &eGolden Hook&r này sẽ tăng lượng kinh nghiệm thu được từ kẻ thù bị kéo lên boong!"]
	quest.7188DC06A28AE30E.quest_subtitle: "Tay"
	quest.7188DC06A28AE30E.title: "&eGolden Hook&r"
	quest.71A1FD0772453B51.quest_desc: ["Bạn có ghét việc phải nhấn chuột phải vào mọi thứ không? Từ cừu với kéo đến bò với xô? Đây là thế kỷ 21, chúng ta nên có robot làm mọi thứ! Hoặc ít nhất là Router làm mọi việc. \n\n\n\nVới Activator Module, nó sẽ đóng vai như bạn đang nhấn chuột phải vào các thứ. \n\n\n\nBạn có thể thiết lập nó sẽ nhấn chuột phải vào cái gì, nó sẽ Tấn công hay Sử dụng Mob hay Khối, nếu bạn Shift + Chuột phải, và khoảng cách cần thiết trong Module."]
	quest.71C552678A0F649F.quest_desc: ["&7Osmium&r xuất hiện xung quanh Deepslate và chỉ cần sắt để khai thác nhưng nó cho chỉ số tốt hơn &cNetherite&r!"]
	quest.71C552678A0F649F.quest_subtitle: "21"
	quest.71C552678A0F649F.title: "&7Áo giáp Osmium"
	quest.71D133BA3EC6F4FD.quest_desc: ["The Extrator sẽ \"làm phát triển\" khối hoặc vật phẩm bên dưới nó và di chuyển chúng vào kho ở phía trên.\n\n\n\nĐiều này có thể được dùng để tạo máy phát Cobblestone hoạt động với nhiều loại đá, máy phát Amethyst, hoặc thậm chí máy phát Dragon Egg, cùng với các loại khác!"]
	quest.71D133BA3EC6F4FD.quest_subtitle: "Khai thác Đá! (và Nhiều hơn)"
	quest.71E4FD61787DE299.quest_desc: ["Một vật phẩm khác bạn chỉ có thể tìm thấy trong Ancient Cities là &6Allthemodium Smithing Template&r.\n\n\n\nĐể lấy nó, bạn sẽ cần chải suspicious Clay.\n\n\n\nBạn có thể tìm thấy nó trên sàn của Ancient City.\n\n\n\n{image:atm:textures/questpics/allthemodium/all_clay.png width:200 height:100 align:center}"]
	quest.71E4FD61787DE299.title: "&6Allthemodium Smithing Template"
	quest.71FDF8CD953E46FC.quest_desc: ["HAHAHA tôi có làm bạn sợ với vật phẩm Creative trong nhiệm vụ không?\n\n\n\nĐừng lo, bạn sẽ không cần vật phẩm đó để hoàn thành chương này, tôi chỉ muốn làm bạn sợ\n\n\n\nTôi đôi khi cũng có thể vui vẻ..."]
	quest.722978AC0C1B2649.quest_desc: ["Vật phẩm dễ để tự động hóa nguồn &9nước&r vô hạn. \n\n\n\nCần thêm &9nước&r? Làm thêm một cái nữa!"]
	quest.722978AC0C1B2649.quest_subtitle: "Có thể dùng làm chất làm mát lò phản ứng"
	quest.722978AC0C1B2649.title: "Vô hạn &9Nước&r"
	quest.7270A37E31A70C91.quest_desc: ["&6&lThánh&r dành cho tất cả người chơi Hỗ trợ/Chữa lành. Nó chủ yếu dùng để chữa lành và hỗ trợ. \n\n\n\nVật liệu tập trung của &6&lThánh&r là &6Ngọc Thiêng&r được chế tạo. Bạn có thể làm Rune với chúng hoặc giết &6&lTu sĩ&r để nhận &6Rune Thánh&r. \n\n\n\n&6Cuộn Thánh&r có màu &fTrắng&r với chữ &6Vàng&r."]
	quest.7270A37E31A70C91.title: "&6&lThánh"
	quest.72717D1135486D7F.quest_desc: ["Hãy thu thập một ít hạt giống."]
	quest.72717D1135486D7F.quest_subtitle: "Block Tay 1, Block Cỏ 0"
	quest.72717D1135486D7F.title: "Đánh cỏ"
	quest.7279700A93E8630B.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_unobtainium.png width:100 height:150 align:center}"]
	quest.7279700A93E8630B.title: "&5Unobtainium&r"
	quest.728BE1816DA23DC0.quest_desc: ["Ender Dragon là Trùm bảo vệ The End. \n\n\n\nKhi bạn vào End Portal, bạn sẽ đến End Island nơi nó sinh ra. \n\n\n\nNó có 200 Trái tim và có thể tấn công bằng Quả cầu lửa hoặc đâm vào bạn. \n\n\n\nBạn phải phá End Crystals trên các cột vì chúng hồi máu cho nó, để giết nó! \n\n\n\nKhi bạn giết nó, nó sẽ rơi: Arcane Essence, Epic Shaderbags, Dragonskin, Dragon Scales từ hai mod khác nhau, và một lượng kinh nghiệm lớn! \n\n\n\nSau đó Cổng sẽ mở để bạn có thể trở về Overworld, hoặc bạn có thể tìm End Gateway để khám phá các đảo ngoài. Bạn cũng sẽ tìm thấy Trứng Rồng trên Cổng."]
	quest.728BE1816DA23DC0.title: "Giết Rồng End"
	quest.72989212DD45DC10.quest_desc: ["Để tìm quả trứng này, bạn sẽ cần quét đi &aCát đáng ngờ&r trong các tàn tích Đại dương Ấm.\n\n\n\nBạn có thể đặt quả Trứng vào thế giới và nó sẽ từ từ nở thành một &dSnifflet&r. Việc này mất khoảng 20 phút để nở bình thường, nhưng có thể đặt trên một khối Rêu để tăng gấp đôi tốc độ nở, chỉ mất 10 phút.\n\n\n\nSnifflet cuối cùng sẽ phát triển thành một &dSniffer&r trưởng thành có thể đào lên các vật phẩm như &2Torchflower Seeds&r hoặc &2Pitcher Pods&r khi chúng đi qua các khối mà chúng có thể đào.\n\n\n\nBạn có thể giao phối 2 Sniffer trưởng thành bằng cách sử dụng Torchflowers."]
	quest.72989212DD45DC10.quest_subtitle: "Người họ xa của Scruff McGruff"
	quest.72989212DD45DC10.title: "&aCon &5Sniffer"
	quest.729DCB919A92B735.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_bolt.png width:100 height:150 align:center}"]
	quest.729DCB919A92B735.quest_subtitle: "Phòng Thử nghiệm"
	quest.729DCB919A92B735.title: "Trang trí Giáp Bolt"
	quest.72A71E1D6D8996FD.quest_desc: ["Đây có phải là code? Tôi không phải là lập trình viên!? Tôi chỉ muốn tạo ra những nhiệm vụ này! \n\n\n\nỞ đây, bạn có thể nhập một Regex vào thanh Tìm kiếm và nhấn nút Cộng để thêm nó vào Bộ lọc. Bất cứ khi nào Regex đó xuất hiện, nó sẽ bị lọc ra."]
	quest.72AB70FD8D8FABBF.quest_subtitle: "&cThe Nether&r!"
	quest.72AB70FD8D8FABBF.title: "Trên Con đường Cao tốc..."
	quest.72D6265E35814927.quest_desc: ["Hầu hết các trò chơi có hệ thống Máu và Sát thương đều có Khung bất khả xâm phạm. Sau khi nhận sát thương, bạn sẽ có vài khung bất khả xâm phạm để 1. Bạn không chết ngay lập tức bởi một đòn tấn công đơn giản và 2. Có thời gian để phản công. \n\n\n\nVới &eDây chuyền Thánh giá&r, bạn có thêm vài khung bất khả xâm phạm. Điều này có nghĩa là có thêm vài lần để phản công!"]
	quest.72D6265E35814927.quest_subtitle: "Dây chuyền"
	quest.72D6265E35814927.title: "&eDây chuyền Thánh giá&r"
	quest.72DDA413D73E3235.quest_desc: ["Chỉ số cao hơn hẳn trong mọi thứ với bộ áo giáp tiếp theo trong hàng ngũ &6&lAllthemodium&r và &3Vibranium&r! \n\n\n\nBạn sẽ cần &6Allthemodium Armor&r để tạo ra nó."]
	quest.72DDA413D73E3235.quest_subtitle: "32"
	quest.72DDA413D73E3235.title: "&3Vibranium Armor"
	quest.72E1C19156633391.quest_desc: ["Thùng và Bể là một cách tuyệt vời ở giai đoạn đầu để di chuyển qua dung nham."]
	quest.72E1C19156633391.title: "Thùng dung nham"
	quest.730130CCF1CF5119.quest_desc: ["Những Di vật này có thể được tìm thấy trong &2Overworld&r!"]
	quest.730130CCF1CF5119.title: "&2Overworld"
	quest.7338CA23B27B2AF8.quest_subtitle: "&f12 &cSát thương tấn công"
	quest.73B73870B29DFAD9.quest_desc: ["Một trong chúng ta! Một trong chúng ta!\n\n\n\nChiếc &eMũ Người Làng&r khiến người làng tin rằng bạn đến từ cùng một thị trấn nên họ loại bỏ Thuế Người Ngoài Thị Trấn. Giao dịch với Người Làng rẻ hơn."]
	quest.73B73870B29DFAD9.quest_subtitle: "Đầu"
	quest.73B73870B29DFAD9.title: "&eMũ Người Làng"
	quest.73B8A70240E6070E.quest_desc: ["Tìm một con Bò và nhấp chuột phải vào nó bằng một Xô.\n\n\n\nThật đấy, tại sao không có Bò đực?"]
	quest.73B8A70240E6070E.quest_subtitle: "Tại sao trong trò chơi không có Bò đực?"
	quest.73B8A70240E6070E.title: "Vắt sữa bò - Kiếm lời"
	quest.73D60868024FF907.quest_desc: ["Dung dịch MK2!\n\n\n\nBất kỳ Nguồn Dung dịch nào gần đây đều có thể sử dụng với cái này, không chỉ kề cận."]
	quest.73D6B980D35082A0.quest_desc: ["Cái này mất một chút thời gian để giải thích nên hãy kiên nhẫn.\n\n\n\nĐầu tiên, tìm một &aPháo đài Evoker&r.\n\nTiếp theo, tìm một Sách Nghiên cứu được ẩn trong đó. Sau đó, nhờ một Thương nhân đang bị bắt làm con tin trong &aPháo đài&r dịch nó. (Giống như những người dịch nhiệm vụ con tin của chúng ta!)\n\nMột khi đã dịch xong, hãy mang nó đến &6&lLinh mục&r trong một &6Làng&r để đổi lấy &eSách Phép&r!\n\n\n\nNó tăng cường &6Phép Thánh&r và đừng lo, các Thương nhân con tin rất rất hiếm, cứ tiếp tục tìm kiếm!"]
	quest.73D6B980D35082A0.title: "&6Kinh Thánh Người Làng"
	quest.73E2A53A088AD29A.quest_subtitle: "11 Khối hồng ướt"
	quest.73FC51144FC2DA52.quest_desc: ["Với &7Găng tay&r này, bạn sẽ hút máu từ kẻ thù bạn đánh trúng!\n\n\n\nỒ vâng xin lỗi tôi quên... bleh bleh blehhh!"]
	quest.73FC51144FC2DA52.quest_subtitle: "Tay"
	quest.73FC51144FC2DA52.title: "&7Găng tay ma cà rồng&r"
	quest.73FF01D830A669AA.quest_desc: ["&4Mở rộng&r: Thổi gió biến Lò sắt của bạn thành Lò cao su sắt! Nó giờ đây chỉ nấu chảy Quặng nhưng với tốc độ gấp đôi! Có, tính năng này cộng dồn với các Mở rộng khác và các Tầng cấp Lò khác nhau."]
	quest.73FF01D830A669AA.title: "&4Mở rộng&r: Thổi gió"
	quest.7408CCF998D9CD37.quest_desc: ["Một &eSách phép&r có thể chế tạo... vâng, nó không dễ chế tạo. \n\n\n\nKhó nhất để lấy là Quyển sách đổ nát, mà bạn có thể tìm thấy trong Rương &9Thành phố cổ&r. &4Bình máu&r có thể được lấy bằng cách đặt một Quái vật (hoặc thậm chí chính bạn) vào một Nồi lớn trên đống lửa trại hoặc một Nồi lớn thuộc tính. &5Bình Tia chớp&r được tạo ra bằng cách dùng một Chiếc lên trên một Creeper có điện. \n\n\n\nKhi bạn làm tất cả những điều đó, bạn có thể chế tạo Cuốn sách cổ. 12 &3Ô phép&r của nó rất hữu ích!"]
	quest.7408CCF998D9CD37.title: "Cuốn sách cổ"
	quest.74130EB1E4B8586D.quest_desc: ["Sử dụng &aSự mê hoặc của Ihagan&r, bạn có thể hy sinh một Allay, Dơi, Ong, hoặc Vẹt để triệu hồi một &6Ong bị chiếm hữu&r. Khi đánh bại nó, nó sẽ rơi Mật ong đầy nguyền rủa, nguyên liệu chính để làm Phấn cam!"]
	quest.74130EB1E4B8586D.title: "&6Phấn cam"
	quest.74200A48498DD7F8.quest_desc: ["Tạo năng lượng từ mặt trời!"]
	quest.74200A48498DD7F8.quest_subtitle: "Tạo khoảng 51FE/t"
	quest.744AC6BD82FC2DEE.quest_subtitle: "&f36 &cSát thương tấn công"
	quest.748A01B5607C475B.quest_desc: ["Chứa Talismans... không còn gì nhiều. Có thể cũng giữ quần bạn lên nhưng chưa thử nghiệm."]
	quest.748A01B5607C475B.quest_subtitle: "Tìm thấy trong Hầm mỏ hoặc Pháo đài"
	quest.748A01B5607C475B.title: "&6Thắt lưng da"
	quest.74B352457BF1541B.quest_desc: ["Nếu bạn giống tôi, hoặc bất kỳ người lành mạnh nào, bạn ghét Bột Tuyết. May mắn thay, &l&3Artifacts&r cung cấp cho chúng ta một công cụ để đối phó với nó! Giày tuyết! \n\n\n\nGiày tuyết sẽ cho phép bạn đi an toàn trên Bột Tuyết giống như giày da vậy. Bạn cũng sẽ nhận được tăng Tốc độ khi đi trên bất kỳ Tuyết nào!"]
	quest.74B352457BF1541B.quest_subtitle: "Chân"
	quest.74FC0DDDB91DB172.quest_desc: ["Để cuộc sống dễ dàng hơn, AE2 cung cấp một bộ thiết bị để thao tác dữ liệu ME, tức là di chuyển các vật phẩm đã lưu trữ khắp thế giới.\n\n\n\n&bGiao diện ME&f là một trong số đó. Là thiết bị đầu vào, Giao diện cho phép bất kỳ vật phẩm/chất lỏng/v.v nào được dẫn qua bên ngoài nó, sau đó tự động được lưu trữ trong Mạng ME mà giao diện được kết nối.\n\n\n\nLà thiết bị đầu ra, Giao diện có thể được cấu hình để giữ một số lượng nhất định của vật phẩm đã lưu trữ sẵn có, từ mạng ME đến kho chứa nội bộ của nó. Điều này cho phép các vật phẩm sau đó được nhận bởi một nguồn bên ngoài như người chơi khác hoặc một ống dẫn."]
	quest.74FC0DDDB91DB172.quest_subtitle: "ÔI, ÔI, ÔI!"
	quest.74FC0DDDB91DB172.title: "Vào/Ra"
	quest.7503823ACDDB0491.quest_desc: ["Cái này và &aMũ Siêu Tự Tín&r mang lại cho bạn tất cả bùa hộ mệnh may mắn bạn cần!\n\n&2Khăn Quang May Mắn&r cấp thêm một cấp độ May Mắn cho Cuốc của bạn."]
	quest.7503823ACDDB0491.quest_subtitle: "Khăn quàng cổ (Dây chuyền)"
	quest.7503823ACDDB0491.title: "&2Khăn Quang May Mắn&r"
	quest.7574A782DCFB87CE.quest_desc: ["Kivi có thể được dùng cho một vài thứ, chủ yếu là để trang trí và chế tạo máy móc.\n\n\n\nBạn sẽ cần Kivi để làm Khung Máy và các máy móc khác trong XyCraft. Nó có thể được dùng cùng với Xychorium Gems trong Máy Đẽo Đá để tạo khối trang trí."]
	quest.7574A782DCFB87CE.title: "&l&7Kivi"
	quest.757B14D08A9A03C4.quest_desc: ["Giống như hầu hết các máy móc Mod, Lò Nung Sắt có Cấu hình. Cấu hình có thể được tìm thấy bằng cách nhấp vào góc trên trái. Sẽ có các mục Đầu vào, Đầu ra, và Kích hoạt Redstone. Kích hoạt Redstone thay đổi thời điểm Lò sẽ nung chảy. Các nút trên cùng xác định xem nó tự động Đầu vào hoặc Đầu ra, có nghĩa là nó sẽ tự động di chuyển đến và từ các kho đã kết nối. Các ô là mỗi phía của Lò và xác định xem nó Đầu vào, Đầu ra, làm cả hai, Đầu vào Nhiên liệu, hoặc không làm gì. Điều này quan trọng đối với các Vật phẩm được ống dẫn vào hoặc ra. Bộ liên kết cài đặt Lò sẽ sao chép tất cả các cài đặt này sang các Lò khác!"]
	quest.757B14D08A9A03C4.title: "Cấu hình"
	quest.75FE0B514448865B.quest_desc: ["Nâng cấp được bỏ trực tiếp vào Bộ định tuyến và Bộ định tuyến có thể chứa tối đa 5 cái. Nâng cấp ảnh hưởng trực tiếp đến tất cả Mô-đun mà chúng có thể và thường có thể chồng chất!"]
	quest.75FE0B514448865B.title: "&lNâng cấp"
	quest.76062D375E4CC8DD.quest_desc: ["Chúng ta đã thấy Bộ lọc (Filters) và vòng lặp (Round Robins), giờ lại thấy cả hai! Điều này hữu ích để giữ các vật phẩm theo một thứ tự cụ thể, chẳng hạn như khi tạo hạt giống Nông nghiệp Huyền ảo (Mystical Agriculture Seeds)!"]
	quest.76406EFFF8CBA6B4.quest_desc: ["Kim cương là một trong những vật liệu tốt nhất để chế tạo công cụ, nhưng cũng cho phép bạn truy cập các chiều không gian mới như Nether!"]
	quest.76406EFFF8CBA6B4.title: "Chúng ta đã khai thác được &bKim cương&r!"
	quest.764609E41957DA69.quest_subtitle: "6,561 Khối Ngọc lục bảo"
	quest.76558D23A70AFF78.title: "&bQuả cầu Nâng cấp Băng&r"
	quest.7658C1C663394E85.quest_desc: ["Có nhiều lệnh hữu ích trong ATM. Dưới đây là một số lệnh:\n\n\n\n&e/sethome&r (tên nhà) | Cho phép bạn đặt một nhà mà bạn có thể dịch chuyển trở lại bằng /home (tên). Ví dụ: /sethome farm - sau đó dịch chuyển với /home farm.\n\n\n\n&e/spawn&r | Lệnh này sẽ dịch chuyển bạn đến điểm sinh của thế giới trên (overworld).\n\n\n\n&e/rtp&r | 'Dịch chuyển ngẫu nhiên' sẽ đưa bạn đến một vị trí ngẫu nhiên trong thế giới.\n\n\n\nLưu ý: Các lệnh này có thời gian hồi chiêu và giới hạn. Nếu bạn muốn thay đổi chúng, bạn có thể chỉnh sửa file cấu hình được tìm thấy tại đây:\n\n\n\n - Đối với Singleplayer | &osaves/(tên lưu)/serverconfig/ftbessentials.snbt&r\n\n\n\n - Đối với Máy chủ | &oworld/serverconfig/ftbessentials.snbt&r"]
	quest.7678B5DD1339833E.quest_desc: ["Tấm pin mặt trời tạo ra FE khi được tiếp cận trực tiếp với mặt trời. Tuy nhiên, bạn có thể sử dụng &7Kính ngữ cảnh End&r để bỏ qua các khối trên đường đi."]
	quest.76A38CCA5816CDAD.quest_desc: ["Kết hợp Oxy, Etylen và một Chất nền trong một &aBuồng phản ứng áp suất&r sẽ tạo ra một HDPE Pellet."]
	quest.76A38CCA5816CDAD.title: "HDPE Pellets"
	quest.76CDF08465700AA2.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_silent.png width:100 height:150 align:center}"]
	quest.76CDF08465700AA2.quest_subtitle: "Thành phố cổ đại"
	quest.76CDF08465700AA2.title: "Trang trí giáp Silence"
	quest.76EA017B12E8F01B.quest_desc: ["Phần này cho bạn thấy các cách khác nhau để lưu trữ sức mạnh của bạn!"]
	quest.76EA017B12E8F01B.title: "&f&lLưu trữ sức mạnh"
	quest.7741905EA8380B25.quest_desc: ["&aTrang trí giáp&r là các vật phẩm dùng để thêm trang trí cho giáp của bạn! Việc này có thể được thực hiện ở Bàn rèn khí.\n\n\n\nMặc dù chúng có công thức, hầu hết các trang trí là những vật hiếm tìm thấy từ rương chiến lợi phẩm hoặc khai quật khảo cổ. Khi bạn tìm thấy một cái, bạn có thể nhân bản Mẫu bằng cách sử dụng công thức để tạo thêm!"]
	quest.7741905EA8380B25.title: "&dTrang trí giáp"
	quest.7749703A10B78AB1.quest_desc: ["Khả năng đầu tiên với &8Drowned Belt&r nằm ở tên, nó là một Chiếc đai, nó giữ các Talismans. \n\n \n\nKhả năng thứ hai hoạt động với việc bơi trong &9Nước&r. Bạn có bao giờ ghen tị với cách Drowned di chuyển qua &9Nước&r như thể đó là nhà của họ? Vâng, với Khả năng này bạn có thể giống họ! \n\n \n\nKhả năng thứ ba hoạt động như Impaling, bạn sẽ gây thêm Sát thương trong &9Nước&r. \n\n \n\nVà Khả năng cuối cùng cũng hoạt động với Phép thuật Trident, bạn giờ có thể sử dụng Channeling ở bất kỳ đâu bất kể bạn ướt hay không!"]
	quest.7749703A10B78AB1.quest_subtitle: "Tìm thấy trong Tàu đắm và Đổ nát đại dương"
	quest.7749703A10B78AB1.title: "&8Chiếc đai Drowned"
	quest.7778937DF377C1B4.quest_desc: ["Đây là một lựa chọn tuyệt vời để tạo ra sức mạnh.\n\n\n\nNó tạo ra khoảng 96FE/t ở mực nước biển, và tăng dựa trên độ cao của bạn. Càng cao Y level, nó càng tạo ra nhiều sức mạnh hơn!"]
	quest.7778937DF377C1B4.quest_subtitle: "Tạo năng lượng từ gió"
	quest.779CA0C49F93C4F9.quest_subtitle: "729 Đá Obsidian"
	quest.77C9EE701F72586D.quest_desc: ["&bÔ di động&f hoạt động giống hệt ô thông thường, có thể được chèn vào rương hoặc ổ đĩa và được lấp đầy tương ứng. \n\n\n\nTuy nhiên, khác với ô thông thường, nội dung của chúng cũng có thể được truy cập độc lập thông qua chính vật phẩm ô, giống như một cái ba lô kỹ thuật số mang hương vị ME."]
	quest.77F241BEE9902751.quest_desc: ["Chiếc rương lớn nhất từ Sophisticated Storage"]
	quest.77F241BEE9902751.quest_subtitle: "Nhiều không gian cho hoạt động!"
	quest.77F241BEE9902751.title: "&dRương Netherite"
	quest.77FC692AC94D2EEF.title: "&l&9Phần thưởng Overworld:&r&e Creepers"
	quest.78202A1CF5D86B94.quest_desc: ["Ngân hàng năng lượng (&9Power Bank&r) của Powah.\n\n\n\nChúng cũng có thể được dùng để nâng cấp tổng dung lượng lưu trữ năng lượng của mạng không dây &7Ender Networks&r của bạn."]
	quest.78311531069807DE.quest_desc: ["Trong Applied Energistics 2, mỗi mạng ME có một số &ekênh&f nhất định, đơn giản là có bao nhiêu thiết bị mạng có thể vừa trên toàn mạng.\n\n\n\nNhư một nguyên tắc chung, bất kỳ thiết bị nào xử lý trực tiếp dữ liệu ME (các vật phẩm được lưu trữ trong mạng) và thực hiện một số dạng I/O sẽ chiếm một kênh. Thông thường, các thành phần chỉ quan tâm đến lưu trữ năng lượng nội bộ của mạng, như &eEnergy Cells&f và &eInscribers&f, &okhông&r chiếm kênh.\n\n\n\nCác mạng không có &bME Controller&f được gọi là mạng 'ad-hoc' và chỉ hỗ trợ tối đa 8 kênh."]
	quest.785951190FFDAA21.quest_desc: ["Tăng kích thước chồng trong Ba lô lên 4."]
	quest.785951190FFDAA21.title: "&eNâng cấp Chồng Cấp 2"
	quest.789AF6D0A6321945.quest_desc: ["Đây là vật thể quan trọng nhất! Mạnh mẽ nhất! Nguy hiểm nhất &l&3Artifact&r trong tất cả!\n\n{@pagebreak}\n\nTôi thậm chí không chắc nên giải thích nó làm gì, nó quá nguy hiểm!\n\n{@pagebreak}\n\nNếu bạn chắc chắn có thể kiểm soát sức mạnh của nó, thì hãy tiếp tục đọc...\n\n{@pagebreak}\n\nChưa muộn để quay lại!\n\n{@pagebreak}\n\nĐược rồi, tôi đã cảnh báo bạn...\n\n{@pagebreak}\n\nNhấn Shift để có cơ hội Xì khi &dWhoopie Cushion&r được trang bị."]
	quest.789AF6D0A6321945.quest_subtitle: "Độc nhất"
	quest.789AF6D0A6321945.title: "&dWhoopie Cushion&r"
	quest.78AA7BFABBFB9973.quest_desc: ["&2&lSách Phép Thuật của Thiên Nhiên&r &e. \n\n\n\nNó có 10 &3Phép Thuật&r và tăng cường &2Phép Thuật Thiên Nhiên&r! \n\n\n\nTuy nhiên, bạn cần một Sách Phép Thuật Thối Rữa để chế tạo nó..."]
	quest.78AA7BFABBFB9973.title: "&2Kinh Druid"
	quest.78D1C97A542133D8.quest_desc: ["Augments là các Nâng cấp cho Lò Luyện Sắt!\n\n\n\nỞ góc trên bên phải của giao diện Lò Luyện sẽ có nút để xem phần Augment. Sẽ có vị trí Đỏ, Xanh lá, và Xanh lam, mỗi vị trí có thể chứa 1 Augment màu tương ứng."]
	quest.78D1C97A542133D8.title: "&lNâng cấp"
	quest.78E51D22C16C4686.quest_desc: ["Bộ Điều Khiển Kho cũng có thể kết nối với các kho khác một cách không dây, điều này có thể thực hiện bằng Công Cụ Kho, chỉ cần nhấp chuột phải vào Bộ Điều Khiển Kho để liên kết nó và nhấp chuột phải vào các kho để kết nối chúng.\n\n\n\nPhạm vi kết nối không dây giống như bình thường, 14 khối không gian."]
	quest.78E66F1DE42C747A.quest_desc: ["&9Mảnh Echo&r có thể khá mệt mỏi để farm, hơn nữa chúng ta sẽ cần rất nhiều! Vậy tại sao không có một cách dễ dàng hơn để farm chúng. \n\n\n\nVới &d&lInfusion&r chúng ta có thể biến 1 &9Mảnh Echo&r thành 4! \n\n\n\nChúng ta sẽ cần &a70 Eterna&r, &c50% Quanta&r, và &550% Arcana&r. \n\n\n\nĐể có được chúng, chúng ta có thể sử dụng 12 &4Glowing Hellshelves&r và 2 &9Deepshelves&r, mà không phải là &9Dormant&r!"]
	quest.78E66F1DE42C747A.title: "Vô hạn §9Mảnh Echo§r?"
	quest.78ECC28DD4BA9696.quest_desc: ["Trong khi bạn có thể lấy được phần lớn vật liệu §dThế giới khác§r bằng Spiritfire, bạn cũng có thể sử dụng §9Gậy Tiên tri§r để định vị những vật liệu này.\n\n\n\nTrước tiên, bạn sẽ cần kết nối Gậy với vật liệu bạn đang tìm kiếm. Ví dụ, nếu bạn đang săn lùng §8Đá Thế giới khác§r, bạn có thể sử dụng Gậy trên §aĐá andesit§r để giúp định vị Đá Thế giới khác trong thế giới.\n\n\n\nMột khi đã kết nối với một vật liệu, bạn có thể giữ chuột phải với Gậy trong tay, và một hạt phát ra theo hướng của vật liệu gần nhất mà nó đã kết nối.\n\n\n\nBạn vẫn cần phải chịu tác động của §3Con mắt thứ ba§r để có thể thu hoạch khối Thế giới khác."]
	quest.78ECC28DD4BA9696.quest_subtitle: "Săn lùng Vật liệu §dThế giới khác§r"
	quest.78ECC28DD4BA9696.title: "Công cụ chuyên dụng: Gậy Tiên tri"
	quest.78FEDE6FA4845585.quest_desc: ["Một số §d§lPhép hòa trộn§r cần những lượng rất, rất chính xác của §aEterna§r, §cQuanta§r, hoặc §5Arcana§r.\n\n\n\nĐể có được chúng, bạn có thể cần một trong những §7Kệ§r này.\n\n\n\nMỗi cái giảm số lượng của essence tương ứng."]
	quest.78FEDE6FA4845585.title: "§4Lượng âm§r"
	quest.791A981914CE345F.quest_subtitle: "§f10 §cSát thương"
	quest.791AE62ACACBD5BA.quest_subtitle: "Bạn sẽ mở nó, đóng nó, rồi mở lại, chỉ vì bạn chán."
	quest.7940E814260C556F.title: "§bHợp kim Củng cố"
	quest.79757F66DF263FA0.quest_desc: ["Để tạo ra phản ứng để Lò phản ứng bật, chúng ta sẽ cần đưa vào một lượng lớn năng lượng. §oVà tôi nói là một lượng lớn năng lượng§r.\n\n\n\nĐiều này yêu cầu bạn thiết lập một số §9Tia laser§r mà tất cả cần được cấp năng lượng, sau đó bắn 400MFE trực tiếp vào Ma trận Tập trung Laser.\n\n\n\nMa trận Tập trung Laser được đặt ở trung tâm của một mặt của Lò phản ứng nhiệt hạch. Chúng ta sẽ xây dựng các Tia laser tiếp theo."]
	quest.79757F66DF263FA0.quest_subtitle: "Tia Laser Khốn Kiếp"
	quest.79757F66DF263FA0.title: "Laser Tập Trung"
	quest.7975C7145572C438.quest_desc: ["Dù bạn là người chơi mod lâu năm hay một người mới hoàn toàn với MC, ai cũng phải làm một &2Xẻng Gỗ&r.\n\n\n\nXẻng cho phép bạn phá hầu hết các khối đá và kim loại. Cái bằng gỗ này sẽ không bền lâu, vì vậy hãy đảm bảo thu thập một ít &3Đá Cuội&r với nó!"]
	quest.7975C7145572C438.title: "Xẻng Đầu Tiên"
	quest.79AD74A863EA43CB.quest_desc: ["Flux Networks thực sự cung cấp một cách để lưu trữ năng lượng bạn tạo ra cho mạng của bạn!\n\n\n\nChúng chứa lượng lớn năng lượng tổng thể và có thể được nâng cấp để lưu trữ thêm nhiều hơn nữa!"]
	quest.79AD74A863EA43CB.quest_subtitle: "Lưu Trữ Năng Lượng"
	quest.79AD74A863EA43CB.title: "Kho Lưu Trữ Flux"
	quest.79AF63E77AD70A93.quest_desc: ["&7Kệ Sách&r là điểm khởi đầu của bạn, nhưng chắc chắn không phải là điểm kết thúc. Tối thiểu không phải với &7Kệ Sách&r thông thường. \n\n\n\nChỉ với &7Kệ Sách&r thông thường, bạn chỉ có thể đạt được &aEterna&r lên và tối đa 30. \n\n(Tôi sẽ giải thích về &5Cấp Độ Phép Thuật&r sớm nhưng chỉ cần biết bạn cần chúng lên)"]
	quest.79AF63E77AD70A93.title: "&2&lVanilla&r Tối Đa chỉ là sự khởi đầu"
	quest.79C4CF8D7312FC28.quest_desc: ["Tốt nhất mà Vanilla có được! &5Netherite&r! Đừng lo lắng bạn sẽ không cần Smithing Template cho nó, chỉ cần rất nhiều &5Netherite&r. \n\n \n\nNó nung chảy một vật phẩm mỗi 5 Tick có nghĩa là 4 Vật Phẩm Được Nung Mỗi Giây. Đúng rồi, bây giờ nó không còn là S.P.S. (Giây trên Mỗi Lần Nung) nữa, mà là S.P.S. (Lần Nung Trên Mỗi Giây). \n\n \n\nĐược chế tạo từ &dLò Nung Obsidian&r... chờ đã, đây không phải là Lò Nung Cuối Cùng?"]
	quest.79C4CF8D7312FC28.title: "&5Lò Netherite&r"
	quest.79D2617E01481281.quest_desc: ["Để bắt đầu với AE2, bạn sẽ cần khai thác một tài nguyên quan trọng cho mod được gọi là &bCertus Quartz&f. Bạn sẽ tìm thấy Certus Quartz Crystals trong thiên thạch mà bạn có thể khai thác để lấy Certus Quartz &eDust&f và &eCrystals&f."]
	quest.79D2617E01481281.title: "Certus Quartz"
	quest.79E30114ED8870EE.quest_subtitle: "&f7 &cSát thương tấn công"
	quest.79EF24E396779B9F.quest_subtitle: "Cấp: &f2"
	quest.7A32C50A6125E566.quest_desc: ["Cái &aSpore Sack&r là tất cả về.. bạn đã đoán đúng! &aSpores&r!!! Khả năng đầu tiên giải phóng một &aSpore&r mỗi lần bạn bị tấn công. Cái &aSpore&r sẽ bay xung quanh cho đến khi dính vào một Khối và sẽ nổ khi một sinh vật đến gần. \n\n \n\nKhả năng thứ hai cho phép bạn tích lũy &aSpores&r. Mỗi lần bạn bị tấn công 1 &aSpore&r được giải phóng và 1 được giữ trong &aSpore Sack&r của bạn để dùng sau. \n\n \n\nKhả năng thứ ba cho phép &aSpores&r nổi trôi sinh sản như tế bào, phân chia và nhân lên! \n\n \n\nKhả năng cuối cùng là tốt nhất! Sử dụng Left Alt bạn có thể giải phóng tất cả &aSpores&r đã tích lũy! Kích thước của chúng phụ thuộc vào máu của bạn."]
	quest.7A32C50A6125E566.quest_subtitle: "Tìm thấy trong Kim Tự Tháp Rừng Nguyên Sinh"
	quest.7A32C50A6125E566.title: "&aSpore Sack"
	quest.7A615E2A152917AD.quest_desc: ["Để làm điều này bạn cần 2 &5Lò Netherite&r và 7 mảnh kính mỗi mảnh có màu của Cầu Vồng. &cĐỏ&r, &6Cam&r, &eVàng&r, &2Xanh lá&r, &3Xanh dương&r, &9Lam&r- &5Tím&r, và &5Tím nhạt&r-&dĐỏ tươi&r. Đúng vậy! Toàn bộ Roy G. Bpm!"]
	quest.7A615E2A152917AD.title: "&cR&6a&ei&2n&3b&9o&5w &cC&eo&3r&5e"
	quest.7A9AE63998BB41FF.quest_desc: ["Để xác định thời điểm Máy sinh (Spawner) sẽ sinh quái, nó chọn một số ngẫu nhiên giữa độ trễ sinh tối đa và tối thiểu. Độ trễ tối thiểu có thể dao động từ 20 đến 32.767. Mỗi viên đường sẽ tăng hoặc giảm độ trễ tối thiểu đi 10."]
	quest.7A9AE63998BB41FF.title: "Độ trễ sinh tối thiểu"
	quest.7AE3C8134F5ED726.quest_desc: ["Tăng kích thước xếp trong Ba lô lên 16."]
	quest.7AE3C8134F5ED726.title: "&dNâng cấp xếp tầng 4"
	quest.7AE502EDB73BD57A.quest_desc: ["Máy này nghiền quặng thành dạng \"bụi bẩn\". Điều này hữu ích để chuyển cục quặng thành bụi bẩn, sau đó có thể qua Buồng làm giàu để tạo bụi quặng, rồi nung chảy thành phôi."]
	quest.7AE502EDB73BD57A.quest_subtitle: "Nó nghiền mọi thứ."
	quest.7B0764DDE94E73D0.quest_desc: ["Sử dụng một số cơ chế vanilla và 2 &aFission Reactor Logic Adapters&r, chúng ta có thể tạo một công tắc đơn giản để ngắt và tắt lò phản ứng &o&e trong trường hợp mọi thứ trở nên điên rồ&r.\n\n\n\nĐể làm điều này, chúng ta cần một mảnh Redstone, một Piston, một khối cát hoặc sỏi, và một Observer.\n\n\n\nTrên một mặt, chúng ta sẽ đặt một Logic Adapter xuống, sau đó bỏ qua một khối phía trên nó và đặt một Adapter khác. Đặt Adapter trên cùng thành &9Kích hoạt&r, và Adapter dưới cùng thành &cTổn thất nghiêm trọng&r.\n\n\n\nTiếp theo, phía trước và bên dưới Adapter dưới, đặt bất kỳ khối xây dựng nào và gắn một mảnh Redstone lên nó dẫn từ Adapter. Sau đó chúng ta sẽ đặt một Piston hướng lên phía trước mảnh Redstone đó, rồi đặt mảnh cát hoặc sỏi lên Piston đó.\n\n\n\nPhần cuối cùng của công tắc, đặt Observer với mặt hướng &b ra ngoài về phía thiết lập Piston&r. &9Điều này quan trọng&r!\n\n\n\nBất cứ khi nào Lò phản ứng bị tổn thất nghiêm trọng, nó sẽ kích hoạt Adapter dưới, khiến Redstone nhận tín hiệu, sau đó kích hoạt Piston và đẩy cát/sỏi lên. Điều này sẽ kích hoạt Observer, sau đó tắt Lò phản ứng.\n\n\n\n{image:atm:textures/questpics/mek/example_circuit.png width:200 height:250 align:1}"]
	quest.7B0764DDE94E73D0.quest_subtitle: "Cần hình ảnh? Xem Ponder!"
	quest.7B0764DDE94E73D0.title: "Ví dụ về Công tắc"
	quest.7B0DFA55B4D8B16D.quest_desc: ["Để tạo một Cổng tùy chỉnh, đặt một khối Teleporter xuống. Kết nối nguồn điện vào khối.\n\n\n\nTạo một \"Khung cổng\" với khối Teleporter làm đáy của cổng.\n\n\n\nSản phẩm cuối cùng sẽ là một cấu trúc cổng 4x3, với hai khối ở giữa tạo thành cổng."]
	quest.7B0DFA55B4D8B16D.quest_subtitle: "Dịch chuyển tinh hoa"
	quest.7B0DFA55B4D8B16D.title: "Cổng tùy chỉnh!"
	quest.7B3613C01F0B1373.quest_desc: ["Để kết hợp &3Vibranium&r, &5Unobtainium&r và &6Allthemodium&r, chúng ta cần thử thách bản thân trong &l&cPowah&r! \n\n\n\nĐặt Energizing Orb xuống rồi đặt Energizing Rods hướng về nó. Energizing Rods cần được đặt trên một Power Source và sẽ gửi Năng lượng vào Orb. Lượng năng lượng mỗi cái chứa và gửi được xác định bởi Tier. \n\n\n\nĐặt các Ingot, 2 trái tim Piglich và một Khối Nitro Crystals X1 đã nén vào Orb (thứ tự không quan trọng). Sau khi 1 Tỷ FE được đưa vào Orb thông qua Rods, nó sẽ sẵn sàng!\n\n\n\n{ \"text\": \"POWAH QUESTLINE\", \"color\": \"#55FF55\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"2A6EBEEBAB882679\" } }"]
	quest.7B4AF35313D7D779.quest_subtitle: "Bậc: &64"
	quest.7B4AF35313D7D779.title: "&6Khung Máy Tối Thượng"
	quest.7B500E0577BDFF8F.quest_desc: ["&6Đồng thau&r là sự kết hợp của &6đồng&r và kẽm. \n\n\n\nCó hàng chục cách khác nhau để tạo hợp kim này, tôi sẽ không nói cho bạn cách đúng để làm."]
	quest.7B500E0577BDFF8F.quest_subtitle: "18"
	quest.7B500E0577BDFF8F.title: "&6Giáp Đồng thau"
	quest.7B7D1F0CB326B28F.quest_desc: ["&bME IO Port&f cho phép nội dung kho của mạng ME được sắp xếp nhanh chóng giữa các phương tiện lưu trữ khác nhau như cell ME và container ngoài được kết nối với storage bus.\n\n\n\nKhi một cell được chèn vào khe đầu vào bên trái, IO Port có thể được chuyển đổi để hoặc đổ cell ra các kho ME khác hoặc đổ vào cell (lý tưởng là được phân vùng) với các vật phẩm cụ thể được trải rộng trên các kho khác."]
	quest.7B7D1F0CB326B28F.quest_subtitle: "Tái cấu trúc"
	quest.7BCD4A425CF6199B.quest_desc: ["Sau khi giết con dê của Lòng Thương Xót được triệu hồi từ &9Xeovrenth Adjure&r, bạn sẽ có thêm một Cruelty Essence. Kết hợp nó với một ít Cocao Beans để tạo ra Brown Chalk."]
	quest.7BCD4A425CF6199B.title: "&#4E2C00Brown Chalk"
	quest.7C07D6A33F7ADB02.quest_desc: ["Đây là nâng cấp Ba lô, cho phép bạn đựng ba lô của mình bên trong ba lô khác.\n\n\n\nVì vậy bạn có thể có ba lô trong ba lô khi cần ba lô của mình trong ba lô."]
	quest.7C07D6A33F7ADB02.quest_subtitle: "Ba lô trong ba lô của bạn?"
	quest.7C0F7A1B3AB9A1A1.quest_subtitle: "Thêm tùy chọn lọc"
	quest.7C0F7A1B3AB9A1A1.title: "&eNâng cấp Đổ lại Nâng cao"
	quest.7C3F65B5DAC7E57B.quest_desc: ["&dShadow Glaives&r là vũ khí nhiều hơn là &6Relic&r. Khả năng đầu tiên chỉ là ném 1 &dGlaive&r. Sau khi nó đánh trúng một sinh vật, nó sẽ bật lại các sinh vật khác, và có thể quay trở lại bạn. Bạn có thể nâng cấp nó để tăng sát thương, số lần nảy và tốc độ sạc lại nhanh hơn. \n\n \n\nKhả năng thứ hai sử dụng toàn bộ điểm nạp để giải phóng một &dlưỡi cưa khổng lồ&r! Rất tuyệt, tôi khuyên bạn nên thử!"]
	quest.7C3F65B5DAC7E57B.quest_subtitle: "Tìm thấy trong các Thành phố End và Tàu End"
	quest.7C3F65B5DAC7E57B.title: "&dShadow Glaive"
	quest.7C61906C6C87C97D.quest_desc: ["&9Electromagnetic Coil&r được đặt trực tiếp phía trên &aRotational Complex&r để chuyển năng lượng động thành điện năng.\n\n\n\nBạn có thể sử dụng nhiều, với tối đa 7 cho một Turbine sử dụng 28 lưỡi. Chúng phải chạm vào một Coil khác, hoặc Rotational Complex."]
	quest.7C758209D06ED0E3.quest_desc: ["Bằng cách kết hợp &4Infused Hellshelf&r với một ít &eGlowstone&r, chúng ta có thể tạo ra &4Glowing Hellshelves&r! \n\n\n\nChúng có cùng &aEterna&r và &cQuanta&r, nhưng cấp &53% Arcana&r. \n\n\n\nĐiều này sẽ hữu ích cho các &d&lInfusion&r sau này, ví dụ như nếu chúng ta muốn dùng 12 cái để &d&lInfuse&r một &9Dormant Deepshelf&f thành &9Deepshelf&r!"]
	quest.7C758209D06ED0E3.title: "&4Glowing Hellshelf"
	quest.7C79BCE482A06199.quest_desc: ["&b&lIce&r xoay quanh các phép thuật Mùa đông. Sử dụng &bIce&r và &bSnow&r để làm lạnh và gây tổn thương kẻ thù. \n\n\n\nVật liệu Focus của &b&lIce&r là &bFrozen Bone&r, rơi từ &bStrays&r. Bạn có thể dùng chúng để chế tạo &bIce Rune&r hoặc giết &b&lCryomancer&r để lấy nó. \n\n\n\nCác &bScrolls&r của nó có màu &bLight Blue&r với chữ &9Darker Blue&r."]
	quest.7C79BCE482A06199.title: "&b&lIce"
	quest.7C9D9D1C054874A7.quest_desc: ["Bạn bao giờ muốn có những &5Enchantments&r hoàn hảo nhất? Như, mọi chỉ số tối đa, mọi &5Enchantment&r tốt có sẵn? Nếu vậy, bạn sẽ cần những thứ này! \n\n\n\nĐầu tiên, là 4 &9Soul-Touched Sculkshelves&r và 4 &9Echoing Sculkshelves&r. Chúng sẽ cung cấp cho chúng ta tất cả &cQuanta&r và &5Arcana&r cần thiết! \n\n\n\nTiếp theo, là &dDraconic Endshelf&r sẽ cho chúng ta &a100 Eterna&r, tức là lượng &aEterna&r và mức tối đa. \n\n\n\nThứ ba, là &6Geode-Encased Bookshelf of Stability&r, điều này sẽ khiến &cQuanta&r không phản chúng ta bằng những &5Enchantments&r tồi! \n\n\n\nCuối cùng là tùy chọn nhưng bạn nên thêm, đó là &6Deepshelf of Arcane Treasures&r. Cái &7Bookshelf&r đó sẽ cho phép chúng ta có được những &5Enchantments&r bình thường không có, như &5Mending&r!"]
	quest.7C9D9D1C054874A7.title: "&6&lCài đặt Enchanting tốt nhất"
	quest.7CC49360D07086B8.quest_desc: ["Món đồ này là cách bạn thực hiện Truyền dẫn Không dây.\n\n\n\nBạn có thể thiết lập các kênh cụ thể, do bạn đặt tên, để truyền bất cứ thứ gì bạn muốn từ nó."]
	quest.7CC49360D07086B8.quest_subtitle: "Năng lượng Không dây, Khí, Chất lỏng, Mọi thứ."
	quest.7D38BC3DB3406F51.quest_desc: ["Với Cuốc Gỗ của chúng ta, đá không phải là vấn đề để phá!\n\n\n\n&3Đá cuội&r mở khóa phần tiếp theo của tiến trình bằng cách dùng nó để chế tạo Lò nung để nung quặng của chúng ta.\n\n\n\nBạn cũng sẽ muốn nâng cấp cuốc lên đá để khai thác các quặng tốt hơn như &bSắt&r!"]
	quest.7D38BC3DB3406F51.title: "Thời Đá"
	quest.7D52DD751DDADA1B.quest_desc: ["Cáp cơ bản để truyền tải năng lượng."]
	quest.7D7983F39E6E818D.title: "Tầng: &9Niotic"
	quest.7DE2154159D273C3.quest_desc: ["Nâng cấp trực tiếp lên &6Allthemodium&r.\n\n{image:atm:textures/questpics/allthemodium/all_armor_vib.png width:100 height:175 align:center}"]
	quest.7DE2154159D273C3.title: "&3Giáp Vibranium"
	quest.7E17AB5A4492929E.quest_desc: ["Mọi Lò phản ứng đều dùng Uranium ở đâu đó làm nhiên liệu, phải không?\n\n\n\nĐầu tiên, hãy thu thập một ít &aPhôi Uranium&r. Chúng ta sẽ cần xử lý chúng trong một &9Phòng làm giàu&r để biến chúng thành &eBánh Uranium&r."]
	quest.7E17AB5A4492929E.quest_subtitle: "Tất nhiên nó dùng Uranium"
	quest.7E17AB5A4492929E.title: "&aUranium"
	quest.7E39FB9F3E973009.title: "Khí Ether"
	quest.7E92ED270C67FDE5.quest_desc: ["Gần như mọi máy móc bạn có thể chế tạo trong mod đều yêu cầu một &9Vỏ điện môi&r.\n\n\n\nBạn sẽ cần chế tạo &bPaste&r trước, cũng như một số &aThanh&r để tiến tới!"]
	quest.7E92ED270C67FDE5.title: "Bắt đầu với Thảm điện môi"
	quest.7E9E03274A88347D.quest_desc: ["Tăng kích thước chồng trong Ba lô lên 2."]
	quest.7E9E03274A88347D.title: "&fNâng cấp Chồng Hạng 1"
	quest.7EA6B942D1294ED6.quest_desc: ["Máy này có thể khai mỏ giúp bạn!\n\n\n\nNó hoàn toàn có thể cấu hình, và thậm chí có thể thay thế các khối đã khai bằng đá sỏi, hoặc bất kỳ khối nào bạn cung cấp cho nó!"]
	quest.7EA6B942D1294ED6.quest_subtitle: "Một người bạn robot lớn hơn."
	quest.7EC01E7DB045DB05.quest_desc: ["&aAugments&r là các nâng cấp Lò nung có thể thay đổi hoặc nâng cấp chức năng của Lò nung.\n\n\n\n - Blasting: Chuyển đổi Lò nung chỉ cho phép các công thức Blasting.\n\n\n\n - Smoking: Chuyển đổi Lò nung chỉ cho phép các công thức Smoking.\n\n\n\n - Factory: Chuyển đổi Lò nung để sử dụng năng lượng thay vì nhiên liệu, và nâng cấp nó thành một nhà máy, cho phép nung nhiều vật phẩm cùng lúc. Số lượng tăng tùy theo hạng của Lò nung.\n\n\n\n - Speed: Tăng gấp đôi tốc độ lò nung với chi phí gấp đôi nhiên liệu.\n\n\n\n - Fuel Efficiency: Tăng gấp đôi số lượng vật phẩm nung được trên mỗi nhiên liệu, nhưng giảm tốc độ 25%"]
	quest.7EC01E7DB045DB05.title: "Lò nung &aNâng cấp"
	quest.7EC8814940C4C3D7.quest_desc: ["Sử dụng vật phẩm này để thu nhỏ. Hữu ích cho việc làm tự động hóa và cũng chỉ là vui vẻ chung chung."]
	quest.7EC8814940C4C3D7.quest_subtitle: "Honey, Tôi Thu Nhỏ Rồi"
	quest.7EC8814940C4C3D7.title: "Thiết Bị Thu Nhỏ Cá Nhân"
	quest.7EF57BBEAA4B6B08.quest_desc: ["Bạn đang muốn tạo kho lưu trữ ảo bằng mod như &9Applied Energistics 2&r?\n\n\n\nĐây là cách tuyệt vời để nâng cấp kho lưu trữ của bạn, nhưng điều quan trọng là phải nói về &eVật phẩm NBT&r và cách tốt nhất để lưu trữ chúng.\n\n\n\nVật phẩm NBT là các vật phẩm có thêm các thẻ đính kèm. Các vật phẩm phép thuật, vật phẩm có độ bền và hơn thế nữa. Đây là các vật phẩm có thẻ NBT đính kèm. Vì vậy, chúng thường không thể chồng được.\n\n\n\nKhi bạn lưu trữ nhiều vật phẩm như vậy vào hệ thống lưu trữ như AE2, bạn có thể gặp vấn đề cho bản lưu hoặc máy chủ.\n\n\n\nVì vậy, tốt nhất là lưu trữ chúng trong Rương hoặc Túi!"]
	quest.7EFBAF3E281D2EBE.quest_desc: ["Bus lưu trữ ME &bME Storage Bus&f, khi đối mặt với một container lưu trữ bên ngoài, sẽ cho phép container được sử dụng như thể nó là một phần của mạng ME, cho phép lấy vật phẩm ra từ container hoặc chèn vào nó hoàn toàn thông qua ME. \n\n\n\nBus lưu trữ có thể được lọc và được cấp ưu tiên cụ thể sao cho các vật phẩm cụ thể sẽ cố gắng đi đến bộ lưu trữ đính kèm trước, tuy nhiên nó sẽ không di chuyển ngược lại bất kỳ vật phẩm đã lọc nào từ bất kỳ đâu trong mạng đến bộ lưu trữ đính kèm của nó."]
	quest.7EFBAF3E281D2EBE.quest_subtitle: "Rương dự phòng"
	quest.7EFBFF5D0DA018E7.quest_desc: ["Thêm bộ lọc cho các vật phẩm bạn muốn tự động xóa trong Ba lô."]
	quest.7EFBFF5D0DA018E7.quest_subtitle: "Thêm bộ lọc cho các vật phẩm bạn muốn tự động xóa trong Ba lô."
	quest.7F09F8F98C13F11B.quest_desc: ["Lễ hiến tế ma quỷ mà không có &cSự hiến tế&r! :D\n\n\n\nHầu hết thời gian, Ma quỷ chỉ thích các vật phẩm nên đừng quá sợ hãi. Tuy nhiên, nếu bạn có con Bò yêu quý, bạn có thể cần phải lo lắng. Xin lỗi Betsy.\n\n\n\n&aChén hiến tế&r được dùng để đặt các vật phẩm cần thiết cho Lễ nghi. Chúng có thể được đặt ở bất kỳ đâu trong Lễ nghi, miễn là nó không che phủ bất kỳ phấn vẽ (Chalk) cần thiết nào. \n\n\n\nBây giờ, bạn chỉ cần bốn cái, nhưng sau này bạn sẽ cần hơn mười cái chén cho mỗi lễ nghi!\n\n\n\n&6Chén hiến tế vàng&r được dùng ở giữa Lễ nghi để kích hoạt nó, và thường cũng cần một Sách Ràng Buộc (Book of Binding) cho Lễ nghi bên trong nó."]
	quest.7F09F8F98C13F11B.title: "Chuẩn bị cho Lễ nghi: &6Chén"
	quest.7F11ABFB2E21B7E4.quest_desc: ["Áo giáp là một phần rất quan trọng của &l&2Minecraft&r, nó là thứ bảo vệ bạn khỏi nguy hiểm. \n\n\n\nCác mảnh áo giáp khác nhau cho các Điểm Áo giáp (Armor Points) khác nhau. Đây là thứ xác định hiệu quả của Áo giáp bạn, càng nhiều càng tốt!\n\n\n\nHầu hết áo giáp có thể được thay đổi để trang trí hơn với Đường vẽ trang trí (Armor Trims), hãy dùng một mảnh Áo giáp với một Đường vẽ trang trí, và một Vật phẩm để tô màu để thay đổi diện mạo!"]
	quest.7F11ABFB2E21B7E4.title: "&l&bÁo giáp cơ bản&r"
	quest.7F2D696AC9F4C4E4.quest_desc: ["'&bGương ơi gương&r trên tường, làm sao tôi quay lại Điểm Hồi Sinh (Respawn Point) từ chuyến đi của mình?' \n\n \n\n'Sau khi đặt &bGương Ma thuật&r lên một Chiếc giường bằng cách nhấp chuột phải vào nó, bạn có thể giữ chuột phải để &bGương Ma thuật&r dịch chuyển bạn trở lại chiếc giường của bạn!' \n\n \n\n'Cảm ơn &bGương&r!'"]
	quest.7F2D696AC9F4C4E4.quest_subtitle: "Có thể tìm thấy trong Mỏ hầm (Mineshafts) hay Pháo đài (Strongholds)"
	quest.7F2D696AC9F4C4E4.title: "&bGương Ma thuật"
	quest.7F59941D62E672B0.quest_desc: ["Occultism cung cấp nhiều hơn chỉ là Quỷ để nghiền quặng của bạn!\n\n\n\nCó những Quỷ có thể di chuyển đồ đạc cho bạn, chặt gỗ, và nhiều hơn nữa!!\n\n\n\nCòn có cách để triệu hồi những người bạn tuyệt vời được gọi là &dThân tộc&r cho bạn các hiệu ứng đặc biệt và thậm chí chiến đấu cho bạn! Hãy chắc chắn xem các &dNghi thức Thân tộc&r trong sách hướng dẫn của bạn!"]
	quest.7F59941D62E672B0.title: "&dThân tộc"
	quest.7F67849DE9F700D8.quest_desc: ["&2Nâng cấp&r: Tốc độ làm cho Lò nướng của bạn nhanh hơn! &bLò nướng Kim cương&r sẽ nướng mỗi 40 Tick thay vì 80 Tick. Với chi phí là gấp đôi lượng Nhiên liệu tiêu thụ."]
	quest.7F67849DE9F700D8.title: "&2Nâng cấp&r: Tốc độ"
	quest.7F6B66566C211735.quest_desc: ["Đá nhỏ giọt (Dripstone) được dùng trên máy sinh quái sẽ giảm máu tối đa của quái vật được sinh ra. Điều này có thể giảm máu của chúng xuống còn 20%"]
	quest.7F6B66566C211735.title: "Máu"
	quest.7F85669FEA41CD97.quest_desc: ["Người bảo vệ Trung lập của &6Làng&r. Anh ấy sẽ tấn công tất cả Quái vật Hung ác gần đó. Giống như Iron Golem nhưng anh ấy trông quen thuộc? Có thể là ai đó chúng ta biết trong bộ đồng phục? \n\n\n\nBạn có thể giao dịch Healing Potions (Potion Hồi máu) với anh ấy và Ngọc lục bảo để lấy Bản đồ Gấp (Furled Map) sẽ sớm được tạo ra để giúp chống lại &aPháo đài Evoker&r! \n\n\n\nNếu bạn muốn giết anh ấy, anh ấy sẽ liên tục tấn công bạn bằng &6Holy Spells&r (Phép thuật Thánh). Anh ấy cũng sẽ Hồi máu bản thân khi máu thấp. \n\n\n\nKhi bị giết, anh ấy sẽ rơi Arcane Essence, Inks, &6Holy Runes&r (Rune Thánh), và &6Holy Scrolls&r (Cuộn Thánh).\n\n{image:atm:textures/questpics/iron_spells/spells_priest.png width:100 height:200 align:center}"]
	quest.7F85669FEA41CD97.title: "&6&lLinh mục"
	quest.7F8DEDD0A54D1E11.quest_desc: ["Tôi tự hỏi Droppers (Máy nhả) làm gì? \n\nTôi nghĩ chúng nhả đồ... \n\n\n\nBất kỳ item nào trong Bộ đệm (Buffer) sẽ được nhả xuống đất. \n\n\n\nCó thể hữu ích với thứ gì đó như Botania!"]
	quest.7F990FBC1A691020.quest_desc: ["Rương bẫy giống với rương thường, chỉ khác là chúng phát tín hiệu redstone khi được mở và không thể kết hợp thành một."]
	quest.7F990FBC1A691020.quest_subtitle: "\"Tôi tự hỏi bên trong có gì?\""
	quest.7FABB77A60E7962C.quest_desc: ["Bằng cách hòa trộn Obsidian với &bDiamonds&r chúng ta có thể nhận được Bụi Obsidian tinh chế! \n\n\n\nSau đó, chúng ta có thể nén &7Osmium&r vào để có dạng thỏi. \n\n\n\nSau tất cả, chúng ta có thể biến những thỏi đó thành Áo giáp với chỉ số tốt hơn cả Áo giáp Allthemodium&r!"]
	quest.7FABB77A60E7962C.quest_subtitle: "31"
	quest.7FABB77A60E7962C.title: "&5Áo giáp Obsidian tinh chế"
	quest.7FC54AF87CBDD222.quest_desc: ["&5Chiến trường cổ đại&r chỉ là một mảnh của quá khứ. \n\n\n\nAi biết chuyện gì đã xảy ra. \n\n\n\nAi biết ai đã chiến đấu với ai. Tất cả những gì chúng ta có bây giờ là những mảnh tường và những &5chồng áo giáp&r này. Tốt nhất là hãy nhặt chúng bằng cách Đào chúng với Cuốc của bạn.\n\n{image:atm:textures/questpics/iron_spells/spells_battleground.png width:200 height:100 align:center}"]
	quest.7FC54AF87CBDD222.title: "&5Chiến trường cổ đại"
	quest.7FE969CB4B419FC6.quest_desc: ["Với một chút công việc vào Mekanism, cỗ máy này cho phép bạn truyền bất cứ thứ gì không dây.\n\n\n\nBạn có thể thiết lập các kênh cụ thể để truyền các vật phẩm riêng lẻ, năng lượng, hoặc thậm chí khí từ Mekanism. Nó khá tuyệt."]
	quest.7FE969CB4B419FC6.quest_subtitle: "Không chỉ hoạt động cho Năng lượng"
	quest.7FE969CB4B419FC6.title: "&9Mekanism: &6Bộ liên kết lượng tử"
